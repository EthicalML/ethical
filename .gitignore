# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Python
__pycache__
*.pyc

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories. Both forms: the trailing-slash pattern does not match
# the node_modules symlink a git worktree carries, which is how one was once
# committed and clobbered the main tree's real directory on merge.
node_modules/
node_modules

# Astro build output and generated metadata
dist/
.astro/

# Local verification captures
scripts/verify/out/

# Tags
tags
tags.*
.tags 
.tags.*

# Github pages
Gemfile.lock
_site/

# Working / scratch files
tmp/

# Agent-local state stays out of the repo, but skills are project tooling and
# belong to everyone working on it. The eslint ignore for .claude is separate
# (eslint.config.mjs) and unaffected: worktrees are still never linted.
.claude/*
!.claude/skills/
.claude/settings.local.json
CLAUDE.md
tmp2
.obsidian/
.github/.obsidian/

# Local build environment (FORM_ENDPOINT etc.)
.env
.env.*
!.env.example
