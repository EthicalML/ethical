{
  "name": "ethical-institute-site",
  "description": "Website for The Institute for Ethical AI Alignment & Safety",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:ratchet": "node scripts/verify/verify-check.mjs && node scripts/verify/verify-styles-doc.mjs && node scripts/verify/verify-motion-docs.mjs",
    "lint": "eslint .",
    "format": "prettier --write src scripts astro.config.mjs eslint.config.mjs prettier.config.mjs package.json tsconfig.json .github/copilot-instructions.md README.md",
    "format:check": "prettier --check src scripts astro.config.mjs eslint.config.mjs prettier.config.mjs package.json tsconfig.json .github/copilot-instructions.md README.md",
    "events:banners": "node scripts/events/fetch-banners.mjs",
    "verify:dom": "node scripts/verify/verify-dom.mjs",
    "verify:dom:all": "sh -c 'node scripts/verify/verify-dom.mjs --viewport 1440x1000 \"$@\" && node scripts/verify/verify-dom.mjs --viewport 420x900 \"$@\"' --",
    "verify:events": "node scripts/verify/verify-events.mjs",
    "verify:shots": "node scripts/verify/verify-shots.mjs",
    "verify:shots:all": "sh -c 'node scripts/verify/verify-shots.mjs --viewport 1440x1000 \"$@\" && node scripts/verify/verify-shots.mjs --viewport 420x900 \"$@\"' --",
    "verify:motion": "node scripts/verify/verify-motion.mjs",
    "verify:motion:all": "sh -c 'node scripts/verify/verify-motion.mjs --viewport 1440x1000 \"$@\" && node scripts/verify/verify-motion.mjs --viewport 420x900 \"$@\"' --",
    "verify:parity": "node scripts/verify/verify-parity.mjs",
    "verify:typewriter": "node scripts/verify/verify-typewriter.mjs",
    "postbuild": "pagefind --site dist",
    "styles:sync": "node scripts/verify/verify-styles-doc.mjs --sync",
    "check:styles-doc": "node scripts/verify/verify-styles-doc.mjs",
    "check:motion-docs": "node scripts/verify/verify-motion-docs.mjs",
    "check:voice": "bash scripts/verify/check-voice.sh",
    "verify:canvas-surface": "node scripts/verify/verify-canvas-surface.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "7.0.8",
    "@astrojs/preact": "^6.0.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.9",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "fontkit": "^2.0.4",
    "globals": "17.11.0",
    "pagefind": "^1.5.2",
    "png-to-ico": "^3.0.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "wawoff2": "^2.0.1"
  },
  "overrides": {
    "nanoid": "^3.3.17"
  }
}
