---
interface Props {
  embedded?: boolean;
  backdrop?: boolean;
  surface?: 'dark' | 'page';
}

/* `surface` is the hardcoded label for what this mount sits on: the light theme
   keeps whole blocks dark, so a cube inside one must keep painting light-on-dark.
   Both embedded callers pass the same props but sit on different surfaces —
   `ArticleHero` on the dark hero, `ProjectPortal` on paper — so the caller says
   which, and canvas never sniffs its own backdrop. */
const { embedded = false, backdrop = false, surface = 'dark' } = Astro.props;
---

{
  embedded ? (
    <kompute-cube class:list={['kompute-canvas-mount', !backdrop && 'widget embedded-widget']} data-surface={surface}>
      <canvas aria-label="Animated Kompute cube" />
    </kompute-cube>
  ) : (
    <section aria-labelledby="kompute-cube-heading" data-reveal>
      <p class="eyebrow">CUSTOM WIDGET</p>
      <h2 id="kompute-cube-heading">Kompute cube</h2>
      <kompute-cube class="widget kompute-canvas-mount" data-surface={surface}>
        <canvas aria-label="Animated Kompute cube" />
      </kompute-cube>
    </section>
  )
}

<script>
  import '../shared/canvas/KomputeCube';
</script>

<style>
  kompute-cube {
    display: block;
  }
  canvas {
    display: block;
    height: 100%;
    width: 100%;
  }
</style>
