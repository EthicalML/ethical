---
interface Props {
  embedded?: boolean;
  backdrop?: boolean;
  surface?: 'dark' | 'page';
}

/* `surface` overrides the surface this mount would otherwise inherit from the
   nearest `data-surface` ancestor. Both embedded callers pass the same props but
   sit on different surfaces: `ArticleHero` inside a block that declares itself
   dark, so it says nothing, and `ProjectPortal` on paper inside no block at all,
   which is already `page`. Canvas never sniffs its own backdrop. */
const { backdrop = false, surface } = Astro.props;
---

<kompute-cube class:list={['kompute-canvas-mount', !backdrop && 'widget embedded-widget']} data-surface={surface}>
  <canvas aria-label="Animated Kompute cube"></canvas>
</kompute-cube>

<script>
  import '../shared/canvas/KomputeCube';
</script>

<style>
  kompute-cube {
    display: block;
  }
  canvas {
    display: block;
    height: 100%;
    width: 100%;
  }
</style>
