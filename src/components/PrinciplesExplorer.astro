---
import { getCollection } from 'astro:content';
import { isExternalHref } from '../utils/external-links.mjs';

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  homepage?: boolean;
  /* Single-lane mode for card-width embeds: one lane, row click opens the detail
     in place with a back control instead of navigating. Default off; the full
     two-lane explorer is unchanged when absent. */
  compact?: boolean;
}

const principles = (await getCollection('principles')).sort((a, b) => a.data.number.localeCompare(b.data.number));
const { eyebrow, heading, intro, homepage = false, compact = false } = Astro.props;
---

<section
  id={compact ? undefined : 'principles'}
  class:list={['principles-explorer', homepage && 'home-section', compact && 'compact']}
  data-principles
  data-reveal
>
  <p class="eyebrow">{eyebrow}</p>
  <principles-explorer data-compact={compact ? 'true' : undefined}>
    <div class="principles-explorer-grid">
      <div>
        <h2>{heading}</h2>
        <p class="section-intro">{intro}</p>
        <div class="principle-rows">
          {
            principles.map(({ data }, index) => (
              <button
                type="button"
                class:list={{ active: index === 0 }}
                data-principle-row={index}
                data-principle-number={data.number}
                data-principle-href={`/principles/${data.number}/`}
                data-morph-pair={`principle-${data.number}`}
                data-morph-href={`/principles/${data.number}/`}
              >
                <>
                  <span>{data.number}</span>
                  <strong>{data.title}</strong>
                  <i>{index === 0 ? '●' : ''}</i>
                </>
              </button>
            ))
          }
        </div>
      </div>
      <div class="principle-detail-wrap">
        {
          compact && (
            <button type="button" class="principle-back" data-principle-back>
              All principles
            </button>
          )
        }
        {
          principles.map(({ data }, index) => (
            <article class:list={['principle-detail', index === 0 && 'active']} data-principle-detail={index}>
              <p class="eyebrow">PRINCIPLE {data.number} — COMMITMENT</p>
              <h3 data-principle-title={data.number} data-morph-source={`principle-${data.number}`} data-morph-name={`principle-title-${data.number}`}>
                {data.title}
              </h3>
              <p class="commitment">{data.commitment}</p>
              <div class="detail-split">
                <div>
                  <>
                    <h4>FAILURE MODES</h4>
                    <ul>
                      {data.failure_modes?.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </>
                </div>
                <div>
                  <>
                    <h4>PRACTICAL CONTROLS</h4>
                    <ul>
                      {data.controls?.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </>
                </div>
              </div>
              <div class="principle-links">
                {data.related_links.map(({ label, href }) => (
                  <a
                    class="button"
                    href={href}
                    target={isExternalHref(href) ? '_blank' : undefined}
                    rel={isExternalHref(href) ? 'noopener noreferrer' : undefined}
                  >
                    {label}
                  </a>
                ))}
                <a class="button primary" href={`/principles/${data.number}/`} data-morph-pair={`principle-${data.number}`}>
                  Read principle
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </principles-explorer>
</section>
<script>
  import { navigate } from 'astro:transitions/client';
  import { bindMorphPairs } from '../shared/MorphPairs';

  class PrinciplesExplorer extends HTMLElement {
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      const rows = Array.from(this.querySelectorAll<HTMLElement>('[data-principle-row]'));
      const details = Array.from(this.querySelectorAll<HTMLElement>('[data-principle-detail]'));
      const titles = Array.from(this.querySelectorAll<HTMLElement>('[data-principle-title]'));
      if (!rows.length || !details.length) return;

      const select = (index: number, animate = true) => {
        rows.forEach((row, rowIndex) => {
          row.classList.toggle('active', rowIndex === index);
          const marker = row.querySelector<HTMLElement>('i');
          if (marker) marker.textContent = rowIndex === index ? '●' : '';
        });
        details.forEach((detail, detailIndex) => {
          detail.classList.toggle('active', detailIndex === index);
          if (detailIndex === index) {
            detail.style.animation = 'none';
            if (animate) {
              requestAnimationFrame(() => {
                detail.style.animation = 'principle-in .45s ease';
              });
            }
          }
        });
      };
      const restoredIndex = titles.findIndex((title) => title.hasAttribute('data-morph-restored'));
      if (restoredIndex >= 0) select(restoredIndex, false);

      bindMorphPairs(this, this.controller.signal);

      const compact = this.dataset.compact === 'true';
      this.querySelector('[data-principle-back]')?.addEventListener(
        'click',
        () => {
          delete this.dataset.lane;
        },
        { signal: this.controller.signal },
      );

      rows.forEach((row, index) => {
        if (!compact) {
          row.addEventListener(
            'mouseenter',
            () => {
              select(index);
            },
            { signal: this.controller.signal },
          );
        }
        row.addEventListener(
          'click',
          () => {
            // Do not replay the `principle-in` entrance fade here: this click triggers the
            // outgoing navigation, and the view-transition snapshot of the morph source (the
            // detail title) is captured while that fade still holds the detail near opacity 0,
            // which erases the forward morph. Select without animating so the source is fully
            // opaque when snapshotted.
            select(index, false);
            // Compact single-lane mode opens the detail in place; the detail's own
            // Read principle button carries the navigation.
            if (compact) {
              this.dataset.lane = 'detail';
              return;
            }
            const href = row.dataset.principleHref;
            if (href) void navigate(href);
          },
          { signal: this.controller.signal },
        );
      });
    }

    disconnectedCallback() {
      this.controller.abort();
    }
  }

  if (!customElements.get('principles-explorer')) {
    customElements.define('principles-explorer', PrinciplesExplorer);
  }
</script>

<style is:global>
.principles-explorer { display: block; }

.principles-explorer-grid { align-items: start; display: grid; gap: 56px; grid-template-columns: 1fr 1.15fr; margin-top: 20px; }

.principles-explorer-grid h2 { font: 300 44px/1.08 var(--font-display); margin: 0 0 10px; }

.principle-rows { margin-top: 24px; }

.principle-rows button { align-items: center; background: none; border: 0; border-top: 1px solid rgba(255,255,255,.08); border-radius: 0; color: rgba(244,242,238,.72); cursor: pointer; display: grid; grid-template-columns: 44px 1fr auto; padding: 14px 16px; text-align: left; width: 100%; }

.principle-rows button.active { background: var(--accent-wash-09); border-radius: var(--radius-row); }

.principle-rows span { color: var(--text-4); font: var(--mono-9)/1 var(--font-mono); }

.principle-rows strong { font-size: 17px; font-weight: 400; }

.principle-rows i { color: var(--accent); font-style: normal; }

.principle-detail-wrap { position: sticky; top: 96px; }

.principle-detail { background: rgba(255,255,255,.02); border: 1px solid var(--hairline-card); border-radius: 0; display: none; padding: 34px; }

.principle-detail.active { display: block; }

.principle-detail h3 { font: 300 34px/1.15 var(--font-display); margin: 20px 0; }

.principle-detail .commitment { color: var(--text-2); font-size: 16px; line-height: 1.6; }

.detail-split { border-top: 1px solid var(--hairline-card); display: grid; gap: 26px; grid-template-columns: 1fr 1fr; margin: 28px 0 0; padding-top: 24px; }

.detail-split h4 { color: rgba(244,242,238,.4); font: var(--mono-10)/normal var(--font-mono); letter-spacing: .1em; margin: 0; }

.detail-split ul { color: rgba(244,242,238,.72); display: flex; flex-direction: column; font-size: 14px; gap: 7px; line-height: normal; list-style: none; margin: 11px 0 0; padding: 0; }

.principle-links { border-top: 1px solid var(--hairline-card); display: flex; flex-wrap: wrap; gap: 8px; margin-top: 26px; padding-top: 22px; }

@keyframes principle-in { from { opacity: 0; transform: translateY(10px); } }

.principles-explorer.compact .principles-explorer-grid { gap: 0; grid-template-columns: 1fr; margin-top: 8px; }

.principles-explorer.compact .principles-explorer-grid h2 { font-size: 26px; margin-bottom: 8px; }

.principles-explorer.compact .section-intro { font-size: 13.5px; line-height: 1.55; }

.principles-explorer.compact .principle-rows { margin-top: 16px; }

.principles-explorer.compact .principle-rows button { padding: 11px 12px; }

.principles-explorer.compact .principle-rows strong { font-size: 15px; }

.principles-explorer.compact .principle-detail-wrap { display: none; position: static; }

.principles-explorer.compact principles-explorer[data-lane="detail"] .principle-detail-wrap { display: block; }

.principles-explorer.compact principles-explorer[data-lane="detail"] .principles-explorer-grid > div:first-child { display: none; }

.principles-explorer.compact .principle-detail { padding: 22px; }

.principles-explorer.compact .principle-detail h3 { font-size: 26px; margin: 14px 0; }

.principles-explorer.compact .principle-detail .commitment { font-size: 14px; }

.principles-explorer.compact .detail-split { gap: 18px; grid-template-columns: 1fr; margin-top: 20px; padding-top: 18px; }

.principle-back {
  background: none;
  border: 1px solid var(--hairline-card);
  border-radius: var(--radius-pill);
  color: var(--text-2);
  cursor: pointer;
  font: var(--mono-9)/1 var(--font-mono);
  letter-spacing: .09em;
  margin-bottom: 14px;
  padding: 10px 14px;
  text-transform: uppercase;
}

.principle-back:hover { border-color: rgba(94,230,160,.45); color: var(--accent); }

@media (max-width: 950px) {
  .principle-detail-wrap { position: static; }
}

@media (max-width: 950px) {
  .detail-split { grid-template-columns:1fr; }
}

@media (max-width: 950px) {
  .principles-explorer-grid { gap: 32px; grid-template-columns: 1fr; }
}

@media (max-width: 950px) {
  .principle-detail-wrap { position: static; }
}

@media (max-width: 600px) {
  .principles-explorer-grid { gap: 24px; }
}

@media (max-width: 600px) {
  .principle-rows button {
      grid-template-columns: 34px minmax(0, 1fr) 22px;
      min-height: 52px;
      padding-inline: 10px;
    }
}

@media (max-width: 600px) {
  .principle-rows strong { font-size: 15px; }
}

@media (max-width: 600px) {
  .principle-detail { padding: 24px 20px; }
}

@media (max-width: 600px) {
  .detail-split { grid-template-columns: 1fr; }
}
</style>
