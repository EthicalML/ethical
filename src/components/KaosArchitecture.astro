---
interface Props {
  embedded?: boolean;
  panel?: boolean;
  backdrop?: boolean;
  transitionName?: string;
  morphSource?: string;
  variant?: 'ambient' | 'interactive';
  surface?: 'dark' | 'page';
}

/* `surface`: see KomputeCube.astro. Every mount either sits inside a block that
   declares the dark role or on the page ground, so no caller needs to override. */
const { panel = false, backdrop = false, transitionName, morphSource, variant = 'ambient', surface } = Astro.props;
const transitionStyle = transitionName ? `view-transition-name: ${transitionName}` : undefined;
---

{
  panel ? (
    <kaos-architecture
      class="kaos-architecture-mount"
      aria-label="KAOS control-plane architecture"
      variant={variant}
      transition:name={transitionName}
      style={transitionStyle}
      data-morph-source={morphSource}
      data-surface={surface}
    />
  ) : (
    <kaos-architecture
      class:list={['kaos-architecture-mount', !backdrop && 'widget embedded-widget']}
      aria-label="KAOS control-plane architecture"
      variant={variant}
      transition:name={transitionName}
      style={transitionStyle}
      data-surface={surface}
    />
  )
}

<script>
  import '../shared/canvas/KaosArchitecture';
</script>
