---
interface Criterion {
  number: string;
  name: string;
  description: string;
  principle: string;
  principleHref: string;
}

interface Props {
  criteria: Criterion[];
}

const { criteria } = Astro.props;
---

<div class="criteria-map prose-block" data-reveal>
  <div class="map-header" aria-hidden="true"><span>AI-RFX criterion</span><span>Responsible AI Principle</span></div>
  {
    criteria.map((criterion) => (
      <details>
        <summary>
          <span class="criterion-number">{criterion.number}</span>
          <strong>{criterion.name}</strong>
          <a href={criterion.principleHref}>{criterion.principle}</a>
          <i aria-hidden="true">+</i>
        </summary>
        <p>{criterion.description}</p>
      </details>
    ))
  }
</div>

<style>
  .criteria-map {
    border-top: 1px solid var(--hairline-card);
  }

  .map-header,
  summary {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) minmax(220px, 0.7fr) 24px;
  }

  .map-header {
    color: var(--text-4);
    font: var(--mono-9)/1 var(--font-mono);
    letter-spacing: 0.1em;
    padding: 0 16px 12px;
    text-transform: uppercase;
  }

  .map-header span:first-child {
    grid-column: 1 / 3;
  }

  details {
    border-bottom: 1px solid var(--hairline-card);
  }

  summary {
    align-items: center;
    cursor: pointer;
    gap: 14px;
    list-style: none;
    padding: 18px 16px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover strong {
    color: var(--accent-ink);
  }

  .criterion-number {
    color: var(--text-4);
    font: var(--mono-10)/1 var(--font-mono);
  }

  summary strong {
    font-size: 16px;
    font-weight: 450;
    transition: color var(--duration-2);
  }

  summary a {
    border: 1px solid var(--accent-line);
    border-radius: var(--radius-pill);
    color: var(--accent-ink);
    font: var(--mono-9)/1.2 var(--font-mono);
    justify-self: start;
    letter-spacing: 0.05em;
    padding: 7px 10px;
  }

  summary i {
    color: var(--text-3);
    font-style: normal;
    transition: transform var(--duration-2);
  }

  details[open] summary i {
    transform: rotate(45deg);
  }

  details > p {
    color: var(--text-2);
    line-height: 1.65;
    margin: 0;
    max-width: 820px;
    padding: 0 16px 22px 84px;
  }

  @media (max-width: 600px) {
    .map-header {
      display: none;
    }

    summary {
      grid-template-columns: 38px 1fr 24px;
    }

    summary a {
      grid-column: 2 / 3;
    }

    summary i {
      grid-column: 3;
      grid-row: 1 / 3;
    }

    details > p {
      padding-left: 68px;
    }
  }
</style>
