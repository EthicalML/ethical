<request-path data-scenario="user" data-step="0">
  <div class="scenario-row" role="group" aria-label="Request scenario">
    <button type="button" class="active" aria-pressed="true" data-scenario="user">User request</button>
    <button type="button" aria-pressed="false" data-scenario="agent">Autonomous agent</button>
    <button type="button" aria-pressed="false" data-scenario="denied">Denied request</button>
  </div>
  <div class="identity-row" aria-live="polite">
    <span class="token subject"><i></i>subject: <b data-subject>keycloak:user</b></span>
    <span class="token actor"><i></i>actor: <b data-actor>serviceaccount:agent</b></span>
  </div>
  <div class="path" aria-label="Request authorization path">
    <article data-path-step><span>01</span><strong>Client</strong><small>request</small></article><i aria-hidden="true">→</i>
    <article data-path-step><span>02</span><strong>Envoy Gateway</strong><small>JWT verify</small></article><i aria-hidden="true">→</i>
    <article data-path-step class="pdp"><span>03</span><strong>OPA PDP</strong><small data-decision>allow / deny</small></article><i aria-hidden="true">→</i>
    <article data-path-step><span>04</span><strong>Agent</strong><small>identity checked</small></article><i aria-hidden="true">→</i>
    <article data-path-step><span>05</span><strong>Onward hop</strong><small>both tokens</small></article>
    <div class="denied-stamp" aria-hidden="true">403 · DENY</div>
  </div>
  <button class="step-button" type="button" data-step-button>Advance request →</button>
</request-path>

<script>
  class RequestPath extends HTMLElement {
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      const scenarios = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-scenario]'));
      const steps = Array.from(this.querySelectorAll<HTMLElement>('[data-path-step]'));
      const advance = this.querySelector<HTMLButtonElement>('[data-step-button]');
      const subject = this.querySelector<HTMLElement>('[data-subject]');
      const actor = this.querySelector<HTMLElement>('[data-actor]');
      const decision = this.querySelector<HTMLElement>('[data-decision]');
      if (!scenarios.length || !steps.length || !advance || !subject || !actor || !decision) return;
      let current = 0;

      const render = () => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const denied = this.dataset.scenario === 'denied';
        const limit = denied ? 2 : steps.length - 1;
        steps.forEach((step, index) => step.classList.toggle('active', reduced || index <= Math.min(current, limit)));
        this.dataset.step = String(current);
        this.classList.toggle('is-denied', denied && (reduced || current >= limit));
        advance.textContent = current >= limit ? 'Replay path ↺' : 'Advance request →';
      };
      const select = (button: HTMLButtonElement) => {
        this.dataset.scenario = button.dataset.scenario;
        current = 0;
        scenarios.forEach((item) => {
          const active = item === button;
          item.classList.toggle('active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        const autonomous = this.dataset.scenario === 'agent';
        const denied = this.dataset.scenario === 'denied';
        subject.textContent = autonomous ? 'serviceaccount:agent' : denied ? 'keycloak:unknown' : 'keycloak:user';
        actor.textContent = 'serviceaccount:agent';
        decision.textContent = denied ? 'deny · fail closed' : 'allow';
        render();
      };
      scenarios.forEach((button) => button.addEventListener('click', () => select(button), { signal: this.controller.signal }));
      advance.addEventListener(
        'click',
        () => {
          const limit = this.dataset.scenario === 'denied' ? 2 : steps.length - 1;
          current = current >= limit ? 0 : current + 1;
          render();
        },
        { signal: this.controller.signal },
      );
      render();
    }

    disconnectedCallback() {
      this.controller.abort();
    }
  }
  if (!customElements.get('request-path')) customElements.define('request-path', RequestPath);
</script>

<style>
  request-path {
    border: 1px solid var(--hairline-card);
    display: block;
    margin-top: 38px;
  }
  .scenario-row {
    border-bottom: 1px solid var(--hairline-card);
    display: flex;
    padding: 10px;
  }
  button {
    background: transparent;
    border: 0;
    color: var(--text-3);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--mono-10);
    padding: 10px 12px;
  }
  .scenario-row button.active {
    background: var(--accent-wash-09);
    color: var(--accent);
  }
  .identity-row {
    display: flex;
    gap: 8px;
    padding: 22px 24px 0;
  }
  .token {
    border: 1px solid var(--hairline-card);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--mono-9);
    padding: 7px 10px;
  }
  .token i {
    background: var(--accent);
    border-radius: 50%;
    display: inline-block;
    height: 5px;
    margin-right: 6px;
    width: 5px;
  }
  .token b {
    color: var(--text-1);
    font-weight: 400;
  }
  .path {
    align-items: center;
    display: grid;
    gap: 9px;
    grid-template-columns: 1fr auto 1.25fr auto 1fr auto 1fr auto 1fr;
    min-height: 250px;
    overflow: hidden;
    padding: 28px 24px;
    position: relative;
  }
  .path > i {
    color: var(--text-4);
    font-style: normal;
  }
  article {
    border: 1px solid var(--hairline-card);
    min-height: 106px;
    opacity: 0.25;
    padding: 16px 12px;
    transition:
      border-color 0.25s ease,
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  article.active {
    border-color: rgba(94, 230, 160, 0.42);
    opacity: 1;
    transform: translateY(-3px);
  }
  article span,
  article small {
    color: var(--text-3);
    display: block;
    font-family: var(--font-mono);
    font-size: var(--mono-9);
  }
  article strong {
    display: block;
    font-size: var(--body-13);
    font-weight: 500;
    margin: 15px 0 5px;
  }
  .denied-stamp {
    border: 1px solid var(--glitch-red);
    color: var(--glitch-red);
    font-family: var(--font-mono);
    font-size: var(--body-14);
    font-weight: 600;
    left: 55%;
    opacity: 0;
    padding: 9px 12px;
    pointer-events: none;
    position: absolute;
    top: 47%;
    transform: rotate(-8deg) scale(1.4);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .is-denied .pdp {
    border-color: var(--glitch-red);
  }
  .is-denied .denied-stamp {
    opacity: 1;
    transform: rotate(-8deg) scale(1);
  }
  .step-button {
    border-top: 1px solid var(--hairline-card);
    color: var(--accent);
    padding: 18px 24px;
    text-align: left;
    width: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    article,
    .denied-stamp {
      transition: none;
    }
    article.active {
      transform: none;
    }
    .step-button {
      display: none;
    }
  }
  @media (max-width: 850px) {
    .path {
      align-items: stretch;
      grid-template-columns: 1fr;
    }
    .path > i {
      text-align: center;
      transform: rotate(90deg);
    }
    article {
      min-height: auto;
    }
    .denied-stamp {
      left: 45%;
      top: 48%;
    }
  }
  @media (max-width: 560px) {
    .scenario-row {
      display: grid;
      grid-template-columns: 1fr;
    }
    .identity-row {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
