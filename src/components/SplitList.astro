---
interface Column {
  title: string;
  items: string[];
}

interface Props {
  left: Column;
  right: Column;
}

const { left, right } = Astro.props;
---

<section class="split-list" aria-label={`${left.title} and ${right.title}`} data-reveal>
  {
    [left, right].map((column) => (
      <div>
        <h2 class="eyebrow">{column.title}</h2>
        <ul>
          {column.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<style is:global>
  .split-list ul {
    color: var(--text-2);
    line-height: 1.8;
    padding-left: 18px;
  }

  @media (max-width: 600px) {
    .split-list {
      padding-inline: 18px;
    }
  }

  @media (max-width: 600px) {
    .split-list > div {
      padding: 24px 20px;
    }
  }
</style>
