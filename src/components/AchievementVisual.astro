---
interface Props {
  variant: 'eu-adoption' | 'uk-adoption' | 'citation-network' | 'un-chair' | 'acm-bridges' | 'policy-timeline';
}

const { variant } = Astro.props;
const meter = variant === 'eu-adoption' ? { adopted: 8, total: 12 } : variant === 'uk-adoption' ? { adopted: 13, total: 14 } : undefined;
---

<div class:list={['achievement-visual', `visual-${variant}`]} aria-hidden="true">
  {
    meter && (
      <svg viewBox="0 0 48 48">
        <path class="glyph-hairline" d="M9 37h30" />
        {Array.from({ length: meter.total }, (_, index) => {
          const x = 9 + (30 / (meter.total - 1)) * index;
          const height = index < meter.adopted ? 12 : 6;
          return <path class:list={['meter-segment', { adopted: index < meter.adopted }]} d={`M${x} 35V${35 - height}`} />;
        })}
        <text x="9" y="13">
          {meter.adopted}/{meter.total}
        </text>
      </svg>
    )
  }

  {
    variant === 'citation-network' && (
      <svg viewBox="0 0 48 48">
        <path class="glyph-hairline" d="M11 24h12M29 24l8-10M29 24l8 10" />
        <path class="glyph-accent" d="M11 24h12" />
        <circle class="glyph-node" cx="9" cy="24" r="3" />
        <circle class="glyph-node glyph-node-main" cx="26" cy="24" r="5" />
        <circle class="glyph-node" cx="39" cy="12" r="2.5" />
        <circle class="glyph-node" cx="39" cy="36" r="2.5" />
      </svg>
    )
  }

  {
    variant === 'un-chair' && (
      <svg viewBox="0 0 48 48">
        <circle class="glyph-hairline" cx="24" cy="24" r="15" />
        <circle class="glyph-hairline glyph-dash" cx="24" cy="24" r="9" />
        <circle class="glyph-node glyph-node-main" cx="35" cy="13" r="4" />
      </svg>
    )
  }

  {
    variant === 'acm-bridges' && (
      <svg viewBox="0 0 48 48">
        <path class="glyph-hairline glyph-dash" d="M8 31Q24 8 40 31" />
        <path class="glyph-accent" d="M8 31Q24 8 40 31" />
        <circle class="glyph-node glyph-node-main" cx="8" cy="31" r="4" />
        <circle class="glyph-node" cx="40" cy="31" r="4" />
      </svg>
    )
  }

  {
    variant === 'policy-timeline' && (
      <svg viewBox="0 0 48 48">
        <path class="glyph-hairline" d="M8 25h32" />
        <path class="glyph-accent" d="M8 25h23" />
        <circle class="glyph-node glyph-node-main" cx="8" cy="25" r="4" />
        <circle class="glyph-node" cx="40" cy="25" r="4" />
        <path class="glyph-tick" d="M16 20v10M24 20v10M32 20v10" />
      </svg>
    )
  }
</div>

<style>
  .achievement-visual {
    align-items: center;
    background: rgba(94, 230, 160, 0.08);
    border: 1px solid rgba(94, 230, 160, 0.24);
    display: flex;
    height: 52px;
    justify-content: center;
    left: 24px;
    position: absolute;
    top: 24px;
    width: 52px;
    z-index: 2;
  }
  svg {
    display: block;
    height: 40px;
    width: 40px;
  }
  path,
  circle {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  text {
    fill: var(--accent);
    font: 7px var(--font-mono);
    letter-spacing: 0.04em;
  }
  .glyph-hairline,
  .glyph-node,
  .glyph-tick,
  .meter-segment {
    stroke: rgba(244, 242, 238, 0.38);
    stroke-width: 1;
  }
  .glyph-accent,
  .meter-segment.adopted {
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .glyph-node {
    fill: var(--bg-inset);
  }
  .glyph-node-main {
    fill: var(--accent);
    stroke: var(--accent);
  }
  .glyph-dash {
    stroke-dasharray: 2 3;
  }
  .glyph-tick {
    opacity: 0.42;
  }
</style>
