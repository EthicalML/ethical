---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<section class:list={['stat-band', stats.length === 4 && 'four-stat']} aria-label="Institute statistics" data-reveal style={`--stat-columns: ${stats.length}`}>
  {
    stats.map((stat) => (
      <div class="stat">
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </div>
    ))
  }
</section>
