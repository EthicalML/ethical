---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<section class="stat-band" aria-label="Institute statistics" data-reveal>
  {
    stats.map((stat) => (
      <div class="stat">
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </div>
    ))
  }
</section>
