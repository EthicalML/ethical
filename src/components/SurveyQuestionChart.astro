---
import type { SurveyOptionAggregate, SurveyQuestionAggregate } from '../utils/SurveyReportData';

interface Props {
  question: SurveyQuestionAggregate;
}

const { question } = Astro.props;
const visibleOptions = question.options.slice(0, 8);
const remainingOptions = question.options.slice(8);
const headingId = `survey-question-${question.number}`;
const percentage = (option: SurveyOptionAggregate) => `${Math.round(option.share)}%`;
const barStyle = (option: SurveyOptionAggregate) => `--share: ${Math.min(option.share, 100).toFixed(2)}%`;
---

<figure class="survey-question" id={question.id} aria-labelledby={headingId} data-reveal>
  <figcaption>
    <span>QUESTION {String(question.number).padStart(2, '0')}</span>
    <h3 id={headingId}>{question.label}</h3>
    <p>
      N={question.responseCount}
      {question.multiChoice && <em>Multiple selections allowed</em>}
    </p>
  </figcaption>

  <ol class="survey-option-list">
    {
      visibleOptions.map((option) => (
        <li>
          <span class="option-label">{option.label}</span>
          <span class="bar-track" aria-hidden="true">
            <span style={barStyle(option)} />
          </span>
          <strong>{percentage(option)}</strong>
          <small title={`${option.count} respondents`}>n={option.count}</small>
        </li>
      ))
    }
  </ol>

  {
    remainingOptions.length > 0 && (
      <details>
        <summary>Show {remainingOptions.length} more answer options</summary>
        <ol class="survey-option-list remaining-options">
          {remainingOptions.map((option) => (
            <li>
              <span class="option-label">{option.label}</span>
              <span class="bar-track" aria-hidden="true">
                <span style={barStyle(option)} />
              </span>
              <strong>{percentage(option)}</strong>
              <small title={`${option.count} respondents`}>n={option.count}</small>
            </li>
          ))}
        </ol>
      </details>
    )
  }
</figure>

<style>
  .survey-question {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.028), transparent);
    border: 1px solid var(--hairline-card);
    margin: 0;
    padding: 28px;
  }

  figcaption {
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 18px;
  }

  figcaption > span,
  figcaption p,
  summary,
  small {
    font-family: var(--font-mono);
  }

  figcaption > span {
    color: var(--accent);
    font-size: var(--mono-9);
    letter-spacing: 0.12em;
  }

  h3 {
    font: 300 clamp(25px, 3vw, 34px) / 1.18 var(--font-display);
    margin: 12px 0 14px;
    max-width: 920px;
  }

  figcaption p {
    align-items: center;
    color: var(--text-3);
    display: flex;
    flex-wrap: wrap;
    font-size: var(--mono-10);
    gap: 10px 18px;
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }

  figcaption em {
    color: var(--text-2);
    font-style: normal;
  }

  .survey-option-list {
    display: grid;
    gap: 2px;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }

  li {
    align-items: center;
    display: grid;
    gap: 14px;
    grid-template-columns: minmax(170px, 290px) minmax(100px, 1fr) 50px 58px;
    min-height: 42px;
    padding: 6px 8px;
  }

  li:nth-child(odd) {
    background: rgba(255, 255, 255, 0.018);
  }

  .option-label {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.35;
  }

  .bar-track {
    background: rgba(255, 255, 255, 0.065);
    display: block;
    height: 12px;
    overflow: hidden;
  }

  .bar-track > span {
    background: var(--accent);
    display: block;
    height: 100%;
    min-width: 2px;
    width: var(--share);
  }

  strong,
  small {
    text-align: right;
  }

  strong {
    color: var(--text-1);
    font: 400 15px/1 var(--font-mono);
  }

  small {
    color: var(--text-3);
    font-size: var(--mono-9);
  }

  details {
    border-top: 1px solid var(--hairline);
    margin-top: 16px;
    padding-top: 10px;
  }

  summary {
    color: var(--accent);
    cursor: pointer;
    font-size: var(--mono-10);
    letter-spacing: 0.06em;
    min-height: 44px;
    padding: 14px 8px 8px;
    text-transform: uppercase;
  }

  .remaining-options {
    margin-top: 8px;
  }

  @media (max-width: 720px) {
    .survey-question {
      padding: 16px;
    }

    figcaption {
      padding-bottom: 14px;
    }

    h3 {
      margin: 10px 0;
    }

    .survey-option-list {
      margin-top: 14px;
    }

    li {
      gap: 8px;
      grid-template-columns: minmax(116px, 1.3fr) minmax(54px, 1fr) 38px 42px;
      min-height: 44px;
      padding: 6px 2px;
    }
  }

  @media (max-width: 430px) {
    li {
      grid-template-columns: minmax(106px, 1.25fr) minmax(48px, 1fr) 36px 40px;
    }
  }
</style>
