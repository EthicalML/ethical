---
// Site-wide Cmd/Ctrl+K search palette over the Pagefind index generated at
// build time (postbuild: pagefind --site dist). Results are split into Pages
// and Newsletter groups so the 400-issue archive never crowds out the site's
// own pages. The index only exists on built output; in dev the palette opens
// with a note instead of results.
//
// Nothing the palette shows first depends on that index. A curated set of
// flagship destinations is server-rendered into the panel, so the palette opens
// with content on the first frame and filters that set on every keystroke while
// Pagefind is still loading its chunks. Issue numbers are answered locally from
// the collection too: Pagefind ANDs query terms, so "mle 123" asked it for pages
// containing both "mle" (a string that appears on no issue page, they read "The
// ML Engineer") and "123", and returned everything except issue 123.
import { NEWSLETTER_TAGS } from '../content.config';
import { getIssueNumbers, toIssueRanges } from '../utils/RecentIssues';

const NEWSLETTER_PREFIX = '/newsletter/';

const SUGGESTIONS = [
  { href: '/principles/', title: 'The 9 Responsible AI Principles', note: 'The principles for AI alignment and safety' },
  { href: '/policy/', title: 'AI policy and standards', note: 'EU AI Act, ISO, UN and national engagement' },
  { href: '/frameworks/', title: 'AI safety frameworks', note: 'Procurement, maturity and security frameworks' },
  { href: '/open-source/', title: 'Open source projects', note: 'KAOS, Kompute, XAI and the production ML catalogue' },
  { href: '/newsletter/', title: 'The ML Engineer newsletter', note: 'Weekly production ML and MLOps issues' },
  { href: '/blog/', title: 'Blog', note: 'Engineering notes and write-ups' },
  { href: '/reports/state-of-ml-2025/', title: 'State of Production ML 2025', note: 'Survey report, data and analysis' },
  { href: '/about/', title: 'About the Institute', note: 'Mission, membership and the network' },
];

const issueRanges = toIssueRanges(await getIssueNumbers());
---

<command-palette data-newsletter-prefix={NEWSLETTER_PREFIX} data-newsletter-tags={NEWSLETTER_TAGS.join(' ')} data-newsletter-issues={issueRanges}>
  <div class="palette-overlay" data-palette-overlay hidden>
    <div class="palette-panel" data-surface="dark" role="dialog" aria-modal="true" aria-label="Site search">
      <div class="palette-input-row">
        <span class="palette-glyph" aria-hidden="true">›</span>
        <input data-palette-input type="search" placeholder="Search the Institute…" autocomplete="off" spellcheck="false" aria-label="Search query" />
        <span class="palette-hint" aria-hidden="true">ESC</span>
      </div>
      <div class="palette-results" data-palette-results>
        <div class="palette-group" data-palette-group="suggested">
          <p class="palette-eyebrow" data-palette-suggested-eyebrow>START HERE</p>
          <div data-palette-list="suggested">
            {
              SUGGESTIONS.map((suggestion) => (
                <a class="palette-result" href={suggestion.href} data-palette-suggestion>
                  <strong>{suggestion.title}</strong>
                  <span>{suggestion.note}</span>
                </a>
              ))
            }
          </div>
        </div>
        <div class="palette-group" data-palette-group="pages" hidden>
          <p class="palette-eyebrow">MORE PAGES</p>
          <div data-palette-list="pages"></div>
        </div>
        <div class="palette-group" data-palette-group="newsletter" hidden>
          <p class="palette-eyebrow">THE ML ENGINEER — NEWSLETTER</p>
          <div data-palette-list="newsletter"></div>
        </div>
      </div>
      <p class="palette-status" data-palette-status hidden></p>
    </div>
  </div>
</command-palette>

<style>
  .palette-overlay {
    align-items: flex-start;
    backdrop-filter: blur(4px);
    background: rgba(var(--scrim-modal-rgb), 0.62);
    display: flex;
    inset: 0;
    justify-content: center;
    padding: 16vh 16px 16px;
    position: fixed;
    z-index: 60;
  }
  .palette-overlay[hidden] {
    display: none;
  }
  .palette-panel {
    background: var(--bg-inset);
    border: 1px solid var(--hairline-card);
    border-radius: 10px;
    box-shadow: 0 24px 80px var(--shadow-drop);
    max-height: 62vh;
    overflow: hidden auto;
    width: min(640px, 100%);
  }
  .palette-input-row {
    align-items: center;
    border-bottom: 1px solid var(--hairline);
    display: flex;
    gap: 12px;
    padding: 14px 16px;
    position: sticky;
    top: 0;
    background: var(--bg-inset);
  }
  .palette-glyph {
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .palette-input-row input {
    background: none;
    border: 0;
    color: var(--text-1);
    flex: 1;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.03em;
    outline: none;
    padding: 0;
  }
  .palette-input-row input::placeholder {
    color: var(--ink-5);
  }
  .palette-hint {
    border: 1px solid var(--hairline);
    border-radius: 4px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.1em;
    padding: 3px 6px;
  }
  .palette-results {
    padding: 6px 0 10px;
  }
  .palette-results[hidden],
  .palette-group[hidden] {
    display: none;
  }
  .palette-eyebrow {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--mono-10);
    letter-spacing: 0.14em;
    margin: 12px 16px 6px;
  }
  .palette-results :global(a.palette-result) {
    border-left: 2px solid transparent;
    display: block;
    padding: 9px 16px 9px 14px;
  }
  .palette-results :global(a.palette-result[hidden]) {
    display: none;
  }
  .palette-results :global(a.palette-result:hover),
  .palette-results :global(a.palette-result[data-active='1']) {
    background: var(--accent-wash);
    border-left-color: var(--accent-ink);
    opacity: 1;
  }
  .palette-results :global(a.palette-result strong) {
    color: var(--text-1);
    display: block;
    font-size: 14px;
    font-weight: 500;
  }
  .palette-results :global(a.palette-result span) {
    color: var(--text-2);
    display: block;
    font-size: 12.5px;
    line-height: 1.55;
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .palette-results :global(a.palette-result mark) {
    background: none;
    color: var(--accent-ink);
  }
  .palette-status {
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--mono-11);
    letter-spacing: 0.06em;
    margin: 0;
    padding: 16px;
  }

  /* Reachable from the header on a phone as of this change, so the panel is sized
     for one: the 16vh drop wasted a third of a short screen, and the box is capped
     in dvh because the on-screen keyboard shrinks the visual viewport while the
     field is focused. The 16px field is the iOS rule, not a type choice — Safari
     zooms the whole page in on any focused input below 16px. */
  @media (max-width: 600px) {
    .palette-overlay {
      padding: 8vh 12px 12px;
    }
    .palette-panel {
      max-height: 70dvh;
    }
    .palette-input-row input {
      font-size: 16px;
    }
  }
</style>

<script>
  type PagefindResult = { data: () => Promise<{ url: string; excerpt: string; meta?: { title?: string } }> };
  type Pagefind = { search: (query: string) => Promise<{ results: PagefindResult[] }>; preload?: (query: string) => Promise<void> };
  type Entry = { url: string; title: string; excerpt: string };

  const PAGE_LIMIT = 6;
  const NEWSLETTER_LIMIT = 5;
  // Fragments are fetched in one batch, so this bounds a round trip rather than a waterfall.
  const FETCH_LIMIT = 16;

  class CommandPalette extends HTMLElement {
    private controller = new AbortController();
    private pagefind?: Pagefind;
    private pagefindFailed = false;
    private debounce?: number;
    private searchId = 0;
    private issueRanges: [number, number][] = [];

    connectedCallback() {
      this.controller = new AbortController();
      const { signal } = this.controller;
      const overlay = this.querySelector<HTMLElement>('[data-palette-overlay]');
      const input = this.querySelector<HTMLInputElement>('[data-palette-input]');
      if (!overlay || !input) return;

      this.issueRanges = (this.dataset.newsletterIssues ?? '')
        .split(' ')
        .filter(Boolean)
        .map((part) => {
          const [from, to] = part.split('-');
          return [Number(from), Number(to ?? from)] as [number, number];
        });

      document.addEventListener(
        'keydown',
        (event) => {
          if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
            event.preventDefault();
            if (overlay.hidden) this.open();
            else this.close();
          } else if (event.key === 'Escape' && !overlay.hidden) {
            this.close();
          } else if (!overlay.hidden && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
            event.preventDefault();
            this.move(event.key === 'ArrowDown' ? 1 : -1);
          } else if (!overlay.hidden && event.key === 'Enter') {
            const active = this.rows().find((link) => link.dataset.active === '1');
            if (active) {
              event.preventDefault();
              this.close();
              active.click();
            }
          }
        },
        { signal },
      );
      document.addEventListener(
        'click',
        (event) => {
          const target = event.target as HTMLElement;
          if (target.closest('[data-command-palette-open]')) {
            event.preventDefault();
            this.open();
          } else if (!overlay.hidden && !target.closest('.palette-panel')) {
            this.close();
          }
        },
        { signal },
      );
      input.addEventListener(
        'input',
        () => {
          // The local pass runs on the keystroke itself: filtering the curated set
          // and resolving an issue number needs no index, so the panel always
          // responds immediately and the Pagefind pass only adds to it.
          const query = input.value.trim();
          this.renderLocal(query);
          window.clearTimeout(this.debounce);
          this.debounce = window.setTimeout(() => void this.search(query), 80);
        },
        { signal },
      );
      document.addEventListener('astro:before-swap', () => this.close(), { signal });

      // Warm the search engine before the first open: the Pagefind bundle,
      // its wasm binary and the index metadata otherwise load on demand, which
      // made the first palette interaction visibly slow.
      const warm = () => void this.loadPagefind({ quiet: true });
      if (typeof requestIdleCallback === 'function') requestIdleCallback(warm, { timeout: 2500 });
      else setTimeout(warm, 350);
    }

    disconnectedCallback() {
      this.controller.abort();
      window.clearTimeout(this.debounce);
    }

    private open() {
      const overlay = this.querySelector<HTMLElement>('[data-palette-overlay]');
      const input = this.querySelector<HTMLInputElement>('[data-palette-input]');
      if (!overlay || !input) return;
      overlay.hidden = false;
      input.value = '';
      this.renderLocal('');
      this.status('');
      input.focus();
      if (this.pagefindFailed) this.status('Search index unavailable — it is generated on the production build.');
      else void this.loadPagefind();
    }

    private close() {
      const overlay = this.querySelector<HTMLElement>('[data-palette-overlay]');
      if (overlay) overlay.hidden = true;
    }

    private async loadPagefind(options?: { quiet?: boolean }) {
      if (this.pagefind || this.pagefindFailed) return;
      try {
        // Generated by the postbuild pagefind step; present only on built output.
        // The specifier goes through a variable so neither Vite nor the type
        // checker tries to resolve it as a module at build time.
        const indexUrl = '/pagefind/pagefind.js';
        this.pagefind = (await import(/* @vite-ignore */ indexUrl)) as Pagefind;
        // Pull the index chunks down too so the first keystroke searches locally.
        void this.pagefind.preload?.('');
      } catch {
        this.pagefindFailed = true;
        if (!options?.quiet) this.status('Search index unavailable — it is generated on the production build.');
      }
    }

    private status(text: string) {
      const status = this.querySelector<HTMLElement>('[data-palette-status]');
      if (!status) return;
      status.textContent = text;
      status.hidden = !text;
    }

    private suggestions() {
      return Array.from(this.querySelectorAll<HTMLAnchorElement>('[data-palette-suggestion]'));
    }

    /** Filters the server-rendered destinations and resolves an issue number, with no index. */
    private renderLocal(query: string) {
      const group = this.querySelector<HTMLElement>('[data-palette-group="suggested"]');
      const eyebrow = this.querySelector<HTMLElement>('[data-palette-suggested-eyebrow]');
      const needle = query.toLowerCase();
      let visible = 0;
      for (const suggestion of this.suggestions()) {
        const haystack = suggestion.textContent?.toLowerCase() ?? '';
        const match = !needle || haystack.includes(needle);
        suggestion.hidden = !match;
        if (match) visible += 1;
      }
      if (group) group.hidden = visible === 0;
      if (eyebrow) eyebrow.textContent = needle ? 'PAGES' : 'START HERE';
      // An emptied box drops back to the opening state; otherwise the previous
      // query's index matches stay put until the new ones replace them, so the
      // list narrows rather than blanking between keystrokes.
      if (!needle) {
        this.fill('pages', []);
        this.fill('newsletter', []);
      }
      this.pinIssue(this.issueFromQuery(query));
      this.markFirstActive();
    }

    /** A number anywhere in the query that names a real issue: "123", "mle 123", "issue 123". */
    private issueFromQuery(query: string) {
      const digits = query.match(/\d{1,4}/);
      if (!digits) return undefined;
      const issue = Number(digits[0]);
      return this.issueRanges.some(([from, to]) => issue >= from && issue <= to) ? issue : undefined;
    }

    private issueUrl(issue: number) {
      return `${this.dataset.newsletterPrefix ?? '/newsletter/'}${issue}/`;
    }

    /** Keeps the number match as the first newsletter row without rebuilding the rest. */
    private pinIssue(issue?: number) {
      const results = this.querySelector<HTMLElement>('[data-palette-results]');
      const group = this.querySelector<HTMLElement>('[data-palette-group="newsletter"]');
      const pages = this.querySelector<HTMLElement>('[data-palette-group="pages"]');
      const list = this.querySelector<HTMLElement>('[data-palette-list="newsletter"]');
      if (!results || !group || !pages || !list) return;
      list.querySelector('[data-palette-pin]')?.remove();
      if (issue !== undefined) {
        const row = this.row({ url: this.issueUrl(issue), title: `The ML Engineer, issue #${issue}`, excerpt: `Open newsletter issue ${issue}` });
        row.dataset.palettePin = '';
        list.prepend(row);
      }
      group.hidden = list.children.length === 0;
      // An asked-for issue number is the answer, so its group leads; without one
      // the site's own pages come first and the archive stays below them.
      if (issue === undefined) results.append(group);
      else results.insertBefore(group, pages);
    }

    private async search(query: string) {
      if (!query) {
        this.render([], []);
        this.status('');
        return;
      }
      await this.loadPagefind();
      if (!this.pagefind) return;
      const id = ++this.searchId;
      const response = await this.pagefind.search(query);
      if (id !== this.searchId) return;
      const prefix = this.dataset.newsletterPrefix ?? '/newsletter/';
      const pages: Entry[] = [];
      // Tag names typed into the palette surface a browse row jumping to the
      // filtered archive, ahead of the full-text issue matches.
      const normalized = query.toLowerCase().replace(/\s+/g, '-');
      const issues: Entry[] = (this.dataset.newsletterTags ?? '')
        .split(' ')
        .filter((tag) => tag && normalized.length >= 2 && tag.includes(normalized))
        .slice(0, 2)
        .map((tag) => ({
          url: `${prefix}topic/${tag}/`,
          title: `Browse tag: ${tag}`,
          excerpt: `All newsletter issues tagged <mark>${tag}</mark>`,
        }));
      // One batch instead of a fragment fetch per result: the awaits used to run in
      // series, so every extra result cost another round trip before anything rendered.
      const fragments = await Promise.all(response.results.slice(0, FETCH_LIMIT).map((result) => result.data()));
      if (id !== this.searchId) return;
      const suggested = new Set(this.suggestions().flatMap((link) => (link.hidden ? [] : [link.getAttribute('href')])));
      for (const data of fragments) {
        if (pages.length >= PAGE_LIMIT && issues.length >= NEWSLETTER_LIMIT) break;
        const url = data.url.replace(/index\.html$/, '');
        const entry = { url, title: data.meta?.title || url, excerpt: data.excerpt };
        if (url.startsWith(prefix)) {
          if (issues.length < NEWSLETTER_LIMIT) issues.push(entry);
        } else if (pages.length < PAGE_LIMIT && !suggested.has(url)) {
          pages.push(entry);
        }
      }
      this.render(pages, issues);
      this.status(this.querySelector('a.palette-result:not([hidden])') ? '' : `No results for “${query}”.`);
    }

    private render(pages: Entry[], issues: Entry[]) {
      // The locally resolved issue stays pinned above the full-text matches.
      const issue = this.issueFromQuery(this.querySelector<HTMLInputElement>('[data-palette-input]')?.value.trim() ?? '');
      this.fill('pages', pages);
      this.fill('newsletter', issue === undefined ? issues : issues.filter((entry) => entry.url !== this.issueUrl(issue)));
      this.pinIssue(issue);
      this.markFirstActive();
    }

    private row(entry: Entry) {
      const link = document.createElement('a');
      link.className = 'palette-result';
      link.href = entry.url;
      const title = document.createElement('strong');
      title.textContent = entry.title;
      const excerpt = document.createElement('span');
      // Pagefind excerpts carry only <mark> highlights; rendered as HTML so
      // matches read highlighted rather than as literal tags.
      excerpt.innerHTML = entry.excerpt;
      link.append(title, excerpt);
      link.addEventListener('click', () => this.close(), { signal: this.controller.signal });
      return link;
    }

    private fill(key: 'pages' | 'newsletter', entries: Entry[]) {
      const group = this.querySelector<HTMLElement>(`[data-palette-group="${key}"]`);
      const list = this.querySelector<HTMLElement>(`[data-palette-list="${key}"]`);
      if (!group || !list) return;
      group.hidden = !entries.length;
      list.textContent = '';
      for (const entry of entries) list.append(this.row(entry));
    }

    private rows() {
      return Array.from(this.querySelectorAll<HTMLAnchorElement>('a.palette-result')).filter((link) => !link.hidden);
    }

    private markFirstActive() {
      const rows = this.rows();
      const keep = rows.find((link) => link.dataset.active === '1');
      // Every row is cleared, not just the visible ones: a filtered-out row that
      // kept the flag would still be the one Enter opened.
      for (const link of this.querySelectorAll<HTMLAnchorElement>('a.palette-result')) if (link !== keep) delete link.dataset.active;
      if (!keep && rows[0]) rows[0].dataset.active = '1';
    }

    private move(delta: number) {
      const links = this.rows();
      if (!links.length) return;
      const current = links.findIndex((link) => link.dataset.active === '1');
      if (current >= 0) delete links[current].dataset.active;
      const next = ((current < 0 ? (delta > 0 ? -1 : 0) : current) + delta + links.length) % links.length;
      links[next].dataset.active = '1';
      links[next].scrollIntoView({ block: 'nearest' });
    }
  }

  if (!customElements.get('command-palette')) {
    customElements.define('command-palette', CommandPalette);
  }
</script>
