---
import EventBanner from './EventBanner.astro';
import { loadEvents, openCfps, eventDate, daysUntil, type Event } from '../utils/Events';

interface Props {
  /** speaking: upcoming events we appear at. featured: the curated list, in the order given. */
  mode: 'speaking' | 'featured';
  names?: string[];
  empty?: string;
}

const { mode, names = [], empty } = Astro.props;
const today = new Date();
const { upcoming } = await loadEvents(today);

const events: Event[] =
  mode === 'speaking'
    ? upcoming.filter((event) => (event.talks ?? []).length > 0)
    : names
        .map((name) => upcoming.find((event) => event.name === name))
        .filter((event): event is Event => Boolean(event));
---

{
  events.length === 0 && empty ? (
    <p class="cards-empty">{empty}</p>
  ) : (
    <div class="event-cards">
      {events.map((event) => (
        <a class="event-card" href={event.url} target="_blank" rel="noopener noreferrer" data-reveal>
          <span class="card-banner">
            <EventBanner
              slug={event.slug}
              series={event.series}
              label={event.series.toUpperCase()}
              topic={event.topics?.[0]}
            />
          </span>
          <span class="card-body">
            <span class="card-date">{eventDate(event)}</span>
            <span class="card-name">{event.name}</span>
            {event.location && <span class="card-where">{event.location}</span>}
            {(event.talks ?? []).map((talk) => (
              <span class="card-talk">{talk.title}</span>
            ))}
            <span class="card-marks">
              {(event.talks ?? []).length > 0 && <span class="mark speaking">SPEAKING</span>}
              {openCfps(event, today).map((cfp) => (
                <span class="mark cfp">CFP · {daysUntil(cfp.deadline!, today)}D</span>
              ))}
            </span>
          </span>
        </a>
      ))}
    </div>
  )
}

<style>
  .event-cards {
    display: grid;
    gap: var(--space-20);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: var(--space-34) 0 var(--space-26);
  }
  .event-card {
    border: 1px solid var(--hairline);
    color: inherit;
    display: grid;
    grid-template-rows: auto 1fr;
    text-decoration: none;
    transition:
      border-color 0.4s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .event-card:hover {
    border-color: var(--accent-edge, var(--hairline-strong));
    transform: translateY(-3px);
  }
  .card-banner {
    aspect-ratio: 5 / 2;
    display: block;
    overflow: hidden;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding: var(--space-20);
  }
  .card-date {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .card-name {
    color: var(--text-1);
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .card-where {
    color: var(--text-2);
    font-size: 0.88rem;
  }
  .card-talk {
    border-top: 1px solid var(--hairline);
    color: var(--text-3);
    font-size: 0.85rem;
    margin-top: var(--space-8);
    padding-top: var(--space-8);
  }
  .card-marks {
    display: flex;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }
  .mark {
    border: 1px solid var(--hairline);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    padding: 3px var(--space-8);
  }
  .mark.cfp {
    border-color: var(--accent-edge, var(--hairline-strong));
    color: var(--accent, var(--text-1));
  }
  .cards-empty {
    color: var(--text-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .event-card {
      transition: none;
    }
    .event-card:hover {
      transform: none;
    }
  }
  @media (max-width: 760px) {
    .event-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
