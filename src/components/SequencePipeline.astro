<sequence-pipeline class="sequence-pipeline prose-block" data-reveal>
  <div class="sequence-heading">
    <div>
      <p class="eyebrow">SEQUENCE RECORDING</p>
      <h3>From host tensors to shader results</h3>
    </div>
    <button type="button" data-replay>Replay sequence ↻</button>
  </div>

  <div class="concept-flow" aria-label="Kompute API creation order">
    <span><b>01</b> Manager</span><i>→</i><span><b>02</b> Tensors</span><i>→</i><span><b>03</b> Algorithm</span><i>→</i><span><b>04</b> Sequence</span>
  </div>

  <div class="pipeline-animation" aria-label="Sequence operation flow">
    <div class="band host-band">
      <span class="band-label">HOST</span>
      <div class="tensor-set">
        <span>tensorInA</span><span>tensorInB</span><span>tensorOutA</span><span>tensorOutB</span>
      </div>
    </div>
    <div class="operation sync-device"><span>OpSyncDevice</span><i>↓</i></div>
    <div class="band device-band">
      <span class="band-label">DEVICE</span>
      <div class="shader-block"><small>ALGORITHM</small><strong>shader.spv</strong><span>push constants [2] → [3]</span></div>
    </div>
    <div class="operation dispatch"><span>OpAlgoDispatch</span><i>⚡</i></div>
    <div class="operation sync-local"><span>OpSyncLocal</span><i>↑</i></div>
    <p class="result">RESULTS SYNCHRONISED</p>
  </div>

  <figure class="pipeline-static">
    <img
      src="/images/oss/kompute-architecture.jpg"
      alt="Kompute Manager architecture linking sequences, algorithms, tensors, and the Vulkan device"
      loading="lazy"
    />
    <figcaption>Kompute’s Manager, Sequence, Algorithm and Tensor architecture.</figcaption>
  </figure>
</sequence-pipeline>

<script>
  class SequencePipeline extends HTMLElement {
    private controller = new AbortController();
    private observer?: IntersectionObserver;

    connectedCallback() {
      this.controller = new AbortController();
      const replay = this.querySelector<HTMLButtonElement>('[data-replay]');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const play = () => {
        this.classList.remove('playing');
        void this.offsetWidth;
        this.classList.add('playing');
      };

      replay?.addEventListener('click', play, { signal: this.controller.signal });
      this.observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          play();
          this.observer?.disconnect();
        },
        { threshold: 0.35 },
      );
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.controller.abort();
      this.observer?.disconnect();
    }
  }

  if (!customElements.get('sequence-pipeline')) customElements.define('sequence-pipeline', SequencePipeline);
</script>

