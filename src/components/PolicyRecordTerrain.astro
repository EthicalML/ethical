---
import type { PolicyRecordProduct } from './PolicyRecordData';

interface Props {
  products: PolicyRecordProduct[];
}

const { products } = Astro.props;
// Only documents with curated verbatim phrases join the terrain rotation.
const terrainDocs = products.map((product, index) => ({ product, index })).filter(({ product }) => product.phrases.length > 0);
---

<policy-record-terrain class="ter" data-reveal>
  <header class="ter-head">
    <div>
      <p class="eyebrow">PHRASE TERRAIN</p>
      <h2>The record as language</h2>
      <p class="ter-lede">Select a document to reform the sphere from its own verbatim phrases. Idle, it holds the full policy corpus.</p>
    </div>
    <p class="record-count"><strong>{terrainDocs.length}</strong> documents</p>
  </header>

  <div class="ter-split">
    <div class="ter-list" role="listbox" aria-label="Policy documents">
      {
        terrainDocs.map(({ product, index }) => (
          <button
            type="button"
            class="ter-row"
            role="option"
            data-index={index}
            data-phrases={JSON.stringify(product.phrases)}
            data-summary={product.summary}
            data-href={product.href}
            aria-selected="false"
          >
            <span class="ter-row-title">{product.title}</span>
            <span class="instrument-tag">{product.instrument}</span>
          </button>
        ))
      }
    </div>

    <div class="ter-stage">
      <phrase-terrain class="ter-canvas"><canvas aria-hidden="true"></canvas></phrase-terrain>
      <div class="ter-dossier">
        <p data-dossier>Idle: the full policy corpus. Select a document to reform the sphere.</p>
        <a class="ter-cta" data-cta href="/policy/" hidden>Open PDF ↗</a>
      </div>
    </div>
  </div>
</policy-record-terrain>

<script>
  import '../shared/canvas/PhraseTerrain';
  import type { PhraseTerrain } from '../shared/canvas/PhraseTerrain';

  class PolicyRecordTerrain extends HTMLElement {
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      this.querySelectorAll<HTMLButtonElement>('.ter-row').forEach((row) => {
        row.addEventListener('click', () => this.select(row), { signal: this.controller.signal });
      });
    }

    disconnectedCallback() {
      this.controller.abort();
    }

    private select(row: HTMLButtonElement) {
      const terrain = this.querySelector('phrase-terrain') as PhraseTerrain | null;
      const phrases = JSON.parse(row.dataset.phrases ?? '[]') as string[];
      terrain?.setPhrases(phrases);
      this.querySelectorAll<HTMLButtonElement>('.ter-row').forEach((other) => other.setAttribute('aria-selected', String(other === row)));
      const dossier = this.querySelector<HTMLElement>('[data-dossier]');
      if (dossier) dossier.textContent = row.dataset.summary ?? '';
      const cta = this.querySelector<HTMLAnchorElement>('[data-cta]');
      if (cta && row.dataset.href) {
        cta.href = row.dataset.href;
        cta.hidden = false;
      }
    }
  }

  if (!customElements.get('policy-record-terrain')) {
    customElements.define('policy-record-terrain', PolicyRecordTerrain);
  }
</script>

<style>
  .ter {
    border-block: 1px solid var(--hairline);
    display: block;
    padding: 72px 48px 88px;
  }

  .ter-head {
    align-items: end;
    display: flex;
    gap: 24px;
    justify-content: space-between;
  }

  h2 {
    font: 300 clamp(34px, 4.2vw, 54px) / 1.02 var(--font-display);
    margin: 16px 0 0;
  }

  .ter-lede {
    color: var(--text-3);
    margin: 12px 0 0;
    max-width: 48ch;
  }

  .record-count {
    color: var(--text-4);
    flex: none;
    font: var(--mono-10) / 1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .record-count strong {
    color: var(--accent);
    font-size: 22px;
    font-weight: 400;
    margin-right: 7px;
  }

  .ter-split {
    display: grid;
    gap: 32px;
    grid-template-columns: minmax(320px, 0.85fr) 1.15fr;
    margin-top: 40px;
  }

  .ter-list {
    display: flex;
    flex-direction: column;
    max-height: 560px;
    overflow-y: auto;
  }

  .ter-row {
    background: transparent;
    border: 0;
    border-top: 1px solid var(--hairline);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px 14px 20px;
    position: relative;
    text-align: left;
  }

  .ter-row:hover {
    background: rgba(255, 255, 255, 0.025);
  }

  .ter-row[aria-selected='true'] {
    background: var(--accent-wash-09);
  }

  .ter-row[aria-selected='true']::before {
    background: var(--accent);
    content: '';
    inset: 0 auto 0 0;
    position: absolute;
    width: 2px;
  }

  .ter-row-title {
    color: var(--text-1);
    font: 400 15px/1.35 var(--font-body);
  }

  .instrument-tag {
    color: var(--text-4);
    font: var(--mono-9) / 1.3 var(--font-mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .ter-stage {
    align-self: start;
    position: sticky;
    top: 24px;
  }

  .ter-canvas {
    background: var(--bg-inset);
    border: 1px solid var(--hairline-card);
    display: block;
    height: 52vh;
    min-height: 380px;
  }

  .ter-canvas canvas {
    display: block;
    height: 100%;
    width: 100%;
  }

  .ter-dossier {
    align-items: center;
    display: flex;
    gap: 24px;
    justify-content: space-between;
    padding-top: 20px;
  }

  .ter-dossier p {
    color: var(--text-2);
    line-height: 1.55;
    margin: 0;
  }

  .ter-cta {
    border: 1px solid var(--accent);
    color: var(--accent);
    flex: none;
    font: var(--mono-10) / 1 var(--font-mono);
    letter-spacing: 0.1em;
    padding: 11px 16px;
    text-transform: uppercase;
  }

  .ter-cta:hover {
    background: var(--accent);
    color: var(--accent-on);
  }

  @media (max-width: 900px) {
    .ter {
      padding: 56px 22px 64px;
    }

    .ter-split {
      grid-template-columns: 1fr;
    }

    .ter-stage {
      order: 1;
      position: static;
    }

    .ter-list {
      max-height: none;
      order: 2;
    }
  }
</style>
