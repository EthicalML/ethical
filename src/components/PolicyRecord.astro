---
interface PolicyProduct {
  date?: string;
  href: string;
  instrument: string;
  title: string;
  track: string;
}

interface Filter {
  label: string;
  value: string;
}

interface Props {
  filters: Filter[];
  products: PolicyProduct[];
}

const { filters, products } = Astro.props;
---

<policy-record class="policy-record" data-reveal>
  <header>
    <div>
      <p class="eyebrow">DELIVERED PRODUCTS</p>
      <h2>The policy record</h2>
    </div>
    <p class="record-count" aria-live="polite"><strong>{products.length}</strong> records</p>
  </header>

  <div class="policy-filters" aria-label="Filter policy products">
    {
      filters.map((filter, index) => (
        <button type="button" data-filter={filter.value} aria-pressed={index === 0 ? 'true' : 'false'}>
          {filter.label}
        </button>
      ))
    }
  </div>

  <div class="record-head" aria-hidden="true">
    <span>Product</span>
    <span>Instrument</span>
    <span>Date</span>
    <span>Record</span>
  </div>
  <div class="record-rows">
    {
      products.map((product) => (
        <article data-record data-track={product.track}>
          <h3>{product.title}</h3>
          <span class="instrument-tag">{product.instrument}</span>
          <time>{product.date}</time>
          <a href={product.href} target="_blank" rel="noopener noreferrer">
            Read →
          </a>
        </article>
      ))
    }
  </div>
</policy-record>

<script>
  class PolicyRecord extends HTMLElement {
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      this.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
        button.addEventListener('click', () => this.filter(button), {
          signal: this.controller.signal,
        });
      });
    }

    disconnectedCallback() {
      this.controller.abort();
    }

    private filter(activeButton: HTMLButtonElement) {
      const track = activeButton.dataset.filter ?? 'all';
      let visible = 0;

      this.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button === activeButton));
      });
      this.querySelectorAll<HTMLElement>('[data-record]').forEach((record) => {
        const show = track === 'all' || record.dataset.track === track;
        record.hidden = !show;
        if (show) visible += 1;
      });

      const count = this.querySelector<HTMLElement>('.record-count strong');
      if (count) count.textContent = String(visible);
    }
  }

  if (!customElements.get('policy-record')) {
    customElements.define('policy-record', PolicyRecord);
  }
</script>

<style>
  .policy-record {
    border-block: 1px solid var(--hairline);
    display: block;
    padding: 82px 48px 96px;
  }

  header {
    align-items: end;
    display: flex;
    justify-content: space-between;
  }

  h2 {
    font: 300 clamp(42px, 5vw, 66px) / 1 var(--font-display);
    margin: 18px 0 0;
  }

  .record-count {
    color: var(--text-4);
    font: var(--mono-10) / 1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .record-count strong {
    color: var(--accent);
    font-size: 22px;
    font-weight: 400;
    letter-spacing: 0;
    margin-right: 7px;
  }

  .policy-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 42px 0 34px;
  }

  button {
    background: transparent;
    border: 1px solid var(--hairline-card);
    border-radius: var(--radius-pill);
    color: var(--text-3);
    cursor: pointer;
    font: var(--mono-9) / 1 var(--font-mono);
    letter-spacing: 0.1em;
    min-height: 38px;
    padding: 0 14px;
  }

  button[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-on);
  }

  .record-head,
  article {
    align-items: center;
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(300px, 1.8fr) minmax(150px, 0.75fr) 90px 72px;
  }

  .record-head {
    color: var(--text-4);
    font: var(--mono-9) / 1 var(--font-mono);
    letter-spacing: 0.12em;
    padding: 0 18px 12px;
    text-transform: uppercase;
  }

  article {
    border-top: 1px solid var(--hairline);
    min-height: 78px;
    padding: 16px 18px;
  }

  article[hidden] {
    display: none;
  }

  article:hover {
    background: rgba(255, 255, 255, 0.025);
  }

  h3 {
    font: 400 16px/1.35 var(--font-sans);
    margin: 0;
  }

  .instrument-tag,
  time {
    color: var(--text-4);
    font: var(--mono-9) / 1.35 var(--font-mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .instrument-tag {
    color: var(--text-3);
  }

  a {
    color: var(--accent);
    font: var(--mono-9) / 1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 800px) {
    .policy-record {
      padding: 64px 24px 72px;
    }

    header {
      align-items: start;
      flex-direction: column;
    }

    .record-count {
      margin-top: 20px;
    }

    .record-head {
      display: none;
    }

    article {
      gap: 10px 16px;
      grid-template-columns: 1fr auto;
      padding-block: 20px;
    }

    h3 {
      grid-column: 1 / -1;
    }

    time {
      grid-column: 1;
    }

    a {
      grid-column: 2;
      grid-row: 2 / span 2;
    }
  }

  @media (max-width: 600px) {
    .policy-record {
      padding: 56px 18px 60px;
    }

    .policy-filters {
      margin-block: 34px 26px;
    }
  }
</style>
