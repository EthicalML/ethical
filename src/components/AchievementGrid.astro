<achievement-grid class="achievement-grid">
  <div class="collage-piece collage-filler filler-west" data-collage-piece data-order="0" aria-hidden="true"></div>
  <div class="collage-piece collage-diamond diamond-north" data-collage-piece data-order="1" aria-hidden="true"></div>
  <div class="collage-piece collage-filler filler-north" data-collage-piece data-order="2" aria-hidden="true"></div>
  <div class="collage-piece collage-accent accent-eu" data-collage-piece data-order="4" aria-hidden="true"></div>
  <div class="collage-piece collage-filler filler-east" data-collage-piece data-order="6" aria-hidden="true"></div>
  <div class="collage-piece collage-accent accent-uk" data-collage-piece data-order="8" aria-hidden="true"></div>
  <div class="collage-piece collage-filler filler-centre" data-collage-piece data-order="9" aria-hidden="true"></div>
  <div class="collage-piece collage-filler filler-south" data-collage-piece data-order="12" aria-hidden="true"></div>
  <div class="collage-piece collage-accent accent-static" data-collage-piece data-order="14" aria-hidden="true"></div>
  <div class="collage-piece collage-diamond diamond-south" data-collage-piece data-order="16" aria-hidden="true"></div>
  <slot />
</achievement-grid>

<script>
  class AchievementGridElement extends HTMLElement {
    private controller = new AbortController();
    private observer?: IntersectionObserver;

    connectedCallback() {
      this.controller = new AbortController();
      const pieces = [...this.querySelectorAll<HTMLElement>('.achievement-card, [data-collage-piece]')];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      pieces.forEach((piece, index) => {
        piece.style.setProperty('--piece-order', piece.dataset.order ?? String(index));
        if (reduced) {
          piece.dataset.settled = 'true';
          return;
        }
        piece.addEventListener('animationend', () => (piece.dataset.settled = 'true'), {
          once: true,
          signal: this.controller.signal,
        });
      });

      this.dataset.motionReady = 'true';
      if (this.dataset.entered === 'true') return;
      if (reduced || !('IntersectionObserver' in window)) {
        this.dataset.entered = 'true';
        return;
      }

      this.observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          this.dataset.entered = 'true';
          this.observer?.disconnect();
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
      );
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.controller.abort();
      this.observer?.disconnect();
    }
  }

  if (!customElements.get('achievement-grid')) {
    customElements.define('achievement-grid', AchievementGridElement);
  }
</script>
