<achievement-grid class="achievement-grid">
  <slot />
</achievement-grid>

<script>
  class AchievementGridElement extends HTMLElement {
    private controller = new AbortController();
    private observer?: IntersectionObserver;

    connectedCallback() {
      this.controller = new AbortController();
      const cards = [...this.querySelectorAll<HTMLElement>('.achievement-card')];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      cards.forEach((card, index) => {
        card.style.setProperty('--achievement-order', String(index));
        if (reduced) {
          card.dataset.settled = 'true';
          return;
        }
        card.addEventListener('animationend', () => (card.dataset.settled = 'true'), {
          once: true,
          signal: this.controller.signal,
        });
        card.addEventListener('pointermove', (event) => this.trackPointer(card, event), {
          signal: this.controller.signal,
        });
        card.addEventListener(
          'pointerleave',
          () => {
            card.style.removeProperty('--hover-x');
            card.style.removeProperty('--hover-y');
          },
          { signal: this.controller.signal },
        );
      });

      this.dataset.motionReady = 'true';
      if (this.dataset.entered === 'true') return;
      if (reduced || !('IntersectionObserver' in window)) {
        this.dataset.entered = 'true';
        return;
      }

      this.observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          this.dataset.entered = 'true';
          this.observer?.disconnect();
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
      );
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.controller.abort();
      this.observer?.disconnect();
    }

    private trackPointer(card: HTMLElement, event: PointerEvent) {
      const bounds = card.getBoundingClientRect();
      const x = ((event.clientX - bounds.left) / bounds.width) * 100;
      const y = ((event.clientY - bounds.top) / bounds.height) * 100;
      card.style.setProperty('--hover-x', `${Math.max(0, Math.min(100, x))}%`);
      card.style.setProperty('--hover-y', `${Math.max(0, Math.min(100, y))}%`);
    }
  }

  if (!customElements.get('achievement-grid')) {
    customElements.define('achievement-grid', AchievementGridElement);
  }
</script>
