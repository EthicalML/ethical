---
import ArticleHeroCanvas from './ArticleHeroCanvas.astro';
import KaosArchitecture from './KaosArchitecture.astro';
import KomputeCube from './KomputeCube.astro';
import OpenSourceHeroCanvas from './OpenSourceHeroCanvas.astro';
import PolicyHeroCanvas from './PolicyHeroCanvas.astro';

/* MDX passes a `slot="backdrop"` child as `props.backdrop` and then lifts it
   into the slots map, which deletes the boolean the caller wrote alongside it.
   Restoring it here keeps the flag meaningful from both `.astro` and `.mdx`. */
if (Astro.slots.has('backdrop')) Astro.props.backdrop = true;

const { eyebrow, title, intro, canvas = false, backdrop = false, transitionName } = Astro.props;
---

<header
  class:list={['article-hero', (canvas || backdrop) && 'canvas-variant', canvas === 'kompute' && 'kompute-variant']}
  data-surface={canvas || backdrop ? 'dark' : undefined}
  data-surface-plate={canvas || backdrop ? '' : undefined}
  data-reveal
>
  {canvas === 'kaos' ? <KaosArchitecture embedded backdrop /> : canvas === true && <ArticleHeroCanvas />}
  {canvas === 'kompute' && <KomputeCube embedded backdrop />}
  {canvas === 'policy' && <PolicyHeroCanvas />}
  {canvas === 'open-source' && <OpenSourceHeroCanvas />}
  {backdrop && <slot name="backdrop" />}
  <p class="eyebrow">{eyebrow}</p>
  <h1 transition:name={transitionName} style={transitionName ? `view-transition-name: ${transitionName}` : undefined}>{title}</h1>
  {intro && <p>{intro}</p>}
</header>

<style is:global>
  .article-hero {
    min-height: 480px;
    padding: 108px 48px 76px;
    position: relative;
  }

  .article-hero h1 {
    font: 300 clamp(54px, 7vw, 88px)/0.98 var(--font-display);
    letter-spacing: -0.025em;
    margin: 24px 0;
    max-width: 960px;
  }

  .article-hero > p:last-child {
    color: var(--text-2);
    font-size: 18px;
    line-height: 1.6;
    max-width: 680px;
  }

  .article-hero.canvas-variant {
    min-height: 650px;
    overflow: hidden;
  }

  .article-hero.canvas-variant::after {
    background: linear-gradient(90deg, rgba(var(--scrim-inset-rgb), 0.93) 0%, rgba(var(--scrim-inset-rgb), 0.77) 35%, transparent 72%);
    content: '';
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }

  .article-hero.canvas-variant > :not(canvas, .kaos-architecture-mount, .kompute-canvas-mount, .theme-buffer-mount, .policy-citadel-mount, .oss-lattice-mount) {
    position: relative;
    z-index: 2;
  }

  .article-hero.canvas-variant > .kaos-architecture-mount {
    height: min(500px, 100%);
    left: 34%;
    mask-image: linear-gradient(90deg, transparent 0, #000 260px);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 260px);
    margin: 0;
    opacity: 0.72;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 66%;
    z-index: 0;
  }

  .article-hero.canvas-variant > .kompute-canvas-mount {
    height: 100%;
    left: 34%;
    mask-image: linear-gradient(90deg, transparent 0, #000 260px);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 260px);
    opacity: 0.58;
    position: absolute;
    right: 0;
    top: 0;
    width: 66%;
    z-index: 0;
  }

  .article-hero.canvas-variant > .kompute-canvas-mount canvas {
    height: 100%;
    width: 100%;
  }

  /* The buffer slab sits further right and dimmer than the cube: it cycles
    through a light sage state whose plate is near white, and the hero title has
    to stay readable across the whole cycle rather than only on the dark ones. */
  .article-hero.canvas-variant > .theme-buffer-mount {
    height: 100%;
    left: 42%;
    mask-image: linear-gradient(90deg, transparent 0, #000 300px);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 300px);
    opacity: 0.4;
    position: absolute;
    right: 0;
    top: 0;
    width: 58%;
    z-index: 0;
  }

  .article-hero.canvas-variant > .policy-citadel-mount,
  .article-hero.canvas-variant > .oss-lattice-mount {
    display: contents;
  }

  /* The base absolute placement is owned here rather than inherited from
    Hero.css: this hero has no other reason to load the flagship hero sheet, and
    it did so only because every composed page pulled the whole prose barrel. */
  .article-hero.canvas-variant .hero-canvas {
    bottom: 0;
    height: 100%;
    left: 34%;
    mask-image: linear-gradient(90deg, transparent 0, #000 260px);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 260px);
    opacity: 0.85;
    position: absolute;
    right: 0;
    top: 0;
    width: 66%;
  }

  @media (max-width: 950px) {
    .article-hero {
      min-height: 390px;
      padding: 72px 24px 50px;
    }
  }

  @media (max-width: 950px) {
    .article-hero h1 {
      font-size: 48px;
    }
  }

  @media (max-width: 950px) {
    .article-hero {
      min-height: 420px;
      padding: 80px 24px 56px;
    }
  }

  @media (max-width: 950px) {
    .article-hero h1 {
      font-size: clamp(48px, 8vw, 64px);
    }
  }

  @media (max-width: 600px) {
    .article-hero {
      min-height: 360px;
      padding: 64px 18px 44px;
    }
  }

  @media (max-width: 600px) {
    .article-hero h1 {
      font-size: clamp(42px, 11.5vw, 50px);
    }
  }

  @media (max-width: 600px) {
    .article-hero > p:last-child {
      font-size: 16px;
    }
  }

  @media (max-width: 950px) {
    .article-hero.canvas-variant > .kaos-architecture-mount,
    .article-hero.canvas-variant > .kompute-canvas-mount,
    .article-hero.canvas-variant > .theme-buffer-mount,
    .article-hero.canvas-variant .hero-canvas {
      bottom: 0;
      height: 340px;
      left: 0;
      mask-image: linear-gradient(180deg, transparent, #000 30%);
      -webkit-mask-image: linear-gradient(180deg, transparent, #000 30%);
      opacity: 0.5;
      right: 0;
      top: auto;
      transform: none;
      width: 100%;
    }

    /* Narrow widths put the slab directly under the title rather than beside
      it, so the sage state needs more headroom than the dark canvases do. */
    .article-hero.canvas-variant > .theme-buffer-mount {
      height: 300px;
      opacity: 0.3;
    }
  }
</style>
