---
import ArticleHeroCanvas from './ArticleHeroCanvas.astro';
import KaosGraph from './KaosGraph.astro';

const { eyebrow, title, intro, canvas = false, transitionName } = Astro.props;
---

<header class:list={['article-hero', canvas && 'canvas-variant']} data-reveal>
  {canvas === 'kaos' ? <KaosGraph embedded backdrop /> : canvas && <ArticleHeroCanvas />}
  <p class="eyebrow">{eyebrow}</p>
  {
    transitionName ? (
      <h1 transition:name={transitionName} style={`view-transition-name: ${transitionName}`}>
        {title}
      </h1>
    ) : (
      <h1>{title}</h1>
    )
  }
  {intro && <p>{intro}</p>}
</header>
