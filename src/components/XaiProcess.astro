---
import AnimationWindow from './AnimationWindow.astro';

interface ProcessStep {
  number: string;
  title: string;
  checkpoint: string;
}

interface Props {
  steps: ProcessStep[];
}

const { steps }: Props = Astro.props;
---

<AnimationWindow class="xai-process-window" title="responsible-ml.process">
  <xai-process data-stage="0">
    <div class="process-heading">
      <div>
        <p class="eyebrow">TOOL + PROCESS</p>
        <h3>Responsible ML is a continuous workflow</h3>
      </div>
      <p aria-live="polite"><i aria-hidden="true"></i><span data-process-state>Inspect the data before training</span></p>
    </div>

    <div class="process-flow" aria-label="Three-step responsible machine learning workflow">
      <div class="model-packet" aria-hidden="true"><span>ML</span></div>
      {
        steps.map(({ number, title, checkpoint }, index) => (
          <>
            <article data-process-step={index}>
              <span class="step-number">{number}</span>
              <small>CHECKPOINT</small>
              <h4>{title}</h4>
              <p>{checkpoint}</p>
              <div class="checkpoint-actions">
                <>
                  <span>EXPLAIN</span>
                  <i>→</i>
                  <span>SURFACE BIAS</span>
                  <i>→</i>
                  <span>MITIGATE</span>
                </>
              </div>
              <b class="checkpoint-stamp">CHECKED ✓</b>
            </article>
            {index < steps.length - 1 && (
              <i class="process-arrow" aria-hidden="true">
                →
              </i>
            )}
          </>
        ))
      }
    </div>

    <div class="feedback-loop">
      <span>RESPONSIBLE AI PRINCIPLES</span>
      <i aria-hidden="true"></i>
      <b>Applied at every checkpoint</b>
      <i aria-hidden="true"></i>
      <span>PRODUCTION FEEDBACK ↺</span>
    </div>
  </xai-process>
</AnimationWindow>

<script>
  const processStates = ['Inspect the data before training', 'Evaluate model behaviour across groups', 'Monitor production predictions and feed findings back'];

  class XaiProcess extends HTMLElement {
    private controller = new AbortController();
    private timer = 0;
    private stage = 0;

    connectedCallback() {
      this.controller = new AbortController();
      const windowElement = this.closest<HTMLElement>('animation-window');
      if (!windowElement) return;
      windowElement.addEventListener('animationwindow:play', () => this.play(), { signal: this.controller.signal });
      windowElement.addEventListener('animationwindow:pause', () => this.pause(), { signal: this.controller.signal });
      this.render();
      if (windowElement.dataset.playing === 'true') this.play();
    }

    disconnectedCallback() {
      this.controller.abort();
      window.clearTimeout(this.timer);
    }

    private play() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (this.stage >= 2) this.stage = 0;
      this.render();
      this.scheduleNext();
    }

    private pause() {
      window.clearTimeout(this.timer);
    }

    private scheduleNext() {
      window.clearTimeout(this.timer);
      this.timer = window.setTimeout(() => {
        this.stage = this.stage >= 2 ? 0 : this.stage + 1;
        this.render();
        this.scheduleNext();
      }, 1400);
    }

    private render() {
      this.dataset.stage = String(this.stage);
      const state = this.querySelector<HTMLElement>('[data-process-state]');
      if (state) state.textContent = processStates[this.stage];
      this.querySelectorAll<HTMLElement>('[data-process-step]').forEach((step) => {
        const index = Number(step.dataset.processStep);
        step.classList.toggle('passed', index < this.stage);
        step.classList.toggle('current', index === this.stage);
      });
    }
  }

  if (!customElements.get('xai-process')) customElements.define('xai-process', XaiProcess);
</script>

<style>
  :global(.xai-process-window) {
    --accent: #e8b45c;
    --accent-wash-09: rgba(232, 180, 92, 0.09);
    border-color: rgba(232, 180, 92, 0.25);
    margin-top: 34px;
  }
  xai-process {
    display: block;
    padding: 28px;
  }
  .process-heading {
    align-items: end;
    display: flex;
    gap: 28px;
    justify-content: space-between;
  }
  .process-heading h3 {
    font: 300 30px/1.15 var(--font-display);
    margin: 11px 0 0;
  }
  .process-heading > p {
    align-items: center;
    color: var(--text-3);
    display: flex;
    font: var(--mono-9)/1.45 var(--font-mono);
    gap: 8px;
    margin: 0;
    max-width: 260px;
  }
  .process-heading > p i {
    background: var(--accent);
    border-radius: 50%;
    flex: 0 0 auto;
    height: 6px;
    width: 6px;
  }
  .process-flow {
    align-items: stretch;
    display: grid;
    gap: 12px;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    margin-top: 36px;
    padding-top: 28px;
    position: relative;
  }
  .process-flow article {
    border: 1px solid var(--hairline-card);
    min-height: 270px;
    opacity: 0.38;
    padding: 20px;
    position: relative;
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      opacity 0.3s ease,
      transform 0.3s ease;
  }
  .process-flow article.passed,
  .process-flow article.current {
    opacity: 1;
  }
  .process-flow article.passed {
    border-color: rgba(94, 230, 160, 0.25);
  }
  .process-flow article.current {
    background: rgba(94, 230, 160, 0.06);
    border-color: var(--accent);
    transform: translateY(-5px);
  }
  .step-number,
  .process-flow article > small,
  .process-flow article > p {
    font-family: var(--font-mono);
  }
  .step-number {
    color: var(--accent);
    font-size: var(--mono-9);
  }
  .process-flow article > small {
    color: var(--text-4);
    float: right;
    font-size: var(--mono-9);
    letter-spacing: 0.1em;
  }
  h4 {
    font: 400 var(--body-18)/1.15 var(--font-display);
    margin: 35px 0 9px;
  }
  .process-flow article > p {
    color: var(--text-3);
    font-size: var(--mono-10);
    line-height: 1.55;
    margin: 0;
  }
  .checkpoint-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 20px;
  }
  .checkpoint-actions span,
  .checkpoint-actions i {
    color: var(--text-4);
    font: normal var(--mono-9)/1.3 var(--font-mono);
  }
  .process-flow article.current .checkpoint-actions span,
  .process-flow article.passed .checkpoint-actions span {
    color: var(--accent);
  }
  .checkpoint-stamp {
    bottom: 18px;
    color: var(--accent);
    font: 400 var(--mono-9)/1 var(--font-mono);
    opacity: 0;
    position: absolute;
    right: 18px;
    transform: rotate(-5deg) scale(1.2);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .process-flow article.current .checkpoint-stamp,
  .process-flow article.passed .checkpoint-stamp {
    opacity: 1;
    transform: rotate(-5deg) scale(1);
  }
  .process-arrow {
    align-self: center;
    color: var(--text-4);
    font-style: normal;
  }
  .model-packet {
    align-items: center;
    background: var(--accent);
    color: var(--accent-on);
    display: flex;
    font: 700 8px/1 var(--font-mono);
    height: 20px;
    justify-content: center;
    left: 12%;
    position: absolute;
    top: 0;
    transform: rotate(45deg);
    transition: left 0.9s ease;
    width: 20px;
  }
  .model-packet span {
    transform: rotate(-45deg);
  }
  [data-stage='1'] .model-packet {
    left: 49%;
  }
  [data-stage='2'] .model-packet {
    left: 86%;
  }
  .feedback-loop {
    align-items: center;
    border: 1px solid var(--hairline-card);
    display: grid;
    gap: 10px;
    grid-template-columns: auto 1fr auto 1fr auto;
    margin-top: 20px;
    padding: 15px 18px;
  }
  .feedback-loop span,
  .feedback-loop b {
    color: var(--text-3);
    font: var(--mono-9)/1.35 var(--font-mono);
  }
  .feedback-loop b {
    color: var(--accent);
    font-weight: 400;
  }
  .feedback-loop i {
    border-top: 1px solid var(--hairline-card);
  }
  @media (max-width: 800px) {
    xai-process {
      padding: 22px 18px;
    }
    .process-heading {
      align-items: start;
      flex-direction: column;
    }
    .process-flow {
      grid-template-columns: 1fr;
      padding-top: 0;
    }
    .process-arrow {
      text-align: center;
      transform: rotate(90deg);
    }
    .model-packet {
      display: none;
    }
    .feedback-loop {
      grid-template-columns: 1fr;
    }
    .feedback-loop i {
      display: none;
    }
  }
  @media (max-width: 799px) {
    :global(.xai-process-window .window-content) {
      container-type: inline-size;
      overflow: hidden;
    }
    xai-process {
      box-sizing: border-box;
      width: 1340px;
      zoom: calc(100cqw / 1340px);
    }
    .process-heading {
      align-items: end;
      flex-direction: row;
    }
    .process-flow {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      padding-top: 28px;
    }
    .process-arrow {
      transform: none;
    }
    .model-packet {
      display: flex;
    }
    .feedback-loop {
      grid-template-columns: auto 1fr auto 1fr auto;
    }
    .feedback-loop i {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .process-flow article,
    .checkpoint-stamp,
    .model-packet {
      transition: none;
    }
    .process-flow article {
      opacity: 1;
    }
    .process-flow article.current {
      transform: none;
    }
    .checkpoint-stamp {
      opacity: 1;
      transform: rotate(-5deg) scale(1);
    }
    .model-packet {
      left: 86%;
    }
  }
</style>
