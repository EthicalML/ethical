---
import { isExternalHref } from '../utils/external-links.mjs';
import LinkCardGrid from './LinkCardGrid.astro';

interface LinkCard {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
}

interface Props {
  cards: LinkCard[];
}

const { cards } = Astro.props;
---

<LinkCardGrid class="framework-link-cards prose-block" reveal>
  {
    cards.map((card) => {
      const external = isExternalHref(card.href);
      return (
        <a href={card.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
          <span>{card.eyebrow}</span>
          <strong>{card.title}</strong>
          <p>{card.description}</p>
          <i class="accent-action">Read more</i>
        </a>
      );
    })
  }
</LinkCardGrid>

<style>
  a {
    border: 1px solid var(--hairline-card);
    display: flex;
    flex-direction: column;
    min-height: 260px;
    padding: 24px;
  }

  span,
  i {
    font-size: var(--mono-9);
    line-height: 1.2;
  }

  span {
    color: var(--text-4);
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  strong {
    color: var(--text-1);
    font-size: 20px;
    font-weight: 450;
    line-height: 1.25;
    margin-top: 24px;
  }

  p {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  i {
    margin-top: auto;
  }

  @media (max-width: 950px) {
    :global(.link-card-grid.framework-link-cards) {
      grid-template-columns: 1fr;
    }

    a {
      min-height: 220px;
    }
  }
</style>
