---
interface HeroButton {
  href: string;
  label: string;
}

interface Props {
  status: string;
  status_href?: string;
  // The client router swaps responses into the current document, which a feed
  // or any other non-HTML target cannot survive. Set this when status_href
  // points at one.
  status_reload?: boolean;
  // An array renders the classic three-line display title with the glitch
  // closing line. A plain string selects the longform mode: the full title is
  // balanced across up to three lines at a wider measure, with the last line
  // in the accent ink and no glitch animation.
  title: string[] | string;
  subtitle_lines: string[];
  beneficiaries?: string[];
  typewriter_underline?: boolean;
  primary_button?: HeroButton;
  secondary_button?: HeroButton;
}

const {
  status,
  status_href,
  status_reload = false,
  title,
  subtitle_lines,
  beneficiaries = [],
  typewriter_underline = false,
  primary_button,
  secondary_button,
}: Props = Astro.props;
const hasActionsSlot = Astro.slots.has('actions');
const initialBeneficiary = beneficiaries[0];
const [missionLine1, missionLine2] = subtitle_lines;
const ariaSentence = [...subtitle_lines, initialBeneficiary].filter(Boolean).join(' ');

const balanceLines = (text: string, lines: number): string[] => {
  const words = text.split(' ');
  const target = Math.ceil(text.length / lines);
  const out: string[] = [];
  let current = '';
  for (const word of words) {
    if (current && current.length + word.length + 1 > target && out.length < lines - 1) {
      out.push(current);
      current = word;
    } else {
      current = current ? `${current} ${word}` : word;
    }
  }
  out.push(current);
  return out;
};
const longform = typeof title === 'string';
if (longform && title.length > 110) {
  console.warn(`[Hero] longform title exceeds the 110-character budget (${title.length}): ${title}`);
}
const titleLines = longform ? balanceLines(title, 3) : title;
const titleTier = longform && title.length > 70 ? 'long' : undefined;
---

<header
  class="hero"
  data-surface="dark"
  data-surface-plate
  data-reveal
  data-pagefind-ignore
  data-title-mode={longform ? 'longform' : undefined}
  data-title-tier={titleTier}
>
  <hero-cycle><canvas class="hero-canvas" aria-hidden="true"></canvas></hero-cycle>
  <div class="hero-copy">
    {
      status_href ? (
        <a class="status-pill" href={status_href} data-astro-reload={status_reload ? '' : undefined}>
          <span aria-hidden="true" />
          {status}
        </a>
      ) : (
        <p class="status-pill">
          <span aria-hidden="true" />
          {status}
        </p>
      )
    }
    <h1>
      {
        titleLines.map((line, index) =>
          index !== titleLines.length - 1 ? (
            <span>{line}</span>
          ) : longform ? (
            <em>{line}</em>
          ) : (
            <em class="glitch" data-text={line}>
              {line}
            </em>
          ),
        )
      }
    </h1>
    <type-writer data-beneficiaries={JSON.stringify(beneficiaries)}>
      <p class="hero-subtitle" data-underline={typewriter_underline ? 'true' : 'false'} aria-label={ariaSentence}>
        <span class="hero-typewriter-line">
          <span class="hero-typewriter-text">{missionLine1}</span>
        </span>
        <span class="hero-typewriter-line">
          <span class="hero-typewriter-text">{missionLine2}</span>
        </span>
        <span class="hero-typewriter-line hero-typewriter-dynamic">
          <span class="hero-typewriter-glitch" data-text={initialBeneficiary}>
            <span class="hero-typewriter-text">{initialBeneficiary}</span><span class="hero-typewriter-cursor" aria-hidden="true"></span>
          </span>
        </span>
      </p>
    </type-writer>
    {
      hasActionsSlot ? (
        <div class="actions">
          <slot name="actions" />
        </div>
      ) : (
        primary_button &&
        secondary_button && (
          <nav class="actions" aria-label="Primary actions">
            <a class="button primary" href={primary_button.href}>
              {primary_button.label}
            </a>
            <a class="button" href={secondary_button.href}>
              {secondary_button.label}
            </a>
          </nav>
        )
      )
    }
    <div class="graph-switcher" aria-hidden="true">
      <span class="active" data-hero-mode="planes"></span>
      <span data-hero-mode="sphere"></span>
      <span data-hero-mode="contour"></span>
    </div>
  </div>
</header>

<script>
  import '../shared/canvas/HeroCycle';

  type TypewriterPhase = 'initial' | 'typing' | 'deleting' | 'dwell' | 'static';

  class TypeWriter extends HTMLElement {
    private destroyed = false;
    private observer?: IntersectionObserver;
    private timer?: number;

    connectedCallback() {
      this.destroyed = false;
      const subtitle = this.querySelector<HTMLElement>('.hero-subtitle');
      const outputs = Array.from(this.querySelectorAll<HTMLElement>('.hero-typewriter-text'));
      const glitch = this.querySelector<HTMLElement>('.hero-typewriter-glitch');
      const cursor = this.querySelector<HTMLElement>('.hero-typewriter-cursor');

      let beneficiaries: string[] = [];
      try {
        const parsed = JSON.parse(this.dataset.beneficiaries ?? '[]');
        beneficiaries = Array.isArray(parsed) ? parsed : [];
      } catch {
        return;
      }

      const initialBeneficiary = beneficiaries[0];
      if (!subtitle || outputs.length !== 3 || !glitch || !cursor || !initialBeneficiary) return;

      const initialLines = [outputs[0].textContent ?? '', outputs[1].textContent ?? '', initialBeneficiary];
      const styles = getComputedStyle(subtitle);
      const duration = (name: string, fallback: number) => {
        const value = Number.parseFloat(styles.getPropertyValue(name));
        return Number.isFinite(value) ? value : fallback;
      };
      const typeDelay = duration('--typewriter-type-delay', 45);
      const deleteDelay = duration('--typewriter-delete-delay', 25);
      const wait = (milliseconds: number) =>
        new Promise<void>((resolve) => {
          this.timer = window.setTimeout(resolve, milliseconds);
        });
      const jitter = () => typeDelay + (Math.random() - 0.5) * 12;
      const setPhase = (phase: TypewriterPhase) => {
        subtitle.dataset.typewriterPhase = phase;
      };
      const setText = (output: HTMLElement, text: string) => {
        output.textContent = text;
        if (output === outputs[2]) glitch.dataset.text = text;
      };
      const type = async (output: HTMLElement, text: string, phase: TypewriterPhase = 'typing') => {
        setPhase(phase);
        (output === outputs[2] ? glitch : output.parentElement)?.append(cursor);
        for (const character of text) {
          if (this.destroyed) return;
          setText(output, output.textContent + character);
          await wait(jitter());
        }
      };
      const remove = async (output: HTMLElement, count: number) => {
        setPhase('deleting');
        for (let index = 0; index < count; index += 1) {
          if (this.destroyed) return;
          setText(output, output.textContent.slice(0, -1));
          await wait(deleteDelay);
        }
      };
      const waitForGlitchEnd = async (skipActiveBurst = false) => {
        const headlineAnimation = document
          .querySelector<HTMLElement>('.glitch')
          ?.getAnimations()
          .find((animation) => 'animationName' in animation && animation.animationName === 'om-flicker');
        const cycle = Number(headlineAnimation?.effect?.getTiming().duration) || 9000;
        const current = Number(headlineAnimation?.currentTime) || 0;
        const phase = current % cycle;
        const burstStart = cycle * 0.656;
        const burstEnd = cycle * 0.767;
        const canUseCurrentBurst = phase < burstEnd && (!skipActiveBurst || phase < burstStart);
        await wait(canUseCurrentBurst ? burstEnd - phase : cycle - phase + burstEnd);
      };
      const run = async () => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          initialLines.forEach((line, index) => setText(outputs[index], line));
          setPhase('static');
          return;
        }

        outputs.forEach((output) => setText(output, ''));
        for (let index = 0; index < initialLines.length; index += 1) {
          await type(outputs[index], initialLines[index], 'initial');
        }

        if (beneficiaries.length <= 1) {
          setPhase('dwell');
          return;
        }

        let beneficiaryIndex = 0;
        let firstRotation = true;
        while (!this.destroyed) {
          setPhase('dwell');
          await waitForGlitchEnd(firstRotation);
          firstRotation = false;
          await remove(outputs[2], beneficiaries[beneficiaryIndex].length);
          beneficiaryIndex = (beneficiaryIndex + 1) % beneficiaries.length;
          await type(outputs[2], beneficiaries[beneficiaryIndex]);
        }
      };

      if (!('IntersectionObserver' in window)) {
        void run();
        return;
      }

      this.observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        this.observer?.disconnect();
        void run();
      });
      this.observer.observe(subtitle);
    }

    disconnectedCallback() {
      this.destroyed = true;
      this.observer?.disconnect();
      if (this.timer !== undefined) window.clearTimeout(this.timer);
    }
  }

  if (!customElements.get('type-writer')) {
    customElements.define('type-writer', TypeWriter);
  }
</script>

<style is:global>
  @import './Hero.css';
</style>
