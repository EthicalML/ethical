---
import SurveyReportApp from './SurveyReportApp';
import type { SurveyReportData } from '../utils/SurveyReportData';
import type { SurveyMethodologyCopy, SurveyReportChapter, SurveyReportFinding, SurveyReportStat } from './SurveyReportApp';

interface Props {
  report: SurveyReportData;
  year: number;
  chapters: SurveyReportChapter[];
  findings: Record<string, SurveyReportFinding>;
  stats: SurveyReportStat[];
  methodology: SurveyMethodologyCopy;
}

const props = Astro.props;
---

<SurveyReportApp {...props} client:load />
