---
import { getPolicyCorpus, policyCorpusThemes } from '../utils/PolicyCorpus';

const { documents, quotes } = await getPolicyCorpus();
const canvasData = JSON.stringify(quotes.map(({ featured, text, theme, title }) => ({ featured, text, theme, title })));
---

<policy-corpus-canvas class="policy-corpus-canvas" data-quote-count={quotes.length} data-document-count={documents.length}>
  <header class="canvas-corpus-header">
    <div>
      <p class="eyebrow">CORPUS EXPLORER · CANVAS</p>
      <h2>The record speaks.</h2>
    </div>
    <p>{quotes.length} passages selected from {documents.length} source documents.</p>
  </header>

  <p class="canvas-corpus-intro">Select a theme. The typographic field resolves into verbatim positions from the delivered record.</p>

  <div class="canvas-corpus-filters" aria-label="Filter canvas corpus by theme">
    {
      policyCorpusThemes.map((theme, index) => (
        <button type="button" data-canvas-theme={theme.value} aria-pressed={index === 0 ? 'true' : 'false'}>
          {theme.label}
        </button>
      ))
    }
  </div>

  <policy-corpus-field class="canvas-corpus-field" data-quotes={canvasData}>
    <canvas aria-label="A drifting field of verbatim policy passages that converges into the selected theme"></canvas>
  </policy-corpus-field>

  <div class="canvas-corpus-sources" aria-live="polite">
    {
      quotes.map((quote) => (
        <article data-canvas-quote data-quote-theme={quote.theme} data-featured={quote.featured ? 'true' : undefined} hidden={!quote.featured}>
          <blockquote>{quote.text}</blockquote>
          <span>
            <strong>{quote.title}</strong>
            {quote.date && <time>{quote.date}</time>}
          </span>
          <a href={quote.href} target="_blank" rel="noopener noreferrer">
            Read source →
          </a>
        </article>
      ))
    }
  </div>
</policy-corpus-canvas>

<script>
  import '../shared/canvas/PolicyCorpusField';

  class PolicyCorpusCanvasElement extends HTMLElement {
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      this.querySelectorAll<HTMLButtonElement>('[data-canvas-theme]').forEach((button) => {
        button.addEventListener('click', () => this.select(button), { signal: this.controller.signal });
      });
      const initial = this.querySelector<HTMLButtonElement>('[data-canvas-theme="all"]');
      if (initial) this.select(initial);
    }

    disconnectedCallback() {
      this.controller.abort();
    }

    private select(activeButton: HTMLButtonElement) {
      const theme = activeButton.dataset.canvasTheme ?? 'all';
      this.querySelectorAll<HTMLButtonElement>('[data-canvas-theme]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button === activeButton));
      });
      const candidates = [...this.querySelectorAll<HTMLElement>('[data-canvas-quote]')].filter((quote) =>
        theme === 'all' ? quote.dataset.featured === 'true' : quote.dataset.quoteTheme === theme,
      );
      this.querySelectorAll<HTMLElement>('[data-canvas-quote]').forEach((quote) => (quote.hidden = true));
      candidates.slice(0, 3).forEach((quote) => (quote.hidden = false));
      this.querySelector('policy-corpus-field')?.dispatchEvent(new CustomEvent('corpus-theme', { detail: { theme } }));
    }
  }

  if (!customElements.get('policy-corpus-canvas')) {
    customElements.define('policy-corpus-canvas', PolicyCorpusCanvasElement);
  }
</script>

<style>
  .policy-corpus-canvas {
    background: var(--bg-inset);
    border-block: 1px solid var(--hairline);
    display: block;
    overflow: hidden;
    padding: 86px 0 96px;
  }
  .canvas-corpus-header,
  .canvas-corpus-intro,
  .canvas-corpus-filters,
  .canvas-corpus-sources {
    margin-inline: auto;
    max-width: 1344px;
    padding-inline: 48px;
  }
  .canvas-corpus-header {
    align-items: end;
    display: flex;
    gap: 40px;
    justify-content: space-between;
  }
  h2 {
    font: 300 clamp(48px, 6vw, 76px) / 1 var(--font-display);
    letter-spacing: -0.025em;
    margin: 18px 0 0;
  }
  .canvas-corpus-header > p {
    color: var(--text-4);
    font: var(--mono-10) / 1.6 var(--font-mono);
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }
  .canvas-corpus-intro {
    color: var(--text-2);
    font-size: var(--body-16);
    line-height: 1.7;
    margin-top: 28px;
  }
  .canvas-corpus-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: 36px 28px;
  }
  button {
    background: rgba(17, 19, 18, 0.72);
    border: 1px solid var(--hairline-card);
    border-radius: var(--radius-pill);
    color: var(--text-3);
    cursor: pointer;
    font: var(--mono-9) / 1 var(--font-mono);
    letter-spacing: 0.1em;
    min-height: 38px;
    padding: 0 14px;
  }
  button[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-on);
  }
  .canvas-corpus-field {
    display: block;
    height: 720px;
    position: relative;
  }
  canvas {
    display: block;
    height: 100%;
    width: 100%;
  }
  .canvas-corpus-sources {
    display: grid;
    gap: 1px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1px;
  }
  .canvas-corpus-sources article {
    background: var(--bg-panel);
    min-height: 98px;
    padding: 20px;
  }
  .canvas-corpus-sources blockquote {
    display: none;
  }
  .canvas-corpus-sources span {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .canvas-corpus-sources strong,
  .canvas-corpus-sources time,
  .canvas-corpus-sources a {
    font: var(--mono-9) / 1.45 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .canvas-corpus-sources strong {
    color: var(--text-3);
    font-weight: 400;
  }
  .canvas-corpus-sources time {
    color: var(--text-4);
  }
  .canvas-corpus-sources a {
    color: var(--accent);
    display: inline-block;
    margin-top: 14px;
  }
  @media (max-width: 800px) {
    .canvas-corpus-header {
      align-items: start;
      flex-direction: column;
    }
    .canvas-corpus-field {
      height: 860px;
    }
    .canvas-corpus-sources {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .canvas-corpus-header,
    .canvas-corpus-intro,
    .canvas-corpus-filters,
    .canvas-corpus-sources {
      padding-inline: 18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .canvas-corpus-field {
      display: none;
    }
    .canvas-corpus-sources {
      gap: 10px;
      margin-top: 34px;
    }
    .canvas-corpus-sources blockquote {
      color: var(--text-1);
      display: block;
      font: 300 25px / 1.3 var(--font-display);
      margin: 0 0 20px;
    }
  }
</style>
