---
const { embedded = false } = Astro.props;
---

{
  embedded ? (
    <kaos-graph class="widget embedded-widget kaos-canvas-mount" aria-label="KAOS agent graph" />
  ) : (
    <section id="opensource" aria-labelledby="kaos-heading" data-reveal>
      <p class="eyebrow">CUSTOM WIDGET</p>
      <h2 id="kaos-heading">KAOS agent graph</h2>
      <kaos-graph class="widget kaos-canvas-mount" />
    </section>
  )
}

<script>
  import '../shared/canvas/KaosGraph';
</script>
