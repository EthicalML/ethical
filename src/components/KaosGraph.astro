---
interface Props {
  embedded?: boolean;
  panel?: boolean;
  backdrop?: boolean;
  transitionName?: string;
  morphSource?: string;
}

const { embedded = false, panel = false, backdrop = false, transitionName, morphSource } = Astro.props;
const transitionStyle = transitionName ? `view-transition-name: ${transitionName}` : undefined;
---

{
  panel ? (
    <kaos-graph
      class="kaos-canvas-mount"
      aria-label="KAOS agent graph"
      transition:name={transitionName}
      style={transitionStyle}
      data-morph-source={morphSource}
      data-surface="dark"
    />
  ) : embedded ? (
    <kaos-graph
      class:list={['kaos-canvas-mount', !backdrop && 'widget embedded-widget']}
      aria-label="KAOS agent graph"
      transition:name={transitionName}
      style={transitionStyle}
      data-surface="dark"
    />
  ) : (
    <section id="opensource" aria-labelledby="kaos-heading" data-reveal>
      <p class="eyebrow">CUSTOM WIDGET</p>
      <h2 id="kaos-heading">KAOS agent graph</h2>
      <kaos-graph class="widget kaos-canvas-mount" transition:name={transitionName} style={transitionStyle} data-surface="dark" />
    </section>
  )
}

<script>
  import '../shared/canvas/KaosGraph';
</script>
