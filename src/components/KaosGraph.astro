---
interface Props {
  embedded?: boolean;
  panel?: boolean;
  transitionName?: string;
}

const { embedded = false, panel = false, transitionName } = Astro.props;
const transitionStyle = transitionName ? `view-transition-name: ${transitionName}` : undefined;
---

{
  panel ? (
    <kaos-graph class="kaos-canvas-mount" aria-label="KAOS agent graph" transition:name={transitionName} style={transitionStyle} />
  ) : embedded ? (
    <kaos-graph class="widget embedded-widget kaos-canvas-mount" aria-label="KAOS agent graph" transition:name={transitionName} style={transitionStyle} />
  ) : (
    <section id="opensource" aria-labelledby="kaos-heading" data-reveal>
      <p class="eyebrow">CUSTOM WIDGET</p>
      <h2 id="kaos-heading">KAOS agent graph</h2>
      <kaos-graph class="widget kaos-canvas-mount" transition:name={transitionName} style={transitionStyle} />
    </section>
  )
}

<script>
  import '../shared/canvas/KaosGraph';
</script>
