---
import AnimationWindow from '../AnimationWindow.astro';

const operations = ['recall', 'write', 'forget'];
---

<AnimationWindow class="call-flow-window" title="memory.remote-client">
  <memory-call-flow data-operation="recall" data-stage="0">
    <div class="operation-bar">
      <span>REMOTE MEMORY CALL</span>
      <div role="group" aria-label="Choose a memory operation">
        {
          operations.map((operation, index) => (
            <button type="button" data-operation-button={operation} aria-pressed={index === 0 ? 'true' : 'false'} class:list={{ active: index === 0 }}>
              {operation}()
            </button>
          ))
        }
      </div>
    </div>

    <div class="flow-stage">
      <article class="agent-pod">
        <small>AGENT POD</small>
        <strong>Agent runtime</strong>
        <span>remote memory client</span>
        <code data-call>recall(query)</code>
      </article>

      <div class="transport" aria-label="Authenticated call into the MemoryStore service">
        <span class="packet" aria-hidden="true">CALL</span>
        <div class="scope"><small>AUTHENTICATED AS</small><b>agent-support</b></div>
        <i aria-hidden="true"></i>
        <p><b>scope derived server-side</b><span>session · agent · user · store</span></p>
      </div>

      <section class="store">
        <header><small>CENTRAL SERVICE</small><strong>MemoryStore</strong><span>tenant/support</span></header>
        <div class="tiers">
          <article data-tier="short">
            <i>01</i><div><strong>Short-term window</strong><p>Verbatim turns · relational rows</p></div><small>TOKEN-BUDGETED</small>
          </article>
          <article data-tier="medium">
            <i>02</i><div><strong>Medium-term summary</strong><p>One rolling window per session</p></div><small>APPEND-ONLY</small>
          </article>
          <article data-tier="long">
            <i>03</i><div><strong>Long-term facts</strong><p>Mem0 extraction · vector recall</p></div><small>DEDUPLICATED</small>
          </article>
        </div>
      </section>
    </div>

    <footer>
      <p><span class="status-dot"></span><b data-status>Client prepares a scoped recall</b></p>
      <div><span>DEV · SQLite + Chroma / one volume</span><span>PROD · Postgres + pgvector</span></div>
    </footer>
  </memory-call-flow>
</AnimationWindow>

<script>
  const callStatuses: Record<string, string[]> = {
    recall: [
      'Client prepares a scoped recall',
      'Authenticated call crosses the pod boundary',
      'MemoryStore queries all three scoped tiers',
      'Relevant memory is assembled',
      'Scoped recall returns to the agent',
    ],
    write: [
      'Client prepares a verbatim turn',
      'Authenticated write crosses the pod boundary',
      'MemoryStore commits the turn to relational rows',
      'Summary and fact extraction run inside the store',
      'Write acknowledgement returns to the agent',
    ],
    forget: [
      'Client requests deletion by scope',
      'Authenticated forget crosses the pod boundary',
      'MemoryStore resolves the server-owned scope',
      'Matching rows, summary and facts are removed',
      'Deletion result returns to the agent',
    ],
  };

  class MemoryCallFlow extends HTMLElement {
    private controller = new AbortController();
    private timer = 0;
    private stage = 0;

    connectedCallback() {
      this.controller = new AbortController();
      const windowElement = this.closest<HTMLElement>('animation-window');
      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-operation-button]'));
      if (!windowElement) return;
      buttons.forEach((button) =>
        button.addEventListener(
          'click',
          () => {
            this.dataset.operation = button.dataset.operationButton;
            buttons.forEach((item) => {
              const active = item === button;
              item.classList.toggle('active', active);
              item.setAttribute('aria-pressed', String(active));
            });
            this.stage = 0;
            this.render();
            if (windowElement.dataset.playing === 'true') this.play();
          },
          { signal: this.controller.signal },
        ),
      );
      windowElement.addEventListener('animationwindow:play', () => this.play(), { signal: this.controller.signal });
      windowElement.addEventListener('animationwindow:pause', () => this.pause(), { signal: this.controller.signal });
      this.render();
      if (windowElement.dataset.playing === 'true') this.play();
    }

    disconnectedCallback() {
      this.controller.abort();
      this.pause();
    }

    private play() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      this.pause();
      this.timer = window.setTimeout(() => {
        this.stage = (this.stage + 1) % 5;
        this.render();
        this.play();
      }, 1150);
    }

    private pause() {
      window.clearTimeout(this.timer);
    }

    private render() {
      const operation = this.dataset.operation ?? 'recall';
      const stage = matchMedia('(prefers-reduced-motion: reduce)').matches ? 4 : this.stage;
      this.dataset.stage = String(stage);
      const call = this.querySelector<HTMLElement>('[data-call]');
      const status = this.querySelector<HTMLElement>('[data-status]');
      if (call) call.textContent = `${operation}(${operation === 'recall' ? 'query' : 'scope'})`;
      if (status) status.textContent = callStatuses[operation][stage];
    }
  }

  if (!customElements.get('memory-call-flow')) customElements.define('memory-call-flow', MemoryCallFlow);
</script>

<style>
  :global(.call-flow-window) {
    --memory: #b694ff;
    border-color: rgba(182, 148, 255, 0.28);
  }
  memory-call-flow {
    display: block;
    min-height: 520px;
  }
  .operation-bar {
    align-items: center;
    border-bottom: 1px solid var(--hairline-card);
    display: flex;
    justify-content: space-between;
    padding: 12px 18px;
  }
  .operation-bar > span,
  button,
  small,
  code,
  footer {
    font-family: var(--font-mono);
  }
  .operation-bar > span {
    color: var(--text-3);
    font-size: var(--mono-9);
    letter-spacing: 0.12em;
  }
  .operation-bar div {
    display: flex;
    gap: 6px;
  }
  button {
    background: transparent;
    border: 1px solid var(--hairline-card);
    color: var(--text-3);
    cursor: pointer;
    font-size: var(--mono-9);
    padding: 8px 12px;
  }
  button.active {
    background: rgba(182, 148, 255, 0.09);
    border-color: var(--memory);
    color: var(--memory);
  }
  .flow-stage {
    align-items: stretch;
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(150px, 0.7fr) minmax(190px, 0.8fr) minmax(390px, 1.65fr);
    min-height: 410px;
    padding: 28px 22px;
  }
  .agent-pod {
    align-self: center;
    background: rgba(74, 199, 255, 0.035);
    border: 1px solid rgba(74, 199, 255, 0.3);
    padding: 22px 18px;
  }
  .agent-pod small,
  .store header small {
    color: var(--text-4);
    font-size: var(--mono-8-5);
    letter-spacing: 0.1em;
  }
  .agent-pod strong,
  .agent-pod span {
    display: block;
  }
  .agent-pod strong {
    font: 400 var(--body-18)/1.2 var(--font-display);
    margin: 18px 0 5px;
  }
  .agent-pod span {
    color: #4ac7ff;
    font: var(--mono-9)/1.4 var(--font-mono);
  }
  .agent-pod code {
    border-top: 1px solid var(--hairline-card);
    color: var(--text-2);
    display: block;
    font-size: var(--mono-9);
    margin-top: 20px;
    padding-top: 12px;
  }
  .transport {
    align-items: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
  }
  .scope {
    border: 1px solid rgba(182, 148, 255, 0.3);
    padding: 8px 10px;
    text-align: center;
  }
  .scope small,
  .scope b {
    display: block;
    font: var(--mono-8-5)/1.4 var(--font-mono);
  }
  .scope small {
    color: var(--text-4);
  }
  .scope b {
    color: var(--memory);
    font-weight: 400;
  }
  .transport i {
    border-top: 1px solid rgba(182, 148, 255, 0.4);
    display: block;
    margin: 28px 0 18px;
    position: relative;
    width: 100%;
  }
  .transport i::after {
    border: 4px solid transparent;
    border-left-color: var(--memory);
    content: '';
    position: absolute;
    right: -7px;
    top: -4px;
  }
  .transport p {
    margin: 0;
    text-align: center;
  }
  .transport p b,
  .transport p span {
    display: block;
    font: var(--mono-8-5)/1.5 var(--font-mono);
  }
  .transport p b {
    color: var(--text-2);
    font-weight: 400;
  }
  .transport p span {
    color: var(--text-4);
  }
  .packet {
    background: var(--memory);
    color: #17151c;
    font: 700 8px/1 var(--font-mono);
    left: 0;
    opacity: 0;
    padding: 5px;
    position: absolute;
    top: 52%;
    transition:
      left 0.55s ease,
      opacity 0.2s ease;
    z-index: 2;
  }
  [data-stage='1'] .packet {
    left: 12%;
    opacity: 1;
  }
  [data-stage='2'] .packet,
  [data-stage='3'] .packet {
    left: 88%;
    opacity: 1;
  }
  [data-stage='4'] .packet {
    left: 12%;
    opacity: 1;
  }
  .store {
    border: 1px solid rgba(182, 148, 255, 0.32);
    padding: 16px;
  }
  .store header {
    align-items: end;
    border-bottom: 1px solid var(--hairline-card);
    display: grid;
    grid-template-columns: 1fr auto;
    padding-bottom: 13px;
  }
  .store header small {
    grid-column: 1 / -1;
  }
  .store header strong {
    font: 400 var(--body-18)/1.2 var(--font-display);
    margin-top: 7px;
  }
  .store header span {
    color: var(--memory);
    font: var(--mono-9)/1 var(--font-mono);
  }
  .tiers {
    display: grid;
    gap: 8px;
    padding-top: 14px;
  }
  .tiers article {
    align-items: center;
    border: 1px solid var(--hairline-card);
    display: grid;
    gap: 12px;
    grid-template-columns: auto 1fr auto;
    padding: 13px;
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }
  .tiers i {
    color: var(--memory);
    font: normal var(--mono-9)/1 var(--font-mono);
  }
  .tiers strong {
    font-size: var(--body-13);
    font-weight: 500;
  }
  .tiers p {
    color: var(--text-3);
    font: var(--mono-8-5)/1.4 var(--font-mono);
    margin: 3px 0 0;
  }
  .tiers article > small {
    color: var(--text-4);
    font-size: 8px;
    letter-spacing: 0.08em;
  }
  [data-operation='recall'][data-stage='2'] .tiers article,
  [data-operation='forget'][data-stage='2'] .tiers article,
  [data-operation='write'][data-stage='2'] [data-tier='short'],
  [data-stage='3'] .tiers article {
    background: rgba(182, 148, 255, 0.06);
    border-color: rgba(182, 148, 255, 0.55);
    transform: translateX(-3px);
  }
  footer {
    align-items: center;
    border-top: 1px solid var(--hairline-card);
    display: flex;
    justify-content: space-between;
    min-height: 56px;
    padding: 0 18px;
  }
  footer p {
    align-items: center;
    color: var(--text-2);
    display: flex;
    font-size: var(--mono-9);
    gap: 9px;
    margin: 0;
  }
  .status-dot {
    background: var(--memory);
    border-radius: 50%;
    height: 6px;
    width: 6px;
  }
  footer > div {
    display: flex;
    gap: 16px;
  }
  footer > div span {
    color: var(--text-4);
    font-size: 8px;
  }
  @media (max-width: 820px) {
    .flow-stage {
      grid-template-columns: 1fr;
    }
    .transport {
      min-height: 140px;
    }
    .transport i {
      transform: rotate(90deg);
      width: 90px;
    }
    footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
      padding-block: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .packet {
      display: none;
    }
    .tiers article {
      transition: none;
    }
  }
</style>
