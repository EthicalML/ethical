---
// The three-checkpoint explainability pipeline the header's nav preview draws, as a standalone
// mount. `backdrop` drops the mount out of flow so the hero that holds it places the canvas
// full-bleed behind its copy, the same contract `KomputeCube` carries.
interface Props {
  backdrop?: boolean;
  surface?: 'dark' | 'page';
}

const { backdrop = false, surface } = Astro.props;
---

<xai-pipeline class:list={[backdrop && 'hero-backdrop-mount']} data-surface={surface} aria-hidden="true">
  <canvas class:list={[backdrop && 'hero-canvas']}></canvas>
</xai-pipeline>

<script>
  import '../shared/canvas/XaiPipeline';
</script>

<style>
  xai-pipeline,
  canvas {
    display: block;
    height: 100%;
    width: 100%;
  }

  /* The hero owns the placement of a `.hero-canvas`, so the mount itself must not generate a box
    between the two. */
  xai-pipeline.hero-backdrop-mount {
    display: contents;
  }
</style>
