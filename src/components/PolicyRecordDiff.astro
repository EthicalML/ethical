---
import type { PolicyPair, PolicyRecordProduct } from './PolicyRecordData';

interface Props {
  products: PolicyRecordProduct[];
  pairs: PolicyPair[];
}

const { products, pairs } = Astro.props;
const pairByDoc = new Map(pairs.map((pair) => [pair.docFrom, pair]));
// Serialized for the client: pair panes plus dossier fallbacks, read only inside this element.
const payload = {
  pairs: pairs.map((pair) => ({ ...pair, title: products[pair.docFrom]?.title ?? '' })),
  summaries: Object.fromEntries(products.map((product, index) => [index, product.summary])),
};
const firstPairIndex = pairs.length > 0 ? pairs[0].docFrom : 0;
---

<policy-record-diff class="dif" data-reveal data-first={firstPairIndex} data-payload={JSON.stringify(payload)}>
  <header class="dif-head">
    <div>
      <p class="eyebrow">VERBATIM ADOPTION</p>
      <h2>What we wrote, what the text says</h2>
      <p class="dif-lede">Badged records carried language into the instrument. Select one to compare the submission against the adopted text.</p>
    </div>
    <p class="record-count"><strong>{pairs.length}</strong> adoption diffs</p>
  </header>

  <div class="dif-split">
    <div class="dif-list" role="listbox" aria-label="Policy products">
      {
        products.map((product, index) => (
          <button type="button" class="dif-row" role="option" data-index={index} aria-selected={index === firstPairIndex ? 'true' : 'false'}>
            <span class="dif-row-title">{product.title}</span>
            <span class="dif-row-meta">
              <span class="instrument-tag">{product.instrument}</span>
              {pairByDoc.has(index) && <span class="dif-badge">ADOPTED</span>}
            </span>
          </button>
        ))
      }
    </div>

    <div class="dif-pane" data-mount aria-live="polite"></div>
  </div>
</policy-record-diff>

<script>
  interface DiffPair {
    docFrom: number;
    instrument: string;
    reference: string;
    ours: string;
    theirs: string;
    verified: boolean;
    title: string;
  }

  class PolicyRecordDiff extends HTMLElement {
    private controller = new AbortController();
    private pairs = new Map<number, DiffPair>();
    private summaries: Record<string, string> = {};

    connectedCallback() {
      this.controller = new AbortController();
      const raw = this.dataset.payload ?? '{}';
      const data = JSON.parse(raw) as { pairs: DiffPair[]; summaries: Record<string, string> };
      this.pairs = new Map(data.pairs.map((pair) => [pair.docFrom, pair]));
      this.summaries = data.summaries;
      this.querySelectorAll<HTMLButtonElement>('.dif-row').forEach((row) => {
        row.addEventListener('click', () => this.select(Number(row.dataset.index)), { signal: this.controller.signal });
      });
      this.select(Number(this.dataset.first ?? '0'));
    }

    disconnectedCallback() {
      this.controller.abort();
    }

    // Underlay salient words (length > 3) that appear on the opposite side.
    private highlight(text: string, otherText: string) {
      const otherTokens = new Set(otherText.toLowerCase().match(/[a-z0-9]{4,}/g) ?? []);
      return text.replace(/[A-Za-z0-9]{4,}/g, (word) => (otherTokens.has(word.toLowerCase()) ? `<mark>${word}</mark>` : word));
    }

    private select(index: number) {
      const mount = this.querySelector<HTMLElement>('[data-mount]');
      if (!mount) return;
      this.querySelectorAll<HTMLButtonElement>('.dif-row').forEach((row) => row.setAttribute('aria-selected', String(Number(row.dataset.index) === index)));
      const pair = this.pairs.get(index);
      if (!pair) {
        mount.innerHTML = `<div class="dif-dossier"><p class="eyebrow">NO ADOPTION DIFF</p><p>${this.summaries[index] ?? ''}</p></div>`;
        return;
      }
      const oursHi = this.highlight(pair.ours, pair.theirs);
      const theirsHi = this.highlight(pair.theirs, pair.ours);
      const tag = pair.verified ? '' : '<span class="pending-tag">PENDING OWNER VERIFICATION</span>';
      mount.innerHTML = `
        <p class="dif-ref">${pair.instrument} · ${pair.reference} ${tag}</p>
        <div class="dif-cols">
          <article class="dif-col dif-ours"><span class="eyebrow">WHAT WE WROTE</span><p>${oursHi}</p></article>
          <article class="dif-col dif-theirs"><span class="eyebrow">WHAT THE TEXT SAYS</span><p>${theirsHi}</p></article>
        </div>`;
    }
  }

  if (!customElements.get('policy-record-diff')) {
    customElements.define('policy-record-diff', PolicyRecordDiff);
  }
</script>

<style>
  .dif {
    border-block: 1px solid var(--hairline);
    display: block;
    padding: 72px 48px 88px;
  }

  .dif-head {
    align-items: end;
    display: flex;
    gap: 24px;
    justify-content: space-between;
  }

  h2 {
    font: 300 clamp(34px, 4.2vw, 54px) / 1.02 var(--font-display);
    margin: 16px 0 0;
    max-width: 18ch;
  }

  .dif-lede {
    color: var(--text-3);
    margin: 12px 0 0;
    max-width: 48ch;
  }

  .record-count {
    color: var(--text-4);
    flex: none;
    font: var(--mono-10) / 1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .record-count strong {
    color: var(--accent);
    font-size: 22px;
    font-weight: 400;
    margin-right: 7px;
  }

  .dif-split {
    display: grid;
    gap: 32px;
    grid-template-columns: minmax(320px, 0.9fr) 1.4fr;
    margin-top: 40px;
  }

  .dif-list {
    display: flex;
    flex-direction: column;
    max-height: 620px;
    overflow-y: auto;
  }

  .dif-row {
    background: transparent;
    border: 0;
    border-top: 1px solid var(--hairline);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 15px 16px 15px 20px;
    position: relative;
    text-align: left;
  }

  .dif-row:hover {
    background: rgba(255, 255, 255, 0.025);
  }

  .dif-row[aria-selected='true'] {
    background: var(--accent-wash-09);
  }

  .dif-row[aria-selected='true']::before {
    background: var(--accent);
    content: '';
    inset: 0 auto 0 0;
    position: absolute;
    width: 2px;
  }

  .dif-row-title {
    color: var(--text-1);
    font: 400 15px/1.35 var(--font-body);
  }

  .dif-row-meta {
    align-items: center;
    display: flex;
    gap: 12px;
  }

  .instrument-tag {
    color: var(--text-3);
    font: var(--mono-9) / 1.3 var(--font-mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .dif-badge {
    background: var(--accent);
    color: var(--accent-on);
    font: var(--mono-9) / 1 var(--font-mono);
    letter-spacing: 0.1em;
    padding: 3px 7px;
  }

  .dif-pane {
    align-self: start;
    position: sticky;
    top: 24px;
  }

  :global(.dif-ref) {
    color: var(--text-3);
    font: var(--mono-10) / 1.4 var(--font-mono);
    letter-spacing: 0.08em;
    margin: 0 0 20px;
    text-transform: uppercase;
  }

  :global(.pending-tag) {
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-3);
    font: var(--mono-9) / 1 var(--font-mono);
    letter-spacing: 0.1em;
    margin-left: 8px;
    padding: 3px 6px;
  }

  :global(.dif-cols) {
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr 1fr;
  }

  :global(.dif-col) {
    background: var(--bg-inset);
    border: 1px solid var(--hairline-card);
    padding: 22px;
  }

  :global(.dif-theirs) {
    border-left: 2px solid var(--accent);
  }

  :global(.dif-col .eyebrow) {
    color: var(--text-4);
    display: block;
    margin-bottom: 14px;
  }

  :global(.dif-col p) {
    color: var(--text-2);
    font: 400 16px/1.6 var(--font-display);
    margin: 0;
  }

  :global(.dif-col mark) {
    background: var(--accent-wash-16, rgba(94, 230, 160, 0.16));
    color: var(--text-1);
    padding: 0 1px;
  }

  :global(.dif-dossier) {
    background: var(--bg-inset);
    border: 1px solid var(--hairline-card);
    padding: 26px;
  }

  :global(.dif-dossier .eyebrow) {
    color: var(--text-4);
    margin-bottom: 12px;
  }

  :global(.dif-dossier p:last-child) {
    color: var(--text-2);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 900px) {
    .dif {
      padding: 56px 22px 64px;
    }

    .dif-split {
      grid-template-columns: 1fr;
    }

    :global(.dif-cols) {
      grid-template-columns: 1fr;
    }

    .dif-pane {
      position: static;
    }
  }
</style>
