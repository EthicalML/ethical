---
interface Card {
  variant: string;
  title: string;
  sub_items: Array<{ label: string; detail: string }>;
  body: string;
  tags: string[];
  action: string;
}

interface Props {
  cards: Card[];
}

const { cards } = Astro.props;
---

<section id="frameworks" aria-labelledby="frameworks-heading" data-reveal>
  <p class="eyebrow">FRAMEWORKS</p>
  <h2 id="frameworks-heading">Frameworks for implementation</h2>
  <div class="card-grid">
    {
      cards.map((card) => (
        <article class="feature-card">
          <p class="eyebrow">{card.variant}</p>
          <h3>{card.title}</h3>
          {card.variant === 'sub-items' ? (
            <dl>
              {card.sub_items.map((item) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.detail}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <>
              <p>{card.body}</p>
              <ul class="tags" aria-label="Topics">
                {card.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <span class="action">{card.action}</span>
            </>
          )}
        </article>
      ))
    }
  </div>
</section>
