---
// The monokai-institute.nvim buffer slab, as a standalone mount.
interface Props {
  surface?: 'dark' | 'page';
}

const { surface } = Astro.props;
---

<theme-buffer-iso data-surface={surface} aria-hidden="true">
  <canvas></canvas>
</theme-buffer-iso>

<script>
  import '../shared/canvas/ThemeBufferIso';
</script>

<style>
  theme-buffer-iso,
  canvas {
    display: block;
    height: 100%;
    width: 100%;
  }
</style>
