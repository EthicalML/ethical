---
import { siteTitle } from '../data/navigation';

/* The header logo: the two-line wordmark that collapses into the 2x2 IE/AS mark and back.
   The four key letters are real characters in the sentence, measured in place and flown to
   the grid, so the motion always matches the actual font metrics. See SKILL of the design
   handoff's "Interactions & Behavior" section. */

const LINE1 = 'The Institute for Ethical AI';
const LINE2 = 'Alignment & Safety';

/* Key glyphs are located from the strings, never hard-coded: the copy can change without
   silently animating the wrong letters. */
/* Spaces must be non-breaking: a collapsing space between per-character spans would
   shorten the measured sentence. */
const NBSP = '\u00A0';

const keyed = (text: string, keys: string[]) =>
  [...text].map((ch, index) => ({
    ch: ch === ' ' ? NBSP : ch,
    key: keys.find((k) => text.indexOf(k) === index),
  }));

const line1 = keyed(LINE1, ['I', 'E']);
const line2 = keyed(LINE2, ['A', 'S']);
---

<site-logo>
  <a class="site-logo-link" href="/" aria-label={siteTitle}>
    <span class="site-logo-stage" aria-hidden="true">
      <span class="site-logo-text">
        <span class="site-logo-line">
          {
            line1.map((c) => (
              <span class="site-logo-char" data-key={c.key}>
                {c.ch}
              </span>
            ))
          }
        </span>
        <span class="site-logo-line site-logo-line-accent">
          {
            line2.map((c) => (
              <span class="site-logo-char" data-key={c.key}>
                {c.ch}
              </span>
            ))
          }
        </span>
      </span>
      <span class="site-logo-mark">
        {
          ['I', 'E', 'A', 'S'].map((k) => (
            <span class="site-logo-cell" data-cell={k}>
              <span class="site-logo-glyph">{k}</span>
            </span>
          ))
        }
      </span>
    </span>
  </a>
</site-logo>

<script>
  type Key = 'I' | 'E' | 'A' | 'S';

  const KEYS: Key[] = ['I', 'E', 'A', 'S'];
  const HOLD = 1800;
  const RUN = 900;
  const CYCLE = (HOLD + RUN) * 2;

  /* The handoff's scatter distances are quoted at its 26px demo size; they scale with ours. */
  const DEMO_FONT = 26;
  const SCATTER_X = 46;
  const SCATTER_Y = 14;

  /* Brand colours are fixed identity values, not site accent tokens. The mark's cells are
     theme-invariant; only the page-side type colour and the travelling glyphs' start colour
     change, so the ramps are per theme. */
  const CELL_RGBA = 'rgba(18,24,21,';
  const CELL_ACCENT_RGBA = 'rgba(87,227,155,';
  const RAMPS: Record<'dark' | 'light', Record<Key, [number[], number[]]>> = {
    dark: {
      I: [
        [242, 245, 243],
        [242, 245, 243],
      ],
      E: [
        [242, 245, 243],
        [242, 245, 243],
      ],
      A: [
        [87, 227, 155],
        [8, 17, 12],
      ],
      S: [
        [87, 227, 155],
        [87, 227, 155],
      ],
    },
    light: {
      I: [
        [11, 14, 12],
        [242, 245, 243],
      ],
      E: [
        [11, 14, 12],
        [242, 245, 243],
      ],
      A: [
        [15, 122, 76],
        [8, 17, 12],
      ],
      S: [
        [15, 122, 76],
        [87, 227, 155],
      ],
    },
  };

  interface Metrics {
    font: number;
    cell: number;
    gap: number;
    glyph: number;
    /* Optical nudge per key glyph, em-relative, solved from the font's ink metrics. */
    nudge: Record<Key, { x: number; y: number }>;
    from: Record<Key, { x: number; y: number }>;
    width: number;
    height: number;
  }

  class SiteLogoElement extends HTMLElement {
    private controller = new AbortController();
    private frame = 0;
    private started = false;
    private origin = 0;
    private metrics: Metrics | null = null;
    private theme: 'dark' | 'light' = 'dark';
    private themeWatch?: MutationObserver;
    private motionQuery = matchMedia('(prefers-reduced-motion: reduce)');
    private markQuery = matchMedia('(max-width: 1040px)');
    private stage!: HTMLElement;
    private text!: HTMLElement;
    private chars: HTMLElement[] = [];
    private lines: HTMLElement[] = [];
    private cells = new Map<Key, HTMLElement>();
    private glyphs = new Map<Key, HTMLElement>();
    private probes = new Map<Key, HTMLElement>();

    connectedCallback() {
      if (this.started) return;
      const stage = this.querySelector<HTMLElement>('.site-logo-stage');
      const text = this.querySelector<HTMLElement>('.site-logo-text');
      if (!stage || !text) return;
      this.started = true;
      this.controller = new AbortController();
      this.stage = stage;
      this.text = text;
      this.lines = Array.from(this.querySelectorAll<HTMLElement>('.site-logo-line'));
      this.chars = Array.from(this.querySelectorAll<HTMLElement>('.site-logo-char'));
      for (const key of KEYS) {
        this.cells.set(key, this.querySelector<HTMLElement>(`[data-cell="${key}"]`)!);
        this.glyphs.set(key, this.querySelector<HTMLElement>(`[data-cell="${key}"] .site-logo-glyph`)!);
        this.probes.set(key, this.querySelector<HTMLElement>(`.site-logo-char[data-key="${key}"]`)!);
      }

      this.readTheme();
      this.themeWatch = new MutationObserver(() => this.readTheme());
      this.themeWatch.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });

      const signal = this.controller.signal;
      window.addEventListener('resize', () => this.sync(), { signal });
      this.motionQuery.addEventListener('change', () => this.sync(), { signal });
      this.markQuery.addEventListener('change', () => this.sync(), { signal });
      document.fonts?.ready.then(() => this.sync());
      window.setTimeout(() => this.sync(), 250);
      this.sync();
    }

    disconnectedCallback() {
      this.started = false;
      this.controller.abort();
      this.themeWatch?.disconnect();
      if (this.frame) cancelAnimationFrame(this.frame);
      this.frame = 0;
    }

    private readTheme() {
      const ramp = getComputedStyle(this).getPropertyValue('--logo-ramp').trim();
      this.theme = ramp === 'light' ? 'light' : 'dark';
    }

    /** Picks the mode for the current viewport and preferences, then measures and starts. */
    private sync() {
      if (this.frame) cancelAnimationFrame(this.frame);
      this.frame = 0;

      if (this.markQuery.matches) {
        this.dataset.mode = 'mark';
        this.measure();
        this.applyStaticNudges();
        return;
      }
      if (this.motionQuery.matches) {
        this.dataset.mode = 'static';
        this.clearFrameStyles();
        return;
      }

      this.dataset.mode = 'animate';
      this.measure();
      if (!this.metrics) return;
      this.origin = performance.now();
      this.frame = requestAnimationFrame(this.tick);
    }

    /**
     * Measures the at-rest composition: the key glyphs' centres relative to the text block,
     * the block's own size (which the outer link reserves), and each key glyph's optical
     * nudge. The nudge is solved from canvas ink metrics rather than the handoff's table:
     * that table was measured against a synthetic oblique, and this site ships the real
     * Newsreader Italic, whose ink leans the other way.
     */
    private measure() {
      this.clearFrameStyles();
      const styles = getComputedStyle(this);
      const number = (name: string) => parseFloat(styles.getPropertyValue(name));
      const font = number('--logo-font');
      const cell = number('--logo-cell');
      const gap = number('--logo-gap');
      const glyph = number('--logo-glyph');

      const base = this.text.getBoundingClientRect();
      const from = {} as Metrics['from'];
      for (const key of KEYS) {
        const rect = this.probes.get(key)!.getBoundingClientRect();
        from[key] = {
          x: rect.left - base.left + rect.width / 2,
          y: rect.top - base.top + rect.height / 2,
        };
      }

      const nudge = {} as Metrics['nudge'];
      for (const key of KEYS) {
        nudge[key] = solveNudge(key, glyph, key === 'A' || key === 'S');
      }

      if (base.width > 0) {
        this.style.setProperty('--logo-reserve-width', `${base.width}px`);
        this.style.setProperty('--logo-reserve-height', `${base.height}px`);
      }
      this.metrics = { font, cell, gap, glyph, nudge, from, width: base.width, height: base.height };
    }

    /** The static mark tier carries the full nudge, since it is permanently collapsed. */
    private applyStaticNudges() {
      if (!this.metrics) return;
      for (const key of KEYS) {
        const { x, y } = this.metrics.nudge[key];
        this.glyphs.get(key)!.style.transform = `translate(${x.toFixed(4)}em, ${y.toFixed(4)}em)`;
      }
    }

    private clearFrameStyles() {
      for (const char of this.chars) {
        char.style.transform = '';
        char.style.opacity = '';
      }
      for (const key of KEYS) {
        const cell = this.cells.get(key)!;
        cell.style.cssText = '';
        this.glyphs.get(key)!.style.transform = '';
      }
      this.stage.style.width = '';
      this.stage.style.height = '';
    }

    private tick = (now: number) => {
      const t = (now - this.origin) % CYCLE;
      let p: number;
      if (t < HOLD) p = 0;
      else if (t < HOLD + RUN) p = (t - HOLD) / RUN;
      else if (t < HOLD * 2 + RUN) p = 1;
      else p = 1 - (t - (HOLD * 2 + RUN)) / RUN;
      this.render(p);
      this.frame = requestAnimationFrame(this.tick);
    };

    private render(p: number) {
      const m = this.metrics;
      if (!m) return;
      const e = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
      const lerp = (a: number, b: number) => a + (b - a) * e;
      const scale = m.font / DEMO_FONT;
      const step = m.cell + m.gap;
      const collapsed = m.cell * 2 + m.gap;
      const boxAlpha = Math.max(0, (e - 0.55) / 0.45);
      const ramp = Math.min(1, boxAlpha / 0.6);
      const grid: Record<Key, [number, number]> = {
        I: [0, 0],
        E: [step, 0],
        A: [0, step],
        S: [step, step],
      };

      /* The scatter: every non-key letter pushes away from its own line's centre, takes a
         three-phase vertical jitter and thins out slightly faster than the move completes. */
      for (const line of this.lines) {
        const items = Array.from(line.children) as HTMLElement[];
        const centre = (items.length - 1) / 2;
        items.forEach((item, i) => {
          if (item.dataset.key) return;
          const rel = (i - centre) / centre;
          const dx = rel * SCATTER_X * scale * e;
          const dy = ((i % 3) - 1) * SCATTER_Y * scale * e;
          item.style.transform = `translate(${dx.toFixed(2)}px, ${dy.toFixed(2)}px)`;
          item.style.opacity = Math.max(0, 1 - e * 1.15).toFixed(3);
        });
      }

      const ramps = RAMPS[this.theme];
      for (const key of KEYS) {
        const from = m.from[key];
        const to = { x: grid[key][0] + m.cell / 2, y: grid[key][1] + m.cell / 2 };
        const cell = this.cells.get(key)!;
        cell.style.left = `${(lerp(from.x, to.x) - m.cell / 2).toFixed(2)}px`;
        cell.style.top = `${(lerp(from.y, to.y) - m.cell / 2).toFixed(2)}px`;
        cell.style.fontSize = `${lerp(m.font, m.glyph).toFixed(2)}px`;
        cell.style.background = `${key === 'A' ? CELL_ACCENT_RGBA : CELL_RGBA}${boxAlpha.toFixed(3)})`;
        cell.style.color = mix(ramps[key][0], ramps[key][1], ramp);
        const nudge = m.nudge[key];
        this.glyphs.get(key)!.style.transform = `translate(${(nudge.x * e).toFixed(4)}em, ${(nudge.y * e).toFixed(4)}em)`;
      }

      /* The stage animates inside the reservation, so the nav row never reflows. */
      this.stage.style.width = `${lerp(m.width, collapsed).toFixed(2)}px`;
      this.stage.style.height = `${lerp(m.height, collapsed).toFixed(2)}px`;
    }
  }

  function mix(a: number[], b: number[], t: number) {
    const channel = (i: number) => Math.round(a[i] + (b[i] - a[i]) * t);
    return `rgb(${channel(0)},${channel(1)},${channel(2)})`;
  }

  let context: CanvasRenderingContext2D | null = null;

  /**
   * Solves a cell glyph's em-relative nudge so its ink centres in the cell, from the same
   * geometry scripts/build-logo-svgs.mjs uses: the advance box is what gets centred, so the
   * nudge is the gap between the advance centre and the ink centre, and vertically the gap
   * between the line box's centre and the ink's, with the baseline placed by half-leading.
   */
  function solveNudge(glyph: string, size: number, italic: boolean) {
    context ??= document.createElement('canvas').getContext('2d');
    if (!context) return { x: 0, y: 0 };
    context.font = `${italic ? 'italic ' : ''}300 ${size}px Newsreader, serif`;
    const m = context.measureText(glyph);
    const inkMidX = (m.actualBoundingBoxRight - m.actualBoundingBoxLeft) / 2;
    const inkMidY = (m.actualBoundingBoxAscent - m.actualBoundingBoxDescent) / 2;
    const content = m.fontBoundingBoxAscent + m.fontBoundingBoxDescent;
    const baselineFromTop = (size - content) / 2 + m.fontBoundingBoxAscent;
    return {
      x: (m.width / 2 - inkMidX) / size,
      y: (0.5 * size + inkMidY - baselineFromTop) / size,
    };
  }

  if (!customElements.get('site-logo')) customElements.define('site-logo', SiteLogoElement);
</script>

<style>
  /* Identity constants, scaled from the handoff's 26px/30px demo so the two-line wordmark
     fits the existing header row: 17/20 keeps the row at the 70px it already measures.
     Cell tracks the line height (the demo's 30/30), the gap is 6% of the cell rounded to a
     whole pixel, and the in-cell glyph is the mark's 0.64 x cell. */
  site-logo {
    --logo-font: 17px;
    --logo-line: 20px;
    --logo-cell: 20px;
    --logo-gap: 1px;
    --logo-glyph: 12.8px;
    --logo-accent: #57e39b;
    --logo-ramp: dark;
    --logo-type: #f2f5f3;
    display: block;
    flex: none;
  }

  /* The identity's light-theme colours are for paper. The header is a dark surface in both
     site themes, so the logo follows the surface, not the root, exactly as the site's own
     tokens do (see the [data-surface='dark'] remap in tokens.css). --logo-ramp carries the
     same choice to the script, so the travelling glyphs' colour ramp cannot disagree with
     the static type around it. */
  :root[data-theme='light'] site-logo {
    --logo-accent: #0f7a4c;
    --logo-ramp: light;
    --logo-type: #0b0e0c;
  }

  :root[data-theme='light'] :global([data-surface='dark']) site-logo {
    --logo-accent: #57e39b;
    --logo-ramp: dark;
    --logo-type: #f2f5f3;
  }

  .site-logo-link {
    display: block;
    /* The reservation: the row is sized by the at-rest wordmark and never by the frame. */
    height: var(--logo-reserve-height, auto);
    width: var(--logo-reserve-width, auto);
  }

  .site-logo-stage {
    display: block;
    position: relative;
  }

  .site-logo-text {
    color: var(--logo-type);
    font-family: var(--font-display);
    font-weight: 300;
    white-space: nowrap;
  }

  site-logo[data-mode='animate'] .site-logo-text {
    inset: 0 auto auto 0;
    position: absolute;
  }

  .site-logo-line {
    display: block;
    /* font-size:0 on the line, real size on each span: inter-span whitespace would
       otherwise widen the measured sentence. */
    font-size: 0;
    line-height: var(--logo-line);
  }

  .site-logo-line-accent {
    color: var(--logo-accent);
    font-style: italic;
  }

  .site-logo-char {
    display: inline-block;
    font-size: var(--logo-font);
    line-height: var(--logo-line);
    /* Baseline-aligned inline-blocks sit on the zero-size line strut and add its descent
       to every line box, which made the two-line block 46px instead of 40px. */
    vertical-align: top;
  }

  site-logo[data-mode='animate'] .site-logo-char[data-key] {
    /* Key letters hold their space in the sentence; the travelling cells are what you see. */
    visibility: hidden;
  }

  .site-logo-mark {
    display: contents;
  }

  .site-logo-cell {
    align-items: center;
    background: #121815;
    color: #f2f5f3;
    display: none;
    font-family: var(--font-display);
    font-weight: 300;
    height: var(--logo-cell);
    justify-content: center;
    line-height: 1;
    width: var(--logo-cell);
  }

  .site-logo-cell[data-cell='A'] {
    background: #57e39b;
    color: #08110c;
  }

  .site-logo-cell[data-cell='S'] {
    color: #57e39b;
  }

  .site-logo-cell[data-cell='A'],
  .site-logo-cell[data-cell='S'] {
    font-style: italic;
  }

  .site-logo-glyph {
    display: block;
  }

  site-logo[data-mode='animate'] .site-logo-cell {
    display: flex;
    position: absolute;
  }

  /* Below the drawer breakpoint the row has no width for the wordmark beside the join pill
     and the menu button, so the logo is the mark alone, on the row's 44px control height. */
  @media (max-width: 1040px) {
    site-logo {
      --logo-cell: 21px;
      --logo-gap: 1px;
      --logo-glyph: 13.4px;
    }

    .site-logo-link {
      align-items: center;
      display: flex;
      height: 44px;
      min-height: 44px;
      width: auto;
    }

    .site-logo-text {
      display: none;
    }

    .site-logo-mark {
      display: grid;
      gap: var(--logo-gap);
      grid-template-columns: repeat(2, var(--logo-cell));
    }

    .site-logo-cell {
      display: flex;
      font-size: var(--logo-glyph);
    }
  }
</style>
