---
import { join, menus } from '../data/navigation';
import CommandPalette from './CommandPalette.astro';
import MegaMenu from './MegaMenu.astro';
import MobileDrawer from './MobileDrawer.astro';
import SiteLogo from './SiteLogo.astro';
---

<site-header transition:persist="site-header">
  <div class="header-sticky">
    <div class="header-glass" aria-hidden="true"></div>
    <header class="site-header" data-surface="dark">
      <div class="header-row">
        <SiteLogo />
        <nav class="primary-nav" aria-label="Primary navigation">
          {
            Object.entries(menus)
              .filter(([, menu]) => menu.primary)
              .map(([id, menu]) => (
                <button class="nav-trigger" type="button" aria-expanded="false" data-menu-trigger={id} data-menu-width={menu.width}>
                  {menu.label}
                  <span class="caret" aria-hidden="true">
                    ▾
                  </span>
                </button>
              ))
          }
        </nav>
        <div class="nav-right">
          <button class="nav-trigger" type="button" aria-expanded="false" data-menu-trigger="about" data-menu-width={menus.about.width}>
            {menus.about.label}<span class="caret" aria-hidden="true">▾</span>
          </button>
          <button class="search-trigger" type="button" data-command-palette-open aria-label="Search the site">
            <svg
              class="search-icon"
              viewBox="0 0 24 24"
              width="15"
              height="15"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="10.75" cy="10.75" r="6"></circle>
              <path d="M15.3 15.3 20 20"></path>
            </svg>
            <kbd class="search-keys" aria-hidden="true">⌘K</kbd>
          </button>
          <a class="join-pill" href={join.href}>
            <span class="join-label-full">{join.label}</span>
            <span class="join-label-short">{join.short}</span>
          </a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Light mode">
            <svg
              class="theme-icon theme-icon-sun"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4.25"></circle>
              <path d="M12 2.75v2M12 19.25v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2.75 12h2M19.25 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
            </svg>
            <svg
              class="theme-icon theme-icon-moon"
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.75 6.75 0 0 0 10.7 10.7z"></path>
            </svg>
          </button>
          <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu" data-mobile-menu-open>
            <i aria-hidden="true"></i>
          </button>
        </div>
      </div>
      <MegaMenu />
    </header>
  </div>
  <MobileDrawer />
  <CommandPalette />
</site-header>

<script>
  interface MegaMenuElement extends HTMLElement {
    openMenu(id: string, left: number, width: number): void;
    positionMenu(left: number, width: number): void;
    closeMenu(): void;
  }

  interface MobileDrawerElement extends HTMLElement {
    openMenu(openButton: HTMLButtonElement): void;
    closeMenu(): void;
  }

  class SiteHeaderElement extends HTMLElement {
    private closeTimer?: number;
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      this.setupMenu();
      this.setupMobileMenu();
    }

    disconnectedCallback() {
      this.controller.abort();
      if (this.closeTimer !== undefined) window.clearTimeout(this.closeTimer);
    }

    private setupMenu() {
      const header = this.querySelector<HTMLElement>('.site-header');
      const menu = this.querySelector<MegaMenuElement>('mega-menu');
      const triggers = Array.from(header?.querySelectorAll<HTMLElement>('[data-menu-trigger]') ?? []);
      const headerRow = header?.querySelector<HTMLElement>('.header-row');
      if (!header || !menu || !headerRow || !triggers.length) return;

      let active: string | null = null;
      const signal = this.controller.signal;
      const measure = (trigger: HTMLElement) => {
        const rowBounds = headerRow.getBoundingClientRect();
        const triggerBounds = trigger.getBoundingClientRect();
        const width = Math.min(Number(trigger.dataset.menuWidth), rowBounds.width - 80);
        const left = Math.max(40, Math.min(triggerBounds.left - rowBounds.left, rowBounds.width - width - 40));
        return { left, width };
      };
      const close = () => {
        if (this.closeTimer !== undefined) window.clearTimeout(this.closeTimer);
        active = null;
        menu.closeMenu();
        triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
      };
      const open = (trigger: HTMLElement) => {
        if (this.closeTimer !== undefined) window.clearTimeout(this.closeTimer);
        const id = trigger.dataset.menuTrigger;
        if (!id || id === active) return;
        const { left, width } = measure(trigger);
        triggers.forEach((item) => {
          item.setAttribute('aria-expanded', String(item === trigger));
        });
        menu.openMenu(id, left, width);
        active = id;
      };
      const delayedClose = () => {
        if (this.closeTimer !== undefined) window.clearTimeout(this.closeTimer);
        this.closeTimer = window.setTimeout(close, 240);
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener('mouseenter', () => open(trigger), { signal });
        trigger.addEventListener('focus', () => open(trigger), { signal });
        trigger.addEventListener(
          'click',
          () => {
            if (active === trigger.dataset.menuTrigger) close();
            else open(trigger);
          },
          { signal },
        );
      });
      header.addEventListener(
        'mouseenter',
        () => {
          if (this.closeTimer !== undefined) window.clearTimeout(this.closeTimer);
        },
        { signal },
      );
      header.addEventListener('mouseleave', delayedClose, { signal });
      menu.addEventListener('mega-menu:close', close, { signal });
      document.addEventListener(
        'click',
        (event) => {
          if (!header.contains(event.target as Node)) close();
        },
        { signal },
      );
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape') close();
        },
        { signal },
      );
      window.addEventListener(
        'resize',
        () => {
          const trigger = triggers.find((item) => item.dataset.menuTrigger === active);
          if (trigger && active) {
            const { left, width } = measure(trigger);
            menu.positionMenu(left, width);
          }
        },
        { signal },
      );
      window.addEventListener(
        'scroll',
        () => {
          if (window.scrollY > header.offsetHeight) close();
        },
        { passive: true, signal },
      );
    }

    private setupMobileMenu() {
      const drawer = this.querySelector<MobileDrawerElement>('mobile-drawer');
      const openButton = this.querySelector<HTMLButtonElement>('[data-mobile-menu-open]');
      if (!drawer || !openButton) return;
      // One button owns both directions now, so it has to read its own state:
      // calling openMenu again while open would relock the scroll at the top of
      // the page and lose the position the drawer is holding.
      openButton.addEventListener(
        'click',
        () => {
          if (openButton.getAttribute('aria-expanded') === 'true') drawer.closeMenu();
          else drawer.openMenu(openButton);
        },
        { signal: this.controller.signal },
      );
    }
  }

  if (!customElements.get('site-header')) customElements.define('site-header', SiteHeaderElement);
</script>

<style>
  /* The header is a fixed-height shell holding a bar that compacts inside it. The shell is
     what sticks and what occupies flow, so the row can animate its height as the logo
     collapses without moving a single pixel of the page below it — and every anchor offset,
     scroll-padding and `offsetHeight` reader keeps the number it already had. The shell is
     transparent below the compacted bar, so it must not eat clicks meant for the page.

     The shell is a wrapper rather than the header element itself because the frosted pane has
     to be a sibling of the named header (see .header-glass) and still travel with it: during
     macOS elastic overscroll a sticky element rides the rubber band, and a pane positioned
     against the viewport instead of against the shell tears away from the bar and lands on the
     page text. Sharing one sticky ancestor means one paint offset for both, always. */
  .header-sticky {
    height: var(--header-shell-height);
    pointer-events: none;
    position: sticky;
    top: 0;
    z-index: 60;
  }

  /* Positioned so the mega menu can anchor against it, and layered so the bar's contents sit
     over the pane: both are children of one stacking context now, where the pane's old
     z-index would have painted it over the nav. */
  .site-header {
    position: relative;
    z-index: 1;
  }

  /* The frosted pane, and the reason it is a separate element rather than the bar's own
     background: `.site-header` carries `view-transition-name: site-header` so it survives
     navigations, and a view-transition name makes an element its own backdrop root. Any
     `backdrop-filter` inside it samples an empty backdrop and blurs nothing — which is why
     the header's blur had been silently doing nothing at all. The pane lives outside that
     named subtree, fixed to the viewport, tracking the bar's height. */
  .header-glass {
    backdrop-filter: blur(24px) saturate(175%);
    background: var(--bg-header);
    border-bottom: 1px solid var(--hairline);
    /* The rim: one hairline of light along the top edge, nothing else. */
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 8%);
    height: var(--header-bar-height, 69px);
    inset: 0 0 auto;
    pointer-events: none;
    position: absolute;
    /* Its own compositor layer: without this, Chrome re-rasterizes the backdrop-filter
       whenever a canvas beneath promotes or demotes layers, which flickers. */
    transform: translateZ(0);
    will-change: backdrop-filter;
    /* Under the bar's contents, over the page: the shell's own z-index 60 is what puts the
       pair above the page. */
    z-index: 0;
  }

  @supports not (backdrop-filter: blur(1px)) {
    .header-glass {
      background: var(--bg-header-dense);
    }
  }

  /* A reader who has asked for less transparency gets the pigment back instead. */
  @media (prefers-reduced-transparency: reduce) {
    .header-glass {
      backdrop-filter: none;
      background: var(--bg-header-dense);
      box-shadow: none;
    }
  }

  .header-row {
    align-items: center;
    display: flex;
    gap: var(--space-26);
    /* 15px keeps the row at the 70px it measured with the old mono wordmark, now that the
       logo's at-rest block is 40px tall; the logo publishes --header-collapse as it collapses
       and the bar compacts to 55px on the same eased value. */
    padding: calc(15px - 8px * var(--header-collapse, 0)) 40px;
    pointer-events: auto;
  }

  /* Above the drawer breakpoint the shell holds the at-rest height and the bar shrinks inside
     it. The mega menu hangs off the bar, not the shell, or it would float in the gap. */
  /* Both tiers compact on the same eased value; they only differ in what they start from,
     because the narrow row is sized by its 44px controls rather than by the logo. */
  site-header {
    --header-bar-height: calc(69px - 14px * var(--header-collapse, 0));
    --header-shell-height: 69px;
  }

  @media (min-width: 1041px) {
    site-header {
      --header-bar-height: calc(71px - 16px * var(--header-collapse, 0));
      --header-shell-height: 71px;
    }
  }

  .site-header {
    --header-bar-bottom: var(--header-bar-height);
  }

  .primary-nav {
    align-items: center;
    display: flex;
    flex: none;
  }

  .nav-trigger {
    background: transparent;
    border: 0;
    border-radius: var(--radius-pill);
    color: var(--text-2);
    cursor: pointer;
    font-size: var(--body-13);
    padding: 8px 9px;
  }

  .nav-trigger[aria-expanded='true'] {
    background: var(--wash-3);
    color: var(--text-1);
  }

  .caret {
    font-size: 8px;
    transition: transform var(--duration-3) var(--ease-panel);
  }

  [aria-expanded='true'] .caret {
    transform: rotate(180deg);
  }

  .join-pill {
    border: 1px solid var(--accent-edge);
    border-radius: var(--radius-control);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: var(--mono-10-5);
    letter-spacing: 0.1em;
    margin-inline-start: auto;
    padding: 9px 13px;
    white-space: nowrap;
  }

  /* One height for every framed control in this row. The search box and the join
     pill are cut from the same number rather than each arriving at it through its
     own padding, which is how the icon-only search box ended up 5px shorter than
     the pill beside it at the first compression tier. */
  .nav-right {
    --control-height: 34px;

    align-items: center;
    display: flex;
    gap: 8px;
    margin-inline-start: auto;
  }

  .nav-right .join-pill {
    align-items: center;
    display: inline-flex;
    margin-left: 0;
    min-height: var(--control-height);
  }

  .join-label-short {
    display: none;
  }

  /* Two glyphs, not one: the lens says "search" without being read, and the keycap
     teaches the shortcut. Square corners and the shared control height put it on the
     join pill's baseline grid, so the right-hand controls read as one row of
     same-cut buttons rather than a pill floating beside a rectangle. */
  .search-trigger {
    align-items: center;
    background: var(--wash-1);
    border: 1px solid var(--hairline-card);
    border-radius: 0;
    box-sizing: border-box;
    color: var(--text-2);
    cursor: pointer;
    display: inline-flex;
    gap: 6px;
    height: var(--control-height);
    padding: 6px 5px 6px 9px;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .search-icon {
    display: block;
  }

  .search-keys {
    background: var(--wash-3);
    border-radius: 2px;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    line-height: 1;
    padding: 5px 6px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .search-trigger:hover {
    background: var(--wash-2);
    border-color: var(--accent-edge);
    color: var(--accent-ink);
  }

  .search-trigger:hover .search-keys {
    background: var(--wash-4);
    color: var(--text-2);
  }

  /* Accent text and strokes take --accent-ink, never --accent: the bright mint is
     1.41:1 on paper. Both toggles read their pressed state from the live data-theme
     attribute (see shared/Theme.ts), so the pill can never show the wrong theme. */
  /* A quiet glyph, not a control: no border, no fill, contour only. It sits to the
     right of the join pill and should read as punctuation at the end of the row. */
  .theme-toggle {
    align-items: center;
    background: none;
    border: 0;
    color: var(--text-4);
    cursor: pointer;
    display: inline-flex;
    justify-content: center;
    margin-inline-start: 2px;
    padding: 6px;
    transition: color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--accent-ink);
  }

  /* The icon names the destination, matching the aria-label: a sun while dark is
     active because the click brings light, and a moon once light is on. */
  .theme-icon {
    display: block;
  }

  .theme-icon-moon,
  .theme-toggle[aria-pressed='true'] .theme-icon-sun {
    display: none;
  }

  .theme-toggle[aria-pressed='true'] .theme-icon-moon {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
  }

  .mobile-menu-toggle {
    display: none;
  }

  /* The desktop row's intrinsic minimum sat above the drawer breakpoint, so every
     width between the two scrolled the page sideways. This tier spends the cheapest
     levers — the row's own margins, then the search keycap, then the join pill's
     label and padding — to pull that minimum from 1155 down to 1009. No nav label
     is touched, so the menu reads the same the whole way down. Nav collapse sits at
     1040 rather than 1009 so a wider mono fallback cannot close the gap. */
  @media (max-width: 1180px) {
    .header-row {
      gap: 18px;
      padding: calc(15px - 8px * var(--header-collapse, 0)) 28px;
    }

    .search-keys {
      display: none;
    }

    /* With the keycap gone the lens is the whole control, so the box becomes a
       square of the shared height instead of a short rectangle: padding cannot be
       trusted to land on the pill's height once its content changes. */
    .search-trigger {
      justify-content: center;
      padding: 0;
      width: var(--control-height);
    }

    .join-pill {
      letter-spacing: 0.06em;
      padding: 9px 12px;
    }

    .join-label-full {
      display: none;
    }

    .join-label-short {
      display: inline;
    }
  }

  /* Nav collapse: the desktop row swaps for the drawer. One of five copies that
     must agree — the sticky-header block below, MegaMenu.astro, MobileDrawer.astro's
     block and its `matchMedia`. Move them together: a toggle that appears while the
     drawer is still `display: none` opens nothing at all. Above the row's measured
     minimum by design; see the Breakpoints table in STYLES.md. */
  @media (max-width: 1040px) {
    .header-row {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 14px;
      padding: 16px 24px;
    }

    .primary-nav {
      display: none;
      order: 3;
    }

    .join-pill {
      margin-left: 0;
      position: absolute;
      right: 24px;
      top: 18px;
    }

    /* The theme control lives in the drawer below the drawer breakpoint (see
       MobileDrawer.astro), where it reads as a setting rather than a fourth glyph
       in the row. Search stays in the row: it is a destination, not a setting, and
       hiding it left the palette with no entry point at all on a phone, since the
       keyboard shortcut it advertised does not exist there. */
    .nav-right .nav-trigger,
    .theme-toggle {
      display: none;
    }

    /* Every framed control in the row grows to the 44px touch floor together, and
       the search box keeps the square cut it has at every other width: three
       same-height, same-cut boxes rather than circles bracketing a rectangle. The
       keycap is already gone here, and it teaches a shortcut a phone cannot press. */
    .nav-right {
      --control-height: 44px;
    }

    .search-trigger {
      background: transparent;
      color: var(--text-1);
    }

    .nav-right {
      margin-inline-start: auto;
    }

    .nav-right .join-pill {
      position: static;
    }

    .header-row {
      align-items: center;
      flex-wrap: nowrap;
      gap: 10px;
      min-height: calc(68px - 14px * var(--header-collapse, 0));
      padding: calc(12px - 7px * var(--header-collapse, 0)) 20px;
    }

    .nav-right {
      gap: 8px;
    }

    .nav-right .join-pill {
      padding: 9px 14px;
      position: static;
    }

    /* The toggle is now the only mobile menu control, opening and closing the
       drawer from one place, so it is square and label-free: the word made the
       button change width between its two states, which read as a jump. */
    .mobile-menu-toggle {
      align-items: center;
      background: transparent;
      border: 1px solid var(--hairline-card);
      border-radius: 0;
      box-sizing: border-box;
      color: var(--text-1);
      cursor: pointer;
      display: inline-flex;
      height: var(--control-height);
      justify-content: center;
      width: var(--control-height);
    }

    .mobile-menu-toggle i,
    .mobile-menu-toggle i::before,
    .mobile-menu-toggle i::after {
      background: currentColor;
      display: block;
      height: 1px;
      width: 16px;
    }

    .mobile-menu-toggle i {
      position: relative;
      transition: background-color var(--duration-3) var(--ease-reveal);
    }

    .mobile-menu-toggle i::before,
    .mobile-menu-toggle i::after {
      content: '';
      left: 0;
      position: absolute;
      transition:
        top var(--duration-3) var(--ease-reveal),
        transform var(--duration-3) var(--ease-reveal);
    }

    .mobile-menu-toggle i::before {
      top: -5px;
    }

    .mobile-menu-toggle i::after {
      top: 5px;
    }

    /* Open state: the middle bar drops out and the outer two close onto the
       centre line as the X, so the same three strokes carry both icons. */
    .mobile-menu-toggle[aria-expanded='true'] i {
      background-color: transparent;
    }

    .mobile-menu-toggle[aria-expanded='true'] i::before {
      top: 0;
      transform: rotate(45deg);
    }

    .mobile-menu-toggle[aria-expanded='true'] i::after {
      top: 0;
      transform: rotate(-45deg);
    }
  }

  /* Three 44px controls plus the 189px wordmark put the row's intrinsic minimum at
     383px, so this tier spends the cheap gaps to bring it back to 375 — the narrowest
     phone class in use. The 44px boxes are not a lever: the DOM gate holds every
     mobile control at 44x44. Below 375 the wordmark is the only thing left to cut,
     which is a brand decision rather than a spacing one. */
  @media (max-width: 420px) {
    .header-row {
      gap: 8px;
      padding-inline: 14px;
    }

    .nav-right {
      gap: 6px;
    }

    .nav-right .join-pill {
      padding-inline: 10px;
    }
  }
</style>

<style is:global>
  /* Persisted header chrome must keep its transition name across page scope changes. */
  .site-header {
    view-transition-name: site-header;
  }

  /* The drawer's scroll lock fixes the body at a negative offset, which drags a
     sticky header off screen with it by however far the page was scrolled. The
     toggle that closes the drawer lives in this header, so while the drawer is
     open the header is pinned to the viewport and lifted over it. */
  /* Nav collapse; see the note on the first 1040px block above. */
  @media (max-width: 1040px) {
    body.mobile-nav-open .header-sticky {
      inset-inline: 0;
      position: fixed;
      top: 0;
      z-index: 90;
    }
  }
</style>
