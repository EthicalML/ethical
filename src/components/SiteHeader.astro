---
import menus from '../data/nav.json';
import site from '../data/site.json';
const initialProject = menus.oss.items[0];
---

<site-header>
  <header class="site-header">
    <div class="header-row">
      <a class="wordmark" href="/">
        <span>{site.wordmark.primary}</span>
        <span>{site.wordmark.secondary}</span>
      </a>
      <nav class="primary-nav" aria-label="Primary navigation">
        {
          Object.entries(menus)
            .filter(([, menu]) => menu.primary)
            .map(([id, menu]) => (
              <button class="nav-trigger" type="button" aria-expanded="false" data-menu-trigger={id}>
                {menu.label}
                <span class="caret" aria-hidden="true">
                  ▾
                </span>
              </button>
            ))
        }
      </nav>
      <div class="nav-right">
        <button class="nav-trigger" type="button" aria-expanded="false" data-menu-trigger="about">
          {menus.about.label}<span class="caret" aria-hidden="true">▾</span>
        </button>
        <a class="join-pill" href={site.join.href}>{site.join.label}</a>
        <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-mobile-menu-open>
          <span>Menu</span><i aria-hidden="true"></i>
        </button>
      </div>
    </div>
    <div class="menu-wrap">
      <div class="mega-panel" data-menu-panel aria-hidden="true">
        {
          Object.entries(menus).map(([id, menu]) => (
            <div class:list={['mega-panel-body', id === 'overview' && 'is-active']} data-menu-body={id}>
              {menu.eyebrow && !menu.groups && <p class="menu-eyebrow">{menu.eyebrow}</p>}
              {menu.columns ? (
                <div class="network-menu">
                  {menu.columns.map(({ heading, items }) => (
                    <div>
                      <p>{heading}</p>
                      <div>
                        {items.map(({ title, description, href }) => (
                          <a href={href}>
                            <strong>{title}</strong>
                            <span>{description}</span>
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              ) : menu.groups ? (
                <div class="initiative-menu">
                  <div class="group-rail">
                    {menu.groups.map(({ title, note }, index) => (
                      <button type="button" class:list={{ active: index === 0 }} data-initiative-index={index}>
                        <strong>{title}</strong>
                        <span>{note}</span>
                        <i>→</i>
                      </button>
                    ))}
                  </div>
                  <div class="initiative-panes">
                    {menu.groups.map(({ note, items }, index) => (
                      <div class:list={['initiative-pane', index === 0 && 'active']} data-initiative-pane={index}>
                        <p>{note}</p>
                        <div>
                          {items.map(({ label, description, href }) => (
                            <a href={href}>
                              <strong>{label}</strong>
                              <span>{description}</span>
                            </a>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ) : id === 'oss' ? (
                <div class="oss-menu">
                  <div class="oss-menu-list">
                    {menu.items.map(({ key, eyebrow, title, description, href }, index) => (
                      <a
                        href={href}
                        class:list={{ active: index === 0 }}
                        data-oss-index={index}
                        data-oss-key={key}
                        data-oss-eyebrow={eyebrow}
                        data-oss-title={title}
                        data-oss-description={description}
                      >
                        <span>{eyebrow}</span>
                        <strong>{title}</strong>
                        <small>{description}</small>
                      </a>
                    ))}
                    <footer>
                      {menu.footerLinks.map(({ label, href }) => (
                        <a href={href}>{label}</a>
                      ))}
                    </footer>
                  </div>
                  <div class="oss-menu-preview">
                    <nav-preview mode={initialProject.key}>
                      <canvas aria-hidden="true" />
                    </nav-preview>
                    <p>
                      <span data-oss-preview-eyebrow>{initialProject.eyebrow}</span>
                      <strong data-oss-preview-title>{initialProject.title}</strong>
                      <i data-oss-preview-description>{initialProject.description}</i>
                    </p>
                  </div>
                </div>
              ) : (
                <div class:list={['menu-link-list', id === 'network' && 'two-columns']}>
                  {menu.items.map((item, index) => (
                    <a href={item.href} style={`--row-index:${index}`}>
                      {(id === 'overview' || id === 'about') && <span>{item.number}</span>}
                      <strong>{item.title}</strong>
                      <span aria-hidden="true">→</span>
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
    <div class="mobile-drawer" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Site navigation" aria-hidden="true" data-mobile-menu>
      <div class="mobile-drawer-header">
        <a class="wordmark" href="/">
          <span>{site.wordmark.primary}</span>
          <span>{site.wordmark.secondary}</span>
        </a>
        <a class="join-pill" href={site.join.href}>{site.join.label}</a>
        <button class="mobile-menu-close" type="button" aria-label="Close menu" data-mobile-menu-close>
          <span aria-hidden="true"></span>
        </button>
      </div>
      <nav class="mobile-nav" aria-label="Mobile navigation">
        {
          Object.entries(menus).map(([id, menu], menuIndex) => (
            <section class="mobile-menu-section" style={`--menu-index:${menuIndex}`}>
              <button type="button" aria-expanded="false" aria-controls={`mobile-submenu-${id}`} data-mobile-accordion>
                <span>{String(menuIndex + 1).padStart(2, '0')}</span>
                <strong>{menu.label}</strong>
                <i aria-hidden="true">+</i>
              </button>
              <div class="mobile-submenu" id={`mobile-submenu-${id}`} hidden>
                {menu.columns ? (
                  menu.columns.map((column) => (
                    <div class="mobile-link-group">
                      <p>{column.heading}</p>
                      {column.items.map((item) => (
                        <a href={item.href}>
                          <strong>{item.title}</strong>
                          <span>{item.description}</span>
                        </a>
                      ))}
                    </div>
                  ))
                ) : menu.groups ? (
                  menu.groups.map((group) => (
                    <div class="mobile-link-group">
                      <p>{group.title}</p>
                      {group.items.map((item) => (
                        <a href={item.href}>
                          <strong>{item.label}</strong>
                          <span>{item.description}</span>
                        </a>
                      ))}
                    </div>
                  ))
                ) : (
                  <div class="mobile-link-group">
                    {menu.items.map((item) => (
                      <a href={item.href}>
                        <strong>{item.title}</strong>
                        {item.description && <span>{item.description}</span>}
                      </a>
                    ))}
                    {menu.footerLinks?.map((item) => (
                      <a href={item.href}>
                        <strong>{item.label}</strong>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </section>
          ))
        }
      </nav>
    </div>
  </header>
</site-header>

<script>
  import '../shared/canvas/NavPreview';

  class SiteHeaderElement extends HTMLElement {
    private closeTimer?: number;
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      this.setupMenu();
      this.setupMobileMenu();
    }

    disconnectedCallback() {
      this.controller.abort();
      if (this.closeTimer !== undefined) window.clearTimeout(this.closeTimer);
    }

    private setupMenu() {
      const header = this.querySelector<HTMLElement>('.site-header');
      const panel = header?.querySelector<HTMLElement>('[data-menu-panel]');
      const triggers = Array.from(header?.querySelectorAll<HTMLElement>('[data-menu-trigger]') ?? []);
      const bodies = Array.from(header?.querySelectorAll<HTMLElement>('[data-menu-body]') ?? []);
      const headerRow = header?.querySelector<HTMLElement>('.header-row');
      if (!header || !panel || !headerRow || !triggers.length) return;

      const widths: Record<string, number> = {
        overview: 380,
        oss: 860,
        initiatives: 880,
        network: 640,
        about: 340,
      };
      let active: string | null = null;
      const signal = this.controller.signal;

      const measure = (trigger: HTMLElement, id: string) => {
        const rowBounds = headerRow.getBoundingClientRect();
        const triggerBounds = trigger.getBoundingClientRect();
        const width = Math.min(widths[id], rowBounds.width - 80);
        const left = Math.max(40, Math.min(triggerBounds.left - rowBounds.left, rowBounds.width - width - 40));
        panel.style.setProperty('--panel-left', `${left}px`);
        panel.style.setProperty('--panel-width', `${width}px`);
      };
      const close = () => {
        if (this.closeTimer !== undefined) window.clearTimeout(this.closeTimer);
        active = null;
        panel.classList.remove('is-open');
        panel.setAttribute('aria-hidden', 'true');
        triggers.forEach((trigger) => trigger.setAttribute('aria-expanded', 'false'));
      };
      const open = (trigger: HTMLElement) => {
        if (this.closeTimer !== undefined) window.clearTimeout(this.closeTimer);
        const id = trigger.dataset.menuTrigger;
        if (!id) return;
        measure(trigger, id);
        triggers.forEach((item) => {
          item.setAttribute('aria-expanded', String(item === trigger));
        });
        bodies.forEach((body) => {
          const selected = body.dataset.menuBody === id;
          body.classList.toggle('is-active', selected);
          if (selected) {
            body.style.animation = 'none';
            requestAnimationFrame(() => {
              body.style.animation = 'om-swap .3s cubic-bezier(.16,1,.3,1)';
            });
          }
        });
        panel.setAttribute('aria-hidden', 'false');
        panel.classList.add('is-open');
        active = id;
      };
      const delayedClose = () => {
        if (this.closeTimer !== undefined) window.clearTimeout(this.closeTimer);
        this.closeTimer = window.setTimeout(close, 240);
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener('mouseenter', () => open(trigger), { signal });
        trigger.addEventListener('focus', () => open(trigger), { signal });
        trigger.addEventListener(
          'click',
          () => {
            if (active === trigger.dataset.menuTrigger) close();
            else open(trigger);
          },
          { signal },
        );
      });
      header.addEventListener(
        'mouseenter',
        () => {
          if (this.closeTimer !== undefined) window.clearTimeout(this.closeTimer);
        },
        { signal },
      );
      header.addEventListener('mouseleave', delayedClose, { signal });
      panel.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', close, { signal });
      });

      const previewCanvas = panel.querySelector<HTMLElement>('nav-preview');
      const previewEyebrow = panel.querySelector<HTMLElement>('[data-oss-preview-eyebrow]');
      const previewTitle = panel.querySelector<HTMLElement>('[data-oss-preview-title]');
      const previewDescription = panel.querySelector<HTMLElement>('[data-oss-preview-description]');
      panel.querySelectorAll<HTMLElement>('[data-oss-index]').forEach((row) => {
        const select = () => {
          panel.querySelectorAll('[data-oss-index]').forEach((item) => {
            item.classList.toggle('active', item === row);
          });
          if (row.dataset.ossKey) previewCanvas?.setAttribute('mode', row.dataset.ossKey);
          if (previewEyebrow) previewEyebrow.textContent = row.dataset.ossEyebrow ?? '';
          if (previewTitle) previewTitle.textContent = row.dataset.ossTitle ?? '';
          if (previewDescription) {
            previewDescription.textContent = row.dataset.ossDescription ?? '';
          }
          const preview = panel.querySelector<HTMLElement>('.oss-menu-preview');
          if (preview) {
            preview.style.animation = 'none';
            requestAnimationFrame(() => {
              preview.style.animation = 'om-swap .3s cubic-bezier(.16,1,.3,1)';
            });
          }
        };
        row.addEventListener('mouseenter', select, { signal });
        row.addEventListener('focus', select, { signal });
      });

      panel.querySelectorAll<HTMLElement>('[data-initiative-index]').forEach((row) => {
        const select = () => {
          const index = row.dataset.initiativeIndex;
          panel.querySelectorAll('[data-initiative-index]').forEach((item) => {
            item.classList.toggle('active', item === row);
          });
          panel.querySelectorAll<HTMLElement>('[data-initiative-pane]').forEach((pane) => {
            pane.classList.toggle('active', pane.dataset.initiativePane === index);
          });
        };
        row.addEventListener('mouseenter', select, { signal });
        row.addEventListener('focus', select, { signal });
      });

      document.addEventListener(
        'click',
        (event) => {
          if (!header.contains(event.target as Node)) close();
        },
        { signal },
      );
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape') close();
        },
        { signal },
      );
      window.addEventListener(
        'resize',
        () => {
          const trigger = triggers.find((item) => item.dataset.menuTrigger === active);
          if (trigger && active) measure(trigger, active);
        },
        { signal },
      );
      window.addEventListener(
        'scroll',
        () => {
          if (window.scrollY > header.offsetHeight) close();
        },
        { passive: true, signal },
      );
    }

    private setupMobileMenu() {
      const drawer = this.querySelector<HTMLElement>('[data-mobile-menu]');
      const openButton = this.querySelector<HTMLButtonElement>('[data-mobile-menu-open]');
      const closeButton = drawer?.querySelector<HTMLButtonElement>('[data-mobile-menu-close]');
      if (!drawer || !openButton || !closeButton) return;

      const accordions = Array.from(drawer.querySelectorAll<HTMLButtonElement>('[data-mobile-accordion]'));
      const signal = this.controller.signal;
      let lastFocus: HTMLElement | null = null;
      let lockedScroll = 0;
      const focusable = () =>
        Array.from(drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter((element) => !element.closest('[hidden]'));
      const close = () => {
        if (drawer.getAttribute('aria-hidden') === 'true') return;
        drawer.setAttribute('aria-hidden', 'true');
        openButton.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('mobile-nav-open');
        document.body.style.top = '';
        scrollTo(0, lockedScroll);
        lastFocus?.focus();
      };
      const open = () => {
        lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        lockedScroll = scrollY;
        document.body.style.top = `-${lockedScroll}px`;
        document.body.classList.add('mobile-nav-open');
        drawer.setAttribute('aria-hidden', 'false');
        openButton.setAttribute('aria-expanded', 'true');
        closeButton.focus();
      };

      openButton.addEventListener('click', open, { signal });
      closeButton.addEventListener('click', close, { signal });
      drawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', close, { signal });
      });
      accordions.forEach((button) => {
        button.addEventListener(
          'click',
          () => {
            const expanded = button.getAttribute('aria-expanded') === 'true';
            const controls = button.getAttribute('aria-controls');
            const submenu = controls ? document.getElementById(controls) : null;
            button.setAttribute('aria-expanded', String(!expanded));
            if (submenu) submenu.hidden = expanded;
          },
          { signal },
        );
      });
      document.addEventListener(
        'keydown',
        (event) => {
          if (drawer.getAttribute('aria-hidden') === 'true') return;
          if (event.key === 'Escape') {
            event.preventDefault();
            close();
            return;
          }
          if (event.key !== 'Tab') return;
          const items = focusable();
          const first = items[0];
          const last = items[items.length - 1];
          if (!first || !last) return;
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        },
        { signal },
      );
      matchMedia('(min-width: 951px)').addEventListener(
        'change',
        (event) => {
          if (event.matches) close();
        },
        { signal },
      );
    }
  }

  if (!customElements.get('site-header')) {
    customElements.define('site-header', SiteHeaderElement);
  }
</script>
