---
import menus from '../data/nav.json';
import site from '../data/site.json';
const initialProject = menus.oss.items[0];
---

<header class="site-header" data-site-header>
  <div class="header-row">
    <a class="wordmark" href="/">
      <span>{site.wordmark.primary}</span>
      <span>{site.wordmark.secondary}</span>
    </a>
    <nav class="primary-nav" aria-label="Primary navigation">
      {
        Object.entries(menus)
          .filter(([, menu]) => menu.primary)
          .map(([id, menu]) => (
            <button class="nav-trigger" type="button" aria-expanded="false" data-menu-trigger={id}>
              {menu.label}
              <span class="caret" aria-hidden="true">
                ▾
              </span>
            </button>
          ))
      }
    </nav>
    <div class="nav-right">
      <button class="nav-trigger" type="button" aria-expanded="false" data-menu-trigger="about">
        {menus.about.label}<span class="caret" aria-hidden="true">▾</span>
      </button>
      <a class="join-pill" href={site.join.href}>{site.join.label}</a>
      <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-mobile-menu-open>
        <span>Menu</span><i aria-hidden="true"></i>
      </button>
    </div>
  </div>
  <div class="menu-wrap">
    <div class="mega-panel" data-menu-panel aria-hidden="true">
      {
        Object.entries(menus).map(([id, menu]) => (
          <div class:list={['mega-panel-body', id === 'overview' && 'is-active']} data-menu-body={id}>
            {menu.eyebrow && !menu.groups && <p class="menu-eyebrow">{menu.eyebrow}</p>}
            {menu.columns ? (
              <div class="network-menu">
                {menu.columns.map(({ heading, items }) => (
                  <div>
                    <p>{heading}</p>
                    <div>
                      {items.map(({ title, description, href }) => (
                        <a href={href}>
                          <strong>{title}</strong>
                          <span>{description}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            ) : menu.groups ? (
              <div class="initiative-menu">
                <div class="group-rail">
                  {menu.groups.map(({ title, note }, index) => (
                    <button type="button" class:list={{ active: index === 0 }} data-initiative-index={index}>
                      <strong>{title}</strong>
                      <span>{note}</span>
                      <i>→</i>
                    </button>
                  ))}
                </div>
                <div class="initiative-panes">
                  {menu.groups.map(({ note, items }, index) => (
                    <div class:list={['initiative-pane', index === 0 && 'active']} data-initiative-pane={index}>
                      <p>{note}</p>
                      <div>
                        {items.map(({ label, description, href }) => (
                          <a href={href}>
                            <strong>{label}</strong>
                            <span>{description}</span>
                          </a>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ) : id === 'oss' ? (
              <div class="oss-menu">
                <div class="oss-menu-list">
                  {menu.items.map(({ key, eyebrow, title, description, href }, index) => (
                    <a
                      href={href}
                      class:list={{ active: index === 0 }}
                      data-oss-index={index}
                      data-oss-key={key}
                      data-oss-eyebrow={eyebrow}
                      data-oss-title={title}
                      data-oss-description={description}
                    >
                      <span>{eyebrow}</span>
                      <strong>{title}</strong>
                      <small>{description}</small>
                    </a>
                  ))}
                  <footer>
                    {menu.footerLinks.map(({ label, href }) => (
                      <a href={href}>{label}</a>
                    ))}
                  </footer>
                </div>
                <div class="oss-menu-preview">
                  <nav-preview mode={initialProject.key}>
                    <canvas aria-hidden="true" />
                  </nav-preview>
                  <p>
                    <span data-oss-preview-eyebrow>{initialProject.eyebrow}</span>
                    <strong data-oss-preview-title>{initialProject.title}</strong>
                    <i data-oss-preview-description>{initialProject.description}</i>
                  </p>
                </div>
              </div>
            ) : (
              <div class:list={['menu-link-list', id === 'network' && 'two-columns']}>
                {menu.items.map((item, index) => (
                  <a href={item.href} style={`--row-index:${index}`}>
                    {(id === 'overview' || id === 'about') && <span>{item.number}</span>}
                    <strong>{item.title}</strong>
                    <span aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
  <div class="mobile-drawer" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Site navigation" aria-hidden="true" data-mobile-menu>
    <div class="mobile-drawer-header">
      <a class="wordmark" href="/">
        <span>{site.wordmark.primary}</span>
        <span>{site.wordmark.secondary}</span>
      </a>
      <a class="join-pill" href={site.join.href}>{site.join.label}</a>
      <button class="mobile-menu-close" type="button" aria-label="Close menu" data-mobile-menu-close>
        <span aria-hidden="true"></span>
      </button>
    </div>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {
        Object.entries(menus).map(([id, menu], menuIndex) => (
          <section class="mobile-menu-section" style={`--menu-index:${menuIndex}`}>
            <button type="button" aria-expanded="false" aria-controls={`mobile-submenu-${id}`} data-mobile-accordion>
              <span>{String(menuIndex + 1).padStart(2, '0')}</span>
              <strong>{menu.label}</strong>
              <i aria-hidden="true">+</i>
            </button>
            <div class="mobile-submenu" id={`mobile-submenu-${id}`} hidden>
              {menu.columns ? (
                menu.columns.map((column) => (
                  <div class="mobile-link-group">
                    <p>{column.heading}</p>
                    {column.items.map((item) => (
                      <a href={item.href}>
                        <strong>{item.title}</strong>
                        <span>{item.description}</span>
                      </a>
                    ))}
                  </div>
                ))
              ) : menu.groups ? (
                menu.groups.map((group) => (
                  <div class="mobile-link-group">
                    <p>{group.title}</p>
                    {group.items.map((item) => (
                      <a href={item.href}>
                        <strong>{item.label}</strong>
                        <span>{item.description}</span>
                      </a>
                    ))}
                  </div>
                ))
              ) : (
                <div class="mobile-link-group">
                  {menu.items.map((item) => (
                    <a href={item.href}>
                      <strong>{item.title}</strong>
                      {item.description && <span>{item.description}</span>}
                    </a>
                  ))}
                  {menu.footerLinks?.map((item) => (
                    <a href={item.href}>
                      <strong>{item.label}</strong>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </section>
        ))
      }
    </nav>
  </div>
</header>

<script>
  import '../shared/canvas/NavPreview';
</script>
