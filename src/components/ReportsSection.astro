---
import SurveyExplorerIsland from './SurveyExplorerIsland.astro';

interface Action {
  label: string;
  href: string;
  kind: string;
}

interface TextLink {
  label: string;
  href: string;
}

interface Reports {
  eyebrow: string;
  title: string;
  intro: string;
  actions: Action[];
  governance: {
    eyebrow: string;
    previewEyebrow: string;
    previewLabel: string;
    previewTitle: string;
    steps: Array<{ label: string; detail: string }>;
    title: string;
    text: string;
    actions: Action[];
  };
  security: {
    eyebrow: string;
    leftHeading: string;
    rightHeading: string;
    rows: Array<{ owasp: string; mlsecops: string }>;
    title: string;
    text: string;
    relatedIntro: string;
    relatedLinks: TextLink[];
    actions: Action[];
  };
}

interface Props {
  reports: Reports;
}

const { reports } = Astro.props;
---

<section id="reports" class="reports-section home-section" data-reveal>
  <header>
    <div>
      <p class="eyebrow">{reports.eyebrow}</p>
      <h2 transition:name="survey-title">{reports.title}</h2>
      <p>{reports.intro}</p>
    </div>
    <nav>
      {
        reports.actions.map(({ label, href, kind }) => (
          <a class:list={['button', kind]} href={href}>
            {label}
          </a>
        ))
      }
    </nav>
  </header>
  <div class="home-survey-card"><SurveyExplorerIsland /></div>
  <div class="initiative-pair">
    <article>
      <div class="initiative-preview governance-preview">
        <header><span>{reports.governance.previewEyebrow}</span><span>{reports.governance.previewLabel}</span></header>
        <h4>{reports.governance.previewTitle}</h4>
        {
          reports.governance.steps.map(({ label, detail }, index) => (
            <p>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {label}
              <i>{detail}</i>
            </p>
          ))
        }
      </div>
      <p class="eyebrow">{reports.governance.eyebrow}</p>
      <h3 transition:name="initiative-governance-title">{reports.governance.title}</h3>
      <p>{reports.governance.text}</p>
      <div class="initiative-actions">
        {
          reports.governance.actions.map(({ label, href, kind }) => (
            <a class:list={['button', kind]} href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>
              {label}
            </a>
          ))
        }
      </div>
    </article>
    <article>
      <div class="initiative-preview mlsecops-preview">
        <header><span>{reports.security.leftHeading}</span><span>{reports.security.rightHeading}</span></header>
        {
          reports.security.rows.map(({ owasp, mlsecops }) => (
            <p>
              <>
                <span>{owasp}</span>
                <strong>{mlsecops}</strong>
              </>
            </p>
          ))
        }
      </div>
      <p class="eyebrow">{reports.security.eyebrow}</p>
      <h3 transition:name="initiative-security-title">{reports.security.title}</h3>
      <p>{reports.security.text}</p>
      <p>
        {reports.security.relatedIntro}{' '}
        {
          reports.security.relatedLinks.map(({ label, href }, index) => (
            <>
              {index > 0 && (index === reports.security.relatedLinks.length - 1 ? ', and ' : ', ')}
              <a class="text-link" href={href} rel="noopener">
                {label}
              </a>
            </>
          ))
        }.
      </p>
      <div class="initiative-actions">
        {
          reports.security.actions.map(({ label, href, kind }) => (
            <a class:list={['button', kind]} href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>
              {label}
            </a>
          ))
        }
      </div>
    </article>
  </div>
</section>
