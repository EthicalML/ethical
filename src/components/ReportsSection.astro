---
import SurveyExplorerIsland from './SurveyExplorerIsland.astro';

interface Action {
  label: string;
  href: string;
  kind: string;
}

interface Reports {
  policy: {
    eyebrow: string;
    title: string;
    contributions: Array<{ value: string; text: string }>;
    stats: Array<{ value: string; label: string }>;
    action: { label: string; href: string };
  };
  title: string;
  intro: string;
  actions: Action[];
}

interface Props {
  reports: Reports;
}

const { reports } = Astro.props;
---

<reports-section id="reports" class="reports-section" data-reveal>
  <div class="policy-pulse">
    <div class="policy-pulse-copy">
      <p class="eyebrow">{reports.policy.eyebrow}</p>
      <h2>{reports.policy.title}</h2>
      <ul class="policy-contributions">
        {
          reports.policy.contributions.map(({ value, text }) => (
            <li>
              <strong>{value}</strong>
              <span>{text}</span>
            </li>
          ))
        }
      </ul>
      <div class="network-stats">
        {
          reports.policy.stats.map(({ value, label }) => (
            <div>
              <strong>{value}</strong>
              <span>{label}</span>
            </div>
          ))
        }
      </div>
      <a class="button primary" href={reports.policy.action.href}>{reports.policy.action.label}</a>
    </div>
    <policy-hero-policy-circuit class="policy-pulse-canvas" aria-hidden="true">
      <canvas></canvas>
    </policy-hero-policy-circuit>
  </div>
  <header>
    <div>
      <h2 data-morph-source="survey-title">{reports.title}</h2>
      <p>{reports.intro}</p>
    </div>
    <nav>
      {
        reports.actions.map(({ label, href, kind }) => (
          <a class:list={['button', kind]} href={href} data-morph-pair={href === '/data/survey-explorer/' ? 'survey-title' : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
  </header>
  <div class="home-survey-card"><SurveyExplorerIsland /></div>
</reports-section>

<style>
  reports-section {
    display: block;
    scroll-margin-top: 124px;
  }
  /* Sub-block 2 of the REPORTS & INITIATIVES section: policy narrative and metrics
     on the left, the /policy/ iso citadel embedded as an open backdrop on the right
     (no card framing; CanvasEngine supplies observer gating, the reduced-motion
     static frame and teardown). */
  .policy-pulse {
    align-items: center;
    display: grid;
    gap: 56px;
    grid-template-columns: 1fr 1.1fr;
    margin-bottom: 96px;
  }
  .policy-contributions {
    display: flex;
    flex-direction: column;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .policy-contributions li {
    align-items: baseline;
    display: grid;
    gap: 18px;
    grid-template-columns: 64px 1fr;
  }
  .policy-contributions strong {
    font: 300 26px/1 var(--font-display);
    letter-spacing: -0.01em;
  }
  .policy-contributions span {
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.55;
  }
  .policy-pulse-copy > .button {
    display: inline-block;
    margin-top: 30px;
  }
  .policy-pulse-canvas {
    display: block;
    height: 100%;
    min-height: 480px;
    position: relative;
  }
  .policy-pulse-canvas canvas {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }
  @media (max-width: 950px) {
    .policy-pulse {
      grid-template-columns: 1fr;
      margin-bottom: 72px;
    }
    .policy-pulse-canvas {
      min-height: 380px;
    }
  }
</style>

<script>
  import { bindMorphPairs } from '../shared/MorphPairs';
  import '../shared/canvas/PolicyHeroPolicyCircuit';

  class ReportsSection extends HTMLElement {
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      bindMorphPairs(this, this.controller.signal);
    }

    disconnectedCallback() {
      this.controller.abort();
    }
  }

  if (!customElements.get('reports-section')) {
    customElements.define('reports-section', ReportsSection);
  }
</script>
