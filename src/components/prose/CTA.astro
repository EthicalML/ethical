---
import { isExternalHref } from '../../utils/external-links.mjs';

const { href, label } = Astro.props;
const hasBody = Astro.slots.has('default');
const external = isExternalHref(href);
---

<aside class:list={['cta-block', 'prose-block', !hasBody && 'cta-only']} data-reveal>
  {
    hasBody && (
      <div class="block-body">
        <slot />
      </div>
    )
  }
  <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{label}</a>
</aside>

<style>
  .cta-only {
    justify-content: flex-end;
  }
</style>

<style is:global>
  .cta-block {
    align-items: center;
    display: flex;
    gap: 34px;
    justify-content: space-between;
    margin-top: 34px;
    padding: 26px 30px;
  }

  .cta-block a {
    background: transparent;
    border: 1px solid var(--accent-edge);
    border-radius: var(--radius-control);
    color: var(--accent-ink);
    flex: none;
    font-size: var(--body-14);
    font-family: var(--font-mono);
    font-weight: 500;
    padding: 13px 20px;
  }

  @media (max-width: 950px) {
    .cta-block {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 600px) {
    .cta-block {
      margin-inline: 18px;
      padding: 22px 20px;
    }
  }

  @media (max-width: 600px) {
    .cta-block a {
      width: 100%;
    }
  }
</style>
