---
const { stars, contributors, releases } = Astro.props;
const metrics = [
  { value: stars, label: 'STARS' },
  { value: contributors, label: 'CONTRIBUTORS' },
  { value: releases, label: 'RELEASES' },
];
---

<aside class="metrics-block prose-block" aria-label="Project metrics" data-reveal>
  {
    metrics.map((metric) => (
      <div>
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
      </div>
    ))
  }
</aside>
