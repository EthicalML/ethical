---
import { getEntry } from 'astro:content';

interface Metric {
  value: string;
  label: string;
}

interface Props {
  stars?: string;
  contributors?: string;
  releases?: string;
  metricId?: string;
  labels?: string[];
}

const { stars, contributors, releases, metricId, labels } = Astro.props;
const entry = metricId ? await getEntry('metrics', metricId) : undefined;
const storedMetrics = entry?.data.values ?? [];
const metrics: Metric[] = metricId
  ? storedMetrics.filter(({ label }) => !labels || labels.includes(label))
  : [
      { value: stars ?? '', label: 'STARS' },
      { value: contributors ?? '', label: 'CONTRIBUTORS' },
      { value: releases ?? '', label: 'RELEASES' },
    ];
---

<aside class="metrics-block prose-block" aria-label="Project metrics" data-reveal>
  {
    metrics.map((metric) => (
      <div>
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
      </div>
    ))
  }
</aside>
