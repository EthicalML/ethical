---
interface Metric {
  value: string;
  label: string;
}

interface Props {
  stars?: string;
  contributors?: string;
  releases?: string;
  values?: Metric[];
  ariaLabel?: string;
}

const { stars, contributors, releases, values, ariaLabel = 'Project metrics' } = Astro.props;
const metrics: Metric[] = values ?? [
  { value: stars ?? '', label: 'STARS' },
  { value: contributors ?? '', label: 'CONTRIBUTORS' },
  { value: releases ?? '', label: 'RELEASES' },
];
---

<aside class="metrics-block prose-block" aria-label={ariaLabel} data-reveal style={`--metric-count: ${metrics.length}`}>
  {
    metrics.map((metric) => (
      <div>
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
      </div>
    ))
  }
</aside>
