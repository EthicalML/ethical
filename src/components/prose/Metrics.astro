---
import { getEntry } from 'astro:content';

interface Metric {
  value: string;
  label: string;
}

interface Props {
  stars?: string;
  contributors?: string;
  releases?: string;
  values?: Metric[];
  metricId?: string;
  labels?: string[];
  ariaLabel?: string;
}

const { stars, contributors, releases, values, metricId, labels, ariaLabel = 'Project metrics' } = Astro.props;
const entry = metricId ? await getEntry('metrics', metricId) : undefined;
const storedMetrics = entry?.data.values ?? [];
const metrics: Metric[] = values
  ? values
  : metricId
    ? storedMetrics.filter(({ label }) => !labels || labels.includes(label))
    : [
        { value: stars ?? '', label: 'STARS' },
        { value: contributors ?? '', label: 'CONTRIBUTORS' },
        { value: releases ?? '', label: 'RELEASES' },
      ];
---

<aside class="metrics-block prose-block" aria-label={ariaLabel} data-reveal style={`--metric-count: ${metrics.length}`}>
  {
    metrics.map((metric) => (
      <div>
        <strong>{metric.value}</strong>
        <span>{metric.label}</span>
      </div>
    ))
  }
</aside>

<style is:global>
.metrics-block {
  display: grid;
  grid-template-columns: repeat(var(--metric-count, 3), 1fr);
  margin-top: 20px;
}

.metrics-block div {
  border-right: 1px solid var(--hairline);
  display: grid;
  gap: 8px;
  padding: 24px;
}

.metrics-block div:last-child { border-right: 0; }

.metrics-block strong {
  color: var(--accent);
  font-family: var(--font-display);
  font-size: var(--display-34);
  font-weight: 300;
}

.metrics-block span {
  color: var(--text-3);
  font-family: var(--font-mono);
  font-size: var(--mono-10);
  letter-spacing: .1em;
}

@media (max-width: 800px) {
  .metrics-block { grid-template-columns: 1fr; }
}

@media (max-width: 800px) {
  .metrics-block div {
      border-bottom: 1px solid var(--hairline);
      border-right: 0;
    }
}

@media (max-width: 600px) {
  .metrics-block { margin-inline: 18px; }
}
</style>
