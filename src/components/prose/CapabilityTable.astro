---
import defaultCapabilities from '../../data/kaos-capabilities.json';
const { items = defaultCapabilities } = Astro.props;
---

<div class="capability-table prose-block" data-reveal>
  {items.map((item) => (
    <div>
      <strong>{item.capability}</strong>
      <span>{item.detail}</span>
    </div>
  ))}
</div>
