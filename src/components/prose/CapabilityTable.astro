---
interface Props {
  items: Array<{
    capability: string;
    detail: string;
  }>;
}

const { items } = Astro.props;
---

<div class="capability-table prose-block" data-reveal>
  {
    items.map((item) => (
      <div>
        <strong>{item.capability}</strong>
        <span>{item.detail}</span>
      </div>
    ))
  }
</div>
