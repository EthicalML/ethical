---
import { Image } from 'astro:assets';
import affiliations from '../data/affiliations.json';
import partners from '../data/partners.json';

const logos = import.meta.glob('../assets/logos/*', { eager: true, import: 'default' });
const items = partners.map((partner) => ({
  ...partner,
  logo: logos[`../assets/logos/${partner.logo}`],
}));
---

<section class="affiliations" data-reveal data-marquee>
  <p class="eyebrow">{affiliations.eyebrow}</p>
  <div class="marquee-mask" data-marquee-lantern>
    <div class="marquee-track">
      {[false, true].map((duplicate) => (
        <div class="marquee-set" aria-hidden={duplicate ? 'true' : undefined}>
          {items.map((item) => (
            <div
              class="marquee-item"
              data-marquee-item={duplicate ? undefined : ''}
              aria-label={duplicate ? undefined : `${item.name}: ${item.role}`}
            >
              <span
                class="marquee-logo-frame"
                style={`--logo-mask: url("${item.logo.src}"); --logo-ratio: ${item.logo.width / item.logo.height}`}
              >
                <span class="marquee-logo-silhouette"></span>
                <Image class="marquee-logo-color" src={item.logo} alt="" aria-hidden="true" />
              </span>
              <span class="marquee-role">{item.role}</span>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
