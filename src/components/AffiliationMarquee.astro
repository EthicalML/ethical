---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';

const eyebrow = 'MEMBERSHIPS, ADVISORY ROLES & STANDARDS CONTRIBUTIONS';
const logos = import.meta.glob('../assets/logos/*', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>;
const partnerOrder = ['united-nations', 'european-commission', 'acm', 'linux-foundation', 'owasp', 'ieee', 'iso-iec', 'numfocus', 'tum'];
const partners = (await getCollection('partners')).sort((first, second) => partnerOrder.indexOf(first.id) - partnerOrder.indexOf(second.id));
const items = partners.map(({ data: partner }) => ({
  ...partner,
  logo: logos[`../assets/logos/${partner.logo}`],
}));
---

<affiliation-marquee>
  <section class="affiliations" data-reveal data-marquee>
    <p class="eyebrow">{eyebrow}</p>
    <div class="marquee-mask">
      <div class="marquee-track">
        {
          [false, true].map((duplicate) => (
            <div class="marquee-set" aria-hidden={duplicate ? 'true' : undefined}>
              {items.map((item) => (
                <a
                  class="marquee-item"
                  href={`/partners/#${item.slug}`}
                  tabindex={duplicate ? -1 : undefined}
                  data-marquee-item={duplicate ? undefined : ''}
                  data-partner-logo={item.slug}
                  data-morph-source={`partner-${item.slug}-${duplicate ? 'duplicate' : 'primary'}`}
                  data-morph-name={`partner-logo-${item.slug}`}
                  data-morph-pair={`partner-${item.slug}-${duplicate ? 'duplicate' : 'primary'}`}
                  data-morph-one-way
                  aria-label={duplicate ? undefined : item.role ? `${item.name}: ${item.role}` : item.name}
                >
                  <span class="marquee-logo-frame" style={`--logo-mask: url("${item.logo.src}"); --logo-ratio: ${item.logo.width / item.logo.height}`}>
                    <span class="marquee-logo" />
                  </span>
                  {item.role && <span class="marquee-role">{item.role}</span>}
                </a>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>
</affiliation-marquee>

<style is:global>
  .affiliations {
    border-bottom: 1px solid var(--hairline);
    padding: 26px 0 18.5px;
    overflow: hidden;
  }

  .affiliations > .eyebrow {
    color: var(--ink-5);
    font-size: 9.5px;
    padding: 0 48px 18px;
  }

  .marquee-mask {
    mask-image: linear-gradient(90deg, transparent, #000 120px, #000 calc(100% - 120px), transparent);
    overflow: hidden;
  }

  .marquee-track {
    animation: om-marquee 38s linear infinite;
    display: flex;
    width: max-content;
  }

  .marquee-mask:hover .marquee-track {
    animation-play-state: paused;
  }

  .marquee-set {
    display: flex;
  }

  .marquee-item {
    align-items: center;
    border-left: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 64px;
    justify-content: center;
    padding: 0 42px;
  }

  .marquee-logo-frame {
    align-items: center;
    display: flex;
    flex: 0 0 auto;
    height: 34px;
    justify-content: center;
    width: 154px;
  }

  .marquee-logo {
    background: var(--logo-mark);
    transition: background 0.3s ease;
    height: 100%;
    mask-image: var(--logo-mask);
    mask-mode: alpha;
    mask-position: center;
    mask-repeat: no-repeat;
    mask-size: contain;
    width: clamp(58px, calc(var(--logo-ratio) * 34px), 154px);
  }

  .marquee-role {
    color: var(--text-4);
    font: 9px/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.3s ease;
    white-space: nowrap;
  }

  .marquee-item:hover .marquee-role {
    color: var(--accent-ink);
  }

  .marquee-item:hover .marquee-logo {
    background: var(--accent);
  }

  @keyframes om-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 950px) {
    .affiliations > .eyebrow {
      padding-inline: 24px;
    }
  }

  @media (max-width: 950px) {
    .marquee-mask {
      mask-image: linear-gradient(90deg, transparent, #000 40px, #000 calc(100% - 40px), transparent);
    }
  }

  @media (max-width: 950px) {
    .marquee-item {
      padding-inline: 28px;
    }
  }

  @media (max-width: 950px) and (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      transform: none;
    }
  }
</style>

<style>
  affiliation-marquee {
    display: contents;
  }
</style>

<script>
  import { bindMorphPairs } from '../shared/MorphPairs';

  class AffiliationMarquee extends HTMLElement {
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      bindMorphPairs(this, this.controller.signal);
    }

    disconnectedCallback() {
      this.controller.abort();
    }
  }

  if (!customElements.get('affiliation-marquee')) {
    customElements.define('affiliation-marquee', AffiliationMarquee);
  }
</script>
