---
import type { PolicyRecordProduct } from './PolicyRecordData';

interface Props {
  products: PolicyRecordProduct[];
}

const { products } = Astro.props;

const yearOf = (date?: string) => {
  const match = date?.match(/\d{4}/);
  return match ? match[0] : 'n.d.';
};

const years = ['2020', '2021', '2022', '2023', '2024', '2025', '2026', 'n.d.'];
const instruments = [...new Set(products.map((product) => product.instrument))];

// cell key -> nodes; rows are instruments, columns are years.
const cells = new Map<string, { product: PolicyRecordProduct; index: number }[]>();
products.forEach((product, index) => {
  const key = `${product.instrument}::${yearOf(product.date)}`;
  cells.set(key, [...(cells.get(key) ?? []), { product, index }]);
});
let nodeOrder = 0;
---

<policy-record-strip class="stp" data-reveal>
  <header class="stp-head">
    <div>
      <p class="eyebrow">INSTRUMENT TIMELINE</p>
      <h2>The record as a grid</h2>
      <p class="stp-lede">Instruments down, years across. Hover a node to find its record below; click to jump to it.</p>
    </div>
    <p class="record-count"><strong>{products.length}</strong> records</p>
  </header>

  <div class="stp-scroll">
    <div class="stp-grid" style={`grid-template-columns: minmax(150px, 200px) repeat(${years.length}, minmax(56px, 1fr));`}>
      <span class="stp-corner" aria-hidden="true"></span>
      {years.map((year) => <span class="stp-year">{year}</span>)}
      {
        instruments.map((instrument) => (
          <>
            <span class="stp-instrument">{instrument}</span>
            {years.map((year) => {
              const nodes = cells.get(`${instrument}::${year}`) ?? [];
              return (
                <span class="stp-cell">
                  {nodes.map(({ product, index }) => (
                    <button
                      type="button"
                      class="stp-node"
                      data-index={index}
                      data-track={product.track}
                      data-order={nodeOrder++}
                      aria-label={`${product.title}, ${product.instrument}, ${year}`}
                    />
                  ))}
                </span>
              );
            })}
          </>
        ))
      }
    </div>
  </div>

  <div class="stp-list">
    {
      products.map((product, index) => (
        <article class="stp-row" data-index={index} tabindex="0">
          <span class="stp-swatch" data-track={product.track} aria-hidden="true" />
          <span class="stp-row-title">{product.title}</span>
          <span class="instrument-tag">{product.instrument}</span>
          <time>{product.date ?? 'n.d.'}</time>
          <a href={product.href} target="_blank" rel="noopener noreferrer">
            Read ↗
          </a>
        </article>
      ))
    }
  </div>
</policy-record-strip>

<script>
  class PolicyRecordStrip extends HTMLElement {
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      const nodes = Array.from(this.querySelectorAll<HTMLButtonElement>('.stp-node'));
      const rows = Array.from(this.querySelectorAll<HTMLElement>('.stp-row'));

      const link = (index: number, on: boolean) => {
        nodes.forEach((node) => node.classList.toggle('is-active', on && Number(node.dataset.index) === index));
        rows.forEach((row) => row.classList.toggle('is-active', on && Number(row.dataset.index) === index));
      };

      nodes.forEach((node) => {
        const index = Number(node.dataset.index);
        node.addEventListener('pointerenter', () => link(index, true), { signal: this.controller.signal });
        node.addEventListener('pointerleave', () => link(index, false), { signal: this.controller.signal });
        node.addEventListener('focus', () => link(index, true), { signal: this.controller.signal });
        node.addEventListener('blur', () => link(index, false), { signal: this.controller.signal });
        node.addEventListener(
          'click',
          () => {
            const row = rows.find((candidate) => Number(candidate.dataset.index) === index);
            row?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            link(index, true);
          },
          { signal: this.controller.signal },
        );
      });

      rows.forEach((row) => {
        const index = Number(row.dataset.index);
        row.addEventListener('pointerenter', () => link(index, true), { signal: this.controller.signal });
        row.addEventListener('pointerleave', () => link(index, false), { signal: this.controller.signal });
      });

      this.staggerIn(nodes);
    }

    disconnectedCallback() {
      this.controller.abort();
    }

    private staggerIn(nodes: HTMLElement[]) {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        nodes.forEach((node) => node.classList.add('is-in'));
        return;
      }
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const node = entry.target as HTMLElement;
            const order = Number(node.dataset.order ?? '0');
            node.style.transitionDelay = `${Math.min(order * 22, 700)}ms`;
            node.classList.add('is-in');
            observer.unobserve(node);
          });
        },
        { threshold: 0.2 },
      );
      nodes.forEach((node) => observer.observe(node));
      this.controller.signal.addEventListener('abort', () => observer.disconnect());
    }
  }

  if (!customElements.get('policy-record-strip')) {
    customElements.define('policy-record-strip', PolicyRecordStrip);
  }
</script>

<style>
  .stp {
    --track-eu-ai-act: #5ee6a0;
    --track-eu-digital-acts: #6cb6ff;
    --track-uk: #f2c14e;
    --track-global: #c79bf2;
    --track-sustainability: #57d6c4;
    border-block: 1px solid var(--hairline);
    display: block;
    padding: 72px 48px 88px;
  }

  .stp-head {
    align-items: end;
    display: flex;
    gap: 24px;
    justify-content: space-between;
  }

  h2 {
    font: 300 clamp(34px, 4.2vw, 54px) / 1.02 var(--font-display);
    margin: 16px 0 0;
  }

  .stp-lede {
    color: var(--text-3);
    margin: 12px 0 0;
    max-width: 48ch;
  }

  .record-count {
    color: var(--text-4);
    flex: none;
    font: var(--mono-10) / 1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .record-count strong {
    color: var(--accent);
    font-size: 22px;
    font-weight: 400;
    margin-right: 7px;
  }

  .stp-scroll {
    margin: 40px 0 8px;
    overflow-x: auto;
  }

  .stp-grid {
    display: grid;
    gap: 1px;
    min-width: 640px;
  }

  .stp-corner {
    border-bottom: 1px solid var(--hairline);
  }

  .stp-year {
    border-bottom: 1px solid var(--hairline);
    color: var(--text-4);
    font: var(--mono-9) / 1 var(--font-mono);
    letter-spacing: 0.08em;
    padding: 0 0 10px;
    text-align: center;
  }

  .stp-instrument {
    align-items: center;
    color: var(--text-3);
    display: flex;
    font: var(--mono-9) / 1.3 var(--font-mono);
    letter-spacing: 0.07em;
    padding: 8px 12px 8px 0;
    text-transform: uppercase;
  }

  .stp-cell {
    align-items: center;
    border-left: 1px solid var(--hairline);
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    justify-content: center;
    min-height: 34px;
    padding: 6px 2px;
  }

  .stp-node {
    background: var(--track-color, var(--accent));
    border: 0;
    cursor: pointer;
    height: 12px;
    opacity: 0;
    padding: 0;
    transform: scale(0.3);
    transition:
      opacity 320ms ease,
      transform 320ms ease,
      box-shadow 160ms ease;
    width: 12px;
  }

  .stp-node.is-in {
    opacity: 0.72;
    transform: scale(1);
  }

  .stp-node[data-track='eu-ai-act'] {
    --track-color: var(--track-eu-ai-act);
  }
  .stp-node[data-track='eu-digital-acts'] {
    --track-color: var(--track-eu-digital-acts);
  }
  .stp-node[data-track='uk'] {
    --track-color: var(--track-uk);
  }
  .stp-node[data-track='global'] {
    --track-color: var(--track-global);
  }
  .stp-node[data-track='sustainability'] {
    --track-color: var(--track-sustainability);
  }

  .stp-node:hover,
  .stp-node.is-active {
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.16);
    opacity: 1;
  }

  .stp-list {
    border-top: 1px solid var(--hairline);
    margin-top: 24px;
  }

  .stp-row {
    align-items: center;
    border-bottom: 1px solid var(--hairline);
    display: grid;
    gap: 16px;
    grid-template-columns: 12px minmax(240px, 1.8fr) minmax(120px, 0.7fr) 90px 72px;
    padding: 14px 8px;
    transition: background 200ms ease;
  }

  .stp-row.is-active {
    background: var(--accent-wash-09);
  }

  .stp-swatch {
    background: var(--track-color, var(--accent));
    height: 12px;
    width: 12px;
  }

  .stp-swatch[data-track='eu-ai-act'] {
    --track-color: var(--track-eu-ai-act);
  }
  .stp-swatch[data-track='eu-digital-acts'] {
    --track-color: var(--track-eu-digital-acts);
  }
  .stp-swatch[data-track='uk'] {
    --track-color: var(--track-uk);
  }
  .stp-swatch[data-track='global'] {
    --track-color: var(--track-global);
  }
  .stp-swatch[data-track='sustainability'] {
    --track-color: var(--track-sustainability);
  }

  .stp-row-title {
    color: var(--text-1);
    font: 400 15px/1.35 var(--font-body);
  }

  .instrument-tag,
  time {
    color: var(--text-4);
    font: var(--mono-9) / 1.3 var(--font-mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .instrument-tag {
    color: var(--text-3);
  }

  .stp-row a {
    color: var(--accent);
    font: var(--mono-9) / 1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .stp-node,
    .stp-row {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .stp {
      padding: 56px 22px 64px;
    }

    .stp-row {
      grid-template-columns: 12px 1fr auto;
      row-gap: 8px;
    }

    .stp-row-title {
      grid-column: 2 / -1;
    }

    .stp-row time {
      grid-column: 2;
    }

    .stp-row a {
      grid-column: 3;
      grid-row: 1;
    }

    .instrument-tag {
      grid-column: 2;
    }
  }
</style>
