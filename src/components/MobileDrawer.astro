---
import { menus } from '../data/navigation';
---

<mobile-drawer>
  <div
    class="mobile-drawer"
    id="mobile-menu"
    data-surface="dark"
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
    aria-hidden="true"
    data-mobile-menu
  >
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {
        Object.entries(menus).map(([id, menu], menuIndex) => (
          <section class="mobile-menu-section" style={`--menu-index:${menuIndex}`}>
            <button type="button" aria-expanded="false" aria-controls={`mobile-submenu-${id}`} data-mobile-accordion>
              <span>{String(menuIndex + 1).padStart(2, '0')}</span>
              <strong>{menu.label}</strong>
              <i aria-hidden="true">+</i>
            </button>
            <div class="mobile-submenu" id={`mobile-submenu-${id}`} hidden>
              {menu.columns ? (
                menu.columns.map((column) => (
                  <div class="mobile-link-group">
                    <p>{column.heading}</p>
                    {column.items.map((item) => (
                      <a href={item.href}>
                        <strong>{item.title}</strong>
                        <span>{item.description}</span>
                      </a>
                    ))}
                  </div>
                ))
              ) : menu.groups ? (
                menu.groups.map((group) => (
                  <div class="mobile-link-group">
                    <p>{group.title}</p>
                    {group.items.map((item) => (
                      <a href={item.href}>
                        <strong>{item.label}</strong>
                        <span>{item.description}</span>
                      </a>
                    ))}
                  </div>
                ))
              ) : (
                <div class="mobile-link-group">
                  {menu.items!.map((item) => (
                    <a href={item.href}>
                      <strong>{item.title}</strong>
                      {item.description && <span>{item.description}</span>}
                    </a>
                  ))}
                  {menu.footerLinks?.map((item) => (
                    <a href={item.href}>
                      <strong>{item.label}</strong>
                    </a>
                  ))}
                </div>
              )}
            </div>
          </section>
        ))
      }
      <button class="theme-toggle mobile-theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Light mode">
        <span aria-hidden="true">LIGHT MODE</span>
      </button>
    </nav>
  </div>
</mobile-drawer>

<script>
  class MobileDrawerElement extends HTMLElement {
    private controller = new AbortController();
    private openButton?: HTMLButtonElement;
    private lastFocus: HTMLElement | null = null;
    private lockedScroll = 0;

    connectedCallback() {
      this.controller = new AbortController();
      const drawer = this.querySelector<HTMLElement>('[data-mobile-menu]');
      if (!drawer) return;

      const signal = this.controller.signal;
      drawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => this.closeMenu(), { signal });
      });
      drawer.querySelectorAll<HTMLButtonElement>('[data-mobile-accordion]').forEach((button) => {
        button.addEventListener(
          'click',
          () => {
            const expanded = button.getAttribute('aria-expanded') === 'true';
            const controls = button.getAttribute('aria-controls');
            const submenu = controls ? drawer.querySelector<HTMLElement>(`#${controls}`) : null;
            button.setAttribute('aria-expanded', String(!expanded));
            if (submenu) submenu.hidden = expanded;
          },
          { signal },
        );
      });
      document.addEventListener(
        'keydown',
        (event) => {
          if (drawer.getAttribute('aria-hidden') === 'true') return;
          if (event.key === 'Escape') {
            event.preventDefault();
            this.closeMenu();
            return;
          }
          if (event.key !== 'Tab') return;
          // The toggle now lives in the persisted header rather than the drawer,
          // so the trap has to name it explicitly or the control that closes the
          // dialog would be the one thing Tab could never reach.
          const items = [
            ...(this.openButton ? [this.openButton as HTMLElement] : []),
            ...Array.from(drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')),
          ].filter((element) => !element.closest('[hidden]'));
          const first = items[0];
          const last = items[items.length - 1];
          if (!first || !last) return;
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        },
        { signal },
      );
      // The negation of the CSS boundary, not `min-width: 1041px`. Two numbers
      // have to be kept in step by hand, and they do not quite meet: at a
      // fractional width like 1040.5 — browser zoom, fractional DPI — neither
      // `max-width: 1040px` nor `min-width: 1041px` matches, so the CSS shows the
      // desktop header while this listener still believes it is mobile and never
      // closes the drawer. `not all and` is the exact complement and cannot drift.
      // Nav collapse is written in five places that must agree; the others are
      // the `@media` block below, two in SiteHeader.astro and one in MegaMenu.astro.
      matchMedia('not all and (max-width: 1040px)').addEventListener(
        'change',
        (event) => {
          if (event.matches) this.closeMenu();
        },
        { signal },
      );
    }

    disconnectedCallback() {
      this.controller.abort();
    }

    openMenu(openButton: HTMLButtonElement) {
      const drawer = this.querySelector<HTMLElement>('[data-mobile-menu]');
      if (!drawer) return;
      this.openButton = openButton;
      this.lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      this.lockedScroll = scrollY;
      document.body.style.top = `-${this.lockedScroll}px`;
      document.body.classList.add('mobile-nav-open');
      drawer.setAttribute('aria-hidden', 'false');
      openButton.setAttribute('aria-expanded', 'true');
      // Focus stays on the toggle, which is now the control that closes the
      // drawer and sits above it in the pinned header. Moving focus inside would
      // not take anyway: the panel is still `visibility: hidden` this frame.
    }

    closeMenu() {
      const drawer = this.querySelector<HTMLElement>('[data-mobile-menu]');
      if (!drawer || drawer.getAttribute('aria-hidden') === 'true') return;
      drawer.setAttribute('aria-hidden', 'true');
      this.openButton?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('mobile-nav-open');
      document.body.style.top = '';
      scrollTo(0, this.lockedScroll);
      this.lastFocus?.focus();
    }
  }

  if (!customElements.get('mobile-drawer')) customElements.define('mobile-drawer', MobileDrawerElement);
</script>

<style>
  mobile-drawer {
    display: contents;
  }

  .mobile-drawer {
    display: none;
  }

  @keyframes menu-row {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Nav collapse; see the note in SiteHeader.astro. This block and the `matchMedia`
     above are the same boundary from two sides — the listener negates this query. */
  @media (max-width: 1040px) {
    /* The panel is a plate, not a fade. It used to cross-fade its whole self in
       over the live page, and because both layers are full-screen the page read
       straight through the menu for the length of the transition: a 250ms double
       exposure that looked like a rendering fault rather than a menu arriving.
       The backdrop is therefore opaque from the first frame — `visibility` shows
       instantly on open and holds until the end on close, which is how the
       property interpolates — and the entrance moved inside, onto the content. */
    .mobile-drawer {
      background: var(--bg-panel);
      display: block;
      height: 100dvh;
      inset: 0;
      min-height: 100vh;
      overflow-y: auto;
      overscroll-behavior: contain;
      pointer-events: none;
      position: fixed;
      visibility: hidden;
      z-index: 80;
    }

    .mobile-drawer[aria-hidden='false'] {
      pointer-events: auto;
      visibility: visible;
    }

    /* The group carries the 12px settle and the fade the panel used to carry, so the
       menu still arrives as one movement and the rows keep their own stagger inside
       it. Animating the content rather than the panel also means the plate never
       leaves a strip of page uncovered along its bottom edge.

       Both the transition and the row stagger are declared on the open state only,
       so they run on the way in and not on the way out. Dismissal is deliberately a
       cut: the header carries the control that closes the drawer and is only lifted
       above it (z-index 90) while `body.mobile-nav-open` is set, so any held-open
       plate after that class is removed would cover the header — and its resting
       z-index of 60 sits under the panel's 80. Fading the content out over a held
       plate hid the toggle the user had just pressed for the length of the fade. */
    .mobile-nav {
      opacity: 0;
      transform: translateY(-12px);
    }

    .mobile-drawer[aria-hidden='false'] .mobile-nav {
      opacity: 1;
      transform: none;
      transition:
        opacity var(--duration-3) var(--ease-panel),
        transform var(--duration-3) var(--ease-panel);
    }

    .mobile-nav {
      margin: 0 auto;
      max-width: 760px;
      padding: calc(68px + 24px) 20px 48px;
    }

    .mobile-menu-section {
      border-top: 1px solid var(--hairline);
      padding: 0;
    }

    .mobile-menu-section:last-child {
      border-bottom: 1px solid var(--hairline);
    }

    .mobile-menu-section > button {
      align-items: center;
      background: transparent;
      border: 0;
      color: var(--text-1);
      cursor: pointer;
      display: grid;
      grid-template-columns: 38px 1fr 28px;
      min-height: 60px;
      padding: 8px 4px;
      text-align: left;
      width: 100%;
    }

    .mobile-menu-section > button span {
      color: var(--text-4);
      font: var(--mono-9)/1 var(--font-mono);
      letter-spacing: 0.12em;
    }

    .mobile-menu-section > button strong {
      font: 300 25px/1.1 var(--font-display);
    }

    .mobile-menu-section > button i {
      color: var(--accent-ink);
      font: normal 22px/1 var(--font-body);
      text-align: center;
      transition: transform var(--duration-3) var(--ease-panel);
    }

    .mobile-menu-section > button[aria-expanded='true'] i {
      transform: rotate(45deg);
    }

    .mobile-submenu {
      padding: 0 0 18px 38px;
    }

    .mobile-link-group + .mobile-link-group {
      margin-top: 18px;
    }

    .mobile-link-group > p {
      color: var(--accent-ink);
      font: var(--mono-9)/1 var(--font-mono);
      letter-spacing: 0.14em;
      margin: 8px 0 6px;
      text-transform: uppercase;
    }

    .mobile-link-group a {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 48px;
      padding: 7px 8px;
    }

    .mobile-link-group a strong {
      font-size: 14px;
      font-weight: 400;
    }

    .mobile-link-group a span {
      color: var(--text-3);
      font-size: 12px;
      line-height: 1.4;
      margin-top: 2px;
    }

    .mobile-drawer[aria-hidden='false'] .mobile-menu-section {
      animation: menu-row var(--duration-34) var(--ease-panel) both;
      animation-delay: calc(var(--menu-index) * 35ms);
    }
  }

  @media (max-width: 420px) {
    .mobile-nav {
      padding-inline: 14px;
    }
  }

  /* Accent text and strokes take --accent-ink, never --accent: the bright mint is
     1.41:1 on paper. The control reads its pressed state from the live data-theme
     attribute (see shared/Theme.ts), so the pill can never show the wrong theme.
     The desktop twin lives in SiteHeader; below the drawer breakpoint the header
     row has no space for it, so this one takes a full 44px target instead. */
  .theme-toggle {
    align-items: center;
    background: none;
    border: 1px solid var(--hairline);
    border-radius: 4px;
    color: var(--text-2);
    cursor: pointer;
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 10px;
    justify-content: center;
    letter-spacing: 0.08em;
    padding: 5px 8px;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .theme-toggle:hover,
  .theme-toggle[aria-pressed='true'] {
    border-color: var(--accent-edge);
    color: var(--accent-ink);
  }

  /* Under reduce the drawer arrives with no entrance at all: the plate was already
     instant, and the content skips both the group settle and the row stagger rather
     than playing them faster. */
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }

    .mobile-nav {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .mobile-drawer[aria-hidden='false'] .mobile-nav {
      transition: none;
    }

    .mobile-drawer[aria-hidden='false'] .mobile-menu-section {
      animation: none;
    }
  }

  .mobile-theme-toggle {
    border-radius: var(--radius-pill);
    letter-spacing: 0.14em;
    margin-top: 22px;
    min-height: 44px;
    min-width: 44px;
    padding: 0 16px;
    width: 100%;
  }
</style>
