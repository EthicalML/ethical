---
import PhaseCardGrid from './PhaseCardGrid.astro';
import ComparisonTable from './ComparisonTable.astro';
import CapabilityTable from './prose/CapabilityTable.astro';
const { maturity, phaseEyebrow, phaseHeading, checklistEyebrow, checklistHeading, capabilityEyebrow, capabilityHeading } = Astro.props;
---

<PhaseCardGrid cards={maturity.phases} eyebrow={phaseEyebrow} heading={phaseHeading} />
<section data-reveal>
  <p class="eyebrow">{checklistEyebrow}</p>
  <h2>{checklistHeading}</h2>
  <ComparisonTable rows={maturity.checklist} columns={maturity.checklistColumns} />
</section>
<section data-reveal>
  <p class="eyebrow">{capabilityEyebrow}</p>
  <h2>{capabilityHeading}</h2>
  <CapabilityTable items={maturity.capabilities} />
</section>
