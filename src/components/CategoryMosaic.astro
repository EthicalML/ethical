---
// The catalogue mosaic the header's nav preview draws, as a standalone mount. `set` names the
// tile set: the production-ML ecosystem, the AI regulation catalogue or the production agentic
// systems catalogue, which paints its tiles in the violet tint.
interface Props {
  set?: 'production-ml' | 'ai-guidelines' | 'agentic-systems';
  surface?: 'dark' | 'page';
}

const { set = 'production-ml', surface } = Astro.props;
---

<category-mosaic data-set={set} data-surface={surface} aria-hidden="true">
  <canvas></canvas>
</category-mosaic>

<script>
  import '../shared/canvas/CategoryMosaic';
</script>

<style>
  category-mosaic,
  canvas {
    display: block;
    height: 100%;
    width: 100%;
  }
</style>
