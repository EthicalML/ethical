---
import { getRecentIssueNumbers } from '../utils/RecentIssues';
import type { FormSectionCopy, FormSectionSector, FormSectionStat } from '../data/contactForm';

interface Props {
  variant: string;
  title: string;
  copy: FormSectionCopy;
  sectors?: FormSectionSector[];
  stats?: FormSectionStat[];
  eyebrow?: string;
  submissionVariant?: string;
  homepage?: boolean;
}

const { variant, title, copy, sectors = [], stats = [], eyebrow = copy.homeEyebrow, submissionVariant = variant, homepage = false } = Astro.props;

const isSupportedVariant = variant === 'network-split' || variant === 'contact-full';
const sectionClasses = ['join-section', variant === 'contact-full' && 'contact-full', homepage && 'home-section'];
const issues = await getRecentIssueNumbers();
const minimumSubmissionMs = 3000;
const settleMs = 2500;
---

{
  isSupportedVariant && (
    <section id="join" class:list={sectionClasses} aria-labelledby="network-heading" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <div class="network-split">
        <div>
          <h2 id="network-heading">{title}</h2>
          <p>{copy.intro}</p>
          <div class="network-stats">
            {stats.map((stat) => (
              <div>
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </div>
            ))}
          </div>
          <div class="network-lists">
            <div>
              <p class="eyebrow">{copy.sectorEyebrow}</p>
              {sectors.map(({ name, value }) => (
                <span>
                  <i>{name}</i>
                  <b>{value}</b>
                </span>
              ))}
            </div>
            <div>
              <p class="eyebrow">{copy.issuesEyebrow}</p>
              {issues.map((number) => (
                <a href={`/newsletter/${number}/`}>
                  <b>#{number}</b>
                </a>
              ))}
            </div>
          </div>
        </div>
        <institute-form>
          <form
            id="contact"
            data-institute-form
            data-variant={submissionVariant}
            data-settle-ms={settleMs}
            data-minimum-submission-ms={minimumSubmissionMs}
            data-sending={copy.form.sending}
            style={`--settle: ${settleMs}ms`}
            data-confirmation={copy.form.confirmation}
            data-demo-confirmation={copy.form.demoConfirmation}
            data-error={copy.form.error}
          >
            <header>
              <h3>{copy.form.title}</h3>
            </header>
            <div class="form-fields">
              {copy.form.fields.map((field) => (
                <label class:list={[field.wide && 'wide']}>
                  {field.label}{' '}
                  <input
                    name={field.name}
                    type={field.type as 'text' | 'email'}
                    autocomplete={field.autocomplete}
                    placeholder={field.placeholder}
                    required={field.name === 'name' || field.name === 'email'}
                    aria-describedby={`field-note-${field.name}`}
                  />
                  <small class="field-note" id={`field-note-${field.name}`} data-field-note hidden />
                </label>
              ))}
            </div>
            <fieldset>
              {copy.form.interests.map((interest) => (
                <label data-interest-row={interest.value}>
                  <input
                    type="checkbox"
                    name="interests"
                    value={interest.value}
                    checked={interest.checked}
                    data-interest
                    data-application-interest={interest.value === 'network' ? '' : undefined}
                  />{' '}
                  {interest.label}
                </label>
              ))}
            </fieldset>
            <small class="application-helper" data-application-helper hidden>
              Please provide enough information to consider your application.
            </small>
            <label class="form-honeypot" aria-hidden="true">
              Website <input name="website" type="text" autocomplete="off" tabindex="-1" />
            </label>
            <input name="startedAt" type="hidden" value="" />
            <button type="submit">
              <span data-button-label>{copy.form.button}</span>
              <svg class="button-trace" viewBox="0 0 100 44" preserveAspectRatio="none" aria-hidden="true" data-button-trace>
                <rect x="0.5" y="0.5" width="99" height="43" rx="3" pathLength="100" vector-effect="non-scaling-stroke" />
              </svg>
            </button>
            <i class="send-conduit" aria-hidden="true" />
            <div class="send-overlay" data-send-overlay aria-hidden="true">
              <form-send-iso data-send-iso>
                <canvas />
              </form-send-iso>
            </div>
            <pre class="send-terminal" data-send-terminal aria-hidden="true" hidden />
            <small>{copy.form.disclaimer}</small>
            <p class="form-confirmation" data-form-confirmation role="status" hidden>
              <svg
                class="sent-check"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="4,13 9,18 20,6" pathLength="100" />
              </svg>
              <span data-confirmation-text />
            </p>
          </form>
        </institute-form>
      </div>
    </section>
  )
}

<script>
  import '../shared/canvas/FormSendIso';

  class InstituteForm extends HTMLElement {
    private controller = new AbortController();
    private preselectionTimer?: number;
    private startedAt = Date.now();

    connectedCallback() {
      this.controller = new AbortController();
      this.startedAt = Date.now();

      const form = this.querySelector<HTMLFormElement>('[data-institute-form]');
      const startedAtInput = form?.querySelector<HTMLInputElement>('[name="startedAt"]');
      const message = form?.querySelector<HTMLElement>('[data-form-confirmation]');
      const button = form?.querySelector<HTMLButtonElement>('[type="submit"]');
      const applicationInterest = form?.querySelector<HTMLInputElement>('[data-application-interest]');
      const applicationHelper = form?.querySelector<HTMLElement>('[data-application-helper]');
      if (!form || !startedAtInput || !message || !button) return;

      startedAtInput.value = String(this.startedAt);
      // Set at mount, not at submit: while the form is natively validated the
      // browser blocks the submit event outright, so the custom path would
      // never get to run. A visitor without JS keeps the native behaviour.
      form.noValidate = true;
      // A field that has been corrected drops its note immediately, so the
      // message never outlives the problem it describes.
      form.addEventListener(
        'input',
        (event) => {
          const input = event.target as HTMLInputElement;
          const note = input.parentElement?.querySelector<HTMLElement>('[data-field-note]');
          if (!note || note.hidden || !input.checkValidity()) return;
          note.hidden = true;
          note.textContent = '';
          input.setAttribute('aria-invalid', 'false');
        },
        { signal: this.controller.signal },
      );
      if (applicationInterest && applicationHelper) {
        const updateApplicationHelper = () => {
          applicationHelper.hidden = !applicationInterest.checked;
        };
        applicationInterest.addEventListener('change', updateApplicationHelper, {
          signal: this.controller.signal,
        });
        updateApplicationHelper();
      }

      const requestedInterest = new URLSearchParams(location.search).get('interest');
      const interestInput = Array.from(form.querySelectorAll<HTMLInputElement>('[data-interest]')).find((input) => input.value === requestedInterest);
      if (interestInput) {
        const row = interestInput.closest<HTMLElement>('[data-interest-row]');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          interestInput.checked = true;
          interestInput.dispatchEvent(new Event('change', { bubbles: true }));
        } else if (row) {
          interestInput.checked = false;
          this.preselectionTimer = window.setTimeout(() => {
            row.classList.add('interest-selecting');
            interestInput.checked = true;
            interestInput.dispatchEvent(new Event('change', { bubbles: true }));
          }, 500);
        }
      }

      form.addEventListener(
        'submit',
        (event) => {
          void this.submit(event, form, message, button);
        },
        { signal: this.controller.signal },
      );
    }

    disconnectedCallback() {
      this.controller.abort();
      if (this.preselectionTimer !== undefined) window.clearTimeout(this.preselectionTimer);
    }

    /* The browser's own validation bubble is OS chrome: it cannot be styled, it
       sits outside the page's type and colour, and it vanishes on the next
       click. Validation is reported inline under the offending field instead.
       noValidate is set from script so a no-JS visitor keeps the native path. */
    private validate(form: HTMLFormElement) {
      const inputs = Array.from(form.querySelectorAll<HTMLInputElement>('.form-fields input'));
      let firstInvalid: HTMLInputElement | undefined;
      inputs.forEach((input) => {
        const note = input.parentElement?.querySelector<HTMLElement>('[data-field-note]');
        const valid = input.checkValidity();
        input.setAttribute('aria-invalid', String(!valid));
        if (note) {
          note.textContent = valid ? '' : input.validationMessage;
          note.hidden = valid;
        }
        if (!valid && !firstInvalid) firstInvalid = input;
      });
      firstInvalid?.focus();
      return !firstInvalid;
    }

    private async submit(event: SubmitEvent, form: HTMLFormElement, message: HTMLElement, button: HTMLButtonElement) {
      event.preventDefault();
      if (!this.validate(form)) return;

      const data = new FormData(form);
      // __FORM_TOKEN__ is replaced at build with the base64 receiver URL, so it
      // lives in this bundle and never in the rendered HTML.
      const endpoint = __FORM_TOKEN__ ? atob(__FORM_TOKEN__) : '';
      const clientKey = localStorage.getItem('ethical-form-client') || crypto.randomUUID();
      localStorage.setItem('ethical-form-client', clientKey);
      const payload = {
        name: data.get('name'),
        email: data.get('email'),
        organisation: data.get('organisation'),
        role: data.get('role'),
        furtherInformation: data.get('furtherInformation'),
        interests: data.getAll('interests'),
        website: data.get('website'),
        startedAt: Number(data.get('startedAt')),
        elapsedMs: Date.now() - this.startedAt,
        minimumSubmissionMs: Number(form.dataset.minimumSubmissionMs),
        clientKey,
        page: location.pathname,
        variant: form.dataset.variant,
      };

      // Apps Script answers through a redirect chain that routinely takes several
      // seconds, and a disabled button alone reads as nothing having happened.
      const label = form.querySelector<HTMLElement>('[data-button-label]');
      const text = form.querySelector<HTMLElement>('[data-confirmation-text]');
      const buttonLabel = label?.textContent ?? '';
      const settleMs = Number(form.dataset.settleMs) || 2500;
      button.disabled = true;
      if (label) label.textContent = form.dataset.sending || buttonLabel;
      message.hidden = true;
      form.dataset.state = 'submitting';
      // The terminal treatment narrates only what is actually true at this
      // point. The receiver's reply is unreadable under mode: no-cors, so no
      // line ever claims an acknowledgement.
      // The isometric overlay is driven, not ambient: its packet position is the
      // elapsed share of the settle window, so arrival and confirmation coincide.
      const iso = form.querySelector<HTMLElement & { progress: number; settled: boolean }>('[data-send-iso]');
      const startedSending = performance.now();
      let isoFrame = 0;
      if (iso) {
        iso.settled = false;
        const advance = () => {
          iso.progress = Math.min(1, (performance.now() - startedSending) / settleMs);
          if (iso.progress < 1) isoFrame = requestAnimationFrame(advance);
        };
        advance();
      }

      const terminal = form.querySelector<HTMLElement>('[data-send-terminal]');
      if (terminal) {
        // left: 0 would resolve to the form's padding box, sitting 28px proud of
        // the button; both offsets come from the button so the log stays flush
        // with it whatever the padding is.
        terminal.style.top = `${button.offsetTop + button.offsetHeight + 12}px`;
        terminal.style.left = `${button.offsetLeft}px`;
        const bytes = new TextEncoder().encode(JSON.stringify(payload)).length;
        terminal.hidden = false;
        terminal.textContent = '';
        ['> encoding payload', '> opening channel', `> transmitting ${bytes} bytes`].forEach((line, index) => {
          window.setTimeout(() => (terminal.textContent += (index ? '\n' : '') + line), index * (settleMs / 4));
        });
      }

      try {
        if (endpoint) {
          // The receiver answers through a redirect chain that has taken up to
          // 15 seconds, and mode: no-cors makes its reply unreadable anyway, so
          // waiting the whole way buys no information the confirmation could
          // use. Stop waiting after a settle window instead: keepalive carries
          // the request to completion even if the visitor leaves the page, and
          // a rejection inside the window still surfaces as an error.
          const sent = fetch(endpoint, {
            method: 'POST',
            mode: 'no-cors',
            keepalive: true,
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload),
          });
          await Promise.race([sent, new Promise((resolve) => window.setTimeout(resolve, settleMs))]);
        }
        // The fields leave under their own staggered exit before the
        // confirmation takes the space, so the swap is a handover rather than a
        // cut. display: none cannot be animated, hence the interim state.
        if (iso) {
          iso.progress = 1;
          iso.settled = true;
        }
        if (terminal) terminal.hidden = true;
        form.dataset.state = 'exiting';
        await new Promise((resolve) => window.setTimeout(resolve, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 460));
        form.dataset.state = 'success';
        if (text) text.textContent = endpoint ? (form.dataset.confirmation ?? '') : (form.dataset.demoConfirmation ?? '');
        message.hidden = false;
      } catch {
        if (terminal) terminal.hidden = true;
        form.dataset.state = 'error';
        if (text) text.textContent = form.dataset.error ?? '';
        message.hidden = false;
      } finally {
        cancelAnimationFrame(isoFrame);
        button.disabled = false;
        if (label) label.textContent = buttonLabel;
      }
    }
  }

  if (!customElements.get('institute-form')) {
    customElements.define('institute-form', InstituteForm);
  }
</script>

<style>
  /* Inline validation, replacing the browser's unstylable bubble. */
  .field-note {
    display: none;
  }

  /* display: block would defeat the hidden attribute, leaving a bare marker
     under every optional field. The note also opts out of the label's uppercase
     so a sentence-length message does not shout. */
  .field-note:not([hidden]) {
    color: var(--warn);
    display: block;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.02em;
    line-height: 1.5;
    margin-top: 6px;
    text-transform: none;
  }

  .field-note:not([hidden])::before {
    content: '! ';
    opacity: 0.75;
  }

  /* The browser's default focus ring is a blue that exists nowhere else here. */
  .form-fields input:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 70%, transparent);
    outline: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    outline-offset: 1px;
  }

  .form-fields input[aria-invalid='true']:focus-visible {
    border-color: var(--warn);
    outline-color: color-mix(in srgb, var(--warn) 55%, transparent);
  }

  .form-fields input[aria-invalid='true'] {
    border-color: color-mix(in srgb, var(--warn) 62%, transparent);
  }

  .form-fields input[aria-invalid='true']:focus {
    border-color: var(--warn);
  }

  /* Submission motion: the perimeter trace, the conduit packet, the terminal
     log and the isometric overlay all run together over the settle window. The
     overlay dims the fields; the button, conduit and log stay above it. */
  form {
    position: relative;
  }

  button,
  .send-conduit {
    position: relative;
    z-index: 3;
  }

  .send-overlay {
    display: none;
    inset: 0;
    pointer-events: none;
    position: absolute;
    z-index: 2;
  }

  form[data-state='submitting'] .send-overlay,
  form[data-state='exiting'] .send-overlay {
    animation: overlay-in 300ms ease forwards;
    display: block;
  }

  .send-overlay form-send-iso,
  .send-overlay canvas {
    display: block;
    height: 100%;
    width: 100%;
  }

  @keyframes overlay-in {
    from {
      background: rgba(12, 14, 13, 0);
      opacity: 0;
    }
    to {
      background: rgba(12, 14, 13, 0.72);
      opacity: 1;
    }
  }

  form[data-state='submitting'] button:disabled {
    opacity: 1;
  }

  /* Perimeter trace: one lap of the button edge over the settle window, so the
     travel maps to real elapsed time rather than looping decoratively. */
  .button-trace {
    height: 100%;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    width: 100%;
  }

  .button-trace rect {
    fill: none;
    stroke: var(--accent);
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    stroke-width: 1.5;
  }

  form[data-state='submitting'] .button-trace {
    filter: drop-shadow(0 0 5px rgba(94, 230, 160, 0.65));
    opacity: 1;
  }

  form[data-state='submitting'] .button-trace rect {
    animation: trace-lap var(--settle) linear forwards;
  }

  @keyframes trace-lap {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Conduit: the citadel's packet-along-a-route idiom, under the button. */
  .send-conduit {
    background: rgba(94, 230, 160, 0.16);
    display: block;
    height: 1px;
    margin-top: 12px;
    opacity: 0;
    overflow: hidden;
    position: relative;
    transition: opacity 200ms ease;
  }

  form[data-state='submitting'] .send-conduit {
    opacity: 1;
  }

  .send-conduit::after {
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    box-shadow: 0 0 12px var(--accent);
    content: '';
    inset: 0 auto 0 0;
    position: absolute;
    transform: translateX(-140%);
    width: 26%;
  }

  form[data-state='submitting'] .send-conduit::after {
    animation: conduit-run 820ms linear infinite;
  }

  @keyframes conduit-run {
    to {
      transform: translateX(520%);
    }
  }

  form[data-state='success'] .form-confirmation {
    animation: conduit-bloom 700ms var(--ease-panel);
  }

  @keyframes conduit-bloom {
    from {
      opacity: 0;
      text-shadow: 0 0 26px var(--accent);
      transform: scale(0.97);
    }
  }

  /* Terminal: prints only facts available before the reply, which is unreadable. */
  .send-terminal {
    display: none;
  }

  /* Sits under the button, where it reads best, but absolutely positioned: in
     flow it grew the form line by line as it printed, and even a zero-height
     flow wrapper collected one of the form's 16px flex gaps. The form is a
     flex column, where an abspos child's static position resolves to the
     container corner rather than to the button, so submit() sets top from the
     button's measured offset. Left edge and width match the button. */
  .send-terminal:not([hidden]) {
    background: rgba(10, 12, 11, 0.66);
    border-left: 1px solid rgba(94, 230, 160, 0.45);
    color: var(--accent);
    display: block;
    font: 12px/1.75 var(--font-mono);
    left: 0;
    margin: 0;
    padding: 8px 14px;
    position: absolute;
    text-align: left;
    white-space: pre;
    width: max-content;
    z-index: 3;
  }

  .send-terminal:not([hidden])::after {
    animation: terminal-caret 900ms steps(1) infinite;
    content: '▋';
  }

  @keyframes terminal-caret {
    50% {
      opacity: 0;
    }
  }

  /* Shared exit: fields hand the space over rather than being cut. */
  form[data-state='exiting'] > *:not(.form-confirmation) {
    animation: field-exit 420ms var(--ease-panel) forwards;
  }

  form[data-state='exiting'] > *:nth-child(2) {
    animation-delay: 45ms;
  }
  form[data-state='exiting'] > *:nth-child(3) {
    animation-delay: 90ms;
  }
  form[data-state='exiting'] > *:nth-child(4) {
    animation-delay: 135ms;
  }
  form[data-state='exiting'] > *:nth-child(n + 5) {
    animation-delay: 180ms;
  }

  @keyframes field-exit {
    to {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .sent-check {
    display: none;
  }

  form[data-state='success'] .sent-check {
    color: var(--accent);
    display: block;
    height: 26px;
    margin-bottom: 12px;
    width: 26px;
  }

  form[data-state='success'] .sent-check polyline {
    animation: check-draw 460ms 90ms var(--ease-panel) forwards;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }

  @keyframes check-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  fieldset input[type='checkbox'] {
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.26);
    border-radius: 3px;
    display: grid;
    flex: none;
    padding: 0;
    place-content: center;
    transition:
      background 140ms ease,
      border-color 140ms ease;
  }

  fieldset input[type='checkbox']::before {
    border-bottom: 2px solid var(--accent-on);
    border-right: 2px solid var(--accent-on);
    content: '';
    height: 7px;
    transform: rotate(45deg) scale(0);
    transition: transform 180ms var(--ease-panel);
    width: 4px;
  }

  fieldset input[type='checkbox']:checked {
    background: var(--accent);
    border-color: var(--accent);
  }

  fieldset input[type='checkbox']:checked::before {
    transform: rotate(45deg) scale(1);
  }

  fieldset label.interest-selecting {
    animation: interest-row-select 2000ms ease-out;
    border-radius: var(--radius-control);
  }

  fieldset label.interest-selecting input:checked {
    animation: interest-checkbox-pop 300ms var(--ease-panel);
  }

  @keyframes interest-row-select {
    0% {
      background: var(--accent-wash-16);
      box-shadow: 0 0 0 7px var(--accent-wash-16);
      color: var(--accent);
    }
    100% {
      background: transparent;
      box-shadow: 0 0 0 7px transparent;
    }
  }

  @keyframes interest-checkbox-pop {
    0% {
      transform: scale(0.72);
    }
    60% {
      transform: scale(1.18);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    fieldset input[type='checkbox'],
    fieldset input[type='checkbox']::before {
      transition: none;
    }

    .button-trace rect,
    .send-conduit::after,
    .sent-check polyline,
    form[data-state='exiting'] > *:not(.form-confirmation),
    form[data-state='success'] .form-confirmation {
      animation: none;
    }

    form[data-state='submitting'] button:disabled {
      opacity: 0.6;
    }
  }
</style>

<style is:global>
  .join-section {
    padding: 88px 48px 96px;
    scroll-margin-top: 124px;
  }

  .join-section form {
    scroll-margin-top: 124px;
  }

  .join-section > .network-split {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent);
    border: 1px solid var(--hairline-card);
    border-radius: var(--radius-card-lg);
    display: grid;
    gap: 44px;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    margin-top: 22px;
    padding: 40px;
  }

  .network-split > * {
    min-width: 0;
  }

  .network-split h2 {
    font: 300 44px/1.05 var(--font-display);
    margin: 0;
  }

  .network-split h2 + p {
    color: rgba(244, 242, 238, 0.64);
    font-size: 16px;
    line-height: 1.62;
    margin: 14px 0 0;
    max-width: 560px;
  }

  .form-fields {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-width: 0;
    width: 100%;
  }

  .form-fields > * {
    min-width: 0;
  }

  .form-fields .wide {
    grid-column: 1 / -1;
  }

  .application-helper {
    color: var(--text-2);
    margin-top: -6px;
  }

  .form-confirmation {
    color: var(--text-1);
    font: 300 var(--display-26)/1.35 var(--font-display);
    margin: 0;
  }

  form[data-state='success'] > :not(.form-confirmation) {
    display: none;
  }

  form[data-state='success'] .form-confirmation {
    margin: auto 0;
  }

  form[data-state='error'] .form-confirmation {
