---
import { getRecentIssueNumbers } from '../utils/RecentIssues';
import type { FormSectionCopy, FormSectionSector, FormSectionStat } from '../data/contactForm';

interface Props {
  variant: string;
  title: string;
  copy: FormSectionCopy;
  sectors?: FormSectionSector[];
  stats?: FormSectionStat[];
  eyebrow?: string;
  submissionVariant?: string;
  homepage?: boolean;
}

const { variant, title, copy, sectors = [], stats = [], eyebrow = copy.homeEyebrow, submissionVariant = variant, homepage = false } = Astro.props;

const isSupportedVariant = variant === 'network-split' || variant === 'contact-full';
const sectionClasses = ['join-section', variant === 'contact-full' && 'contact-full', homepage && 'home-section'];
const issues = await getRecentIssueNumbers();
const minimumSubmissionMs = 3000;
const settleMs = 2500;
---

{
  isSupportedVariant && (
    <section id="join" class:list={sectionClasses} aria-labelledby="network-heading" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <div class="network-split">
        <div>
          <h2 id="network-heading">{title}</h2>
          <p>{copy.intro}</p>
          <div class="network-stats">
            {stats.map((stat) => (
              <div>
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </div>
            ))}
          </div>
          <div class="network-lists">
            <div>
              <p class="eyebrow">{copy.sectorEyebrow}</p>
              {sectors.map(({ name, value }) => (
                <span>
                  <i>{name}</i>
                  <b>{value}</b>
                </span>
              ))}
            </div>
            <div>
              <p class="eyebrow">{copy.issuesEyebrow}</p>
              {issues.map((number) => (
                <a href={`/newsletter/${number}/`}>
                  <b>#{number}</b>
                </a>
              ))}
            </div>
          </div>
        </div>
        <institute-form>
          <form
            id="contact"
            data-institute-form
            data-variant={submissionVariant}
            data-settle-ms={settleMs}
            data-minimum-submission-ms={minimumSubmissionMs}
            data-sending={copy.form.sending}
            style={`--settle: ${settleMs}ms`}
            data-confirmation={copy.form.confirmation}
            data-demo-confirmation={copy.form.demoConfirmation}
            data-error={copy.form.error}
          >
            <header>
              <h3>{copy.form.title}</h3>
            </header>
            <div class="form-fields">
              {copy.form.fields.map((field) => (
                <label class:list={[field.wide && 'wide']}>
                  {field.label}{' '}
                  <input
                    name={field.name}
                    type={field.type as 'text' | 'email'}
                    autocomplete={field.autocomplete}
                    placeholder={field.placeholder}
                    required={field.name === 'name' || field.name === 'email'}
                    aria-describedby={`field-note-${field.name}`}
                  />
                  <small class="field-note" id={`field-note-${field.name}`} data-field-note hidden />
                </label>
              ))}
            </div>
            <fieldset>
              {copy.form.interests.map((interest) => (
                <label data-interest-row={interest.value}>
                  <input
                    type="checkbox"
                    name="interests"
                    value={interest.value}
                    checked={interest.checked}
                    data-interest
                    data-application-interest={interest.value === 'network' ? '' : undefined}
                  />{' '}
                  {interest.label}
                </label>
              ))}
            </fieldset>
            <small class="application-helper" data-application-helper hidden>
              Please provide enough information to consider your application.
            </small>
            <label class="form-honeypot" aria-hidden="true">
              Website <input name="website" type="text" autocomplete="off" tabindex="-1" />
            </label>
            <input name="startedAt" type="hidden" value="" />
            <button type="submit">
              <span data-button-label>{copy.form.button}</span>
              <svg class="button-trace" viewBox="0 0 100 44" preserveAspectRatio="none" aria-hidden="true" data-button-trace>
                <rect x="0.5" y="0.5" width="99" height="43" rx="3" pathLength="100" vector-effect="non-scaling-stroke" />
              </svg>
            </button>
            <i class="send-conduit" aria-hidden="true" />
            <div class="send-overlay" data-send-overlay aria-hidden="true">
              <form-send-iso data-send-iso data-surface="page">
                <canvas />
              </form-send-iso>
            </div>
            <pre class="send-terminal" data-send-terminal aria-hidden="true" hidden />
            <small>{copy.form.disclaimer}</small>
            <p class="form-confirmation" data-form-confirmation role="status" hidden>
              <svg
                class="sent-check"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="4,13 9,18 20,6" pathLength="100" />
              </svg>
              <span data-confirmation-text />
            </p>
          </form>
        </institute-form>
      </div>
    </section>
  )
}

<script>
  import '../shared/canvas/FormSendIso';

  class InstituteForm extends HTMLElement {
    private controller = new AbortController();
    private preselectionTimer?: number;
    private startedAt = Date.now();

    connectedCallback() {
      this.controller = new AbortController();
      this.startedAt = Date.now();

      const form = this.querySelector<HTMLFormElement>('[data-institute-form]');
      const startedAtInput = form?.querySelector<HTMLInputElement>('[name="startedAt"]');
      const message = form?.querySelector<HTMLElement>('[data-form-confirmation]');
      const button = form?.querySelector<HTMLButtonElement>('[type="submit"]');
      const applicationInterest = form?.querySelector<HTMLInputElement>('[data-application-interest]');
      const applicationHelper = form?.querySelector<HTMLElement>('[data-application-helper]');
      if (!form || !startedAtInput || !message || !button) return;

      startedAtInput.value = String(this.startedAt);
      // Set at mount, not at submit: while the form is natively validated the
      // browser blocks the submit event outright, so the custom path would
      // never get to run. A visitor without JS keeps the native behaviour.
      form.noValidate = true;
      // A field that has been corrected drops its note immediately, so the
      // message never outlives the problem it describes.
      form.addEventListener(
        'input',
        (event) => {
          const input = event.target as HTMLInputElement;
          const note = input.parentElement?.querySelector<HTMLElement>('[data-field-note]');
          if (!note || note.hidden || !input.checkValidity()) return;
          note.hidden = true;
          note.textContent = '';
          input.setAttribute('aria-invalid', 'false');
        },
        { signal: this.controller.signal },
      );
      if (applicationInterest && applicationHelper) {
        const updateApplicationHelper = () => {
          applicationHelper.hidden = !applicationInterest.checked;
        };
        applicationInterest.addEventListener('change', updateApplicationHelper, {
          signal: this.controller.signal,
        });
        updateApplicationHelper();
      }

      const requestedInterest = new URLSearchParams(location.search).get('interest');
      const interestInput = Array.from(form.querySelectorAll<HTMLInputElement>('[data-interest]')).find((input) => input.value === requestedInterest);
      if (interestInput) {
        const row = interestInput.closest<HTMLElement>('[data-interest-row]');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          interestInput.checked = true;
          interestInput.dispatchEvent(new Event('change', { bubbles: true }));
        } else if (row) {
          interestInput.checked = false;
          this.preselectionTimer = window.setTimeout(() => {
            row.classList.add('interest-selecting');
            interestInput.checked = true;
            interestInput.dispatchEvent(new Event('change', { bubbles: true }));
          }, 500);
        }
      }

      form.addEventListener(
        'submit',
        (event) => {
          void this.submit(event, form, message, button);
        },
        { signal: this.controller.signal },
      );
    }

    disconnectedCallback() {
      this.controller.abort();
      if (this.preselectionTimer !== undefined) window.clearTimeout(this.preselectionTimer);
    }

    /* The browser's own validation bubble is OS chrome: it cannot be styled, it
       sits outside the page's type and colour, and it vanishes on the next
       click. Validation is reported inline under the offending field instead.
       noValidate is set from script so a no-JS visitor keeps the native path. */
    private validate(form: HTMLFormElement) {
      const inputs = Array.from(form.querySelectorAll<HTMLInputElement>('.form-fields input'));
      let firstInvalid: HTMLInputElement | undefined;
      inputs.forEach((input) => {
        const note = input.parentElement?.querySelector<HTMLElement>('[data-field-note]');
        const valid = input.checkValidity();
        input.setAttribute('aria-invalid', String(!valid));
        if (note) {
          note.textContent = valid ? '' : input.validationMessage;
          note.hidden = valid;
        }
        if (!valid && !firstInvalid) firstInvalid = input;
      });
      firstInvalid?.focus();
      return !firstInvalid;
    }

    private async submit(event: SubmitEvent, form: HTMLFormElement, message: HTMLElement, button: HTMLButtonElement) {
      event.preventDefault();
      if (!this.validate(form)) return;

      const data = new FormData(form);
      // __FORM_TOKEN__ is replaced at build with the base64 receiver URL, so it
      // lives in this bundle and never in the rendered HTML.
      const endpoint = __FORM_TOKEN__ ? atob(__FORM_TOKEN__) : '';
      const clientKey = localStorage.getItem('ethical-form-client') || crypto.randomUUID();
      localStorage.setItem('ethical-form-client', clientKey);
      const payload = {
        name: data.get('name'),
        email: data.get('email'),
        organisation: data.get('organisation'),
        role: data.get('role'),
        furtherInformation: data.get('furtherInformation'),
        interests: data.getAll('interests'),
        website: data.get('website'),
        startedAt: Number(data.get('startedAt')),
        elapsedMs: Date.now() - this.startedAt,
        minimumSubmissionMs: Number(form.dataset.minimumSubmissionMs),
        clientKey,
        page: location.pathname,
        variant: form.dataset.variant,
      };

      // Apps Script answers through a redirect chain that routinely takes several
      // seconds, and a disabled button alone reads as nothing having happened.
      const label = form.querySelector<HTMLElement>('[data-button-label]');
      const text = form.querySelector<HTMLElement>('[data-confirmation-text]');
      const buttonLabel = label?.textContent ?? '';
      const settleMs = Number(form.dataset.settleMs) || 2500;
      button.disabled = true;
      if (label) label.textContent = form.dataset.sending || buttonLabel;
      message.hidden = true;
      form.dataset.state = 'submitting';
      // The terminal treatment narrates only what is actually true at this
      // point. The receiver's reply is unreadable under mode: no-cors, so no
      // line ever claims an acknowledgement.
      // The isometric overlay is driven, not ambient: its packet position is the
      // elapsed share of the settle window, so arrival and confirmation coincide.
      const iso = form.querySelector<HTMLElement & { progress: number; settled: boolean }>('[data-send-iso]');
      const startedSending = performance.now();
      let isoFrame = 0;
      if (iso) {
        iso.settled = false;
        const advance = () => {
          iso.progress = Math.min(1, (performance.now() - startedSending) / settleMs);
          if (iso.progress < 1) isoFrame = requestAnimationFrame(advance);
        };
        advance();
      }

      const terminal = form.querySelector<HTMLElement>('[data-send-terminal]');
      if (terminal) {
        // left: 0 would resolve to the form's padding box, sitting 28px proud of
        // the button; both offsets come from the button so the log stays flush
        // with it whatever the padding is.
        terminal.style.top = `${button.offsetTop + button.offsetHeight + 12}px`;
        terminal.style.left = `${button.offsetLeft}px`;
        const bytes = new TextEncoder().encode(JSON.stringify(payload)).length;
        terminal.hidden = false;
        terminal.textContent = '';
        ['> encoding payload', '> opening channel', `> transmitting ${bytes} bytes`].forEach((line, index) => {
          window.setTimeout(() => (terminal.textContent += (index ? '\n' : '') + line), index * (settleMs / 4));
        });
      }

      try {
        if (endpoint) {
          // The receiver answers through a redirect chain that has taken up to
          // 15 seconds, and mode: no-cors makes its reply unreadable anyway, so
          // waiting the whole way buys no information the confirmation could
          // use. Stop waiting after a settle window instead: keepalive carries
          // the request to completion even if the visitor leaves the page, and
          // a rejection inside the window still surfaces as an error.
          const sent = fetch(endpoint, {
            method: 'POST',
            mode: 'no-cors',
            keepalive: true,
            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
            body: JSON.stringify(payload),
          });
          await Promise.race([sent, new Promise((resolve) => window.setTimeout(resolve, settleMs))]);
        }
        // The fields leave under their own staggered exit before the
        // confirmation takes the space, so the swap is a handover rather than a
        // cut. display: none cannot be animated, hence the interim state.
        if (iso) {
          iso.progress = 1;
          iso.settled = true;
        }
        if (terminal) terminal.hidden = true;
        form.dataset.state = 'exiting';
        await new Promise((resolve) => window.setTimeout(resolve, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 460));
        form.dataset.state = 'success';
        if (text) text.textContent = endpoint ? (form.dataset.confirmation ?? '') : (form.dataset.demoConfirmation ?? '');
        message.hidden = false;
      } catch {
        if (terminal) terminal.hidden = true;
        form.dataset.state = 'error';
        if (text) text.textContent = form.dataset.error ?? '';
        message.hidden = false;
      } finally {
        cancelAnimationFrame(isoFrame);
        button.disabled = false;
        if (label) label.textContent = buttonLabel;
      }
    }
  }

  if (!customElements.get('institute-form')) {
    customElements.define('institute-form', InstituteForm);
  }
</script>

<style>
  @import './FormSection.css';
</style>
