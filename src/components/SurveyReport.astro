---
import SurveyQuestionChart from './SurveyQuestionChart.astro';
import type { SurveyQuestionAggregate, SurveySectionId } from '../utils/SurveyReportData';

interface SurveySection {
  id: SurveySectionId;
  eyebrow: string;
  title: string;
  lede: string;
}

interface ReportCopy {
  readingTitle: string;
  readingBody: string;
  methodologyTitle: string;
  methodologyBody: string;
}

interface Props {
  questions: SurveyQuestionAggregate[];
  sections: SurveySection[];
  copy: ReportCopy;
}

const { questions, sections, copy } = Astro.props;
---

<div class="survey-report">
  <aside class="reading-note" aria-labelledby="reading-note-title" data-reveal>
    <p class="eyebrow">READING THE DATA</p>
    <h2 id="reading-note-title">{copy.readingTitle}</h2>
    <p>{copy.readingBody}</p>
  </aside>

  <nav class="report-index" aria-label="Report sections" data-reveal>
    <span>IN THIS REPORT</span>
    <ol>
      {
        sections.map((section, index) => (
          <li>
            <a href={`#${section.id}`}>
              <b>{String(index + 1).padStart(2, '0')}</b>
              {section.title}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {
    sections.map((section) => {
      const sectionQuestions = questions.filter((question) => question.section === section.id);
      return (
        <section class="report-section" id={section.id} aria-labelledby={`${section.id}-heading`}>
          <header data-reveal>
            <p class="eyebrow">{section.eyebrow}</p>
            <h2 id={`${section.id}-heading`}>{section.title}</h2>
            <p>{section.lede}</p>
          </header>
          <div class="question-grid">
            {sectionQuestions.map((question) => (
              <SurveyQuestionChart question={question} />
            ))}
          </div>
        </section>
      );
    })
  }

  <aside class="methodology-note" aria-labelledby="methodology-title" data-reveal>
    <p class="eyebrow">METHODOLOGY</p>
    <h2 id="methodology-title">{copy.methodologyTitle}</h2>
    <p>{copy.methodologyBody}</p>
  </aside>
</div>

<style>
  .survey-report {
    padding: 0 48px 96px;
  }

  .reading-note,
  .methodology-note {
    border: 1px solid var(--hairline-card);
    max-width: 1180px;
    padding: 34px;
  }

  .reading-note {
    background: var(--accent-wash-07);
  }

  .reading-note h2,
  .methodology-note h2 {
    font: 300 clamp(30px, 4vw, 46px) / 1.08 var(--font-display);
    margin: 14px 0 18px;
  }

  .reading-note > p:last-child,
  .methodology-note > p:last-child,
  .report-section > header > p:last-child {
    color: var(--text-2);
    font-size: var(--body-16);
    line-height: 1.7;
    margin-bottom: 0;
    max-width: 850px;
  }

  .report-index {
    border-bottom: 1px solid var(--hairline);
    border-top: 1px solid var(--hairline);
    margin: 72px 0 0;
    max-width: 1180px;
    padding: 24px 0;
  }

  .report-index > span {
    color: var(--text-4);
    font: var(--mono-9)/1 var(--font-mono);
    letter-spacing: 0.12em;
  }

  .report-index ol {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }

  .report-index a {
    border-left: 1px solid var(--hairline-card);
    color: var(--text-2);
    display: flex;
    flex-direction: column;
    font-size: 14px;
    gap: 8px;
    min-height: 64px;
    padding: 8px 14px;
  }

  .report-index a:hover {
    background: var(--accent-wash-07);
    color: var(--text-1);
  }

  .report-index b {
    color: var(--accent);
    font: 400 var(--mono-9)/1 var(--font-mono);
  }

  .report-section {
    max-width: 1180px;
    padding: 96px 0 0;
    scroll-margin-top: 100px;
  }

  .report-section > header h2 {
    font: 300 clamp(44px, 5.5vw, 68px) / 1.03 var(--font-display);
    letter-spacing: -0.02em;
    margin: 18px 0 22px;
  }

  .question-grid {
    display: grid;
    gap: 18px;
    margin-top: 42px;
  }

  .methodology-note {
    margin-top: 96px;
  }

  @media (max-width: 800px) {
    .survey-report {
      padding: 0 24px 76px;
    }

    .reading-note,
    .methodology-note {
      padding: 28px 22px;
    }

    .report-index {
      margin-top: 52px;
    }

    .report-index ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .report-section {
      padding-top: 72px;
    }
  }

  @media (max-width: 480px) {
    .report-index ol {
      grid-template-columns: 1fr;
    }
  }
</style>
