---
import { getCollection } from 'astro:content';
import { isExternalHref } from '../utils/external-links.mjs';
import AnimationWindow from './AnimationWindow.astro';
import KaosGraph from './KaosGraph.astro';
import SurveyExplorerIsland from './SurveyExplorerIsland.astro';

interface Action {
  label: string;
  href: string;
  kind: string;
}

interface Projects {
  section: {
    eyebrow: string;
    title: string;
    intro: string;
  };
  survey: {
    title: string;
    text: string;
    teaser: string;
    actions: Action[];
  };
  kompute: {
    figure: string;
    affiliation: string;
    title: string;
    text: string;
    donationText: string;
    donationLinkText: string;
    donationHref: string;
    tags: string[];
    actions: Action[];
  };
  xai: {
    figure: string;
    stages: Array<{ title: string; detail: string }>;
    title: string;
    text: string;
    linkLabel: string;
    linkHref: string;
  };
  ecosystem: {
    leftHeading: string;
    rightHeading: string;
    rows: Array<{ title: string }>;
    title: string;
    text: string;
    linkLabel: string;
    linkHref: string;
    guidelinesLabel: string;
    guidelinesHref: string;
  };
  kaos: {
    figure: string;
    title: string;
    text: string;
    capabilities: Array<{ name: string; detail: string }>;
    actions: Action[];
    panelEyebrow: string;
    panelStatus: string;
  };
  governance: {
    eyebrow: string;
    previewEyebrow: string;
    previewLabel: string;
    previewTitle: string;
    steps: Array<{ label: string; detail: string }>;
    title: string;
    text: string;
    actions: Action[];
  };
  security: {
    eyebrow: string;
    leftHeading: string;
    rightHeading: string;
    rows: Array<{ owasp: string; mlsecops: string }>;
    title: string;
    text: string;
    relatedIntro: string;
    relatedLinks: Array<{ label: string; href: string }>;
    actions: Action[];
  };
}

interface Props {
  projects: Projects;
  compact?: boolean;
  homepage?: boolean;
}

const { projects, compact = false, homepage = false } = Astro.props;
const carouselTitles = [projects.survey.title, projects.xai.title, projects.ecosystem.title, projects.governance.title, projects.security.title];
const repoEntries = await getCollection('metrics');
const repoMetrics = Object.fromEntries(repoEntries.map(({ id, data }) => [id, data.values]));
const statline = (id: string) => repoMetrics[id].map(({ value, label }: { value: string; label: string }) => (label ? `${value} ${label}` : value));
---

{/* Each block is its own reveal root, entering as it reaches the global reveal threshold. */}
<open-source-showcase id="opensource" class:list={['open-source-prototype', compact && 'compact', homepage && 'home-section']}>
  <p class="eyebrow" data-reveal>{projects.section.eyebrow}</p>
  <h2 data-reveal>{projects.section.title}</h2>
  <p class="section-intro" data-reveal>{projects.section.intro}</p>

  <article class="kompute-feature" data-reveal>
    <div class="oss-copy">
      <p class="figure-label"><span>{projects.kompute.figure}</span><span>{projects.kompute.affiliation}</span></p>
      <h3>{projects.kompute.title}</h3>
      <p>{projects.kompute.text}</p>
      <p>
        {projects.kompute.donationText}{' '}
        <a class="text-link" href={projects.kompute.donationHref} target="_blank" rel="noopener noreferrer">{projects.kompute.donationLinkText}</a>.
      </p>
      <div class="oss-metrics">
        {
          repoMetrics.kompute.map(({ value, label }: { value: string; label: string }) => (
            <div>
              <>
                <strong>{value}</strong>
                <span>{label}</span>
              </>
            </div>
          ))
        }
      </div>
      <div class="oss-tags">{projects.kompute.tags.map((tag) => <span>{tag}</span>)}</div>
      <div class="actions">
        {
          projects.kompute.actions.map(({ label, href, kind }) => (
            <a class:list={['button', kind]} href={href} target="_blank" rel="noopener noreferrer">
              {label}
            </a>
          ))
        }
      </div>
    </div>
    <div class="fixed-canvas cube-mount"><kompute-cube><canvas aria-label="Animated 27-cubie Rubik's cube"></canvas></kompute-cube></div>
  </article>

  <article class="kaos-feature" data-reveal>
    <div>
      <p class="figure-label"><span>{projects.kaos.figure}</span></p>
      <h3 data-morph-source="kaos-title" data-morph-name="kaos-title">{projects.kaos.title}</h3>
      <p>{projects.kaos.text}</p>
      <div class="kaos-capabilities">
        {
          projects.kaos.capabilities.map(({ name, detail }) => (
            <div>
              <>
                <span>{name}</span>
                <strong>{detail}</strong>
              </>
            </div>
          ))
        }
      </div>
      <div class="oss-statline">{statline('kaos').map((stat) => <span>{stat}</span>)}</div>
      <div class="actions">
        {
          projects.kaos.actions.map(({ label, href, kind }) => (
            <a
              class:list={['button', kind]}
              href={href}
              target={isExternalHref(href) ? '_blank' : undefined}
              rel={isExternalHref(href) ? 'noopener noreferrer' : undefined}
              data-morph-pair={href === '/open-source/kaos/' ? 'kaos-title' : undefined}
            >
              {label}
            </a>
          ))
        }
      </div>
    </div>
    <div class="kaos-panel windowed">
      <AnimationWindow title={projects.kaos.panelEyebrow.toLowerCase()} class="kaos-showcase-window" chromeOnly>
        <KaosGraph panel />
      </AnimationWindow>
    </div>
  </article>

  {
    /* Flagship carousel: enters on the global reveal signal sliding in from the
      right on the teaser+survey bundle (the single first snap stop); everything
      after is user-driven over a bounded snap track. Position bubbles sit in the
      inter-card gap above the track (click travels, active stretches to a bar and
      follows); full-height chevron compositions at the edges navigate and dim at
      the ends. */
  }
  <div id="reports" class="oss-carousel" data-reveal="trigger">
    <div class="oss-carousel-bubbles" data-carousel-bubbles>
      {carouselTitles.map((title, index) => <button type="button" data-carousel-bubble={index} aria-label={`Go to ${title}`} />)}
    </div>
    <div class="oss-carousel-stage">
      <button class="oss-carousel-edge prev" type="button" data-carousel-prev aria-label="Previous cards">
        <b aria-hidden="true"></b><i aria-hidden="true">‹</i><b aria-hidden="true"></b>
      </button>
      <button class="oss-carousel-edge next" type="button" data-carousel-next aria-label="Next cards">
        <b aria-hidden="true"></b><i aria-hidden="true">›</i><b aria-hidden="true"></b>
      </button>
      <div class="oss-carousel-track" data-carousel-track tabindex="-1">
        <div class="oss-card teaser-card">
          <span>{projects.survey.teaser}</span>
          <i aria-hidden="true">→</i>
        </div>
        <article class="oss-card survey-card">
          <div class="oss-preview survey-preview">
            <SurveyExplorerIsland compact />
          </div>
          <h3 data-morph-source="survey-title">{projects.survey.title}</h3>
          <p>{projects.survey.text}</p>
          <div class="actions">
            {
              projects.survey.actions.map(({ label, href, kind }) => (
                <a class:list={['button', kind]} href={href} data-morph-pair={href === '/data/survey-explorer/' ? 'survey-title' : undefined}>
                  {label}
                </a>
              ))
            }
          </div>
        </article>
        <article class="oss-card">
          <div class="oss-preview xai-preview">
            <p class="figure-label"><span>{projects.xai.figure}</span></p>
            <div class="xai-stages">
              {
                projects.xai.stages.map(({ title, detail }) => (
                  <div>
                    <>
                      <p>
                        <>
                          <span>{title}</span>
                          <small>{detail}</small>
                        </>
                      </p>
                      <i>
                        <b />
                      </i>
                    </>
                  </div>
                ))
              }
            </div>
          </div>
          <h3>{projects.xai.title}</h3>
          <p>{projects.xai.text}</p>
          <div class="oss-statline">{statline('xai').map((stat) => <span>{stat}</span>)}</div>
          <div class="actions">
            <a class="button primary" href={projects.xai.linkHref}>{projects.xai.linkLabel}</a>
          </div>
        </article>
        <article class="oss-card">
          <div class="oss-preview ecosystem-preview">
            <p class="figure-label"><span>{projects.ecosystem.leftHeading}</span><span>{projects.ecosystem.rightHeading}</span></p>
            <div>
              {
                projects.ecosystem.rows.map(({ title }) => (
                  <p>
                    <span>{title}</span>
                  </p>
                ))
              }
            </div>
          </div>
          <h3>{projects.ecosystem.title}</h3>
          <p>{projects.ecosystem.text}</p>
          <div class="oss-statline">{statline('ecosystem').map((stat) => <span>{stat}</span>)}</div>
          <div class="actions">
            <a class="button primary" href={projects.ecosystem.linkHref} target="_blank" rel="noopener noreferrer">{projects.ecosystem.linkLabel}</a>
            <a class="button" href={projects.ecosystem.guidelinesHref} target="_blank" rel="noopener noreferrer">{projects.ecosystem.guidelinesLabel}</a>
          </div>
        </article>
        <article class="oss-card">
          <div class="initiative-preview governance-preview">
            <header><span>{projects.governance.previewEyebrow}</span><span>{projects.governance.previewLabel}</span></header>
            <h4>{projects.governance.previewTitle}</h4>
            {
              projects.governance.steps.map(({ label, detail }, index) => (
                <p>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  {label}
                  <i>{detail}</i>
                </p>
              ))
            }
          </div>
          <p class="eyebrow">{projects.governance.eyebrow}</p>
          <h3>{projects.governance.title}</h3>
          <p>{projects.governance.text}</p>
          <div class="actions">
            {
              projects.governance.actions.map(({ label, href, kind }) => (
                <a
                  class:list={['button', kind]}
                  href={href}
                  target={isExternalHref(href) ? '_blank' : undefined}
                  rel={isExternalHref(href) ? 'noopener noreferrer' : undefined}
                >
                  {label}
                </a>
              ))
            }
          </div>
        </article>
        <article class="oss-card">
          <div class="initiative-preview mlsecops-preview">
            <header><span>{projects.security.leftHeading}</span><span>{projects.security.rightHeading}</span></header>
            {
              projects.security.rows.map(({ owasp, mlsecops }) => (
                <p>
                  <>
                    <span>{owasp}</span>
                    <strong>{mlsecops}</strong>
                  </>
                </p>
              ))
            }
          </div>
          <p class="eyebrow">{projects.security.eyebrow}</p>
          <h3>{projects.security.title}</h3>
          <p>{projects.security.text}</p>
          <p>
            {projects.security.relatedIntro}{' '}
            {
              projects.security.relatedLinks.map(({ label, href }, index) => (
                <>
                  {index > 0 && (index === projects.security.relatedLinks.length - 1 ? ', and ' : ', ')}
                  <a
                    class="text-link"
                    href={href}
                    target={isExternalHref(href) ? '_blank' : undefined}
                    rel={isExternalHref(href) ? 'noopener noreferrer' : undefined}
                  >
                    {label}
                  </a>
                </>
              ))
            }.
          </p>
          <div class="actions">
            {
              projects.security.actions.map(({ label, href, kind }) => (
                <a
                  class:list={['button', kind]}
                  href={href}
                  target={isExternalHref(href) ? '_blank' : undefined}
                  rel={isExternalHref(href) ? 'noopener noreferrer' : undefined}
                >
                  {label}
                </a>
              ))
            }
          </div>
        </article>
      </div>
    </div>
  </div>
</open-source-showcase>

<style>
  open-source-showcase {
    display: block;
  }
  .kaos-panel.windowed {
    background: transparent;
    border: 0;
    padding: 0;
  }
  :global(.kaos-showcase-window .kaos-canvas-mount) {
    height: 430px;
    margin-top: 0;
  }

  /* The intro shares the title's measure so the section head reads as one block. */
  .section-intro {
    max-width: 760px;
  }

  /* Flagship carousel: position bubbles in the inter-card gap above a snap track
     flanked by full-height chevron compositions. */
  .oss-carousel {
    margin-top: 0;
    scroll-margin-top: 124px;
  }
  .oss-carousel-stage {
    position: relative;
  }
  /* Position bubbles: round dots in the 26px inter-card gap band; only the
     active one stretches into a longer bar. Click travels, active follows. */
  .oss-carousel-bubbles {
    align-items: center;
    display: flex;
    gap: 12px;
    height: 26px;
  }
  .oss-carousel-bubbles button {
    background: rgba(244, 242, 238, 0.28);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    height: 8px;
    padding: 0;
    transition:
      background 0.18s ease,
      width 0.18s ease;
    width: 8px;
  }
  .oss-carousel-bubbles button:hover {
    background: rgba(244, 242, 238, 0.45);
  }
  .oss-carousel-bubbles button.active {
    background: rgba(244, 242, 238, 0.65);
    width: 48px;
  }
  /* Vertical chevron compositions at the track edges: a single chevron centred
     between two gradient lines spanning the full track height, in the strategy
     section's accent line colour; hover takes its neon treatment, a press
     energises the lines, the ends dim when disabled. */
  .oss-carousel-edge {
    align-items: center;
    background: transparent;
    border: 0;
    bottom: 0;
    color: rgba(94, 230, 160, 0.55);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    font: 15px/1 var(--font-mono);
    padding: 0;
    position: absolute;
    top: 0;
    transition:
      color 0.2s ease,
      opacity 0.2s ease,
      filter 0.2s ease;
    width: 26px;
  }
  .oss-carousel-edge b {
    background: linear-gradient(180deg, transparent, rgba(94, 230, 160, 0.5), transparent);
    flex: 1;
    margin: 0;
    transition:
      background 0.2s ease,
      box-shadow 0.2s ease;
    width: 1px;
  }
  .oss-carousel-edge i {
    font-style: normal;
    padding: 8px 0;
  }
  .oss-carousel-edge.prev {
    left: -37px;
  }
  .oss-carousel-edge.next {
    right: -37px;
  }
  .oss-carousel-edge:hover:not([disabled]) {
    color: var(--accent);
  }
  .oss-carousel-edge:hover:not([disabled]) b {
    background: linear-gradient(180deg, transparent, var(--accent), transparent);
    box-shadow: 0 0 14px rgba(94, 230, 160, 0.5);
  }
  .oss-carousel-edge.pressed b,
  .oss-carousel-edge:active:not([disabled]) b {
    animation: edge-energise 0.35s ease;
  }
  @keyframes edge-energise {
    0% {
      box-shadow: 0 0 0 rgba(94, 230, 160, 0);
    }
    50% {
      background: linear-gradient(180deg, transparent, #8bf5c0, transparent);
      box-shadow: 0 0 20px rgba(94, 230, 160, 0.85);
    }
    100% {
      box-shadow: 0 0 14px rgba(94, 230, 160, 0.5);
    }
  }
  .oss-carousel-edge[disabled] {
    color: rgba(244, 242, 238, 0.18);
    cursor: default;
    filter: saturate(0.2);
    opacity: 0.5;
    pointer-events: none;
  }
  .oss-carousel-edge[disabled] b {
    background: linear-gradient(180deg, transparent, rgba(244, 242, 238, 0.18), transparent);
  }
  .oss-carousel-track {
    display: flex;
    gap: 26px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    transition:
      opacity 0.7s var(--ease-panel),
      transform 0.7s var(--ease-panel);
  }
  /* Entrance: the track (survey card first) slides in from the right once the
     carousel reaches 50% visibility; the pending state is only ever set by JS,
     and never under reduced motion. */
  .oss-carousel-track[data-entrance='pending'] {
    opacity: 0;
    transform: translateX(140px);
  }
  .oss-carousel-track::-webkit-scrollbar {
    display: none;
  }
  /* Card shell styles are global (.oss-card in tokens.css); the carousel only
     adds the flex/snap geometry and the bottom-pinned actions row. */
  .oss-card {
    display: flex;
    flex: 0 0 calc(50% - 13px);
    flex-direction: column;
    min-width: 0;
    scroll-snap-align: start;
  }
  .oss-card > .eyebrow {
    margin-top: 24px;
  }
  .oss-card > .eyebrow + h3 {
    margin-top: 8px;
  }
  /* Teaser lead-in: a static thin card with stacked display type and a plain
     arrow glyph; not a control, no hover state, no accent. It bundles with the
     survey card into the single first snap stop (1/3 + 2/3 filling the row). */
  .oss-card.teaser-card {
    align-items: flex-start;
    color: var(--text-1);
    flex-basis: calc(33.333% - 13px);
    justify-content: space-between;
    text-align: left;
  }
  /* The survey card is part of the bundle, never its own desktop snap stop. */
  @media (min-width: 901px) {
    .oss-card.survey-card {
      scroll-snap-align: none;
    }
  }
  .teaser-card span {
    font: 300 24px/1.2 var(--font-display);
    letter-spacing: -0.01em;
  }
  .teaser-card i {
    color: var(--text-3);
    font-size: 26px;
    font-style: normal;
  }
  /* Survey card: two thirds of the row so the next card peeks from the right; the
     interactive island sits in the inner panel with the siblings' top-right glow. */
  .oss-card.survey-card {
    flex-basis: calc(66.666% - 13px);
  }
  .survey-preview {
    background: radial-gradient(70% 100% at 85% 0%, var(--accent-wash-16), var(--bg-inset) 70%);
  }
  .oss-card .actions {
    margin-top: auto;
    padding-top: 22px;
  }

  /* Initiative previews, restored from the retired reports section cards. */
  .initiative-preview {
    background: radial-gradient(70% 100% at 70% 0%, var(--accent-wash-16), var(--bg-inset) 70%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-card);
    padding: 22px;
  }
  .initiative-preview header {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }
  .initiative-preview header span {
    color: var(--text-3);
    font: var(--mono-10) / 1 var(--font-mono);
    letter-spacing: 0.1em;
  }
  .initiative-preview h4 {
    font-size: 19px;
    font-weight: 400;
    margin: 5px 0 20px;
  }
  .initiative-preview > p {
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    font-size: 13px;
    gap: 10px;
    margin: 0;
    padding: 8px 0;
  }
  .initiative-preview > p span,
  .initiative-preview > p i {
    color: var(--text-3);
    font: normal var(--mono-10) / 1 var(--font-mono);
  }
  .initiative-preview > p i {
    margin-left: auto;
  }
  .mlsecops-preview {
    background: var(--bg-inset);
  }
  .mlsecops-preview header {
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 10px;
  }
  .mlsecops-preview > p {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
  }
  .mlsecops-preview > p strong {
    font-weight: 400;
  }

  /* Mobile stays a carousel: near-full-width cards with the next edge peeking;
     the edge zones shrink into the section's own side padding. */
  @media (max-width: 900px) {
    .oss-card,
    .oss-card.survey-card {
      flex-basis: 86%;
    }
    .oss-card.teaser-card {
      flex-basis: 38%;
    }
    /* The same chevron composition scaled into the mobile side padding. */
    .oss-carousel-edge {
      font-size: 12px;
      width: 20px;
    }
    .oss-carousel-edge.prev {
      left: -23px;
    }
    .oss-carousel-edge.next {
      right: -23px;
    }
  }
  @media (max-width: 520px) {
    .oss-carousel-edge.prev {
      left: -18px;
    }
    .oss-carousel-edge.next {
      right: -18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .oss-carousel-bubbles button {
      transition: none;
    }
    .oss-carousel-edge,
    .oss-carousel-edge b {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  import { bindMorphPairs } from '../shared/MorphPairs';
  import { onRevealed } from '../shared/Reveal';
  import '../shared/canvas/KomputeCube';

  class OpenSourceShowcase extends HTMLElement {
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      bindMorphPairs(this, this.controller.signal);
      this.wireCarousel();
    }

    // Bounded card-by-card navigation over the snap track; the teaser is the
    // static lead-in, never a stop. The only automatic motion is the entrance
    // slide-in on the global reveal signal; everything after is user-driven.
    private wireCarousel() {
      const carousel = this.querySelector<HTMLElement>('.oss-carousel');
      const track = this.querySelector<HTMLElement>('[data-carousel-track]');
      const prev = this.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = this.querySelector<HTMLButtonElement>('[data-carousel-next]');
      const bubbles = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-carousel-bubble]'));
      if (!carousel || !track || !prev || !next) return;
      const signal = this.controller.signal;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const behavior = reduced ? ('auto' as const) : ('smooth' as const);

      const realCards = Array.from(track.querySelectorAll<HTMLElement>('.oss-card:not(.teaser-card)'));
      const base = track.firstElementChild as HTMLElement;
      const left = (el: HTMLElement) => el.offsetLeft - base.offsetLeft;
      // Desktop stops: the teaser+survey bundle (track start) then each later
      // card, so one press from the bundle lands the next card. The mobile
      // track cannot fit the bundle, so the survey keeps its own stop there.
      const mobileTrack = window.matchMedia('(max-width: 900px)');
      const stops = () => (mobileTrack.matches ? [0, ...realCards.map(left)] : [0, ...realCards.slice(1).map(left)]);

      // Cards near the track end share the clamped end position, so the nearest-
      // stop rule alone cannot tell them apart there; a navigation records its
      // intended card and wins the tie until the user scrolls by hand.
      const maxScroll = () => track.scrollWidth - track.clientWidth;
      const clamped = (card: HTMLElement) => Math.min(left(card), maxScroll());
      let intent = -1;
      const syncBubbles = () => {
        const position = track.scrollLeft;
        let active = 0;
        realCards.forEach((card, index) => {
          if (Math.abs(clamped(card) - position) < Math.abs(clamped(realCards[active]) - position)) active = index;
        });
        if (position >= maxScroll() - 4) active = realCards.length - 1;
        if (intent >= 0 && Math.abs(clamped(realCards[intent]) - position) <= 4) active = intent;
        bubbles.forEach((bubble, index) => bubble.classList.toggle('active', index === active));
      };
      const syncDisabled = () => {
        prev.disabled = track.scrollLeft <= 4;
        next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
      };

      const go = (direction: number) => {
        const position = track.scrollLeft;
        const list = stops();
        const target = direction > 0 ? list.find((stop) => stop > position + 4) : [...list].reverse().find((stop) => stop < position - 4);
        if (target === undefined) return;
        intent = -1;
        track.scrollTo({ left: target, behavior });
      };

      // The pressed class replays the line-energise pulse on real presses.
      const press = (edge: HTMLButtonElement, direction: number) => {
        edge.classList.remove('pressed');
        void edge.offsetWidth;
        edge.classList.add('pressed');
        setTimeout(() => edge.classList.remove('pressed'), 380);
        go(direction);
      };
      prev.addEventListener('click', () => press(prev, -1), { signal });
      next.addEventListener('click', () => press(next, 1), { signal });
      bubbles.forEach((bubble, index) => {
        // Bubble 0 is the bundle on desktop: it travels to the track start.
        const target = () => (index === 0 && !mobileTrack.matches ? 0 : clamped(realCards[index]));
        bubble.addEventListener(
          'click',
          () => {
            intent = index;
            track.scrollTo({ left: target(), behavior });
            // A shared end position may not move the track at all; sync now so
            // the intended bubble lights even without a scroll event.
            syncBubbles();
          },
          { signal },
        );
      });
      ['wheel', 'touchstart', 'pointerdown'].forEach((type) => track.addEventListener(type, () => (intent = -1), { signal, passive: true }));
      track.addEventListener(
        'scroll',
        () => {
          syncBubbles();
          syncDisabled();
        },
        { signal, passive: true },
      );
      syncBubbles();
      syncDisabled();

      // Entrance slide-in on the global reveal signal (shared Reveal module).
      // Desktop track only; reduced motion gets no slide.
      if (reduced || !window.matchMedia('(min-width: 901px)').matches) return;
      track.dataset.entrance = 'pending';
      onRevealed(carousel, () => delete track.dataset.entrance, signal);
    }

    disconnectedCallback() {
      this.controller.abort();
    }
  }

  if (!customElements.get('open-source-showcase')) {
    customElements.define('open-source-showcase', OpenSourceShowcase);
  }
</script>
