---
import { getCollection } from 'astro:content';
import { isExternalHref } from '../utils/external-links.mjs';
import AnimationWindow from './AnimationWindow.astro';
import KaosGraph from './KaosGraph.astro';
import SurveyExplorerIsland from './SurveyExplorerIsland.astro';

interface Action {
  label: string;
  href: string;
  kind: string;
}

interface Projects {
  section: {
    eyebrow: string;
    title: string;
    intro: string;
  };
  survey: {
    title: string;
    text: string;
    teaser: string;
    actions: Action[];
  };
  kompute: {
    figure: string;
    affiliation: string;
    title: string;
    text: string;
    donationText: string;
    donationLinkText: string;
    donationHref: string;
    tags: string[];
    actions: Action[];
  };
  xai: {
    figure: string;
    stages: Array<{ title: string; detail: string }>;
    title: string;
    text: string;
    linkLabel: string;
    linkHref: string;
  };
  ecosystem: {
    leftHeading: string;
    rightHeading: string;
    rows: Array<{ title: string }>;
    title: string;
    text: string;
    linkLabel: string;
    linkHref: string;
    guidelinesLabel: string;
    guidelinesHref: string;
  };
  kaos: {
    figure: string;
    title: string;
    text: string;
    capabilities: Array<{ name: string; detail: string }>;
    actions: Action[];
    panelEyebrow: string;
    panelStatus: string;
  };
  governance: {
    eyebrow: string;
    previewEyebrow: string;
    previewLabel: string;
    previewTitle: string;
    steps: Array<{ label: string; detail: string }>;
    title: string;
    text: string;
    actions: Action[];
  };
  security: {
    eyebrow: string;
    leftHeading: string;
    rightHeading: string;
    rows: Array<{ owasp: string; mlsecops: string }>;
    title: string;
    text: string;
    relatedIntro: string;
    relatedLinks: Array<{ label: string; href: string }>;
    actions: Action[];
  };
}

interface Props {
  projects: Projects;
  compact?: boolean;
  homepage?: boolean;
}

const { projects, compact = false, homepage = false } = Astro.props;
const carouselTitles = [projects.survey.title, projects.xai.title, projects.ecosystem.title, projects.governance.title, projects.security.title];
const repoEntries = await getCollection('metrics');
const repoMetrics = Object.fromEntries(repoEntries.map(({ id, data }) => [id, data.values]));
const statline = (id: string) => repoMetrics[id].map(({ value, label }: { value: string; label: string }) => (label ? `${value} ${label}` : value));
---

<open-source-showcase id="opensource" class:list={['open-source-prototype', compact && 'compact', homepage && 'home-section']} data-reveal>
  <p class="eyebrow">{projects.section.eyebrow}</p>
  <h2>{projects.section.title}</h2>
  <p class="section-intro">{projects.section.intro}</p>

  <article class="kompute-feature">
    <div class="oss-copy">
      <p class="figure-label"><span>{projects.kompute.figure}</span><span>{projects.kompute.affiliation}</span></p>
      <h3>{projects.kompute.title}</h3>
      <p>{projects.kompute.text}</p>
      <p>
        {projects.kompute.donationText}{' '}
        <a class="text-link" href={projects.kompute.donationHref} target="_blank" rel="noopener noreferrer">{projects.kompute.donationLinkText}</a>.
      </p>
      <div class="oss-metrics">
        {
          repoMetrics.kompute.map(({ value, label }: { value: string; label: string }) => (
            <div>
              <>
                <strong>{value}</strong>
                <span>{label}</span>
              </>
            </div>
          ))
        }
      </div>
      <div class="oss-tags">{projects.kompute.tags.map((tag) => <span>{tag}</span>)}</div>
      <div class="actions">
        {
          projects.kompute.actions.map(({ label, href, kind }) => (
            <a class:list={['button', kind]} href={href} target="_blank" rel="noopener noreferrer">
              {label}
            </a>
          ))
        }
      </div>
    </div>
    <div class="fixed-canvas cube-mount"><kompute-cube><canvas aria-label="Animated 27-cubie Rubik's cube"></canvas></kompute-cube></div>
  </article>

  <article class="kaos-feature">
    <div>
      <p class="figure-label"><span>{projects.kaos.figure}</span></p>
      <h3 data-morph-source="kaos-title" data-morph-name="kaos-title">{projects.kaos.title}</h3>
      <p>{projects.kaos.text}</p>
      <div class="kaos-capabilities">
        {
          projects.kaos.capabilities.map(({ name, detail }) => (
            <div>
              <>
                <span>{name}</span>
                <strong>{detail}</strong>
              </>
            </div>
          ))
        }
      </div>
      <div class="oss-statline">{statline('kaos').map((stat) => <span>{stat}</span>)}</div>
      <div class="actions">
        {
          projects.kaos.actions.map(({ label, href, kind }) => (
            <a
              class:list={['button', kind]}
              href={href}
              target={isExternalHref(href) ? '_blank' : undefined}
              rel={isExternalHref(href) ? 'noopener noreferrer' : undefined}
              data-morph-pair={href === '/open-source/kaos/' ? 'kaos-title' : undefined}
            >
              {label}
            </a>
          ))
        }
      </div>
    </div>
    <div class="kaos-panel windowed">
      <AnimationWindow title={projects.kaos.panelEyebrow.toLowerCase()} class="kaos-showcase-window" chromeOnly>
        <KaosGraph panel />
      </AnimationWindow>
    </div>
  </article>

  {
    /* Flagship carousel: enters at 50% visibility sliding in from the right on the
      static teaser lead-in, then one 4s auto-advance (counted down on the active
      bubble, the next blade flashing pressed) unless the user interacts first.
      Card-by-card navigation wraps seamlessly via edge clones; the bubbles above
      the track travel and follow. Horizontal at every width. */
  }
  <div id="reports" class="oss-carousel" data-reveal="trigger">
    <div class="oss-carousel-bubbles" data-carousel-bubbles>
      {
        carouselTitles.map((title, index) => (
          <button type="button" data-carousel-bubble={index} aria-label={`Go to ${title}`}>
            <i aria-hidden="true" />
          </button>
        ))
      }
    </div>
    <div class="oss-carousel-stage">
      <button class="oss-carousel-edge prev" type="button" data-carousel-prev aria-label="Previous cards"><span>‹</span></button>
      <button class="oss-carousel-edge next" type="button" data-carousel-next aria-label="Next cards"><span>›</span></button>
      <div class="oss-carousel-track" data-carousel-track tabindex="-1">
        <div class="oss-card teaser-card">
          <span>{projects.survey.teaser}</span>
          <i aria-hidden="true">→</i>
        </div>
        <article class="oss-card survey-card">
          <div class="oss-preview survey-preview">
            <SurveyExplorerIsland compact />
          </div>
          <h3 data-morph-source="survey-title">{projects.survey.title}</h3>
          <p>{projects.survey.text}</p>
          <div class="actions">
            {
              projects.survey.actions.map(({ label, href, kind }) => (
                <a class:list={['button', kind]} href={href} data-morph-pair={href === '/data/survey-explorer/' ? 'survey-title' : undefined}>
                  {label}
                </a>
              ))
            }
          </div>
        </article>
        <article class="oss-card">
          <div class="oss-preview xai-preview">
            <p class="figure-label"><span>{projects.xai.figure}</span></p>
            <div class="xai-stages">
              {
                projects.xai.stages.map(({ title, detail }) => (
                  <div>
                    <>
                      <p>
                        <>
                          <span>{title}</span>
                          <small>{detail}</small>
                        </>
                      </p>
                      <i>
                        <b />
                      </i>
                    </>
                  </div>
                ))
              }
            </div>
          </div>
          <h3>{projects.xai.title}</h3>
          <p>{projects.xai.text}</p>
          <div class="oss-statline">{statline('xai').map((stat) => <span>{stat}</span>)}</div>
          <div class="actions">
            <a class="button primary" href={projects.xai.linkHref}>{projects.xai.linkLabel}</a>
          </div>
        </article>
        <article class="oss-card">
          <div class="oss-preview ecosystem-preview">
            <p class="figure-label"><span>{projects.ecosystem.leftHeading}</span><span>{projects.ecosystem.rightHeading}</span></p>
            <div>
              {
                projects.ecosystem.rows.map(({ title }) => (
                  <p>
                    <span>{title}</span>
                  </p>
                ))
              }
            </div>
          </div>
          <h3>{projects.ecosystem.title}</h3>
          <p>{projects.ecosystem.text}</p>
          <div class="oss-statline">{statline('ecosystem').map((stat) => <span>{stat}</span>)}</div>
          <div class="actions">
            <a class="button primary" href={projects.ecosystem.linkHref} target="_blank" rel="noopener noreferrer">{projects.ecosystem.linkLabel}</a>
            <a class="button" href={projects.ecosystem.guidelinesHref} target="_blank" rel="noopener noreferrer">{projects.ecosystem.guidelinesLabel}</a>
          </div>
        </article>
        <article class="oss-card">
          <div class="initiative-preview governance-preview">
            <header><span>{projects.governance.previewEyebrow}</span><span>{projects.governance.previewLabel}</span></header>
            <h4>{projects.governance.previewTitle}</h4>
            {
              projects.governance.steps.map(({ label, detail }, index) => (
                <p>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  {label}
                  <i>{detail}</i>
                </p>
              ))
            }
          </div>
          <p class="eyebrow">{projects.governance.eyebrow}</p>
          <h3>{projects.governance.title}</h3>
          <p>{projects.governance.text}</p>
          <div class="actions">
            {
              projects.governance.actions.map(({ label, href, kind }) => (
                <a
                  class:list={['button', kind]}
                  href={href}
                  target={isExternalHref(href) ? '_blank' : undefined}
                  rel={isExternalHref(href) ? 'noopener noreferrer' : undefined}
                >
                  {label}
                </a>
              ))
            }
          </div>
        </article>
        <article class="oss-card">
          <div class="initiative-preview mlsecops-preview">
            <header><span>{projects.security.leftHeading}</span><span>{projects.security.rightHeading}</span></header>
            {
              projects.security.rows.map(({ owasp, mlsecops }) => (
                <p>
                  <>
                    <span>{owasp}</span>
                    <strong>{mlsecops}</strong>
                  </>
                </p>
              ))
            }
          </div>
          <p class="eyebrow">{projects.security.eyebrow}</p>
          <h3>{projects.security.title}</h3>
          <p>{projects.security.text}</p>
          <p>
            {projects.security.relatedIntro}{' '}
            {
              projects.security.relatedLinks.map(({ label, href }, index) => (
                <>
                  {index > 0 && (index === projects.security.relatedLinks.length - 1 ? ', and ' : ', ')}
                  <a
                    class="text-link"
                    href={href}
                    target={isExternalHref(href) ? '_blank' : undefined}
                    rel={isExternalHref(href) ? 'noopener noreferrer' : undefined}
                  >
                    {label}
                  </a>
                </>
              ))
            }.
          </p>
          <div class="actions">
            {
              projects.security.actions.map(({ label, href, kind }) => (
                <a
                  class:list={['button', kind]}
                  href={href}
                  target={isExternalHref(href) ? '_blank' : undefined}
                  rel={isExternalHref(href) ? 'noopener noreferrer' : undefined}
                >
                  {label}
                </a>
              ))
            }
          </div>
        </article>
      </div>
    </div>
  </div>
</open-source-showcase>

<style>
  open-source-showcase {
    display: block;
  }
  .kaos-panel.windowed {
    background: transparent;
    border: 0;
    padding: 0;
  }
  :global(.kaos-showcase-window .kaos-canvas-mount) {
    height: 430px;
    margin-top: 0;
  }

  /* The intro shares the title's measure so the section head reads as one block. */
  .section-intro {
    max-width: 760px;
  }

  /* Flagship carousel: bubbles above a snap track flanked by hairline blades. */
  .oss-carousel {
    margin-top: 36px;
    scroll-margin-top: 124px;
  }
  .oss-carousel-stage {
    position: relative;
  }
  /* Position bubbles: one per real card, the active one stretched to a pill; the
     inner bar fills left-to-right as the auto-advance countdown. */
  .oss-carousel-bubbles {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
  }
  .oss-carousel-bubbles button {
    background: rgba(244, 242, 238, 0.22);
    border: 0;
    border-radius: 4px;
    cursor: pointer;
    height: 8px;
    overflow: hidden;
    padding: 0;
    position: relative;
    transition:
      background 0.18s ease,
      width 0.18s ease;
    width: 8px;
  }
  .oss-carousel-bubbles button:hover {
    background: rgba(244, 242, 238, 0.4);
  }
  .oss-carousel-bubbles button.active {
    background: rgba(244, 242, 238, 0.34);
    width: 30px;
  }
  .oss-carousel-bubbles button i {
    background: rgba(244, 242, 238, 0.9);
    border-radius: inherit;
    display: block;
    inset: 0;
    position: absolute;
    transform: scaleX(0);
    transform-origin: left;
  }
  .oss-carousel-bubbles.counting button.active i {
    animation: bubble-countdown 4s linear forwards;
  }
  @keyframes bubble-countdown {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  /* Hairline blades: ultra-thin full-height zones in the section padding, a 1px
     vertical hairline with a centred mono chevron. Hover brightens white-scale
     and extends a short tick; press pulses bright. Never accent green. */
  .oss-carousel-edge {
    background: transparent;
    border: 0;
    bottom: 0;
    color: var(--text-3);
    cursor: pointer;
    font: 12px/1 var(--font-mono);
    padding: 0;
    position: absolute;
    top: 0;
    width: 26px;
    z-index: 2;
  }
  .oss-carousel-edge::before {
    background: rgba(244, 242, 238, 0.22);
    bottom: 0;
    content: '';
    left: 50%;
    position: absolute;
    top: 0;
    transition: background 0.18s ease;
    width: 1px;
  }
  .oss-carousel-edge::after {
    background: rgba(244, 242, 238, 0.6);
    content: '';
    height: 1px;
    position: absolute;
    top: 50%;
    transition: width 0.18s ease;
    width: 0;
  }
  .oss-carousel-edge.prev::after {
    left: 50%;
  }
  .oss-carousel-edge.next::after {
    right: 50%;
  }
  .oss-carousel-edge span {
    background: var(--bg-base);
    left: 50%;
    padding: 7px 1px;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .oss-carousel-edge.prev {
    left: -46px;
  }
  .oss-carousel-edge.next {
    right: -46px;
  }
  .oss-carousel-edge:hover {
    color: var(--text-1);
  }
  .oss-carousel-edge:hover::before {
    background: rgba(244, 242, 238, 0.55);
  }
  .oss-carousel-edge:hover::after {
    width: 9px;
  }
  .oss-carousel-edge:active,
  .oss-carousel-edge.pressed {
    color: #fff;
  }
  .oss-carousel-edge:active::before,
  .oss-carousel-edge.pressed::before {
    background: #fff;
  }
  .oss-carousel-track {
    display: flex;
    gap: 26px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    transition:
      opacity 0.7s var(--ease-panel),
      transform 0.7s var(--ease-panel);
  }
  /* Entrance: the track (survey card first) slides in from the right once the
     carousel reaches 50% visibility; the pending state is only ever set by JS,
     and never under reduced motion. */
  .oss-carousel-track[data-entrance='pending'] {
    opacity: 0;
    transform: translateX(140px);
  }
  .oss-carousel-track::-webkit-scrollbar {
    display: none;
  }
  /* Card shell styles are global (.oss-card in tokens.css); the carousel only
     adds the flex/snap geometry and the bottom-pinned actions row. */
  .oss-card {
    display: flex;
    flex: 0 0 calc(50% - 13px);
    flex-direction: column;
    min-width: 0;
    scroll-snap-align: start;
  }
  .oss-card > .eyebrow {
    margin-top: 24px;
  }
  .oss-card > .eyebrow + h3 {
    margin-top: 8px;
  }
  /* Teaser lead-in: a static thin card with stacked display type and a plain
     arrow glyph; not a control, no hover state, no accent. */
  .oss-card.teaser-card {
    align-items: flex-start;
    color: var(--text-1);
    flex-basis: calc(14% - 13px);
    justify-content: space-between;
    text-align: left;
  }
  .teaser-card span {
    font: 300 24px/1.2 var(--font-display);
    letter-spacing: -0.01em;
  }
  .teaser-card i {
    color: var(--text-3);
    font-size: 26px;
    font-style: normal;
  }
  /* Survey card: two thirds of the row so the next card peeks from the right; the
     interactive island sits in the inner panel with the siblings' top-right glow. */
  .oss-card.survey-card {
    flex-basis: calc(66.666% - 13px);
  }
  .survey-preview {
    background: radial-gradient(70% 100% at 85% 0%, var(--accent-wash-16), var(--bg-inset) 70%);
  }
  .oss-card .actions {
    margin-top: auto;
    padding-top: 22px;
  }

  /* Initiative previews, restored from the retired reports section cards. */
  .initiative-preview {
    background: radial-gradient(70% 100% at 70% 0%, var(--accent-wash-16), var(--bg-inset) 70%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-card);
    padding: 22px;
  }
  .initiative-preview header {
    align-items: center;
    display: flex;
    justify-content: space-between;
  }
  .initiative-preview header span {
    color: var(--text-3);
    font: var(--mono-10) / 1 var(--font-mono);
    letter-spacing: 0.1em;
  }
  .initiative-preview h4 {
    font-size: 19px;
    font-weight: 400;
    margin: 5px 0 20px;
  }
  .initiative-preview > p {
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    font-size: 13px;
    gap: 10px;
    margin: 0;
    padding: 8px 0;
  }
  .initiative-preview > p span,
  .initiative-preview > p i {
    color: var(--text-3);
    font: normal var(--mono-10) / 1 var(--font-mono);
  }
  .initiative-preview > p i {
    margin-left: auto;
  }
  .mlsecops-preview {
    background: var(--bg-inset);
  }
  .mlsecops-preview header {
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 10px;
  }
  .mlsecops-preview > p {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
  }
  .mlsecops-preview > p strong {
    font-weight: 400;
  }

  /* Mobile stays a carousel: near-full-width cards with the next edge peeking;
     the edge zones shrink into the section's own side padding. */
  @media (max-width: 900px) {
    .oss-card,
    .oss-card.survey-card {
      flex-basis: 86%;
    }
    .oss-card.teaser-card {
      flex-basis: 38%;
    }
    .oss-carousel-edge {
      width: 20px;
    }
    .oss-carousel-edge.prev {
      left: -23px;
    }
    .oss-carousel-edge.next {
      right: -23px;
    }
  }
  @media (max-width: 520px) {
    .oss-carousel-edge {
      width: 16px;
    }
    .oss-carousel-edge.prev {
      left: -18px;
    }
    .oss-carousel-edge.next {
      right: -18px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .oss-carousel-bubbles button {
      transition: none;
    }
    .oss-carousel-bubbles.counting button.active i {
      animation: none;
    }
  }
</style>

<script>
  import { bindMorphPairs } from '../shared/MorphPairs';
  import { onRevealed } from '../shared/Reveal';
  import '../shared/canvas/KomputeCube';

  class OpenSourceShowcase extends HTMLElement {
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      bindMorphPairs(this, this.controller.signal);
      this.wireCarousel();
    }

    // Card-by-card navigation over the snap track with a seamless two-clone wrap;
    // the teaser is a lead-in, never a stop. The only automatic movement is one
    // 4s advance after the entrance, counted down on the active bubble, flashed
    // on the next blade, and cancelled by any interaction.
    private wireCarousel() {
      const carousel = this.querySelector<HTMLElement>('.oss-carousel');
      const track = this.querySelector<HTMLElement>('[data-carousel-track]');
      const prev = this.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = this.querySelector<HTMLButtonElement>('[data-carousel-next]');
      const bubbleWrap = this.querySelector<HTMLElement>('[data-carousel-bubbles]');
      const bubbles = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-carousel-bubble]'));
      if (!carousel || !track || !prev || !next || !bubbleWrap) return;
      const signal = this.controller.signal;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const behavior = reduced ? ('auto' as const) : ('smooth' as const);

      // Wrap clones, a pair per edge so each wrap stop shows the same neighbour
      // as its original: [last', first''] ... reals ... [first', second'] — the
      // primed cards are stops, the fillers only complete the visible pair.
      // Landing on a stop clone snaps invisibly to its original once settled.
      const realCards = Array.from(track.querySelectorAll<HTMLElement>('.oss-card:not(.teaser-card)'));
      const first = realCards[0];
      const last = realCards[realCards.length - 1];
      const makeClone = (card: HTMLElement, role: string) => {
        const clone = card.cloneNode(true) as HTMLElement;
        clone.dataset.carouselClone = role;
        clone.setAttribute('aria-hidden', 'true');
        clone.setAttribute('inert', '');
        // Clones are transient wrap frames: no morph wiring, no live island.
        clone.querySelectorAll('[data-morph-source], [data-morph-pair]').forEach((el) => {
          el.removeAttribute('data-morph-source');
          el.removeAttribute('data-morph-pair');
        });
        clone.querySelectorAll('astro-island').forEach((island) => {
          const frame = document.createElement('div');
          frame.innerHTML = island.innerHTML;
          island.replaceWith(frame);
        });
        return clone;
      };
      if (!track.querySelector(':scope > [data-carousel-clone]')) {
        track.prepend(makeClone(first, 'filler'));
        track.prepend(makeClone(last, 'stop-last'));
        track.append(makeClone(first, 'stop-first'));
        track.append(makeClone(realCards[1] ?? first, 'filler'));
      }
      const wrapPrev = track.querySelector<HTMLElement>('[data-carousel-clone="stop-last"]') as HTMLElement;
      const wrapNext = track.querySelector<HTMLElement>('[data-carousel-clone="stop-first"]') as HTMLElement;
      const teaser = track.querySelector<HTMLElement>('.teaser-card');

      const base = track.firstElementChild as HTMLElement;
      const left = (el: HTMLElement) => el.offsetLeft - base.offsetLeft;
      // Navigation stops are the real cards plus the wrap stop clones; never the
      // teaser and never the fillers.
      const stopEls = [wrapPrev, ...realCards, wrapNext];
      const bubbleFor = (el: HTMLElement) => (el === wrapPrev ? realCards.length - 1 : el === wrapNext ? 0 : realCards.indexOf(el));

      const syncBubbles = () => {
        const position = track.scrollLeft;
        let nearest = stopEls[0];
        for (const el of stopEls) {
          if (Math.abs(left(el) - position) < Math.abs(left(nearest) - position)) nearest = el;
        }
        const active = bubbleFor(nearest);
        bubbles.forEach((bubble, index) => bubble.classList.toggle('active', index === active));
      };

      const go = (direction: number) => {
        const position = track.scrollLeft;
        const target = direction > 0 ? stopEls.find((el) => left(el) > position + 4) : [...stopEls].reverse().find((el) => left(el) < position - 4);
        if (target) track.scrollTo({ left: left(target), behavior });
      };

      // Settle detection doubles as the wrap jump: resting on a clone teleports
      // to the identical-looking original.
      let settle: ReturnType<typeof setTimeout> | undefined;
      const normalize = () => {
        const position = track.scrollLeft;
        if (Math.abs(position - left(wrapPrev)) < 8) track.scrollTo({ left: left(last), behavior: 'auto' });
        else if (position > left(wrapNext) - 8) track.scrollTo({ left: left(first), behavior: 'auto' });
      };
      track.addEventListener(
        'scroll',
        () => {
          syncBubbles();
          if (settle !== undefined) clearTimeout(settle);
          settle = setTimeout(normalize, 150);
        },
        { signal, passive: true },
      );

      prev.addEventListener('click', () => go(-1), { signal });
      next.addEventListener('click', () => go(1), { signal });
      bubbles.forEach((bubble, index) => {
        bubble.addEventListener('click', () => track.scrollTo({ left: left(realCards[index]), behavior }), { signal });
      });

      // Open on the teaser lead-in: the prepended clone shifts the track origin.
      requestAnimationFrame(() => {
        if (teaser) track.scrollTo({ left: left(teaser), behavior: 'auto' });
        syncBubbles();
      });

      // Entrance on the global reveal signal (50% visibility with the tall
      // fallback, from the shared Reveal module), then the single counted-down
      // advance. Desktop track only; reduced motion gets neither.
      if (reduced || !window.matchMedia('(min-width: 901px)').matches) return;
      let nudge: ReturnType<typeof setTimeout> | undefined;
      const cancelNudge = () => {
        if (nudge !== undefined) clearTimeout(nudge);
        nudge = undefined;
        bubbleWrap.classList.remove('counting');
      };
      for (const type of ['pointerdown', 'wheel', 'touchstart', 'keydown']) {
        carousel.addEventListener(type, cancelNudge, { signal, passive: true });
      }
      signal.addEventListener('abort', cancelNudge);
      track.dataset.entrance = 'pending';
      onRevealed(
        carousel,
        () => {
          delete track.dataset.entrance;
          bubbleWrap.classList.add('counting');
          nudge = setTimeout(() => {
            nudge = undefined;
            bubbleWrap.classList.remove('counting');
            // Flash the next blade so the movement reads as a visible press.
            next.classList.add('pressed');
            setTimeout(() => next.classList.remove('pressed'), 280);
            go(1);
          }, 4000);
        },
        signal,
      );
    }

    disconnectedCallback() {
      this.controller.abort();
    }
  }

  if (!customElements.get('open-source-showcase')) {
    customElements.define('open-source-showcase', OpenSourceShowcase);
  }
</script>
