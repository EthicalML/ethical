---
/**
 * The talk itself is the subject: scroll swaps the still, the active one offers
 * to play in place. Used both for a curated few on the talks page and for the
 * full set in the prototype, so the two cannot drift.
 *
 * Below 1000px, and for anyone who asked for less motion, ScrollStage stands
 * down and every frame is shown stacked — the reel is an enhancement, never the
 * only way to reach a talk.
 */
import ScrollStage from './ScrollStage.astro';
import EventBanner from './EventBanner.astro';
import VideoLoader from './VideoLoader.astro';
import { loadEvents, eventDate, recordings } from '../utils/Events';
import { tintFor } from '../utils/EventTints';

interface Props {
  /** Talk titles, in the order they should play. Omit for every recording. */
  titles?: string[];
  contactHref?: string;
  contactLabel?: string;
}

const {
  titles = [],
  contactHref = '/contact/?interest=speaking#contact',
  contactLabel = 'Contact for speaking opportunities',
} = Astro.props;

const today = new Date();
const { all } = await loadEvents(today);

const every = all
  .flatMap((event) => recordings(event).map((talk) => ({ event, talk })))
  .sort((left, right) => right.event.start.getTime() - left.event.start.getTime());

// A named list plays in the order given; anything unmatched is dropped rather
// than silently reordered, so a typo shows up as a missing frame.
const order = new Map(titles.map((title, index) => [title, index]));
const reel = titles.length
  ? every
      .filter(({ talk }) => order.has(talk.title))
      .sort((left, right) => order.get(left.talk.title)! - order.get(right.talk.title)!)
  : every;

const videoId = (url?: string) => (url ?? '').match(/[?&]v=([\w-]+)/)?.[1] ?? '';
---

    <ScrollStage class="rl-stage" line={0.42}>
      <div slot="stage" class="rl-screen">
        {
          reel.map(({ event, talk }) => (
            <figure
              class="rl-frame"
              data-stage-item
              data-video-id={videoId(talk.video)}
              data-tint={tintFor(event.topics?.[0], event.slug)[0]}
            >
              {event.image && <img class="rl-backdrop" src={event.image} alt="" loading="lazy" />}
              <span class="rl-inset" data-inset>
                {talk.image ? (
                  <img src={talk.image} alt="" loading="lazy" />
                ) : (
                  <EventBanner
                    slug={event.slug}
                    series={event.series}
                    label={event.series.toUpperCase()}
                    topic={event.topics?.[0]}
                    image={event.image}
                  />
                )}
              </span>
              <figcaption>
                <span class="rl-venue">
                  {event.name} · {eventDate(event)}
                </span>
                <span class="rl-title">{talk.title}</span>
                <span class="rl-actions">
                  <a class="button" href={talk.video} target="_blank" rel="noopener noreferrer">
                    Open video
                  </a>
                  <a class="button primary" href={contactHref}>
                    {contactLabel}
                  </a>
                </span>
              </figcaption>
            </figure>
          ))
        }
        <div class="rl-live" data-live-embed></div>
        <div class="rl-loading" data-loading-slot>
          <VideoLoader />
        </div>
      </div>

      <div slot="steps">
        {
          reel.map(({ event, talk }) => (
            <section class="rl-step" data-stage-step>
              <p class="rl-step-date">{eventDate(event)}</p>
              <h2>{talk.title}</h2>
              <p class="rl-step-venue">
                {event.name}
                {event.location && ` · ${event.location}`}
                {talk.track && ` · ${talk.track}`}
              </p>
              <a class="text-link" href={talk.video} target="_blank" rel="noopener noreferrer">
                Watch on YouTube
              </a>
            </section>
          ))
        }
      </div>
    </ScrollStage>

<style>
  .rl-stage {
    padding: 0 var(--space-40) var(--space-48);
  }
  .rl-screen {
    height: 100%;
    position: relative;
  }
  .rl-frame {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    inset: 0;
    justify-content: flex-end;
    margin: 0;
    opacity: 0;
    padding: var(--space-26);
    position: absolute;
    transition: opacity 0.5s ease;
  }
  .rl-frame[data-active='1'] {
    opacity: 1;
  }
  /* The venue photograph fills the stage; the talk still sits in front of it at
     about two thirds width, so the room is the setting and the slide is the
     subject. */
  .rl-backdrop {
    filter: grayscale(0.35) contrast(1.05);
    height: 100%;
    inset: 0;
    object-fit: cover;
    opacity: 0.3;
    position: absolute;
    width: 100%;
    z-index: 0;
  }
  /* The caption is pinned to the bottom of the frame; the still centres itself
     in whatever is left above it, so lifting the video never drags the text.
     The auto margins do the centring — they absorb the free space before
     justify-content sees it. */
  .rl-inset {
    align-self: center;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--hairline-strong);
    display: block;
    margin: auto;
    min-height: 240px;
    overflow: hidden;
    position: relative;
    width: 72%;
    z-index: 1;
  }
  .rl-inset img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
  .rl-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    margin-top: var(--space-14);
  }
  .rl-actions .button {
    min-height: 44px;
  }
  .rl-venue {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .rl-title {
    color: var(--text-1);
    display: block;
    font-size: 1.1rem;
  }
  figcaption {
    position: relative;
    z-index: 1;
  }
  /* One player, parked over whichever still is active. Eighteen iframes would
     be eighteen player downloads and eighteen sets of cookies; this is one,
     and it only loads once the scroll has settled on a talk. */
  .rl-live {
    display: none;
    position: absolute;
    z-index: 2;
  }
  /* Shown as soon as it holds a player, not once it is ready: a lazily loaded
     iframe inside a display:none box never loads, so gating visibility on the
     load event deadlocked the cue. The loader simply covers it meanwhile. */
  .rl-live:not(:empty) {
    display: block;
  }
  /* Sits exactly where the player will, so the cue becomes the video rather
     than the video appearing beside a spinner. */
  .rl-loading {
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transition: opacity 0.4s ease;
    visibility: hidden;
    z-index: 3;
  }
  .rl-loading[data-showing='1'] {
    opacity: 1;
    visibility: visible;
  }
  .rl-live :global(iframe) {
    border: 0;
    height: 100%;
    width: 100%;
  }
  /* Centred, because the stage switches on the step's midpoint: text sitting at
     the top of a 58vh box is nearly 200px above the point being measured, so a
     talk read as arriving early and leaving late. */
  .rl-step {
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 58vh;
    opacity: 0.3;
    padding: var(--space-34) 0;
    transition: opacity 0.5s ease;
  }
  .rl-step[data-active='1'] {
    opacity: 1;
  }
  .rl-step-date {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    margin: 0;
    text-transform: uppercase;
  }
  .rl-step h2 {
    font-size: 1.4rem;
    line-height: 1.25;
    margin: var(--space-8) 0 var(--space-8);
  }
  .rl-step-venue {
    color: var(--text-3);
    margin: 0 0 var(--space-14);
  }
  @media (max-width: 999px), (prefers-reduced-motion: reduce) {
    .rl-frame {
      opacity: 1;
      margin-bottom: var(--space-26);
      position: static;
    }
    .rl-step {
      min-height: 0;
      opacity: 1;
    }
  }
</style>

<script>
  // The player follows the active talk. It is not autoplay: the embed sits
  // there ready and the visitor presses play.
  //
  // The one rule that matters: react to the active VIDEO changing, not to
  // attribute writes. ScrollStage stamps data-active on every frame on every
  // scroll tick, so an observer that acts on each mutation re-cues eighteen
  // times a scroll — which is what made this flicker.
  const live = document.querySelector<HTMLElement>('[data-live-embed]');
  const slot = document.querySelector<HTMLElement>('[data-loading-slot]');
  const loader = slot?.querySelector<HTMLElement>('[data-loader]');
  const frames = Array.from(document.querySelectorAll<HTMLElement>('.rl-frame'));

  if (live && frames.length) {
    const MIN_CUE = 900;
    let activeId = '';
    let cueShownAt = 0;
    let hideTimer = 0;
    let mountTimer = 0;

    const activeFrame = () => frames.find((frame) => frame.dataset.active === '1');

    // Both overlays take the still's measured rectangle. They were sized as a
    // percentage of the stage while the still is a percentage of the frame's
    // padded content box, so the player came out 26px taller and ran into the
    // caption beneath it.
    const screen = document.querySelector<HTMLElement>('.rl-screen');
    const place = () => {
      const inset = activeFrame()?.querySelector<HTMLElement>('[data-inset]');
      if (!inset || !screen) return;
      const box = inset.getBoundingClientRect();
      const base = screen.getBoundingClientRect();
      for (const node of [live, slot]) {
        if (!node) continue;
        node.style.left = `${box.left - base.left}px`;
        node.style.top = `${box.top - base.top}px`;
        node.style.width = `${box.width}px`;
        node.style.height = `${box.height}px`;
      }
    };

    const showCue = () => {
      if (!slot || !loader) return;
      clearTimeout(hideTimer);
      place();
      // The cue wears the video's own thumbnail, blurred right back, so the
      // handover to the player is a dissolve rather than a cut from a blank
      // panel. YouTube serves this off the image CDN, so it is already warm by
      // the time the embed itself finishes negotiating.
      const id = activeFrame()?.dataset.videoId ?? '';
      slot.style.setProperty('--poster', id ? `url(https://i.ytimg.com/vi/${id}/hqdefault.jpg)` : 'none');
      if (slot.dataset.showing === '1') return;
      cueShownAt = performance.now();
      // Unhidden first so the element is laid out, then flipped on a later
      // frame: opacity cannot transition from a display:none starting point.
      loader.hidden = false;
      requestAnimationFrame(() => {
        slot.dataset.showing = '1';
      });
    };

    // Only ever hides for the talk it was raised for. A player that finishes
    // after the reader has moved on must not uncover someone else's video.
    const hideCueFor = (id: string) => {
      if (!slot || !loader || id !== activeId) return;
      clearTimeout(hideTimer);
      hideTimer = window.setTimeout(
        () => {
          if (id !== activeId) return;
          slot.dataset.showing = '0';
          live.dataset.ready = '1';
          // Teardown waits for the fade, otherwise the cue vanishes mid-transition.
          window.setTimeout(() => {
            if (slot.dataset.showing === '0') loader.hidden = true;
          }, 420);
        },
        Math.max(0, MIN_CUE - (performance.now() - cueShownAt)),
      );
    };

    const mount = (id: string) => {
      if (id !== activeId) return;
      place();
      live.dataset.ready = '0';
      live.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?hl=en" title="Talk recording" allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
      live.querySelector('iframe')?.addEventListener('load', () => hideCueFor(id), { once: true });
      window.setTimeout(() => hideCueFor(id), 6000);
    };

    const wash = document.querySelector<HTMLElement>('.rl-wash');
    const paint = () => {
      const tint = activeFrame()?.dataset.tint;
      if (!wash || !tint) return;
      wash.style.setProperty('--wash', tint);
      wash.dataset.on = '1';
    };

    const sync = () => {
      paint();
      const id = activeFrame()?.dataset.videoId ?? '';
      if (!id) return;
      place();
      if (id === activeId) return; // same talk: nothing to cue, nothing to load
      activeId = id;
      showCue();
      clearTimeout(mountTimer);
      // Settle before building, so scrolling across several talks loads the one
      // you stop on rather than each one you pass.
      mountTimer = window.setTimeout(() => mount(id), 260);
    };

    const observer = new MutationObserver(sync);
    frames.forEach((frame) =>
      observer.observe(frame, { attributes: true, attributeFilter: ['data-active'] }),
    );
    sync();
  }
</script>
