---
import AffiliationMarquee from './AffiliationMarquee.astro';

const footer = {
  about: {
    eyebrow: 'ABOUT THE INSTITUTE',
    text: 'An independent research institute working to ensure that frontier AI is safe, aligned and open for people and society.',
  },
  publicationsEyebrow: 'FROM THE INSTITUTE',
  elsewhere: {
    eyebrow: 'ELSEWHERE',
    links: [
      { label: 'GitHub ↗', href: '/open-source/' },
      { label: 'LinkedIn ↗', href: '/network/' },
      { label: 'YouTube ↗', href: '/talks-and-events/' },
      { label: 'Contact the Institute ↗', href: '/contact/' },
    ],
  },
};
const publications = [
  { kind: 'BLOG', title: 'Production ML, agentic systems & AI safety', href: '/blog/' },
  { kind: 'WEEKLY', title: 'The Machine Learning Engineer newsletter', href: '/newsletter/' },
  { kind: 'TALKS', title: 'Keynotes, conference talks & events', href: '/talks-and-events/' },
  { kind: 'OSS', title: 'Open source projects & curated lists', href: '/open-source/' },
];
---

<aside class="footnote-band" data-reveal>
  <div class="footnote-about">
    <p class="eyebrow">{footer.about.eyebrow}</p><p>{footer.about.text}</p>
    <AffiliationMarquee />
  </div>
  <div class="footnote-talks">
    <p class="eyebrow">{footer.publicationsEyebrow}</p>{
      publications.map((publication) => (
        <a href={publication.href}>
          <>
            <small>{publication.kind}</small>
            <span>{publication.title}</span>
            <b>↗</b>
          </>
        </a>
      ))
    }
  </div>
  <div class="footnote-elsewhere">
    <p class="eyebrow">{footer.elsewhere.eyebrow}</p><div class="footnote-links">
      {footer.elsewhere.links.map(({ label, href }) => <a href={href}>{label}</a>)}
    </div>
  </div>
  <p class="footnote-legal">© {new Date().getFullYear()} The Institute for Ethical AI Alignment & Safety · <a href="/privacy/">Privacy</a></p>
</aside>

<style is:global>
  .footnote-band {
    align-items: start;
    border-top: 1px solid var(--hairline);
    display: grid;
    gap: 44px;
    /* minmax(0, …) not a bare fr: an fr track's automatic minimum is min-content,
       so the longest unbreakable link in a column pushes the grid past the page
       instead of the column shrinking to fit. */
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr) 250px;
    padding: 44px 48px 34px;
  }

  .footnote-band p {
    color: var(--ink-3);
    font-size: 14px;
    line-height: 1.62;
    margin: 0;
    max-width: 520px;
  }

  .footnote-band .eyebrow {
    color: var(--ink-5);
    font: 9.5px/normal var(--font-mono);
    letter-spacing: 0.14em;
  }

  .footnote-about > p:not(.eyebrow) {
    margin-top: 12px;
  }

  .footnote-band a {
    color: var(--ink-3);
    font-size: 13px;
  }

  .footnote-talks {
    display: flex;
    flex-direction: column;
  }

  .footnote-talks > .eyebrow {
    margin-bottom: 10px;
  }

  .footnote-talks a {
    align-items: baseline;
    border-bottom: 1px solid var(--hairline);
    display: flex;
    gap: 12px;
    padding: 7px 0;
  }

  .footnote-talks small {
    color: var(--ink-5);
    flex: none;
    font: 9.5px var(--font-mono);
    letter-spacing: 0.1em;
    width: 52px;
  }

  .footnote-talks a span {
    color: var(--ink-3);
  }

  .footnote-talks b {
    color: var(--accent-ink);
    font-weight: 400;
    margin-left: auto;
  }

  .footnote-links {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 12px;
  }

  .footnote-band .footnote-legal {
    color: var(--ink-5);
    font: 9.5px/normal var(--font-mono);
    grid-column: 1 / -1;
    justify-self: end;
    letter-spacing: 0.1em;
    margin: 8px 0 0;
    max-width: none;
    text-align: right;
  }

  @media (max-width: 950px) {
    .footnote-band {
      padding: 44px 24px;
    }
  }

  @media (max-width: 950px) {
    .footnote-band {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .footnote-band {
      padding: 40px 18px;
    }
  }
</style>
