---
const footer = {
  about: {
    eyebrow: 'ABOUT THE INSTITUTE',
    text: 'An independent research institute working to ensure that frontier AI is safe, aligned and accountable to people and society.',
    standardsLabel: 'Case studies:',
    standards: [
      { label: 'Association for Computing Machinery', href: '/partners/#acm' },
      { label: 'United Nations', href: '/partners/#united-nations' },
      { label: 'European Commission', href: '/partners/#european-commission' },
      { label: 'Linux Foundation', href: '/partners/#linux-foundation' },
      { label: 'NumFOCUS', href: '/partners/#numfocus' },
    ],
  },
  talksEyebrow: 'TALKS & KEYNOTES',
  elsewhere: {
    eyebrow: 'ELSEWHERE',
    links: [
      { label: 'GitHub ↗', href: '/open-source/' },
      { label: 'LinkedIn ↗', href: '/network/' },
      { label: 'YouTube ↗', href: '/talks/' },
      { label: 'Contact the Institute ↗', href: '/contact/' },
    ],
  },
};
const talks = [
  { kind: 'TALK', title: 'NeurIPS 2023 Workshop keynote' },
  { kind: 'TALK', title: 'NeurIPS 2022 — machine learning security' },
  { kind: 'TALK', title: 'KubeCon Europe — ML evaluation at scale' },
  { kind: 'TALK', title: 'PyCon keynote — monitoring, drift and explainability' },
];
const standards = footer.about.standards;
---

<aside class="footnote-band" data-reveal>
  <div class="footnote-about">
    <p class="eyebrow">{footer.about.eyebrow}</p><p>{footer.about.text}</p><div class="standards">
      <span>{footer.about.standardsLabel}</span>
      {standards.map((standard) => <a href={standard.href}>{standard.label}</a>)}
    </div>
  </div>
  <div class="footnote-talks">
    <p class="eyebrow">{footer.talksEyebrow}</p>{
      talks.map((talk) => (
        <a href="/talks/">
          <>
            <small>{talk.kind}</small>
            <span>{talk.title}</span>
            <b>↗</b>
          </>
        </a>
      ))
    }
  </div>
  <div class="footnote-elsewhere">
    <p class="eyebrow">{footer.elsewhere.eyebrow}</p><div class="footnote-links">
      {footer.elsewhere.links.map(({ label, href }) => <a href={href}>{label}</a>)}
    </div>
  </div>
</aside>
