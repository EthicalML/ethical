---
import AffiliationMarquee from './AffiliationMarquee.astro';

const footer = {
  about: {
    eyebrow: 'ABOUT THE INSTITUTE',
    text: 'An independent research institute working to ensure that frontier AI is safe, aligned and accountable to people and society.',
  },
  talksEyebrow: 'TALKS & KEYNOTES',
  elsewhere: {
    eyebrow: 'ELSEWHERE',
    links: [
      { label: 'GitHub ↗', href: '/open-source/' },
      { label: 'LinkedIn ↗', href: '/network/' },
      { label: 'YouTube ↗', href: '/talks/' },
      { label: 'Contact the Institute ↗', href: '/contact/' },
    ],
  },
};
const talks = [
  { kind: 'TALK', title: 'NeurIPS 2023 Workshop Keynote' },
  { kind: 'TALK', title: 'KubeCon Europe Keynote' },
];
---

<aside class="footnote-band" data-reveal>
  <div class="footnote-about">
    <p class="eyebrow">{footer.about.eyebrow}</p><p>{footer.about.text}</p>
    <AffiliationMarquee />
  </div>
  <div class="footnote-talks">
    <p class="eyebrow">{footer.talksEyebrow}</p>{
      talks.map((talk) => (
        <a href="/talks/">
          <>
            <small>{talk.kind}</small>
            <span>{talk.title}</span>
            <b>↗</b>
          </>
        </a>
      ))
    }
    <a class="footnote-all-talks" href="/talks/">All talks</a>
  </div>
  <div class="footnote-elsewhere">
    <p class="eyebrow">{footer.elsewhere.eyebrow}</p><div class="footnote-links">
      {footer.elsewhere.links.map(({ label, href }) => <a href={href}>{label}</a>)}
    </div>
  </div>
  <p class="footnote-legal">© {new Date().getFullYear()} The Institute for Ethical AI Alignment & Safety · <a href="/privacy/">Privacy</a></p>
</aside>

<style is:global>
  .footnote-band {
    align-items: start;
    border-top: 1px solid var(--hairline);
    display: grid;
    gap: 44px;
    grid-template-columns: 1.15fr 0.85fr 250px;
    padding: 44px 48px 34px;
  }

  .footnote-band p {
    color: var(--ink-a610);
    font-size: 14px;
    line-height: 1.62;
    margin: 0;
    max-width: 520px;
  }

  .footnote-band .eyebrow {
    color: var(--ink-a410);
    font: 9.5px/normal var(--font-mono);
    letter-spacing: 0.14em;
  }

  .footnote-about > p:not(.eyebrow) {
    margin-top: 12px;
  }

  .footnote-band a {
    color: var(--ink-a710);
    font-size: 13px;
  }

  .footnote-talks {
    display: flex;
    flex-direction: column;
  }

  .footnote-talks > .eyebrow {
    margin-bottom: 10px;
  }

  .footnote-talks a {
    align-items: baseline;
    border-bottom: 1px solid var(--hairline);
    display: flex;
    gap: 12px;
    padding: 7px 0;
  }

  .footnote-talks small {
    color: var(--ink-5);
    flex: none;
    font: 9.5px var(--font-mono);
    letter-spacing: 0.1em;
    width: 34px;
  }

  .footnote-talks a span {
    color: var(--ink-a740);
  }

  .footnote-talks b {
    color: var(--accent-ink);
    font-weight: 400;
    margin-left: auto;
  }

  .footnote-links {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: 12px;
  }

  .footnote-all-talks {
    color: var(--accent-ink);
    font: var(--mono-10)/1 var(--font-mono);
    letter-spacing: 0.08em;
    margin-top: 14px;
    text-transform: uppercase;
  }

  .footnote-band .footnote-legal {
    color: var(--ink-5);
    font: 9.5px/normal var(--font-mono);
    grid-column: 1 / -1;
    justify-self: end;
    letter-spacing: 0.1em;
    margin: 8px 0 0;
    max-width: none;
    text-align: right;
  }

  @media (max-width: 950px) {
    .footnote-band {
      padding: 44px 24px;
    }
  }

  @media (max-width: 950px) {
    .footnote-band {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .footnote-band {
      padding: 40px 18px;
    }
  }
</style>
