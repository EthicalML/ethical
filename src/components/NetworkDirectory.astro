---
interface Sector {
  name: string;
  value: string;
}

interface Props {
  sectorEyebrow: string;
  sectorHeading: string;
  memberEyebrow: string;
  memberHeading: string;
  members: string[];
  sectors: Sector[];
}

const { sectorEyebrow, sectorHeading, memberEyebrow, memberHeading, members, sectors } = Astro.props;
---

<section class="network-directory" data-reveal>
  <div>
    <p class="eyebrow">{sectorEyebrow}</p>
    <h2>{sectorHeading}</h2>
    {
      sectors.map(({ name, value }) => (
        <p>
          <>
            <span>{name}</span>
            <strong>{value}</strong>
          </>
        </p>
      ))
    }
  </div>
  <div>
    <p class="eyebrow">{memberEyebrow}</p>
    <h2>{memberHeading}</h2>
    <div class="member-wordmarks">{members.map((name) => <span>{name}</span>)}</div>
  </div>
</section>

<style is:global>
.network-directory { display: grid; gap: 60px; grid-template-columns: 1fr 1fr; }

.network-directory > div > p:not(.eyebrow) { border-top: 1px solid var(--hairline); display:flex; justify-content:space-between; margin:0; padding:13px 0; }

.member-wordmarks { display:grid; grid-template-columns:repeat(2,1fr); }

.member-wordmarks span { border:1px solid var(--hairline); color:var(--accent); font:14px var(--font-mono); letter-spacing:.1em; padding:24px; }

.network-section .network-directory { padding: 54px 0 0; }

@media (max-width: 950px) {
  .network-directory { grid-template-columns: 1fr; }
}

@media (max-width: 950px) {
  .network-directory { padding-inline: 24px; }
}

@media (max-width: 600px) {
  .network-directory { padding-inline: 18px; }
  .member-wordmarks { grid-template-columns: 1fr; }
}
</style>
