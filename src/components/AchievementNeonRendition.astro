  }
  achievement-neon-rendition[data-variation='3'] .neon-slot[data-piece='mlsecops'] {
    height: 260px;
    left: 22%;
    top: 300px;
    width: 32%;
  }
  achievement-neon-rendition[data-variation='3'] .neon-slot[data-piece='un'] {
    height: 330px;
    left: 61%;
    top: 290px;
    width: 17%;
  }
  achievement-neon-rendition[data-variation='3'] .neon-slot[data-piece='acm'] {
    height: 280px;
    left: 12%;
    top: 580px;
    width: 35%;
  }
  achievement-neon-rendition[data-variation='3'] .neon-slot[data-piece='through-line'] {
    height: 240px;
    left: 53%;
    top: 620px;
    width: 32%;
  }
  achievement-neon-rendition[data-variation='3'] .neon-filler-west {
    height: 220px;
    left: 0;
    top: 300px;
    width: 16%;
  }
  achievement-neon-rendition[data-variation='3'] .neon-filler-east {
    height: 180px;
    left: 84%;
    top: 80px;
    width: 10%;
  }
  .cascade-diamond {
    background: #171918;
    height: 42px;
    transform: rotate(45deg);
    width: 42px;
    z-index: 1;
  }
  .cascade-diamond-north {
    left: 84%;
    top: 24px;
  }
  .cascade-diamond-south {
    left: 89%;
    top: 732px;
  }
  .ghost-mark {
    color: rgba(244, 242, 238, 0.035);
    font: 300 clamp(116px, 15vw, 190px) / 0.8 var(--font-display);
    letter-spacing: -0.08em;
    position: absolute;
    right: -0.02em;
    top: -0.08em;
    white-space: nowrap;
    z-index: 1;
  }
  .ghost-rule {
    background: var(--neon);
    height: 1px;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
    transform: scaleX(0);
    transform-origin: left;
    z-index: 3;
  }
  achievement-neon-rendition[data-variation='4'][data-entered='true'] .ghost-rule {
    animation: ghost-rule-in 460ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--lego-order) * 60ms + 250ms);
  }
  @keyframes ghost-rule-in {
    to {
      transform: scaleX(1);
    }
  }
  .micro-element {
    left: 50%;
    opacity: 0.42;
    position: absolute;
    right: auto;
    top: 18px;
    transform: translateX(-50%);
    transition:
      filter 300ms ease,
      opacity 300ms ease,
      transform 300ms ease;
    z-index: 3;
  }
  .neon-slot:hover .micro-element,
  .neon-slot[data-active='true'] .micro-element {
    filter: brightness(1.35);
    opacity: 0.95;
    transform: translateX(-50%) scale(1.12);
  }
  .micro-meter {
    align-items: end;
    display: flex;
    gap: 2px;
    height: 22px;
  }
  .micro-meter i {
    background: rgba(244, 242, 238, 0.28);
    display: block;
    height: 9px;
    opacity: 0.18;
    transform: scaleY(0.2);
    transform-origin: bottom;
    width: 2px;
  }
  .micro-meter i[data-adopted='true'] {
    background: var(--neon);
    height: 18px;
  }
  achievement-neon-rendition[data-variation='5'][data-entered='true'] .micro-meter i {
    animation: micro-fill 320ms ease-out both;
    animation-delay: calc(var(--lego-order) * 60ms + var(--micro-index) * 22ms + 260ms);
  }
  @keyframes micro-fill {
    to {
      opacity: 0.9;
      transform: scaleY(1);
    }
  }
  .micro-citation {
    height: 30px;
    width: 64px;
  }
  .micro-citation::before {
    background: rgba(244, 242, 238, 0.24);
    content: '';
    height: 1px;
    left: 7px;
    position: absolute;
    top: 14px;
    width: 50px;
  }
  .micro-citation i {
    background: #0f100f;
    border: 1px solid rgba(244, 242, 238, 0.4);
    height: 7px;
    position: absolute;
    top: 11px;
    width: 7px;
  }
  .micro-citation i:nth-child(1) {
    left: 3px;
  }
  .micro-citation i:nth-child(2) {
    background: var(--neon);
    border-color: var(--neon);
    left: 28px;
  }
  .micro-citation i:nth-child(3) {
    right: 3px;
  }
  .micro-citation i:nth-child(2) {
    animation: citation-ping 3.8s ease-out infinite;
  }
  @keyframes citation-ping {
    0%,
    12%,
    100% {
      box-shadow: 0 0 0 0 rgba(56, 189, 248, 0);
    }
    5% {
      box-shadow: 0 0 0 7px rgba(56, 189, 248, 0.24);
    }
  }
  .micro-ring {
    border: 1px solid rgba(244, 242, 238, 0.2);
    border-radius: 50%;
    border-right-color: var(--neon);
    border-top-color: var(--neon);
    height: 34px;
    width: 34px;
    animation: ring-turn 12s linear infinite;
  }
  @keyframes ring-turn {
    to {
      transform: translateX(-50%) rotate(360deg);
    }
  }
  .neon-slot:hover .micro-ring,
  .neon-slot[data-active='true'] .micro-ring {
    transform: translateX(-50%) scale(1.12);
  }
  .micro-arc {
    height: 30px;
    width: 72px;
  }
  .micro-arc svg {
    height: 100%;
    overflow: visible;
    width: 100%;
  }
  .micro-arc path {
    animation: arc-redraw 5.2s ease-in-out infinite;
    fill: none;
    stroke: var(--neon);
    stroke-dasharray: 82;
    stroke-width: 1;
  }
  .micro-arc circle {
    fill: var(--neon);
  }
  @keyframes arc-redraw {
    0%,
    18% {
      stroke-dashoffset: 82;
    }
    34%,
    100% {
      stroke-dashoffset: 0;
    }
  }
  .micro-rail {
    background: rgba(244, 242, 238, 0.24);
    height: 1px;
    width: 72px;
  }
  .micro-rail i:nth-child(1),
  .micro-rail i:nth-child(2) {
    background: #0f100f;
    border: 1px solid var(--neon);
    border-radius: 50%;
    height: 7px;
    position: absolute;
    top: -3px;
    width: 7px;
  }
  .micro-rail i:nth-child(1) {
    left: 0;
  }
  .micro-rail i:nth-child(2) {
    right: 0;
  }
  .micro-rail i:nth-child(3) {
    animation: rail-blip 4s ease-in-out infinite;
    background: var(--neon);
    border-radius: 50%;
    height: 5px;
    left: 0;
    position: absolute;
    top: -2px;
    width: 5px;
  }
  @keyframes rail-blip {
    0%,
    15%,
    100% {
      opacity: 0;
      transform: translateX(0);
    }
    4% {
      opacity: 1;
    }
    14% {
      opacity: 0;
      transform: translateX(67px);
    }
  }
  achievement-neon-rendition[data-motion-ready='true']:not([data-entered='true']) [data-lego-piece] {
    opacity: 0;
    transform: translate3d(0, -150px, 0) rotate(var(--drop-rotation, 1.6deg));
  }
  achievement-neon-rendition[data-entered='true'] [data-lego-piece]:not([data-settled='true']) {
    animation: lego-click 360ms cubic-bezier(0.18, 0.78, 0.22, 1) both;
    animation-delay: calc(var(--lego-order) * 60ms);
  }
  [data-lego-piece][data-neighbour-nudge='true'] {
    transform: translate3d(var(--impact-x), 0, 0);
    transition: transform 55ms ease-out;
  }
  @keyframes lego-click {
    0% {
      opacity: 0;
      transform: translate3d(0, -150px, 0) rotate(var(--drop-rotation, 1.6deg));
    }
    72% {
      opacity: 1;
      transform: translate3d(0, 0, 0) rotate(0deg) scaleY(1);
    }
    83% {
      opacity: 1;
      transform: translate3d(0, 2px, 0) scale(1.006, 0.982);
    }
    92% {
      opacity: 1;
      transform: translate3d(0, -1px, 0) scale(0.998, 1.004);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .neon-slot:hover .neon-card {
      transform: translate3d(var(--shift-x), var(--shift-y), 0);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .neon-slot[data-active='true'] .neon-card {
      transform: translate3d(var(--shift-x), var(--shift-y), 0);
    }
  }
  @media (max-width: 900px) {
    .achievement-neon-rendition {
      overflow: clip !important;
    }
    .neon-canvas,
    achievement-neon-rendition[data-variation='3'] .neon-canvas {
      display: grid;
      gap: 58px;
      height: auto;
      padding-inline: 34px;
    }
    .neon-filler,
    .cascade-diamond {
      display: none;
    }
    .neon-slot,
    achievement-neon-rendition[data-variation='3'] .neon-slot {
      --shift-x: 0px !important;
      --shift-y: 44px !important;
      height: auto !important;
      left: auto !important;
      min-height: 280px;
      position: relative;
      top: auto !important;
      width: auto !important;
    }
    .neon-slot[data-piece='mlsecops'] {
      min-height: 300px;
    }
    .neon-slot[data-piece='un'] {
      min-height: 360px;
    }
  }
