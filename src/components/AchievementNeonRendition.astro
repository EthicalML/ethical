---
import AchievementVisual from './AchievementVisual.astro';

interface AchievementLink {
  href: string;
  label: string;
}

interface AchievementCard {
  eyebrow: string;
  glyph: 'eu-adoption' | 'uk-adoption' | 'citation-network' | 'un-chair' | 'acm-bridges' | 'policy-timeline';
  links: AchievementLink[];
  piece: string;
  summary: string;
  title: string;
}

interface Props {
  cards: AchievementCard[];
  mode: 'scroll' | 'triggered';
}

const { cards, mode } = Astro.props;
const neon = ['#5ee6a0', '#35d787', '#38bdf8', '#ff3b57', '#a855f7', '#ff5c1f'];
const shifts = [
  { x: 22, y: 0 },
  { x: -18, y: 0 },
  { x: 20, y: 0 },
  { x: 22, y: -4 },
  { x: -16, y: 18 },
  { x: 16, y: 18 },
];
---

<achievement-neon-rendition class="achievement-neon-rendition" data-mode={mode}>
  <div class="neon-canvas">
    <i class="lego-piece neon-filler neon-filler-west" data-lego-piece data-order="0" aria-hidden="true"></i>
    <i class="lego-piece neon-filler neon-filler-east" data-lego-piece data-order="6" aria-hidden="true"></i>
    {
      cards.map((card, index) => (
        <div
          class="lego-piece neon-slot"
          data-lego-piece
          data-neon-slot
          data-order={index + 1}
          data-piece={card.piece}
          style={`--neon:${neon[index]};--shift-x:${shifts[index].x}px;--shift-y:${shifts[index].y}px;--drop-rotation:${index % 2 ? -1.6 : 1.6}deg`}
        >
          <i class="neon-underlay" data-neon-block aria-hidden="true" />
          <article class="neon-card">
            <AchievementVisual variant={card.glyph} />
            <div class="neon-copy">
              <span>{card.eyebrow}</span>
              <strong>{card.title}</strong>
              <p>{card.summary}</p>
              <footer>
                {card.links.map((link) => {
                  const external = link.href.startsWith('http');
                  return (
                    <a href={link.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
                      {link.label} →
                    </a>
                  );
                })}
              </footer>
            </div>
          </article>
        </div>
      ))
    }
  </div>
</achievement-neon-rendition>

<script>
  class AchievementNeonRenditionElement extends HTMLElement {
    private controller = new AbortController();
    private frame?: number;
    private impactTimers: number[] = [];
    private observer?: IntersectionObserver;

    connectedCallback() {
      this.controller = new AbortController();
      const pieces = [...this.querySelectorAll<HTMLElement>('[data-lego-piece]')];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      this.addEventListener('click', this.handleTap, { signal: this.controller.signal });
      window.addEventListener('keydown', this.handleKey, { signal: this.controller.signal });

      if (reduced) {
        this.dataset.assembled = 'true';
        pieces.forEach((piece) => this.setPieceProgress(piece, 1, 0));
        return;
      }

      if (this.dataset.mode === 'scroll') {
        window.addEventListener('scroll', this.requestScrollFrame, { passive: true, signal: this.controller.signal });
        window.addEventListener('resize', this.requestScrollFrame, { passive: true, signal: this.controller.signal });
        this.requestScrollFrame();
        return;
      }

      this.dataset.motionReady = 'true';
      if (!('IntersectionObserver' in window)) {
        this.enterTriggered(pieces);
        return;
      }
      this.observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          this.enterTriggered(pieces);
          this.observer?.disconnect();
        },
        { threshold: 0.08 },
      );
      this.observer.observe(this);
    }

    disconnectedCallback() {
      this.controller.abort();
      this.observer?.disconnect();
      if (this.frame) cancelAnimationFrame(this.frame);
      this.impactTimers.forEach((timer) => clearTimeout(timer));
      this.impactTimers = [];
    }

    private handleTap = (event: MouseEvent) => {
      const target = event.target as HTMLElement;
      if (target.closest('a') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const slot = target.closest<HTMLElement>('[data-neon-slot]');
      this.querySelectorAll<HTMLElement>('[data-neon-slot][data-active="true"]').forEach((active) => {
        if (active !== slot) delete active.dataset.active;
      });
      if (!slot) return;
      if (slot.dataset.active === 'true') delete slot.dataset.active;
      else slot.dataset.active = 'true';
    };

    private handleKey = (event: KeyboardEvent) => {
      if (event.key !== 'Escape') return;
      this.querySelectorAll<HTMLElement>('[data-neon-slot][data-active="true"]').forEach((slot) => delete slot.dataset.active);
    };

    private requestScrollFrame = () => {
      if (this.frame) return;
      this.frame = requestAnimationFrame(() => {
        this.frame = undefined;
        this.updateScrollAssembly();
      });
    };

    private updateScrollAssembly() {
      const pieces = [...this.querySelectorAll<HTMLElement>('[data-lego-piece]')];
      const bounds = this.getBoundingClientRect();
      const start = innerHeight * 0.92;
      const end = innerHeight * 0.18;
      const progress = Math.max(0, Math.min(1, (start - bounds.top) / (start - end)));
      const maximumOrder = Math.max(...pieces.map((piece) => Number(piece.dataset.order ?? 0)), 1);
      const localProgress = pieces.map((piece) => {
        const order = Number(piece.dataset.order ?? 0);
        return Math.max(0, Math.min(1, progress * 1.35 - (order / maximumOrder) * 0.35));
      });
      const impact = Math.max(...localProgress.map((value) => this.impactAmount(value)));
      pieces.forEach((piece, index) => this.setPieceProgress(piece, localProgress[index], impact));
      this.style.setProperty('--assembly-progress', progress.toFixed(3));
      this.dataset.assemblyProgress = progress.toFixed(3);
      this.dataset.assembled = String(progress >= 0.998);
    }

    private setPieceProgress(piece: HTMLElement, progress: number, impact: number) {
      const order = Number(piece.dataset.order ?? 0);
      const drop = 150 + (order % 3) * 18;
      let y: number;
      let scaleY = 1;
      if (progress < 0.78) {
        const travel = progress / 0.78;
        const eased = travel * travel * (3 - 2 * travel);
        y = -drop * (1 - eased);
      } else if (progress < 0.9) {
        const compression = (progress - 0.78) / 0.12;
        y = 2 * compression;
        scaleY = 1 - 0.018 * compression;
      } else {
        const settle = (progress - 0.9) / 0.1;
        y = 2 * (1 - settle);
        scaleY = 0.982 + 0.018 * settle;
      }
      const nudge = (order % 2 ? 1 : -1) * impact * 1.5;
      piece.style.setProperty('--lego-x', `${nudge.toFixed(2)}px`);
      piece.style.setProperty('--lego-y', `${y.toFixed(2)}px`);
      piece.style.setProperty('--lego-opacity', String(Math.min(1, progress / 0.15)));
      piece.style.setProperty('--lego-rotation', `${((1 - progress) * (order % 2 ? -1.6 : 1.6)).toFixed(2)}deg`);
      piece.style.setProperty('--lego-scale-y', scaleY.toFixed(3));
      piece.dataset.pieceProgress = progress.toFixed(3);
    }

    private impactAmount(progress: number) {
      if (progress < 0.78 || progress > 0.96) return 0;
      return Math.sin(((progress - 0.78) / 0.18) * Math.PI);
    }

    private enterTriggered(pieces: HTMLElement[]) {
      if (this.dataset.entered === 'true') return;
      this.dataset.entered = 'true';
      pieces.forEach((piece) => {
        const order = Number(piece.dataset.order ?? 0);
        piece.style.setProperty('--lego-order', String(order));
        piece.addEventListener('animationend', () => (piece.dataset.settled = 'true'), {
          once: true,
          signal: this.controller.signal,
        });
        const timer = window.setTimeout(() => this.nudgeNeighbours(piece), order * 60 + 250);
        this.impactTimers.push(timer);
      });
    }

    private nudgeNeighbours(landingPiece: HTMLElement) {
      this.querySelectorAll<HTMLElement>('[data-lego-piece][data-settled="true"]').forEach((piece) => {
        if (piece === landingPiece) return;
        piece.dataset.neighbourNudge = 'true';
        piece.style.setProperty('--impact-x', Number(piece.dataset.order ?? 0) % 2 ? '1.5px' : '-1.5px');
        const timer = window.setTimeout(() => delete piece.dataset.neighbourNudge, 58);
        this.impactTimers.push(timer);
      });
    }
  }

  if (!customElements.get('achievement-neon-rendition')) {
    customElements.define('achievement-neon-rendition', AchievementNeonRenditionElement);
  }
</script>

<style>
  .achievement-neon-rendition {
    display: block;
    overflow: clip;
  }
  .neon-canvas {
    height: 890px;
    margin: 0 auto;
    max-width: 1344px;
    position: relative;
  }
  .lego-piece {
    opacity: var(--lego-opacity, 1);
    position: absolute;
    transform: translate3d(var(--lego-x, 0), var(--lego-y, 0), 0) rotate(var(--lego-rotation, 0deg)) scaleY(var(--lego-scale-y, 1));
    transform-origin: center bottom;
    will-change: transform, opacity;
  }
  .neon-slot {
    z-index: 2;
  }
  .neon-slot[data-piece='eu'] {
    height: 280px;
    left: 24%;
    top: 0;
    width: 52%;
  }
  .neon-slot[data-piece='uk'] {
    height: 280px;
    left: 24%;
    top: 280px;
    width: 26%;
  }
  .neon-slot[data-piece='mlsecops'] {
    height: 280px;
    left: 50%;
    top: 280px;
    width: 26%;
  }
  .neon-slot[data-piece='un'] {
    height: 420px;
    left: 80%;
    top: 140px;
    width: 18%;
  }
  .neon-slot[data-piece='acm'] {
    height: 310px;
    left: 5%;
    top: 560px;
    width: 38%;
  }
  .neon-slot[data-piece='through-line'] {
    height: 310px;
    left: 43%;
    top: 560px;
    width: 37%;
  }
  .neon-underlay,
  .neon-card {
    inset: 0;
    position: absolute;
  }
  .neon-underlay {
    background: var(--neon);
    z-index: 1;
  }
  .neon-card {
    background: #1a1c1b;
    border: 0;
    color: var(--text-1);
    transform: translate3d(0, 0, 0);
    transition:
      outline-color 180ms ease,
      transform 240ms cubic-bezier(0.2, 0.9, 0.25, 1.15);
    z-index: 2;
  }
  .neon-slot:nth-of-type(even) .neon-card {
    background: #181a19;
  }
  .neon-copy {
    bottom: 0;
    left: 0;
    padding: 24px 26px 25px;
    position: absolute;
    right: 0;
  }
  .neon-copy > span {
    color: var(--text-4);
    display: block;
    font: var(--mono-9) / 1.4 var(--font-mono);
    letter-spacing: 0.1em;
    margin-bottom: 12px;
    text-transform: uppercase;
  }
  .neon-copy > strong {
    display: block;
    font: 300 clamp(31px, 2.7vw, 44px) / 1.02 var(--font-display);
    max-width: 16ch;
  }
  .neon-copy > p {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.5;
    margin: 13px 0 0;
    max-width: 48ch;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 14px;
    margin-top: 15px;
  }
  footer a {
    color: var(--accent);
    font: var(--mono-9) / 1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .neon-filler {
    background: #151716;
    z-index: 1;
  }
  .neon-filler-west {
    height: 280px;
    left: 5%;
    top: 280px;
    width: 19%;
  }
  .neon-filler-east {
    height: 310px;
    left: 80%;
    top: 560px;
    width: 18%;
  }
  achievement-neon-rendition[data-mode='triggered'][data-motion-ready='true']:not([data-entered='true']) [data-lego-piece] {
    opacity: 0;
    transform: translate3d(0, -168px, 0) rotate(var(--drop-rotation, 1.6deg));
  }
  achievement-neon-rendition[data-mode='triggered'][data-entered='true'] [data-lego-piece]:not([data-settled='true']) {
    animation: lego-click 360ms cubic-bezier(0.18, 0.78, 0.22, 1) both;
    animation-delay: calc(var(--lego-order) * 60ms);
  }
  [data-lego-piece][data-neighbour-nudge='true'] {
    transform: translate3d(var(--impact-x), 0, 0);
    transition: transform 55ms ease-out;
  }
  @keyframes lego-click {
    0% {
      opacity: 0;
      transform: translate3d(0, -168px, 0) rotate(var(--drop-rotation, 1.6deg));
    }
    72% {
      opacity: 1;
      transform: translate3d(0, 0, 0) rotate(0deg) scaleY(1);
    }
    83% {
      opacity: 1;
      transform: translate3d(0, 2px, 0) scale(1.006, 0.982);
    }
    92% {
      opacity: 1;
      transform: translate3d(0, -1px, 0) scale(0.998, 1.004);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .neon-slot:hover .neon-card {
      transform: translate3d(var(--shift-x), var(--shift-y), 0);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .neon-slot[data-active='true'] .neon-card {
      transform: translate3d(var(--shift-x), var(--shift-y), 0);
    }
  }
  @media (max-width: 900px) {
    .neon-canvas {
      display: grid;
      gap: 32px;
      height: auto;
      padding-inline: 30px;
    }
    .neon-filler {
      display: none;
    }
    .neon-slot {
      --shift-x: 0px !important;
      --shift-y: 16px !important;
      height: auto !important;
      left: auto !important;
      min-height: 320px;
      position: relative;
      top: auto !important;
      width: auto !important;
    }
  }
  @media (max-width: 600px) {
    .neon-canvas {
      padding-inline: 22px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lego-piece {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .neon-underlay {
      display: none;
    }
    .neon-card {
      transition: outline-color 180ms ease;
    }
    .neon-card:hover {
      outline: 1px solid var(--accent);
      outline-offset: -1px;
    }
  }
</style>
