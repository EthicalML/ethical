  achievement-neon-rendition[data-variation='3'] {
    overflow: visible;
  }
  achievement-neon-rendition[data-variation='3'] .neon-canvas {
    height: 860px;
  }
  achievement-neon-rendition[data-variation='3'] .neon-slot[data-piece='eu'] {
    height: 210px;
    left: 4%;
    top: 50px;
    width: 46%;
  }
  achievement-neon-rendition[data-variation='3'] .neon-slot[data-piece='uk'] {
