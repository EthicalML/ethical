---
interface AchievementLink {
  href: string;
  label: string;
}

interface AchievementCard {
  eyebrow: string;
  footnote?: string;
  glyph?: 'scatter' | 'bracket' | 'tee' | 'corner';
  links: AchievementLink[];
  piece: string;
  summary: string;
  title: string;
}

interface Block {
  area: string;
  dir: number;
  size: 'long' | 'short';
}

interface Dud {
  area: string;
  shape: 'square' | 'diamond' | 'triangle' | 'plain' | 'accent' | 'diamond-open';
}

interface Layout {
  areas: string[];
  blocks: Record<string, Block>;
  duds: Dud[];
}

interface Props {
  cards: AchievementCard[];
  layout: Layout;
  variant: 1 | 2 | 3;
}

const { cards, layout, variant } = Astro.props;

// Card colour: green for the two adoption cards, then blue, purple, orange, red.
const neon = ['#5ee6a0', '#35d787', '#38bdf8', '#a855f7', '#ff5c1f', '#ff3b57'];
// V1 / V2 ghost surface: an oversized dim identifier cropped by the block edge.
const ghostLabels = ['8/12', '13/14', 'CODE', 'UN', 'ACM', '2026'];

// Card displacement on reveal. The ghost variants slide horizontally out of the
// cell (sign from the block); the collage lifts diagonally up-left, uncovering a
// neon slab on the bottom and right edges as in the artifact.
const ghostLongTravel = 58;
const ghostShortTravel = 46;
const collageTravel = 30;
const isCollage = variant === 3;

// ---------------------------------------------------------------------------
// V3 pixel-cluster glyphs, lifted from the Set Table artifact. Each glyph is a
// small cell grid (3x3) with one accent pixel in the card's neon colour.
// ---------------------------------------------------------------------------
const glyphCells: Record<NonNullable<AchievementCard['glyph']>, { cells: number[][]; on: number[] }> = {
  scatter: {
    cells: [
      [0, 0],
      [2, 0],
      [1, 1],
      [0, 2],
      [2, 2],
    ],
    on: [1, 1],
  },
  bracket: {
    cells: [
      [0, 0],
      [0, 1],
      [0, 2],
      [1, 2],
    ],
    on: [0, 0],
  },
  tee: {
    cells: [
      [0, 0],
      [1, 0],
      [2, 0],
      [1, 1],
      [1, 2],
    ],
    on: [1, 0],
  },
  corner: {
    cells: [
      [0, 0],
      [1, 0],
      [0, 1],
      [1, 1],
    ],
    on: [0, 0],
  },
};
const glyphRects = (name: NonNullable<AchievementCard['glyph']>) => {
  const g = glyphCells[name];
  return g.cells.map(([x, y]) => ({ x: x * 4, y: y * 4, on: x === g.on[0] && y === g.on[1] }));
};

// ---------------------------------------------------------------------------
// Placement derived from the layout map so a new block is a data change. Entrance
// order is bottom-up (blocks stack from the floor) so lower rows land first.
// ---------------------------------------------------------------------------
const grid = layout.areas.map((row) => row.trim().split(/\s+/));
const columns = grid[0].length;
const templateAreas = grid.map((row) => `"${row.join(' ')}"`).join(' ');
const placement: Record<string, { col: number; rowBottom: number }> = {};
grid.forEach((row, r) =>
  row.forEach((token, c) => {
    if (token === '.') return;
    const seen = placement[token];
    if (!seen) placement[token] = { col: c, rowBottom: r };
    else {
      seen.col = Math.min(seen.col, c);
      seen.rowBottom = Math.max(seen.rowBottom, r);
    }
  }),
);
const orderOf = Object.fromEntries(
  Object.keys(placement)
    .sort((a, b) => placement[b].rowBottom - placement[a].rowBottom || placement[a].col - placement[b].col)
    .map((token, index) => [token, index + 1]),
);

const placed = cards.map((card, index) => {
  const block = layout.blocks[card.piece];
  const order = orderOf[block.area];
  const base = block.size === 'long' ? ghostLongTravel : ghostShortTravel;
  const shiftX = isCollage ? -collageTravel : block.dir * base;
  const shiftY = isCollage ? -collageTravel : 0;
  return { card, index, block, order, shiftX, shiftY };
});
// Duds are inert: a raised surface, no neon and no slide. They land with the
// stack (order) but never reveal or move on hover.
const duds = layout.duds.map((dud) => ({ area: dud.area, shape: dud.shape, order: orderOf[dud.area] }));
---

<achievement-neon-rendition class="achievement-neon-rendition" data-variation={variant}>
  <div class="neon-canvas" style={`--columns:${columns};--rows:${grid.length};grid-template-areas:${templateAreas}`}>
    {
      placed.map(({ card, index, block, order, shiftX, shiftY }) => (
        <div
          class="lego-piece neon-slot"
          data-lego-piece
          data-neon-slot
          data-order={order}
          data-size={block.size}
          data-piece={card.piece}
          style={`grid-area:${block.area};--neon:${neon[index]};--shift-x:${shiftX}px;--shift-y:${shiftY}px;--drop-rotation:${order % 2 ? -1.6 : 1.6}deg;--fall-dur:${block.size === 'long' ? 440 : 320}ms`}
        >
          <i class="neon-underlay" data-neon-block aria-hidden="true" />
          <article class="neon-card">
            {!isCollage && (
              <span class="ghost-mark" aria-hidden="true">
                {ghostLabels[index]}
              </span>
            )}
            {!isCollage && <i class="ghost-rule" aria-hidden="true" />}

            <div class="neon-copy">
              {isCollage ? (
                <svg class="glyph" viewBox="0 0 11 11" width="20" height="20" aria-hidden="true">
                  {glyphRects(card.glyph ?? 'scatter').map((r) => (
                    <rect x={r.x} y={r.y} width="3" height="3" class:list={['glyph-px', { 'glyph-on': r.on }]} />
                  ))}
                </svg>
              ) : (
                <span class="eyebrow">{card.eyebrow}</span>
              )}
              <strong>{card.title}</strong>
              <p>{card.summary}</p>
              {isCollage && card.footnote && <span class="footnote">{card.footnote}</span>}
              <footer>
                {(block.size === 'long' ? card.links : card.links.slice(0, 1)).map((link) => {
                  const external = link.href.startsWith('http');
                  return (
                    <a href={link.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
                      {link.label} →
                    </a>
                  );
                })}
              </footer>
            </div>
          </article>
        </div>
      ))
    }
    {
      duds.map((dud) => (
        <div
          class="lego-piece dud"
          data-lego-piece
          data-order={dud.order}
          data-shape={dud.shape}
          style={`grid-area:${dud.area};--drop-rotation:${dud.order % 2 ? -1.6 : 1.6}deg;--fall-dur:320ms`}
        >
          {(dud.shape === 'square' || dud.shape === 'plain' || dud.shape === 'accent' || dud.shape === 'diamond-open') && (
            <span class="dud-face" aria-hidden="true" />
          )}
          {dud.shape === 'diamond' && (
            <svg class="dud-shape" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <polygon points="50,0 100,50 50,100 0,50" />
            </svg>
          )}
          {dud.shape === 'triangle' && (
            <svg class="dud-shape" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
              <polygon points="50,0 100,100 0,100" />
            </svg>
          )}
          {dud.shape === 'diamond-open' && (
            <svg class="dud-outline" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
              <polygon points="50,6 94,50 50,94 6,50" />
            </svg>
          )}
        </div>
      ))
    }
  </div>
</achievement-neon-rendition>

<script>
  class AchievementNeonRenditionElement extends HTMLElement {
    private controller = new AbortController();
    private frame?: number;
    private impactTimers: number[] = [];

    connectedCallback() {
      this.controller = new AbortController();
      const pieces = [...this.querySelectorAll<HTMLElement>('[data-lego-piece]')];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      pieces.forEach((piece) => piece.style.setProperty('--lego-order', piece.dataset.order ?? '0'));
      this.addEventListener('click', this.handleTap, { signal: this.controller.signal });
      window.addEventListener('keydown', this.handleKey, { signal: this.controller.signal });

      if (reduced) {
        this.dataset.entered = 'true';
        pieces.forEach((piece) => (piece.dataset.settled = 'true'));
        return;
      }

      this.dataset.motionReady = 'true';
      window.addEventListener('scroll', this.requestEntranceFrame, { passive: true, signal: this.controller.signal });
      window.addEventListener('resize', this.requestEntranceFrame, { passive: true, signal: this.controller.signal });
      this.requestEntranceFrame();
    }

    disconnectedCallback() {
      this.controller.abort();
      if (this.frame) cancelAnimationFrame(this.frame);
      this.impactTimers.forEach((timer) => clearTimeout(timer));
      this.impactTimers = [];
    }

    private handleTap = (event: MouseEvent) => {
      const target = event.target as HTMLElement;
      if (target.closest('a') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const slot = target.closest<HTMLElement>('[data-neon-slot]');
      this.querySelectorAll<HTMLElement>('[data-neon-slot][data-active="true"]').forEach((active) => {
        if (active !== slot) delete active.dataset.active;
      });
      if (!slot) return;
      if (slot.dataset.active === 'true') delete slot.dataset.active;
      else slot.dataset.active = 'true';
    };

    private handleKey = (event: KeyboardEvent) => {
      if (event.key !== 'Escape') return;
      this.querySelectorAll<HTMLElement>('[data-neon-slot][data-active="true"]').forEach((slot) => delete slot.dataset.active);
    };

    private requestEntranceFrame = () => {
      if (this.frame || this.dataset.entered === 'true') return;
      this.frame = requestAnimationFrame(() => {
        this.frame = undefined;
        this.updateEntranceProgress();
      });
    };

    private updateEntranceProgress() {
      if (this.offsetParent === null) return;
      const bounds = this.getBoundingClientRect();
      const scrollReach = Math.min(bounds.height, innerHeight);
      const progress = Math.max(0, Math.min(1, (innerHeight - bounds.top) / scrollReach));
      this.dataset.entranceProgress = progress.toFixed(3);
      if (progress < 0.75) {
        // A zoomed-out or very tall viewport can make 0.75 unreachable (no scroll distance
        // left); fire once the section is visible rather than never entering.
        const scroller = document.scrollingElement;
        const remaining = scroller ? Math.max(0, scroller.scrollHeight - innerHeight - scroller.scrollTop) : 0;
        const maxProgress = Math.max(0, Math.min(1, (innerHeight - (bounds.top - remaining)) / scrollReach));
        const visible = bounds.top < innerHeight && bounds.bottom > 0;
        if (maxProgress >= 0.75 || !visible) return;
      }
      this.enterTriggered([...this.querySelectorAll<HTMLElement>('[data-lego-piece]')]);
    }

    private enterTriggered(pieces: HTMLElement[]) {
      if (this.dataset.entered === 'true') return;
      this.dataset.entered = 'true';
      this.dataset.triggerProgress = this.dataset.entranceProgress ?? '0.750';
      pieces.forEach((piece) => {
        if (getComputedStyle(piece).display === 'none') {
          piece.dataset.settled = 'true';
          return;
        }
        const order = Number(piece.dataset.order ?? 0);
        const onAnimationEnd = (event: AnimationEvent) => {
          if (event.target !== piece || event.animationName !== 'lego-click') return;
          piece.dataset.settled = 'true';
          piece.removeEventListener('animationend', onAnimationEnd);
        };
        piece.addEventListener('animationend', onAnimationEnd, { signal: this.controller.signal });
        const timer = window.setTimeout(() => this.nudgeNeighbours(piece), order * 60 + 250);
        this.impactTimers.push(timer);
      });
    }

    private nudgeNeighbours(landingPiece: HTMLElement) {
      this.querySelectorAll<HTMLElement>('[data-lego-piece][data-settled="true"]').forEach((piece) => {
        if (piece === landingPiece) return;
        piece.dataset.neighbourNudge = 'true';
        piece.style.setProperty('--impact-x', Number(piece.dataset.order ?? 0) % 2 ? '1.5px' : '-1.5px');
        const timer = window.setTimeout(() => delete piece.dataset.neighbourNudge, 58);
        this.impactTimers.push(timer);
      });
    }
  }

  if (!customElements.get('achievement-neon-rendition')) {
    customElements.define('achievement-neon-rendition', AchievementNeonRenditionElement);
  }
</script>

<style>
  .achievement-neon-rendition {
    display: block;
  }
  /* A fixed cell grid driven by grid-template-areas from the layout map. Long
     blocks span two cells; duds fill the gaps. Row height and canvas width are
     per-variant so the stack, the full-width grid and the collage each read
     correctly while clearing the sticky navs inside a 900px viewport. */
  .neon-canvas {
    --row-h: 180px;
    display: grid;
    gap: 0;
    grid-template-columns: repeat(var(--columns), 1fr);
    grid-template-rows: repeat(var(--rows), var(--row-h));
    margin: 0 auto;
    max-width: 1000px;
  }
  [data-variation='2'] .neon-canvas {
    --row-h: 236px;
    max-width: 1180px;
  }
  [data-variation='3'] .neon-canvas {
    --row-h: 230px;
    max-width: 1180px;
  }
  /* The slot is NOT clipped: on reveal the card physically slides out of its own
     cell (see the slide rule), so a hovered card is lifted above its neighbours. */
  .neon-slot {
    position: relative;
    z-index: 2;
  }
  .neon-slot:hover,
  .neon-slot[data-active='true'] {
    z-index: 10;
  }
  .neon-underlay,
  .neon-card {
    inset: 0;
    position: absolute;
  }
  /* The neon under-block sits only within the card's original footprint, so when
     the card slides off it the colour is revealed on the vacated side only. It
     stays transparent at rest and fades in while revealing. */
  .neon-underlay {
    background: var(--neon);
    opacity: 0;
    transition: opacity 300ms ease;
    z-index: 0;
  }
  .neon-slot:hover .neon-underlay,
  .neon-slot[data-active='true'] .neon-underlay {
    opacity: 1;
  }
  .neon-card {
    background: #171918;
    border: 1px solid var(--hairline-card);
    color: var(--text-1);
    overflow: hidden;
    transform: translate3d(0, 0, 0);
    transition:
      outline-color 180ms ease,
      transform 1000ms cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 2;
  }
  .neon-slot[data-size='long'] .neon-card {
    background: #131615;
  }

  /* --- Dud blocks: inert raised surfaces, no neon and no slide. Filled square,
     45deg diamond and triangle (stretched to fill the whole cell), a plain dark
     back, a solid neon-green accent slab, and a large faint centred diamond
     outline for the collage. --- */
  .dud {
    position: relative;
    z-index: 1;
  }
  .dud-face {
    background: #212423;
    border: 1px solid var(--hairline-card);
    inset: 0;
    position: absolute;
  }
  .dud[data-shape='plain'] .dud-face,
  .dud[data-shape='diamond-open'] .dud-face {
    background: #131615;
  }
  .dud[data-shape='accent'] .dud-face {
    background: var(--accent);
    border-color: transparent;
  }
  .dud-shape {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }
  .dud-shape polygon {
    fill: #212423;
    stroke: var(--hairline-card);
    stroke-linejoin: round;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .dud-outline {
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
  }
  .dud-outline polygon {
    fill: none;
    stroke: rgba(244, 242, 238, 0.16);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* --- Copy: consistent anatomy across all variants. Anchored to the TOP so the
     eyebrow/glyph, one-line title and description align at identical offsets on
     every card; the description length may vary, links sit below. --- */
  .neon-copy {
    left: 0;
    padding: 16px 18px;
    position: absolute;
    right: 0;
    top: 0;
    z-index: 6;
  }
  .neon-copy > .eyebrow {
    color: var(--text-4);
    display: block;
    font: var(--mono-8) / 1.3 var(--font-mono);
    height: 12px;
    letter-spacing: 0.1em;
    overflow: hidden;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .neon-copy > .glyph {
    display: block;
    height: 20px;
    width: 20px;
  }
  .glyph-px {
    fill: rgba(244, 242, 238, 0.34);
  }
  .glyph-on {
    fill: var(--neon);
  }
  /* Title is a HARD single line: ellipsis when it does not fit, never two. */
  .neon-copy > strong {
    display: block;
    margin-top: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .neon-slot[data-size='long'] .neon-copy > strong {
    font: 300 clamp(26px, 2.6vw, 36px) / 1.1 var(--font-display);
    letter-spacing: -0.02em;
  }
  .neon-slot[data-size='short'] .neon-copy > strong {
    font: 300 clamp(19px, 2vw, 23px) / 1.15 var(--font-display);
    letter-spacing: -0.01em;
  }
  .neon-copy > p {
    color: var(--text-2);
    display: -webkit-box;
    font-size: 12.5px;
    line-height: 1.45;
    margin: 9px 0 0;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .neon-slot[data-size='short'] .neon-copy > p {
    -webkit-line-clamp: 2;
  }
  .neon-copy > .footnote {
    color: var(--accent);
    display: block;
    font: var(--mono-8) / 1.4 var(--font-mono);
    letter-spacing: 0.12em;
    margin-top: 14px;
    text-transform: uppercase;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: 12px;
  }
  footer a {
    color: var(--accent);
    font: var(--mono-8) / 1.3 var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* --- V1 / V2 ghost numerals (cropped by the block edge, capped to ~50% of the
     card so a long label overflows the top-right but never spans wider) --- */
  .ghost-mark {
    color: rgba(244, 242, 238, 0.05);
    font: 300 100px/0.8 var(--font-display);
    letter-spacing: -0.08em;
    max-width: 50%;
    overflow: hidden;
    position: absolute;
    right: -0.02em;
    top: -0.1em;
    white-space: nowrap;
    z-index: 1;
  }
  .neon-slot[data-size='long'] .ghost-mark {
    font-size: clamp(86px, 9vw, 124px);
  }
  .neon-slot[data-size='short'] .ghost-mark {
    font-size: clamp(56px, 8vw, 78px);
    right: -0.04em;
  }
  .ghost-rule {
    background: var(--neon);
    height: 1px;
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
    transform: scaleX(0);
    transform-origin: left;
    z-index: 5;
  }
  achievement-neon-rendition[data-entered='true'] .ghost-rule {
    animation: ghost-rule-in 460ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--lego-order) * 60ms + 250ms);
  }
  @keyframes ghost-rule-in {
    to {
      transform: scaleX(1);
    }
  }

  /* --- Lego entrance (shared; singles fall snappier than doubles) --- */
  achievement-neon-rendition[data-motion-ready='true']:not([data-entered='true']) [data-lego-piece] {
    opacity: 0;
    transform: translate3d(0, -150px, 0) rotate(var(--drop-rotation, 1.6deg));
  }
  achievement-neon-rendition[data-entered='true'] [data-lego-piece]:not([data-settled='true']) {
    animation: lego-click var(--fall-dur, 360ms) cubic-bezier(0.18, 0.78, 0.22, 1) both;
    animation-delay: calc(var(--lego-order) * 60ms);
  }
  [data-lego-piece][data-neighbour-nudge='true'] {
    transform: translate3d(var(--impact-x), 0, 0);
    transition: transform 55ms ease-out;
  }
  @keyframes lego-click {
    0% {
      opacity: 0;
      transform: translate3d(0, -150px, 0) rotate(var(--drop-rotation, 1.6deg));
    }
    72% {
      opacity: 1;
      transform: translate3d(0, 0, 0) rotate(0deg) scaleY(1);
    }
    83% {
      opacity: 1;
      transform: translate3d(0, 2px, 0) scale(1.006, 0.982);
    }
    92% {
      opacity: 1;
      transform: translate3d(0, -1px, 0) scale(0.998, 1.004);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  /* --- Slide reveal (shared): on hover the CARD slides out of its cell toward the
     open space (horizontally for the ghost variants, diagonally up-left for the
     collage) and lifts above its neighbours, uncovering the neon under-block
     within its original footprint. --- */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .neon-slot:hover .neon-card {
      transform: translate3d(var(--shift-x), var(--shift-y), 0);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .neon-slot[data-active='true'] .neon-card {
      transform: translate3d(var(--shift-x), var(--shift-y), 0);
    }
  }

  /* --- Responsive: hold the grid to a tablet width, then a single column --- */
  @media (max-width: 900px) {
    .neon-canvas,
    [data-variation='2'] .neon-canvas,
    [data-variation='3'] .neon-canvas {
      display: flex;
      flex-direction: column;
      gap: 14px;
      max-width: none;
      padding-inline: 34px;
    }
    .neon-slot {
      grid-area: auto !important;
      height: 300px;
    }
    .dud {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .neon-canvas {
      padding-inline: 24px;
    }
    .neon-slot {
      --shift-x: 52px !important;
      --shift-y: 0px !important;
    }
  }

  /* --- Reduced motion: static settled stack, outline hover only --- */
  @media (prefers-reduced-motion: reduce) {
    .lego-piece {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .neon-underlay {
      display: none;
    }
    .ghost-rule {
      transform: scaleX(1);
    }
    .neon-card {
      transition: outline-color 180ms ease;
    }
    .neon-card:hover {
      outline: 1px solid var(--accent);
      outline-offset: -1px;
    }
  }
</style>
