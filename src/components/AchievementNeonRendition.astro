---
import AchievementVisual from './AchievementVisual.astro';

interface AchievementLink {
  href: string;
  label: string;
}

interface AchievementCard {
  eyebrow: string;
  glyph: 'eu-adoption' | 'uk-adoption' | 'citation-network' | 'un-chair' | 'acm-bridges' | 'policy-timeline';
  links: AchievementLink[];
  piece: string;
  summary: string;
  title: string;
}

interface Props {
  cards: AchievementCard[];
  variant: 1 | 2 | 3 | 4 | 5;
}

const { cards, variant } = Astro.props;
const neon = ['#5ee6a0', '#35d787', '#38bdf8', '#ff3b57', '#a855f7', '#ff5c1f'];
const ghostLabels = ['8/12', '13/14', 'CODE', 'UN', 'ACM', '2026'];
const baseShifts = [
  { x: -55, y: 0 },
  { x: -45, y: 0 },
  { x: 50, y: 0 },
  { x: 42, y: -45 },
  { x: -42, y: 42 },
  { x: 42, y: 42 },
];
const cascadeShifts = [
  { x: 55, y: -40 },
  { x: 45, y: 40 },
  { x: -50, y: 0 },
  { x: 45, y: -40 },
  { x: -42, y: 40 },
  { x: 45, y: 40 },
];
const shifts = variant === 3 ? cascadeShifts : baseShifts;
---

<achievement-neon-rendition class="achievement-neon-rendition" data-variation={variant}>
  <div class="neon-canvas">
    <i class="lego-piece neon-filler neon-filler-west" data-lego-piece data-order="0" aria-hidden="true"></i>
    <i class="lego-piece neon-filler neon-filler-east" data-lego-piece data-order="6" aria-hidden="true"></i>
    {variant === 3 && <i class="lego-piece cascade-diamond cascade-diamond-north" data-lego-piece data-order="2" aria-hidden="true" />}
    {variant === 3 && <i class="lego-piece cascade-diamond cascade-diamond-south" data-lego-piece data-order="7" aria-hidden="true" />}
    {
      cards.map((card, index) => (
        <div
          class="lego-piece neon-slot"
          data-lego-piece
          data-neon-slot
          data-order={index + 1}
          data-piece={card.piece}
          style={`--neon:${neon[index]};--shift-x:${shifts[index].x}px;--shift-y:${shifts[index].y}px;--drop-rotation:${index % 2 ? -1.6 : 1.6}deg`}
        >
          <div class="neon-reveal-clip" aria-hidden="true">
            <i class="neon-underlay" data-neon-block />
          </div>
          <article class="neon-card">
            {variant <= 3 && <AchievementVisual variant={card.glyph} />}
            {variant === 4 && (
              <span class="ghost-mark" aria-hidden="true">
                {ghostLabels[index]}
              </span>
            )}
            {variant === 4 && <i class="ghost-rule" aria-hidden="true" />}
            {variant === 5 && index < 2 && (
              <span class="micro-element micro-meter" aria-hidden="true">
                {Array.from({ length: index === 0 ? 12 : 14 }, (_, segment) => (
                  <i data-adopted={segment < (index === 0 ? 8 : 13) ? 'true' : undefined} style={`--micro-index:${segment}`} />
                ))}
              </span>
            )}
            {variant === 5 && index === 2 && (
              <span class="micro-element micro-citation" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
            )}
            {variant === 5 && index === 3 && <span class="micro-element micro-ring" aria-hidden="true" />}
            {variant === 5 && index === 4 && (
              <span class="micro-element micro-arc" aria-hidden="true">
                <svg viewBox="0 0 72 28">
                  <path d="M5 22Q36-8 67 22" />
                  <circle cx="5" cy="22" r="3" />
                  <circle cx="67" cy="22" r="3" />
                </svg>
              </span>
            )}
            {variant === 5 && index === 5 && (
              <span class="micro-element micro-rail" aria-hidden="true">
                <i />
                <i />
                <i />
              </span>
            )}
            <div class="neon-copy">
              <span>{card.eyebrow}</span>
              <strong>{card.title}</strong>
              <p>{card.summary}</p>
              <footer>
                {card.links.map((link) => {
                  const external = link.href.startsWith('http');
                  return (
                    <a href={link.href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
                      {link.label} →
                    </a>
                  );
                })}
              </footer>
            </div>
          </article>
        </div>
      ))
    }
  </div>
</achievement-neon-rendition>

<script>
  class AchievementNeonRenditionElement extends HTMLElement {
    private controller = new AbortController();
    private frame?: number;
    private impactTimers: number[] = [];

    connectedCallback() {
      this.controller = new AbortController();
      const pieces = [...this.querySelectorAll<HTMLElement>('[data-lego-piece]')];
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      pieces.forEach((piece) => piece.style.setProperty('--lego-order', piece.dataset.order ?? '0'));
      this.addEventListener('click', this.handleTap, { signal: this.controller.signal });
      window.addEventListener('keydown', this.handleKey, { signal: this.controller.signal });

      if (reduced) {
        this.dataset.entered = 'true';
        pieces.forEach((piece) => (piece.dataset.settled = 'true'));
        return;
      }

      this.dataset.motionReady = 'true';
      window.addEventListener('scroll', this.requestEntranceFrame, { passive: true, signal: this.controller.signal });
      window.addEventListener('resize', this.requestEntranceFrame, { passive: true, signal: this.controller.signal });
      this.requestEntranceFrame();
    }

    disconnectedCallback() {
      this.controller.abort();
      if (this.frame) cancelAnimationFrame(this.frame);
      this.impactTimers.forEach((timer) => clearTimeout(timer));
      this.impactTimers = [];
    }

    private handleTap = (event: MouseEvent) => {
      const target = event.target as HTMLElement;
      if (target.closest('a') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const slot = target.closest<HTMLElement>('[data-neon-slot]');
      this.querySelectorAll<HTMLElement>('[data-neon-slot][data-active="true"]').forEach((active) => {
        if (active !== slot) delete active.dataset.active;
      });
      if (!slot) return;
      if (slot.dataset.active === 'true') delete slot.dataset.active;
      else slot.dataset.active = 'true';
    };

    private handleKey = (event: KeyboardEvent) => {
      if (event.key !== 'Escape') return;
      this.querySelectorAll<HTMLElement>('[data-neon-slot][data-active="true"]').forEach((slot) => delete slot.dataset.active);
    };

    private requestEntranceFrame = () => {
      if (this.frame || this.dataset.entered === 'true') return;
      this.frame = requestAnimationFrame(() => {
        this.frame = undefined;
        this.updateEntranceProgress();
      });
    };

    private updateEntranceProgress() {
      if (this.offsetParent === null) return;
      const bounds = this.getBoundingClientRect();
      const scrollReach = Math.min(bounds.height, innerHeight);
      const progress = Math.max(0, Math.min(1, (innerHeight - bounds.top) / scrollReach));
      this.dataset.entranceProgress = progress.toFixed(3);
      if (progress < 0.75) return;
      this.enterTriggered([...this.querySelectorAll<HTMLElement>('[data-lego-piece]')]);
    }

    private enterTriggered(pieces: HTMLElement[]) {
      if (this.dataset.entered === 'true') return;
      this.dataset.entered = 'true';
      this.dataset.triggerProgress = this.dataset.entranceProgress ?? '0.750';
      pieces.forEach((piece) => {
        if (getComputedStyle(piece).display === 'none') {
          piece.dataset.settled = 'true';
          return;
        }
        const order = Number(piece.dataset.order ?? 0);
        const onAnimationEnd = (event: AnimationEvent) => {
          if (event.target !== piece || event.animationName !== 'lego-click') return;
          piece.dataset.settled = 'true';
          piece.removeEventListener('animationend', onAnimationEnd);
        };
        piece.addEventListener('animationend', onAnimationEnd, { signal: this.controller.signal });
        const timer = window.setTimeout(() => this.nudgeNeighbours(piece), order * 60 + 250);
        this.impactTimers.push(timer);
      });
    }

    private nudgeNeighbours(landingPiece: HTMLElement) {
      this.querySelectorAll<HTMLElement>('[data-lego-piece][data-settled="true"]').forEach((piece) => {
        if (piece === landingPiece) return;
        piece.dataset.neighbourNudge = 'true';
        piece.style.setProperty('--impact-x', Number(piece.dataset.order ?? 0) % 2 ? '1.5px' : '-1.5px');
        const timer = window.setTimeout(() => delete piece.dataset.neighbourNudge, 58);
        this.impactTimers.push(timer);
      });
    }
  }

  if (!customElements.get('achievement-neon-rendition')) {
    customElements.define('achievement-neon-rendition', AchievementNeonRenditionElement);
  }
</script>

<style>
  .achievement-neon-rendition {
    display: block;
    overflow: clip;
  }
  .neon-canvas {
    height: 850px;
    margin: 0 auto;
    max-width: 1120px;
    position: relative;
  }
  .lego-piece {
    position: absolute;
    transform-origin: center bottom;
  }
  .neon-slot {
    z-index: 2;
  }
  .neon-slot[data-piece='eu'] {
    height: 220px;
    left: 25%;
    top: 0;
    width: 46%;
  }
  .neon-slot[data-piece='uk'] {
    height: 310px;
    left: 25%;
    top: 240px;
    width: 20%;
  }
  .neon-slot[data-piece='mlsecops'] {
    height: 310px;
    left: 49%;
    top: 240px;
    width: 25%;
  }
  .neon-slot[data-piece='un'] {
    height: 440px;
    left: 79%;
    top: 110px;
    width: 16%;
  }
  .neon-slot[data-piece='acm'] {
    height: 280px;
    left: 6%;
    top: 570px;
    width: 36%;
  }
  .neon-slot[data-piece='through-line'] {
    height: 280px;
    left: 47%;
    top: 570px;
    width: 33%;
  }
  .neon-reveal-clip,
  .neon-underlay,
  .neon-card {
    inset: 0;
    position: absolute;
  }
  .neon-reveal-clip {
    overflow: hidden;
    z-index: 1;
  }
  .neon-underlay {
    background: var(--neon);
  }
  .neon-card {
    background: #1a1c1b;
    border: 0;
    color: var(--text-1);
    overflow: hidden;
    transform: translate3d(0, 0, 0);
    transition:
      outline-color 180ms ease,
      transform 1000ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
    z-index: 2;
  }
  .neon-slot:nth-of-type(even) .neon-card {
    background: #181a19;
  }
  achievement-neon-rendition[data-variation='2'] .neon-card {
    background: #000;
  }
  .neon-copy {
    bottom: auto;
    left: 0;
    padding: 18px 20px 19px;
    position: absolute;
    right: 0;
    top: 76px;
    z-index: 2;
  }
  .neon-copy > span {
    color: var(--text-4);
    display: block;
    font: var(--mono-8) / 1.35 var(--font-mono);
    letter-spacing: 0.1em;
    margin-bottom: 9px;
    text-transform: uppercase;
  }
  .neon-copy > strong {
    display: block;
