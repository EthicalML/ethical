---
import '../styles/tokens.css';
import '../styles/prose.css';
import '../styles/layout.css';
import SiteHeader from '../components/SiteHeader.astro';
import FootnoteBand from '../components/FootnoteBand.astro';
import site from '../data/site.json';

const { frontmatter = {} } = Astro.props;
const title = frontmatter.title ?? 'The Institute for Ethical AI Alignment & Safety';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={site.metaDescription} />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader />
    <main>
      {frontmatter.eyebrow && (
        <header class="prose-header" data-reveal>
          <p class="eyebrow">{frontmatter.eyebrow}</p>
          <h1>{frontmatter.title}</h1>
        </header>
      )}
      <slot />
    </main>
    <FootnoteBand />
    <footer class="site-footer">
      <span>{site.footer.identity}</span>
      <span>{site.footer.legal}</span>
    </footer>
    <script is:inline src="/assets/site.js"></script>
    <script is:inline src="/assets/canvases.js"></script>
    <script is:inline src="/assets/widget-kaos.js"></script>
  </body>
</html>
