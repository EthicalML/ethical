---
import '../styles/tokens.css';
import '../styles/prose.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '../components/SiteHeader.astro';
import FootnoteBand from '../components/FootnoteBand.astro';
import { siteTitle } from '../data/navigation';
import { authors } from '../data/authors';

const metaDescription = 'An independent research institute working to ensure that frontier AI is safe, aligned and open for people and society.';
const ogImage = '/images/banner.jpg';
const { frontmatter = {} } = Astro.props;
const title = frontmatter.title ?? siteTitle;
const seoTitle = frontmatter.seoTitle ?? title;
const description = frontmatter.seoDescription ?? frontmatter.description ?? metaDescription;
// canonicalPath also accepts an absolute URL: republished blog posts point
// their canonical at the original publication off-site.
const canonical = new URL(frontmatter.canonicalPath ?? Astro.url.pathname, Astro.site);
const socialImage = new URL(frontmatter.image ?? ogImage, Astro.site);
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteTitle,
  alternateName: 'The Institute for Ethical AI & Machine Learning',
  url: 'https://ethical.institute/',
  logo: new URL('/favicon.png', Astro.site).href,
  sameAs: [
    'https://github.com/EthicalML',
    'https://machinelearning.substack.com',
    'https://www.linkedin.com/newsletters/the-machine-learning-engineer-6882216044568571904/',
  ],
};
// Named authors resolve through src/data/authors.ts so Person entities carry
// url and sameAs (the E-E-A-T record); unknown names fall back to name-only.
const person = (name: string) => {
  const record = authors[name];
  return record ? { '@type': 'Person', name, url: new URL(record.aboutAnchor, Astro.site).href, sameAs: record.sameAs } : { '@type': 'Person', name };
};
const article = frontmatter.article
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: frontmatter.articleHeadline ?? title,
      description,
      url: canonical.href,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
      image: socialImage.href,
      ...(frontmatter.datePublished ? { datePublished: frontmatter.datePublished } : {}),
      ...(frontmatter.sameAs?.length ? { sameAs: frontmatter.sameAs } : {}),
      author: frontmatter.articleAuthors?.length
        ? frontmatter.articleAuthors.length === 1
          ? person(frontmatter.articleAuthors[0])
          : frontmatter.articleAuthors.map(person)
        : {
            '@type': 'Organization',
            name: organization.name,
            url: organization.url,
          },
      publisher: {
        '@type': 'Organization',
        name: organization.name,
        url: organization.url,
        logo: { '@type': 'ImageObject', url: organization.logo },
      },
    }
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="google-site-verification" content="9rfgBQEvfnZ7HS_kBzINrlrJ-_sJcyJxqEUltqvP9Og" />
    <meta name="description" content={description} />
    {frontmatter.noindex && <meta name="robots" content="noindex" />}
    {!frontmatter.noCanonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title="The ML Engineer newsletter" href="/newsletter/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Production ML, responsible AI and alignment blog" href="/blog/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <meta property="og:type" content={frontmatter.article ? 'article' : 'website'} />
    {frontmatter.article && frontmatter.datePublished && <meta property="article:published_time" content={frontmatter.datePublished} />}
    {frontmatter.article && frontmatter.articleTags?.map((tag: string) => <meta property="article:tag" content={tag} />)}
    <meta property="og:site_name" content="The Institute for Ethical AI Alignment & Safety" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    {article && <script is:inline type="application/ld+json" set:html={JSON.stringify(article)} />}
    <script is:inline>
      // Stamp the stored theme before the first paint, or a light-mode visitor sees a
      // frame of dark. Both `is:inline` and the position in <head> are load-bearing: a
      // bundled/deferred script runs after paint, and an init script at document-start
      // has no `document.documentElement` to write to yet.
      //
      // Dark is the default and `prefers-color-scheme` is deliberately NOT consulted —
      // the theme is an explicit, persisted choice, and an OS fallback would silently
      // flip every headless capture (Playwright emulates light by default).
      //
      // The key must stay `theme`: the verification harness seeds `localStorage.theme`
      // to drive light captures, and a rename would make every light run capture dark.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          // Safari private mode throws on any storage access; fall through to the default.
        }
        document.documentElement.dataset.theme = stored === 'light' ? 'light' : 'dark';
      })();
    </script>
    <script is:inline>
      // The router keeps history.scrollRestoration = 'manual', so on reload the browser
      // paints the top of the page before any script can restore the position — a
      // flicker no post-paint code can beat. When a deep restore is pending, keep the
      // body invisible (background only) from before first paint until the document is
      // tall enough to jump, capped at 800ms so it can never stick. Runs only on real
      // page loads; the router marks inline scripts executed across view transitions.
      (() => {
        const stored = history.state;
        const top = (stored && stored.scrollY) || 0;
        if (!top) return;
        const veil = document.createElement('style');
        veil.textContent = 'body { visibility: hidden }';
        document.head.appendChild(veil);
        const deadline = performance.now() + 800;
        const tick = () => {
          if (Math.abs(scrollY - top) < 2 || performance.now() > deadline) {
            veil.remove();
            return;
          }
          if (document.body && document.documentElement.scrollHeight > top) {
            scrollTo({ left: stored.scrollX || 0, top, behavior: 'instant' });
            veil.remove();
            return;
          }
          requestAnimationFrame(tick);
        };
        tick();
      })();
    </script>
    <ClientRouter />
    <style is:inline>
      /* The pre-hide only ever covers what has not been marked revealed yet. Two things
         clear it without waiting for the reveal bundle: the pre-paint script at the foot
         of <body>, which marks every first-viewport target revealed so LCP text paints
         with the document instead of on script execution, and the <noscript> override
         below, which un-hides everything when there is no script to reveal it. */
      [data-reveal]:not([data-reveal='trigger']):not([data-revealed='1']) {
        opacity: 0;
        transform: translateY(26px);
      }
      /* Flipping the theme repaints every themed property at once. Hundreds of them sit
         behind a colour transition, so without this the page smears through a half-lit
         intermediate at whatever durations happen to be declared. The class is added for
         the single frame the flip lands on and removed on the next one. */
      html.is-theme-switching,
      html.is-theme-switching *,
      html.is-theme-switching *::before,
      html.is-theme-switching *::after {
        transition: none !important;
      }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal]:not([data-reveal='trigger']):not([data-revealed='1']) {
          opacity: 1;
          transform: none;
        }
        ::view-transition-group(*),
        ::view-transition-image-pair(*) {
          animation: revert !important;
        }
        ::view-transition-old(*) {
          animation: content-fade-out 0.22s ease both !important;
        }
        ::view-transition-new(*) {
          animation: content-fade-in 0.22s ease both !important;
        }
        ::view-transition-old(root) {
          animation: content-fade-out 0.22s ease both !important;
        }
        ::view-transition-new(root) {
          animation: content-settle 0.22s ease both !important;
        }
      }
    </style>
    <noscript>
      <!-- Reveal is the only thing that clears the pre-hide, so without script the whole
           page below the first viewport would stay at opacity 0 for ever. Same selector as
           the rule above and later in the cascade, so it wins on source order. -->
      <style>
        [data-reveal]:not([data-reveal='trigger']):not([data-revealed='1']) {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-L2HXV1W6H6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // eslint-disable-next-line prefer-rest-params
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-L2HXV1W6H6');
      let initialPageLoad = true;
      document.addEventListener('astro:page-load', () => {
        if (initialPageLoad) {
          initialPageLoad = false;
          return;
        }
        gtag('config', 'G-L2HXV1W6H6', {
          page_path: location.pathname + location.search,
          page_title: document.title,
        });
      });
    </script>
    <title>{seoTitle}</title>
  </head>
  <body>
    <SiteHeader />
    {
      /* data-pagefind-body scopes the search index to real page content: any dist
        HTML without it (raw legacy /mle archive, redirect stubs) stays unindexed. */
    }
    <main data-pagefind-body data-pagefind-meta={`title:${title}`}>
      <slot name="before-hero" />
      {
        frontmatter.eyebrow && (
          <header class="prose-header" data-reveal>
            <p class="eyebrow">{frontmatter.eyebrow}</p>
            <h1
              transition:name={frontmatter.transitionName}
              style={frontmatter.transitionName ? `view-transition-name: ${frontmatter.transitionName}` : undefined}
              data-principle-transition-title={frontmatter.transitionName?.startsWith('principle-title-') ? '' : undefined}
            >
              {frontmatter.title}
            </h1>
          </header>
        )
      }
      <slot />
    </main>
    <FootnoteBand />
    <script is:inline>
      // Exempt the first viewport from the reveal pre-hide, before the first paint —
      // otherwise LCP waits on the deferred reveal bundle (measured ~950ms vs a 40-70ms
      // FCP). Both `is:inline` and the position are load-bearing: the script must run in
      // the parser, after the body exists (rects measurable) and before paint. It does
      // not re-run on client-side navigation; `new Reveal(true)` settles those. Below
      // the fold and `trigger` roots are untouched.
      document.querySelectorAll('[data-reveal]:not([data-reveal="trigger"])').forEach((target) => {
        if (target.getBoundingClientRect().top < innerHeight) target.setAttribute('data-revealed', '1');
      });
      // `data-paint-hold` opts out elements whose own script rewrites their text at
      // mount (the hero typewriter): painting the server copy first would flash before
      // the wipe. `visibility` keeps layout still; held from script so a scriptless
      // client is never held. The owner clears the hold once its text is correct.
      document.querySelectorAll('[data-paint-hold]').forEach((held) => {
        held.style.visibility = 'hidden';
      });
    </script>
    <script>
      import '../shared/MorphPairs';
      import '../shared/Motion';
      import '../shared/Reveal';
      import '../shared/ScrollRestoration';
      import '../shared/Theme';
    </script>
  </body>
</html>
