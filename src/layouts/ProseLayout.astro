---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout frontmatter={frontmatter}>
  {
    frontmatter.composed ? (
      <slot />
    ) : (
      <article class:list={['prose-page', frontmatter.eyebrow && 'has-outer-header']}>
        <header class="prose-header" data-reveal>
          <p class="eyebrow">{frontmatter.eyebrow ?? 'THE INSTITUTE'}</p>
          <h1>{frontmatter.title}</h1>
        </header>
        <div class="prose-content">
          <slot />
        </div>
      </article>
    )
  }
</BaseLayout>

<style is:global>
.prose-content > p {
  color: var(--text-2);
  font-size: var(--body-18);
  line-height: 1.7;
  margin: 0;
  max-width: 840px;
  padding: 0 48px 72px;
}

.prose-section > p a,
.prose-section > ul a,
.prose-content p a,
.prose-content ul a { color: var(--accent); }

@media (max-width: 800px) {
  .prose-content > p {
      padding-left: 24px;
      padding-right: 24px;
    }
}

@media (max-width: 950px) {
  .prose-content > p { padding: 0 24px 64px; }
}

@media (max-width: 600px) {
  .prose-content > p {
      font-size: 16px;
      padding: 0 18px 54px;
    }
}
</style>
