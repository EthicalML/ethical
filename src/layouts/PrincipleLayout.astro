---
import BaseLayout from './BaseLayout.astro';
import SplitList from '../components/SplitList.astro';
import KaosGraph from '../components/KaosGraph.astro';

const { data, Content } = Astro.props;
const frontmatter = {
  title: `${data.number}. ${data.title}`,
  seoTitle: `${data.title} — Responsible AI Principle ${Number(data.number)}`,
  description: data.description,
  eyebrow: `PRINCIPLE ${data.number} — COMMITMENT`,
  transitionName: `principle-title-${data.number}`,
};
const number = Number(data.number);
const previous = number > 1 ? String(number - 1).padStart(2, '0') : undefined;
const next = number < 9 ? String(number + 1).padStart(2, '0') : undefined;
---

<BaseLayout frontmatter={frontmatter}>
  <article class="principle-prose" data-reveal transition:name="principle-page">
    {data.failure_modes && <p class="commitment">{data.commitment}</p>}
    <Content />
  </article>
  {
    data.failure_modes && data.controls && (
      <SplitList left={{ title: 'FAILURE MODES', items: data.failure_modes }} right={{ title: 'PRACTICAL CONTROLS', items: data.controls }} />
    )
  }
  {data.number === '09' && <KaosGraph />}
  <nav class="principle-pagination" aria-label="Adjacent principles">
    {
      previous && (
        <a href={`/principles/${previous}/`} data-transition-direction="back">
          ← Previous principle
        </a>
      )
    }
    {
      next && (
        <a href={`/principles/${next}/`} data-transition-direction="forward">
          Next principle →
        </a>
      )
    }
  </nav>
</BaseLayout>

<style is:global>
  .principle-prose {
    color: var(--text-2);
    font-size: var(--body-18);
    line-height: 1.7;
    max-width: 840px;
    padding: 0 48px;
  }

  @media (max-width: 950px) {
    .principle-prose {
      padding: 0 24px;
    }
  }

  .principle-pagination {
    display: flex;
    justify-content: space-between;
    padding: 28px 48px 96px;
  }

  .principle-pagination a {
    border: 1px solid var(--hairline-card);
    border-radius: var(--radius-pill);
    padding: 10px 16px;
  }

  @media (max-width: 950px) {
    .principle-pagination {
      flex-wrap: wrap;
      gap: 12px;
      padding: 28px 24px 72px;
    }
  }

  @media (max-width: 600px) {
    .principle-prose {
      font-size: 16px;
      padding-inline: 18px;
    }
  }

  @media (max-width: 600px) {
    .principle-pagination {
      align-items: stretch;
      flex-direction: column;
      padding: 24px 18px 60px;
    }
  }
</style>
