---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHero from '../../components/ArticleHero.astro';

/* Not exported: .astro components may not export values (astro/no-exports-from-components),
   so the llms.txt catalogue keeps its own entry for this route. */
const frontmatter = {
  title: 'Branding',
  seoTitle: 'Branding: the Institute logo, mark, colour and type',
  description:
    'The identity of The Institute for Ethical AI Alignment & Safety: wordmark and mark lockups to download, the brand palette, and the typeface behind them.',
};

/* Every lockup is a committed outlined SVG under public/branding/, generated by
   scripts/build-logo-svgs.mjs. Each carries its own artwork background, which is why the
   dark tiles stay dark on a light page: the background is part of the asset. */
const lockups = [
  { id: 'wordmark', name: 'Wordmark, left aligned', size: '960 × 220' },
  { id: 'horizontal', name: 'Horizontal lockup', size: '960 × 220' },
  { id: 'square-full', name: 'Square, mark and full name', size: '640 × 640' },
  { id: 'square-text-j', name: 'Square, break after “AI”', size: '640 × 640' },
  { id: 'square-text-j-fit', name: 'Square, justified to one measure', size: '640 × 640' },
  { id: 'square-text-fit', name: 'Square, justified, break after “Ethical”', size: '640 × 640' },
  { id: 'square-text-mark', name: 'Square, text block and mark', size: '640 × 640' },
  { id: 'mark', name: 'Mark only', size: '640 × 640' },
];

const darkPalette = [
  { token: '--bg', value: '#080a09', use: 'Artwork background' },
  { token: '--type', value: '#f2f5f3', use: 'Roman lines' },
  { token: '--type-accent', value: '#57e39b', use: 'Italic line' },
  { token: '--cell', value: '#121815', use: 'Dark mark cell' },
  { token: '--cell-accent', value: '#57e39b', use: 'The A cell' },
  { token: '--knockout', value: '#08110c', use: 'Letterform on the green cell' },
  { token: '--glyph-in-cell', value: '#f2f5f3', use: 'I and E in their cells' },
  { token: '--glyph-accent', value: '#57e39b', use: 'S in its dark cell' },
];

const lightPalette = [
  { token: '--bg', value: '#f4f6f4', use: 'Artwork background' },
  { token: '--type', value: '#0b0e0c', use: 'Roman lines' },
  { token: '--type-accent', value: '#0f7a4c', use: 'Italic line, deeper for paper' },
  { token: '--cell', value: '#121815', use: 'Unchanged' },
  { token: '--cell-accent', value: '#57e39b', use: 'Unchanged' },
  { token: '--knockout', value: '#08110c', use: 'Unchanged' },
  { token: '--glyph-in-cell', value: '#f2f5f3', use: 'Unchanged' },
  { token: '--glyph-accent', value: '#57e39b', use: 'Unchanged' },
];
---

<BaseLayout frontmatter={frontmatter}>
  <article class="branding">
    <ArticleHero
      eyebrow="THE INSTITUTE — BRANDING"
      title="Branding"
      intro="A typographic identity for the Institute: a two-line wordmark set in Newsreader, and a 2×2 mark built from the sentence's own initials. Every lockup below is type converted to outlines, so a lockup can never reflow or substitute a font wherever it is placed."
    />

    <section class="branding-section" data-reveal>
      <p class="eyebrow">THE IDENTITY</p>
      <h2>The wordmark</h2>
      <p class="branding-lede">
        The name is set in two lines: the roman line carries the institution, the italic line carries what it works on. The wordmark is the primary signature
        and should be given room; where a row is too tight for two lines, use the mark instead of shrinking the type.
      </p>
      <figure class="branding-figure">
        <img
          class="asset asset-dark"
          src="/branding/wordmark-dark.svg"
          alt="The Institute for Ethical AI Alignment & Safety wordmark"
          width="960"
          height="220"
        />
        <img
          class="asset asset-light"
          src="/branding/wordmark-light.svg"
          alt="The Institute for Ethical AI Alignment & Safety wordmark"
          width="960"
          height="220"
        />
      </figure>
    </section>

    <section class="branding-section" data-reveal>
      <p class="eyebrow">THE MARK</p>
      <h2>Four initials, one square</h2>
      <div class="branding-split">
        <figure class="branding-figure branding-figure-mark">
          <img class="asset" src="/branding/mark-dark.svg" alt="The Institute mark: I and E above A and S" width="640" height="640" loading="lazy" />
        </figure>
        <div class="branding-notes">
          <p>
            The mark takes the I, E, A and S out of the name and sets them in a 2×2 grid: I and E roman above, A and S italic below. The gap between cells is
            six per cent of the cell.
          </p>
          <ul>
            <li><b>I, E</b> — roman, white on <code>#121815</code></li>
            <li><b>A</b> — italic, knocked out of the accent cell <code>#57e39b</code></li>
            <li><b>S</b> — italic, accent on <code>#121815</code></li>
          </ul>
          <p>
            The mark is theme-invariant: its cells stay dark on either background, so it reads as one solid anchor rather than inverting with the page. In the
            site header the mark is not a static image but the destination of a collapse: at the top of a page the header carries the full wordmark, and as the
            reader scrolls away its own four letters fly into the grid while the bar compacts around them. Scrolling back to the top reverses it.
          </p>
        </div>
      </div>
    </section>

    <section class="branding-section" data-reveal>
      <p class="eyebrow">LOCKUPS</p>
      <h2>The library</h2>
      <p class="branding-lede">
        Eight lockups, each supplied for dark and light backgrounds. The artwork background is part of the asset, so a dark lockup stays dark wherever it is
        placed. Download the cut that matches the surface you are placing it on, not the page you are downloading it from.
      </p>
      <ul class="lockup-grid">
        {
          lockups.map(({ id, name, size }) => (
            <li class="lockup">
              <div class="lockup-art">
                <img class="asset asset-dark" src={`/branding/${id}-dark.svg`} alt={`${name} lockup`} loading="lazy" />
                <img class="asset asset-light" src={`/branding/${id}-light.svg`} alt={`${name} lockup`} loading="lazy" />
              </div>
              <div class="lockup-meta">
                <p class="lockup-name">{name}</p>
                <p class="lockup-size">{size}</p>
                <p class="lockup-links">
                  SVG ·
                  <a href={`/branding/${id}-dark.svg`} download>
                    dark
                  </a>
                  /
                  <a href={`/branding/${id}-light.svg`} download>
                    light
                  </a>
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="branding-section" data-reveal>
      <p class="eyebrow">COLOUR</p>
      <h2>The palette</h2>
      <p class="branding-lede">
        Two cuts of one palette. Only the type colours change between them: the accent green is lifted off paper to{' '}
        <code>#0f7a4c</code>, because <code>#57e39b</code> on a light background falls to about 1.6:1 and fails contrast. Every value the mark uses is the same in
        both.
      </p>
      <div class="palette-pair">
        {
          [
            { title: 'Dark', rows: darkPalette },
            { title: 'Light', rows: lightPalette },
          ].map(({ title, rows }) => (
            <div class="palette">
              <p class="palette-title">{title}</p>
              <ul class="swatches">
                {rows.map(({ token, value, use }) => (
                  <li class="swatch">
                    <span class="swatch-chip" style={`background: ${value}`} />
                    <span class="swatch-token">{token}</span>
                    <span class="swatch-value">{value}</span>
                    <span class="swatch-use">{use}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="branding-section" data-reveal>
      <p class="eyebrow">TYPE</p>
      <h2>Newsreader</h2>
      <p class="branding-lede">
        Newsreader at weight 300, roman and italic, is the identity's only typeface. It is self-hosted as a variable font with weight and optical-size axes, so
        the optical size follows the size the type is set at.
      </p>
      <div class="specimen">
        <p class="specimen-line">The Institute for Ethical AI</p>
        <p class="specimen-line specimen-italic">Alignment &amp; Safety</p>
        <p class="specimen-caption">Newsreader 300 roman · Newsreader 300 italic</p>
      </div>
    </section>

    <section class="branding-section" data-reveal>
      <p class="eyebrow">USAGE</p>
      <h2>Working with the identity</h2>
      <ul class="usage">
        <li>No border radius, no shadows, no gradients. The identity is flat type on flat colour.</li>
        <li>Place the outlined SVGs as files. They carry no font reference and cannot reflow or substitute.</li>
        <li>
          Do not re-typeset a lockup by hand. Centring a glyph centres its advance box, not its ink, and every cell in the mark carries a per-glyph optical
          nudge solved from the font's own metrics.
        </li>
        <li>
          Regenerate rather than edit: <code>scripts/build-logo-svgs.mjs</code> is the source of truth for all sixteen files and both favicons, and it re-solves the
          nudges and the justified line sizes whenever the font changes.
        </li>
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .branding-section {
    margin: 0 auto;
    max-width: 1200px;
    padding: 72px 48px 0;
  }

  .branding-section:last-of-type {
    padding-bottom: 96px;
  }

  .branding-section h2 {
    font: 300 var(--display-44) / 1.05 var(--font-display);
    letter-spacing: -0.02em;
    margin: 14px 0 0;
  }

  .branding-lede {
    color: var(--text-2);
    margin: 16px 0 0;
    max-width: 68ch;
  }

  .branding-figure {
    /* The light cut's own background is all but the page colour, so the tile needs an edge
       to read as artwork rather than as bare page. */
    border: 1px solid var(--hairline-card);
    margin: 32px 0 0;
    width: fit-content;
  }

  .asset {
    display: block;
    height: auto;
    max-width: 100%;
  }

  .branding-figure-mark .asset {
    max-width: 320px;
  }

  /* The artwork background belongs to the asset, so the page shows the cut that matches the
     active theme rather than recolouring anything. */
  .asset-light {
    display: none;
  }

  :root[data-theme='light'] .asset-dark {
    display: none;
  }

  :root[data-theme='light'] .asset-light {
    display: block;
  }

  .branding-split {
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    margin-top: 32px;
  }

  .branding-figure-mark {
    margin: 0;
  }

  .branding-notes p {
    color: var(--text-2);
    margin: 0 0 16px;
    max-width: 62ch;
  }

  .branding-notes ul {
    color: var(--text-2);
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
  }

  .branding-notes li {
    border-top: 1px solid var(--hairline);
    padding: 8px 0;
  }

  .branding-notes b {
    color: var(--text-1);
    font-weight: 400;
  }

  .lockup-grid {
    display: grid;
    gap: 28px;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
  }

  .lockup-art {
    align-items: center;
    border: 1px solid var(--hairline-card);
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  .lockup-meta {
    padding: 12px 2px 0;
  }

  .lockup-name {
    margin: 0;
  }

  .lockup-size,
  .lockup-links {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--mono-10-5);
    margin: 4px 0 0;
  }

  .lockup-links a {
    color: var(--accent-ink);
    padding: 0 6px;
  }

  .palette-pair {
    display: grid;
    gap: 40px;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    margin-top: 32px;
  }

  .palette-title {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--mono-10-5);
    letter-spacing: 0.14em;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .swatches {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .swatch {
    align-items: center;
    border-top: 1px solid var(--hairline);
    display: grid;
    font-family: var(--font-mono);
    font-size: var(--mono-10-5);
    gap: 12px;
    grid-template-columns: 28px minmax(0, 1fr) 72px minmax(0, 1.4fr);
    padding: 9px 0;
  }

  .swatch-chip {
    border: 1px solid var(--hairline-card);
    display: block;
    height: 20px;
    width: 28px;
  }

  .swatch-token {
    color: var(--text-1);
  }

  .swatch-value,
  .swatch-use {
    color: var(--text-3);
  }

  .specimen {
    margin-top: 32px;
  }

  .specimen-line {
    font: 300 clamp(34px, 5vw, 60px) / 1.22 var(--font-display);
    margin: 0;
  }

  .specimen-italic {
    color: var(--accent-ink);
    font-style: italic;
  }

  .specimen-caption {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--mono-10-5);
    margin: 18px 0 0;
  }

  .usage {
    color: var(--text-2);
    list-style: none;
    margin: 28px 0 0;
    max-width: 78ch;
    padding: 0;
  }

  .usage li {
    border-top: 1px solid var(--hairline);
    padding: 12px 0;
  }

  code {
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: 0.92em;
  }

  @media (max-width: 950px) {
    .branding-split {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 600px) {
    .branding-section {
      padding: 48px 18px 0;
    }

    .swatch {
      grid-template-columns: 28px minmax(0, 1fr) 72px;
    }

    .swatch-use {
      display: none;
    }
  }
</style>
