---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import NewsletterSubscribe from '../../components/NewsletterSubscribe.astro';

export async function getStaticPaths() {
  const entries = await getCollection('newsletter');
  const numbers = entries.map((entry) => entry.data.issue).sort((first, second) => first - second);
  // Related issues: nearest neighbours sharing at least one tag, closest first.
  const related = (of: (typeof entries)[number]) =>
    entries
      .filter((other) => other.data.issue !== of.data.issue && other.data.tags?.some((tag) => of.data.tags?.includes(tag)))
      .sort((first, second) => Math.abs(first.data.issue - of.data.issue) - Math.abs(second.data.issue - of.data.issue))
      .slice(0, 4)
      .map((other) => ({
        issue: other.data.issue,
        date: other.data.date,
        tags: (other.data.tags ?? []).filter((tag) => of.data.tags?.includes(tag)),
      }));
  return entries.map((entry) => ({ params: { issue: String(entry.data.issue) }, props: { entry, numbers, related: related(entry) } }));
}

const { entry, numbers, related } = Astro.props;
const { Content } = await render(entry);
const issue = entry.data.issue;
const barDate = entry.data.date
  ? [entry.data.date.getDate(), entry.data.date.getMonth() + 1, entry.data.date.getFullYear() % 100].map((part) => String(part).padStart(2, '0')).join('/')
  : undefined;
const position = numbers.indexOf(issue);
const previous = position > 0 ? numbers[position - 1] : undefined;
const next = position < numbers.length - 1 ? numbers[position + 1] : undefined;
// Issue summaries are the description source and many run past the length
// search results render, so they are trimmed on a word boundary rather than
// cut mid-word by the engine.
const truncateDescription = (value: string, maxLength = 160) => {
  if (value.length <= maxLength) return value;
  const candidate = value.slice(0, maxLength - 1).trimEnd();
  return `${candidate.slice(0, candidate.lastIndexOf(' ')).replace(/[,:;]+$/, '')}…`;
};

const frontmatter = {
  title: `The ML Engineer — Issue #${issue}`,
  description: truncateDescription(
    entry.data.summary ?? 'The Machine Learning Engineer newsletter: curated articles, tutorials and insights from experienced machine learning professionals.',
  ),
  article: true,
  articleHeadline: `The Machine Learning Engineer Issue #${issue}`,
  datePublished: entry.data.date?.toISOString().slice(0, 10),
};
---

<BaseLayout frontmatter={frontmatter}>
  <article class="newsletter-issue">
    <Hero
      status="THE ML ENGINEER — WEEKLY NEWSLETTER"
      title={['The Machine', 'Learning Engineer', `Issue #${issue}`]}
      subtitle_lines={['Join 70k+ AI professionals receiving weekly curated', 'articles, tutorials and blog posts on']}
      beneficiaries={['production machine learning.', 'MLOps at scale.', 'agentic systems.', 'ML security.', 'AI safety.']}
    >
      <NewsletterSubscribe slot="actions" />
    </Hero>
    <newsletter-meta-bar>
      <div data-meta-sentinel aria-hidden="true"></div>
      <div class="issue-meta" data-reveal transition:name="newsletter-bar">
        {
          previous ? (
            <a class="issue-step" href={`/newsletter/${previous}/#issue`} data-transition-direction="back" aria-label={`Previous issue, #${previous}`}>
              <i aria-hidden="true">‹</i>
              <span>#{previous}</span>
            </a>
          ) : (
            <span class="issue-step" aria-hidden="true" />
          )
        }
        <div class="issue-chips">
          <span class="issue-chip issue-number">Issue #{issue}</span>
          {barDate && <span class="issue-chip">{barDate}</span>}
          {entry.data.tags?.length ? <span class="chip-rule" aria-hidden="true" /> : null}
          {
            entry.data.tags?.map((tag) => (
              <a class="issue-tag" href={`/newsletter/?tag=${tag}`}>
                {tag}
              </a>
            ))
          }
        </div>
        {
          next ? (
            <a class="issue-step" href={`/newsletter/${next}/#issue`} data-transition-direction="forward" aria-label={`Next issue, #${next}`}>
              <span>#{next}</span>
              <i aria-hidden="true">›</i>
            </a>
          ) : (
            <span class="issue-step" aria-hidden="true" />
          )
        }
      </div>
      <div class="issue-anchor" id="issue" data-scroll-align="start" aria-hidden="true"></div>
      <div class="issue-article" transition:name="newsletter-page">
        {
          entry.data.summary && (
            <blockquote class="prose-quote issue-lede" data-reveal>
              Issue #{issue} 🤖 - {entry.data.summary}
            </blockquote>
          )
        }
        <div class="issue-body">
          <Content />
        </div>
        <p class="issue-subscribe" data-reveal>Enjoy The ML Engineer? <a href="/newsletter/#subscribe">Subscribe to receive the next issue</a>.</p>
      </div>
      {
        related.length > 0 && (
          <aside class="issue-related" data-reveal>
            <p class="eyebrow">MORE ON THESE TOPICS</p>
            <div class="related-grid">
              {related.map((item) => (
                <a href={`/newsletter/${item.issue}/`}>
                  <strong>#{item.issue}</strong>
                  <span>{item.date?.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) ?? ''}</span>
                  <small>{item.tags.join(' · ')}</small>
                </a>
              ))}
            </div>
          </aside>
        )
      }
    </newsletter-meta-bar>
  </article>
</BaseLayout>

<style>
  newsletter-meta-bar {
    display: block;
  }
  /* Landing anchor for issue-to-issue navigation: zero-height, sitting between
     the docked bar and the deck, reserving header + bar height so the text
     starts just under the chrome. */
  .issue-anchor {
    height: 0;
    scroll-margin-top: calc(var(--meta-stuck-top, 62px) + var(--meta-bar-height, 58px));
  }
  .issue-meta {
    align-items: center;
    background: var(--bg-inset);
    border-block: 1px solid var(--hairline);
    display: grid;
    gap: 12px;
    grid-template-columns: minmax(72px, 1fr) auto minmax(72px, 1fr);
    margin-top: 34px;
    padding: 16px 24px;
    position: sticky;
    top: var(--meta-stuck-top, 62px);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      padding 0.3s ease;
    z-index: 40;
  }
  newsletter-meta-bar.is-stuck .issue-meta {
    animation: meta-lock 0.4s var(--ease-panel, cubic-bezier(0.16, 1, 0.3, 1));
    background: var(--bg-panel);
    border-top-color: transparent;
    border-bottom-color: var(--accent-a220);
    padding: 8px 24px;
  }
  /* Lock-in: the bar arrives slightly oversized and compresses as it docks,
     with a brief accent flash on the seam. */
  @keyframes meta-lock {
    from {
      border-bottom-color: var(--accent-a650);
      transform: translateY(-8px) scaleY(1.12);
    }
    60% {
      transform: translateY(1px) scaleY(0.98);
    }
    to {
      transform: none;
    }
  }
  .issue-chips {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .issue-step {
    align-items: center;
    color: var(--text-2);
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: var(--mono-11);
    gap: 7px;
    justify-self: start;
    letter-spacing: 0.08em;
    padding: 6px 2px;
    transition: color 0.2s ease;
  }
  .issue-step:last-child {
    justify-self: end;
  }
  a.issue-step:hover {
    color: var(--accent-ink);
    opacity: 1;
  }
  .issue-step i {
    font-family: var(--font-display);
    font-size: 19px;
    font-style: normal;
    line-height: 1;
  }
  .issue-chip {
    transition:
      font-size 0.3s ease,
      padding 0.3s ease;
  }
  newsletter-meta-bar.is-stuck .issue-chip {
    padding: 6px 11px;
  }
  .issue-chip.issue-number {
    border-color: var(--accent-a400);
    color: var(--accent-ink);
  }
  .chip-rule {
    align-self: center;
    background: var(--ink-wash-a220);
    flex: none;
    height: 22px;
    margin: 0 3px;
    width: 1px;
  }
  .issue-chip,
  .issue-tag {
    flex: none;
    white-space: nowrap;
  }
  /* The deck is the shared pull-quote treatment (see .prose-quote in
     tokens.css), plus a rule separating it from the issue body. */
  .issue-lede {
    border-bottom: 1px solid var(--hairline);
    margin: 34px auto 0;
    padding-bottom: 30px;
  }
  .issue-tag {
    border: 1px solid var(--hairline-card);
    border-radius: var(--radius-pill);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--mono-9);
    letter-spacing: 0.12em;
    padding: 7px 11px;
    text-transform: uppercase;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }
  a.issue-tag:hover {
    border-color: var(--accent-a500);
    color: var(--accent-ink);
    opacity: 1;
  }
  .issue-related {
    margin: 0 auto;
    max-width: 645px;
    padding: 0 24px 88px;
  }
  .issue-related .eyebrow {
    margin-bottom: 14px;
  }
  .related-grid {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  }
  .related-grid a {
    border: 1px solid var(--hairline-card);
    border-radius: 6px;
    display: grid;
    gap: 4px;
    padding: 12px 12px 10px;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .related-grid a:hover {
    border-color: var(--accent-a550);
    opacity: 1;
    transform: translateY(-2px);
  }
  .related-grid strong {
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .related-grid span {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .related-grid small {
    color: var(--text-4);
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.08em;
    margin-top: 3px;
    text-transform: uppercase;
  }
  .issue-chip {
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--mono-10);
    letter-spacing: 0.12em;
    padding: 8px 14px;
  }
  .issue-chip.archive {
    border-color: var(--accent-a350);
    color: var(--accent-ink);
  }
  .issue-body {
    padding: 48px 24px 56px;
  }
  .issue-body :global(.issue-section) {
    padding: 0;
  }
  .issue-body :global(.issue-section) > :global(*) {
    margin-inline: auto;
    max-width: 645px;
  }
  .issue-body :global(p) {
    color: var(--text-2);
    font-size: var(--body-16-5);
    line-height: 1.75;
    margin-block: 0 18px;
  }
  .issue-body :global(h2) {
    border-top: 1px solid var(--hairline);
    font: 300 var(--display-30) / 1.15 var(--font-display);
    letter-spacing: -0.01em;
    margin-block: 40px 18px;
    padding-top: 36px;
  }
  .issue-body :global(h3) {
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: var(--mono-11);
    font-weight: 400;
    letter-spacing: 0.14em;
    margin-block: 30px 14px;
    text-transform: uppercase;
  }
  .issue-body :global(ul) {
    list-style: none;
    margin-block: 0 20px;
    padding: 0;
  }
  .issue-body :global(li) {
    color: var(--text-2);
    font-size: var(--body-16);
    line-height: 1.65;
    margin: 0 0 10px;
    padding-left: 20px;
    position: relative;
  }
  .issue-body :global(li)::before {
    background: var(--accent);
    content: '';
    height: 1px;
    left: 0;
    position: absolute;
    top: 0.75em;
    width: 9px;
  }
  .issue-body :global(a) {
    border-bottom: 1px solid var(--accent-a350);
    color: var(--accent-ink);
    transition:
      border-color 0.2s ease,
      text-shadow 0.2s ease;
  }
  .issue-body :global(a:hover) {
    border-bottom-color: var(--accent-ink);
    opacity: 1;
    text-shadow: 0 0 18px var(--accent-a550);
  }
  .issue-body :global(h2 a),
  .issue-body :global(h3 a) {
    border-bottom: 1px solid var(--accent-a350);
    color: var(--accent-ink);
  }
  .issue-body :global(h2 a:hover),
  .issue-body :global(h3 a:hover) {
    border-bottom-color: var(--accent-ink);
    opacity: 1;
    text-shadow: 0 0 22px var(--accent-edge);
  }
  .issue-body :global(img) {
    border: 1px solid var(--hairline-card);
    border-radius: var(--radius-card);
    height: auto;
    max-width: 100%;
  }
  .issue-body :global(img:not([width])) {
    width: 100%;
  }
  /* Markdown code fences wear the AnimationWindow chrome: inset card, 30px
     bar with traffic lights, the language as the centred window title. */
  .issue-body :global(pre.astro-code) {
    background: var(--bg-inset) !important;
    border: 1px solid var(--hairline-card);
    border-radius: 10px;
    font-size: 13px;
    line-height: 1.75;
    margin-block: 0 20px;
    overflow-x: auto;
    padding: 46px 18px 18px;
    position: relative;
  }
  .issue-body :global(pre.astro-code)::before {
    background:
      radial-gradient(circle at 16px 15px, var(--glitch-red) 3.5px, transparent 4.5px),
      radial-gradient(circle at 29px 15px, var(--warn) 3.5px, transparent 4.5px), radial-gradient(circle at 42px 15px, var(--accent) 3.5px, transparent 4.5px),
      var(--wash-2);
    border-bottom: 1px solid var(--hairline-card);
    content: '';
    height: 30px;
    inset: 0 0 auto;
    position: absolute;
  }
  .issue-body :global(pre.astro-code)::after {
    color: var(--text-3);
    content: attr(data-language);
    font: var(--mono-9) / 30px var(--font-mono);
    inset: 0 0 auto;
    letter-spacing: 0.08em;
    position: absolute;
    text-align: center;
  }
  .issue-body :global(pre.astro-code code) {
    font-family: var(--font-mono);
  }
  .issue-subscribe {
    border-top: 1px solid var(--hairline);
    color: var(--text-2);
    font-size: var(--body-16);
    margin: 0 auto 56px;
    max-width: 645px;
    padding: 30px 24px 0;
  }
  .issue-subscribe a {
    border-bottom: 1px solid var(--accent-a350);
    color: var(--accent-ink);
  }
  @media (max-width: 950px) {
    .issue-body {
      padding: 36px 24px 48px;
    }
  }
  @media (max-width: 600px) {
    .issue-step span {
      display: none;
    }
    .issue-meta {
      grid-template-columns: auto 1fr auto;
    }
    .issue-chips {
      gap: 7px;
    }
    /* The tag row wraps onto its own line at this width, which separates the
       groups on its own; the rule would just dangle at the end of row one. */
    .chip-rule {
      display: none;
    }
  }
</style>

<script>
  // Sticky meta bar: past its natural position the chip row (prev/next steps,
  // issue, date, tags) docks under the site header and gains the header's bar
  // chrome. The sticky offset is measured from the real header height rather
  // than hardcoded per breakpoint.
  class NewsletterMetaBar extends HTMLElement {
    private controller = new AbortController();
    private observer?: IntersectionObserver;

    connectedCallback() {
      this.controller = new AbortController();
      const sentinel = this.querySelector<HTMLElement>('[data-meta-sentinel]');
      const meta = this.querySelector<HTMLElement>('.issue-meta');
      if (!sentinel || !meta) return;

      const setOffset = () => {
        const header = document.querySelector<HTMLElement>('.site-header');
        // Exact (fractional) header height, overlapped by 1px so no seam ever
        // opens between the header and the docked bar. Set on the element so
        // the sticky top, the anchor scroll-margin and the bar height all read it.
        const height = header?.getBoundingClientRect().height ?? 62;
        this.style.setProperty('--meta-stuck-top', `${height - 1}px`);
        this.style.setProperty('--meta-bar-height', `${meta.getBoundingClientRect().height}px`);
      };
      setOffset();
      addEventListener('resize', setOffset, { signal: this.controller.signal });

      this.observer = new IntersectionObserver(([entry]) => this.classList.toggle('is-stuck', !entry.isIntersecting && entry.boundingClientRect.top < 0), {
        rootMargin: '-80px 0px 0px 0px',
      });
      this.observer.observe(sentinel);
    }

    disconnectedCallback() {
      this.controller.abort();
      this.observer?.disconnect();
    }
  }

  if (!customElements.get('newsletter-meta-bar')) {
    customElements.define('newsletter-meta-bar', NewsletterMetaBar);
  }
</script>
