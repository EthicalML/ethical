---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import Hero from '../../components/Hero.astro';
import { blogHref, blogSlug, hasBlogBody, publishedBlogEntries, type BlogEntry } from '../../utils/blog';

export async function getStaticPaths() {
  const entries = publishedBlogEntries(await getCollection('blog'));
  const localEntries = entries.filter(hasBlogBody);
  const linkedPost = (post: BlogEntry) => ({
    external: !hasBlogBody(post),
    href: blogHref(post),
    title: post.data.title,
  });
  const related = (of: BlogEntry) =>
    entries
      .filter((other) => other.id !== of.id && other.data.tags?.some((tag) => of.data.tags?.includes(tag)))
      .sort((first, second) => second.data.date.getTime() - first.data.date.getTime())
      .slice(0, 3)
      .map(linkedPost);
  const seriesNavigation = (of: BlogEntry) => {
    if (!of.data.series) return undefined;
    const posts = entries
      .filter((other) => other.data.series === of.data.series)
      .sort((first, second) => first.data.date.getTime() - second.data.date.getTime());
    const position = posts.findIndex((post) => post.id === of.id);
    return {
      name: of.data.series,
      position: position + 1,
      total: posts.length,
      previous: position > 0 ? linkedPost(posts[position - 1]) : undefined,
      next: position < posts.length - 1 ? linkedPost(posts[position + 1]) : undefined,
    };
  };
  return localEntries.map((entry) => ({
    params: { slug: blogSlug(entry) },
    props: { entry, related: related(entry), seriesNavigation: seriesNavigation(entry) },
  }));
}

const { entry, related, seriesNavigation } = Astro.props;
const { Content } = await render(entry);
const publishedDate = entry.data.originalDate ?? entry.data.date;
const frontmatter = {
  title: entry.data.title,
  description: entry.data.summary,
  eyebrow: entry.data.series ?? 'THE INSTITUTE BLOG',
  image: entry.data.image,
  canonical: entry.data.source !== 'original' ? entry.data.url : undefined,
  article: true,
  articleHeadline: entry.data.title,
  articleAuthors: entry.data.authors,
  datePublished: publishedDate.toISOString().slice(0, 10),
};
const formatDate = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// The hero reuses the newsletter's three-line display: a short base title split
// across the first lines and the closing line carrying the glitch treatment
// (the series part number where one exists, mirroring the issue number).
const balanceLines = (text: string, lines: number): string[] => {
  const words = text.split(' ');
  const target = Math.ceil(text.length / lines);
  const out: string[] = [];
  let current = '';
  for (const word of words) {
    if (current && current.length + word.length + 1 > target && out.length < lines - 1) {
      out.push(current);
      current = word;
    } else {
      current = current ? `${current} ${word}` : word;
    }
  }
  out.push(current);
  return out;
};
const baseTitle = (entry.data.series ?? entry.data.title).replace(/\s*\(Part \d+\)\s*$/i, '');
const heroTitle = seriesNavigation ? [...balanceLines(baseTitle, 2), `Part ${seriesNavigation.position}`] : balanceLines(baseTitle, 3);
---

<BaseLayout frontmatter={frontmatter}>
  <article class="blog-post">
    <Hero
      status="THE INSTITUTE — BLOG"
      title={heroTitle}
      subtitle_lines={['Long-form writing from The Institute on production', 'machine learning, agentic systems and']}
      beneficiaries={['responsible AI.']}
    />
    <div class="blog-meta" data-reveal>
      <p>
        <time datetime={publishedDate.toISOString().slice(0, 10)}>{formatDate(publishedDate)}</time>
        <span>{entry.data.authors.join(', ')}</span>
      </p>
      {entry.data.originalDate && <p>Published here {formatDate(entry.data.date)}</p>}
      {entry.data.tags?.length ? <p class="blog-tags">{entry.data.tags.join(' · ')}</p> : null}
    </div>
    {
      entry.data.summary && (
        <blockquote class="prose-quote blog-lede" data-reveal>
          {entry.data.summary}
        </blockquote>
      )
    }
    {
      seriesNavigation && seriesNavigation.total > 1 && (
        <nav class="blog-series-nav" aria-label={`${seriesNavigation.name} series`} data-reveal>
          {seriesNavigation.previous ? (
            <a
              href={seriesNavigation.previous.href}
              target={seriesNavigation.previous.external ? '_blank' : undefined}
              rel={seriesNavigation.previous.external ? 'noopener noreferrer' : undefined}
            >
              <span>Previous in series</span>
              <strong>{seriesNavigation.previous.title}</strong>
            </a>
          ) : (
            <span />
          )}
          <p>
            <span>{seriesNavigation.name}</span>
            <strong>
              {seriesNavigation.position} of {seriesNavigation.total}
            </strong>
          </p>
          {seriesNavigation.next ? (
            <a
              href={seriesNavigation.next.href}
              target={seriesNavigation.next.external ? '_blank' : undefined}
              rel={seriesNavigation.next.external ? 'noopener noreferrer' : undefined}
            >
              <span>Next in series</span>
              <strong>{seriesNavigation.next.title}</strong>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
    <ArticleBody class="blog-body"><Content /></ArticleBody>
    {
      related.length > 0 && (
        <aside class="blog-related" data-reveal>
          <p class="eyebrow">RELATED</p>
          <ul>
            {related.map((post) => (
              <li>
                <a href={post.href} target={post.external ? '_blank' : undefined} rel={post.external ? 'noopener noreferrer' : undefined}>
                  {post.title}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>
</BaseLayout>

<style>
  .blog-meta,
  .blog-related {
    margin-inline: auto;
    max-width: 645px;
    padding-inline: 24px;
  }
  .blog-meta {
    border-bottom: 1px solid var(--hairline);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--mono-10);
    letter-spacing: 0.08em;
    padding-bottom: 24px;
    text-transform: uppercase;
  }
  .blog-meta p {
    margin: 0 0 8px;
  }
  .blog-meta p:last-child {
    margin-bottom: 0;
  }
  .blog-meta span {
    margin-left: 14px;
  }
  .blog-lede {
    border-bottom: 1px solid var(--hairline);
    margin: 34px auto 0;
    padding-bottom: 30px;
  }
  .blog-series-nav {
    align-items: stretch;
    border-bottom: 1px solid var(--hairline);
    display: grid;
    gap: 12px;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    margin: 0 auto;
    max-width: 645px;
    padding: 18px 0;
  }
  .blog-series-nav > a {
    border: 1px solid var(--hairline-card);
    border-radius: 6px;
    display: grid;
    gap: 5px;
    padding: 11px 13px;
  }
  .blog-series-nav > a:last-child {
    text-align: right;
  }
  .blog-series-nav > a:hover {
    border-color: var(--accent-edge);
    opacity: 1;
  }
  .blog-series-nav span,
  .blog-series-nav p {
    color: var(--text-4);
    font-family: var(--font-mono);
    font-size: var(--mono-9);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .blog-series-nav p {
    align-self: center;
    margin: 0;
    text-align: center;
  }
  .blog-series-nav p span,
  .blog-series-nav p strong {
    display: block;
  }
  .blog-series-nav p strong {
    color: var(--accent-ink);
    margin-top: 5px;
  }
  .blog-series-nav a strong {
    color: var(--text-2);
    font-size: var(--body-14);
    line-height: 1.4;
  }
  .blog-related a {
    color: var(--accent-ink);
  }
  .blog-related {
    border-top: 1px solid var(--hairline);
    padding-bottom: 96px;
    padding-top: 28px;
  }
  .blog-related ul {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }
  .blog-related li {
    margin-top: 10px;
  }
  @media (max-width: 600px) {
    .blog-meta,
    .blog-related {
      padding-inline: 18px;
    }
    .blog-meta span {
      display: block;
      margin: 7px 0 0;
    }
    .blog-series-nav {
      grid-template-columns: 1fr;
      margin-inline: 18px;
    }
    .blog-series-nav > span {
      display: none;
    }
    .blog-series-nav > a:last-child {
      text-align: left;
    }
    .blog-series-nav p {
      grid-row: 1;
    }
  }
</style>
