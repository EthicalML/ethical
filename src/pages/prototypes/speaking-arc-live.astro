---
// PROTOTYPE E — "The spine". Scroll advances the year: the timeline marker
// moves, and the topic bands grow and shrink as the beat shifts from MLOps to
// LLMs. The bands are real tag counts, so the shape is the argument.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollStage from '../../components/ScrollStage.astro';
import SpeakingEnquiry from '../../components/SpeakingEnquiry.astro';
import { loadEvents } from '../../utils/Events';

const today = new Date();
const { all } = await loadEvents(today);
const spoken = all.filter((event) => (event.talks ?? []).length > 0);

const years = [...new Set(spoken.map((event) => event.start.getFullYear()))].sort((a, b) => a - b);
const tracked = ['mlops', 'python', 'cloud-native', 'data-engineering', 'research', 'llms', 'ai-agents'];

const chapters = years.map((year) => {
  const events = spoken.filter((event) => event.start.getFullYear() === year);
  const counts = new Map<string, number>();
  for (const event of events) for (const topic of event.topics ?? []) counts.set(topic, (counts.get(topic) ?? 0) + 1);
  const total = [...counts.values()].reduce((sum, value) => sum + value, 0) || 1;
  return {
    year,
    events,
    bands: tracked.map((topic) => ({ topic, share: (counts.get(topic) ?? 0) / total })),
  };
});

const claims: Record<number, string> = {
  2019: 'Getting a model into production was still the hard part.',
  2020: 'The tooling caught up and the questions moved to operations.',
  2021: 'Explainability and risk stopped being someone else’s problem.',
  2022: 'Production ML became a platform discipline.',
  2024: 'Generative models landed on every roadmap at once.',
  2025: 'The question turned from what a model can do to what it should be allowed to do.',
  2026: 'Agents made every old operational lesson urgent again.',
};
---

<BaseLayout
  frontmatter={{ title: 'Speaking — prototype E', description: 'Prototype.', noindex: true }}
>
  <main class="spine">
    <header class="sp-head">
      <p class="eyebrow">SPEAKING</p>
      <h1>The talk changed because the problem did</h1>
      <p class="lede">
        Eight years of conference stages, and the subject moved with the field. Scroll the years.
      </p>
    </header>

    <ScrollStage class="sp-stage">
      <div slot="stage" class="sp-panel">
        {
          chapters.map((chapter) => (
            <div class="sp-frame" data-stage-item>
              <p class="sp-year">{chapter.year}</p>
              <div class="sp-bands">
                {chapter.bands.map((band) => (
                  <div class="sp-band">
                    <span class="sp-band-label">{band.topic.replace(/-/g, ' ')}</span>
                    <span class="sp-band-track">
                      <span class="sp-band-fill" style={`--share:${Math.round(band.share * 100)}%`} />
                    </span>
                  </div>
                ))}
              </div>
              <p class="sp-count">
                {chapter.events.length} {chapter.events.length === 1 ? 'stage' : 'stages'}
              </p>
            </div>
          ))
        }
      </div>

      <div slot="steps">
        {
          chapters.map((chapter) => (
            <section class="sp-step" data-stage-step>
              <p class="sp-step-year">{chapter.year}</p>
              <h2>{claims[chapter.year] ?? ''}</h2>
              <ul>
                {chapter.events.map((event) => (
                  <li>
                    <strong>{event.name}</strong>
                    {(event.talks ?? []).map((talk) => (
                      <span>
                        {talk.title}
                        {talk.video && (
                          <a href={talk.video} target="_blank" rel="noopener noreferrer">
                            Watch
                          </a>
                        )}
                      </span>
                    ))}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </ScrollStage>

    <section class="sp-close">
      <h2>What comes after agents?</h2>
      <p>That is usually the talk I am asked for next.</p>
      <button class="button primary" type="button" data-enquiry-open>Invite me to speak</button>
    </section>
    <SpeakingEnquiry />
  </main>
</BaseLayout>

<style>
  .sp-head {
    padding: var(--space-56) var(--space-40) var(--space-26);
  }
  .sp-head h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: var(--space-8) 0 var(--space-12);
  }
  .lede {
    color: var(--text-2);
  }
  .sp-stage {
    padding: 0 var(--space-40) var(--space-48);
  }
  .sp-panel {
    border: 1px solid var(--hairline);
    height: 100%;
    position: relative;
  }
  .sp-frame {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    inset: 0;
    opacity: 0;
    padding: var(--space-34);
    position: absolute;
    transition: opacity 0.5s ease;
  }
  .sp-frame[data-active='1'] {
    opacity: 1;
  }
  .sp-year {
    color: var(--accent, var(--text-1));
    font-family: var(--font-mono);
    font-size: 3.2rem;
    margin: 0;
  }
  .sp-bands {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }
  .sp-band {
    display: grid;
    gap: var(--space-12);
    grid-template-columns: 130px 1fr;
    align-items: center;
  }
  .sp-band-label {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sp-band-track {
    background: var(--bg-inset);
    display: block;
    height: 6px;
  }
  .sp-band-fill {
    background: var(--accent, var(--text-1));
    display: block;
    height: 100%;
    transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    width: 0;
  }
  .sp-frame[data-active='1'] .sp-band-fill {
    width: var(--share);
  }
  .sp-count {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    margin: auto 0 0;
    text-transform: uppercase;
  }
  .sp-step {
    border-top: 1px solid var(--hairline);
    min-height: 66vh;
    opacity: 0.3;
    padding: var(--space-34) 0;
    transition: opacity 0.5s ease;
  }
  .sp-step[data-active='1'] {
    opacity: 1;
  }
  .sp-step-year {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    margin: 0;
  }
  .sp-step h2 {
    font-size: 1.5rem;
    line-height: 1.25;
    margin: var(--space-8) 0 var(--space-20);
  }
  .sp-step ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-14);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sp-step li {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .sp-step li span {
    color: var(--text-2);
    font-size: 0.88rem;
  }
  .sp-step li a {
    color: var(--accent, var(--text-1));
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    margin-left: var(--space-8);
    text-transform: uppercase;
  }
  .sp-close {
    border-top: 1px solid var(--hairline);
    padding: var(--space-48) var(--space-40);
  }
  @media (max-width: 999px), (prefers-reduced-motion: reduce) {
    .sp-frame {
      opacity: 1;
      position: static;
    }
    .sp-frame[data-active] .sp-band-fill {
      width: var(--share);
    }
    .sp-step {
      min-height: 0;
      opacity: 1;
    }
  }
</style>
