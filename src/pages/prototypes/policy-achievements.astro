---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AchievementNeonRendition from '../../components/AchievementNeonRendition.astro';
import PrototypeSwitcher from '../../components/PrototypeSwitcher.astro';

const frontmatter = {
  title: 'Policy achievement prototypes',
  description: 'Five triggered-lego studies for the policy achievement record.',
};

const cards = [
  {
    piece: 'eu',
    eyebrow: 'EU · GPAI CODE OF PRACTICE',
    title: '8 of 12',
    summary: 'Eight recommendations entered the Second Draft of the GPAI Code.',
    links: [
      {
        label: 'Read the response',
        href: 'https://www.acm.org/binaries/content/assets/public-policy/acm-europetpc-consultation-2024---2nd-general-purpose-ai-code-of-practice-1.pdf',
      },
    ],
  },
  {
    piece: 'uk',
    eyebrow: 'UNITED KINGDOM · AI REGULATION',
    title: '13 of 14',
    summary: 'Owner-attested adoption total, with the 2022 comments as the related artefact.',
    links: [
      {
        label: 'Read the framework comments',
        href: 'https://www.acm.org/binaries/content/assets/public-policy/europe-tpc-uk-ai-framework-comments.pdf',
      },
    ],
  },
  {
    piece: 'mlsecops',
    eyebrow: 'CITED INTO THE CODE',
    title: 'MLSecOps in the Code',
    summary: 'Both GPAI responses cite the framework beside MITRE, OWASP and UK NCSC.',
    links: [
      { label: 'Explore MLSecOps', href: '/frameworks/security/' },
      {
        label: 'Read the response',
        href: 'https://www.acm.org/binaries/content/assets/public-policy/acm-europetpc-consultation-2024---2nd-general-purpose-ai-code-of-practice-1.pdf',
      },
    ],
  },
  {
    piece: 'un',
    eyebrow: 'UNITED NATIONS',
    title: 'Chair, Principles Committee',
    summary: 'Data Governance Guidelines at the UN Commission on Science and Technology for Development.',
    links: [
      {
        label: 'Public record',
        href: 'https://unctad.org/topic/commission-on-science-and-technology-for-development/working-group-on-data-governance',
      },
    ],
  },
  {
    piece: 'acm',
    eyebrow: 'ACM POLICY LEADERSHIP',
    title: 'Founding in Europe and LATAM',
    summary: 'Founding policy leadership in Europe, followed by a founding committee role in LATAM.',
    links: [{ label: 'ACM volunteer record', href: 'https://www.acm.org/volunteers/volunteer/saucedo_9722274' }],
  },
  {
    piece: 'through-line',
    eyebrow: 'THE THROUGH-LINE',
    title: '2021 to 2026',
    summary: 'Continuous oversight from the 2021 AI Act comments to the 2026 agentic brief.',
    links: [
      { label: '2021 comments', href: 'https://www.acm.org/binaries/content/assets/public-policy/europe-tpc-comments-ai-consultation.pdf' },
      { label: '2026 brief', href: 'https://www.acm.org/public-policy/europe-tpc/calibrating-oversight-agentic-frontier-models-04272026' },
    ],
  },
];

// The Wave: a diagonal cascade on a 6x4 cell grid. Letters are content blocks
// (a repeated letter spans two cells), `m*` are muted dud blocks, `.` is empty.
// Adding a block later is a data change here: extend `areas` and add a `blocks`
// entry; the component derives grid placement, entrance order and reveal clip.
//
//   a  m1 .  .  f  .
//   .  b  b  m2 .  .
//   .  m3 c  c  m4 .
//   e  e  m5 d  .  .
const layout = {
  areas: ['a m1 . . f .', '. b b m2 . .', '. m3 c c m4 .', 'e e m5 d . .'],
  // piece -> grid area, card format, and reveal slide sign (+1 right, -1 left).
  // The two adoption cards (eu, uk) and the narrative through-line take the
  // double blocks (long format); the three compact records take singles (short).
  blocks: {
    eu: { area: 'b', size: 'long' as const, dir: -1 },
    uk: { area: 'c', size: 'long' as const, dir: -1 },
    'through-line': { area: 'e', size: 'long' as const, dir: 1 },
    un: { area: 'a', size: 'short' as const, dir: 1 },
    mlsecops: { area: 'f', size: 'short' as const, dir: -1 },
    acm: { area: 'd', size: 'short' as const, dir: 1 },
  },
  duds: ['m1', 'm2', 'm3', 'm4', 'm5'],
};

const variations = [
  {
    value: 1 as const,
    label: 'V1 · GHOST',
    eyebrow: 'V1 · GHOST NUMERALS',
    description: 'Oversized dim identifiers sit behind the copy, cropped by the block edge, with a thin accent rule drawing across the top on landing.',
  },
  {
    value: 2 as const,
    label: 'V2 · ISOMETRIC',
    eyebrow: 'V2 · GHOST + ISOMETRIC STAGES',
    description: 'The ghost treatment gains an equal isometric stage per card, each a themed block structure that loops idle and activates in neon on hover.',
  },
  {
    value: 3 as const,
    label: 'V3 · TRANSFORMER',
    eyebrow: 'V3 · ROBOTIC TRANSFORMER',
    description: 'Each surface is plated from hairline panels that slide apart on hover, letting the card colour glow from the opened seams.',
  },
  {
    value: 4 as const,
    label: 'V4 · VOLCANIC',
    eyebrow: 'V4 · VOLCANIC NEON CRACKS',
    description: 'On hover fissures branch across the surface from a point, with the neon colour glowing through the cracks and a faint heat shimmer.',
  },
  {
    value: 5 as const,
    label: 'V5 · CIRCUIT',
    eyebrow: 'V5 · CIRCUIT ETCH',
    description: 'A PCB trace etches from a corner with pads and vias, a neon current runs the trace, and the key figure ignites where it terminates.',
  },
];
---

<BaseLayout frontmatter={frontmatter}>
  <header class="prototype-header">
    <p class="eyebrow">PROTOTYPE · POLICY ACHIEVEMENTS</p>
    <h1>Five surfaces on one lego grid.</h1>
    <p>Every variation shares the same later trigger, diagonal wave of long and short blocks, one-second card shift and clipped neon reveal.</p>
  </header>

  <PrototypeSwitcher options={variations.map(({ label, value }) => ({ label, value: String(value) }))}>
    {
      variations.map((variation, index) => (
        <section class="rendition-section" data-prototype-variant={String(variation.value)} hidden={index !== 0}>
          <header>
            <p class="eyebrow">{variation.eyebrow}</p>
            <h2>Highlight achievements</h2>
            <p>{variation.description}</p>
          </header>
          <AchievementNeonRendition variant={variation.value} cards={cards} layout={layout} />
        </section>
      ))
    }
  </PrototypeSwitcher>
</BaseLayout>

<style>
  .prototype-header {
    padding: 128px 48px 72px;
    scroll-margin-top: 124px;
  }
  .prototype-header h1 {
    font: 300 clamp(52px, 7vw, 92px) / 0.98 var(--font-display);
    letter-spacing: -0.03em;
    margin: 20px 0 24px;
    max-width: 1040px;
  }
  .prototype-header > p:last-child,
  .rendition-section > header > p:last-child {
    color: var(--text-2);
    font-size: var(--body-16);
    line-height: 1.7;
    margin: 0;
    max-width: 760px;
  }
  .rendition-section {
    padding: 72px 48px 100px;
    scroll-margin-top: 148px;
  }
  .rendition-section > header {
    margin-bottom: 54px;
  }
  .rendition-section h2 {
    font: 300 clamp(48px, 6vw, 76px) / 1 var(--font-display);
    letter-spacing: -0.025em;
    margin: 18px 0 22px;
  }
  section[hidden] {
    display: none;
  }
  @media (max-width: 600px) {
    .prototype-header {
      padding: 104px 18px 56px;
    }
    .rendition-section {
      padding: 56px 0 72px;
    }
    .rendition-section > header {
      padding-inline: 18px;
    }
  }
</style>
