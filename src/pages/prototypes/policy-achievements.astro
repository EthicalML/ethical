---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AchievementNeonRendition from '../../components/AchievementNeonRendition.astro';
import PrototypeSwitcher from '../../components/PrototypeSwitcher.astro';

const frontmatter = {
  title: 'Policy achievement prototypes',
  description: 'Three layout studies for the policy achievement record on one card system.',
};

// One consistent card system across every variant: eyebrow (or collage glyph) at
// a fixed top position, a hard one-line title, a description, then at most a
// primary and a secondary link. The two variants below reuse these six cards; the
// collage overrides the copy to the artifact's shorter titles and adds glyphs.
const baseCards = [
  {
    piece: 'eu',
    eyebrow: 'EU · GPAI CODE OF PRACTICE',
    title: '8 of 12',
    summary: 'Eight recommendations entered the Second Draft of the GPAI Code.',
    links: [
      {
        label: 'Read the response',
        href: 'https://www.acm.org/binaries/content/assets/public-policy/acm-europetpc-consultation-2024---2nd-general-purpose-ai-code-of-practice-1.pdf',
      },
    ],
  },
  {
    piece: 'uk',
    eyebrow: 'UNITED KINGDOM · AI REGULATION',
    title: '13 of 14',
    summary: 'Owner-attested adoption total, with the 2022 comments as the related artefact.',
    links: [
      {
        label: 'Read the framework comments',
        href: 'https://www.acm.org/binaries/content/assets/public-policy/europe-tpc-uk-ai-framework-comments.pdf',
      },
    ],
  },
  {
    piece: 'mlsecops',
    eyebrow: 'CITED INTO THE CODE',
    title: 'MLSecOps in the Code',
    summary: 'Both GPAI responses cite the framework beside MITRE, OWASP and UK NCSC.',
    links: [
      { label: 'Explore MLSecOps', href: '/frameworks/security/' },
      {
        label: 'Read the response',
        href: 'https://www.acm.org/binaries/content/assets/public-policy/acm-europetpc-consultation-2024---2nd-general-purpose-ai-code-of-practice-1.pdf',
      },
    ],
  },
  {
    piece: 'un',
    eyebrow: 'UNITED NATIONS',
    title: 'Chair, Principles Committee',
    summary: 'Data Governance Guidelines at the UN Commission on Science and Technology for Development.',
    links: [
      {
        label: 'Public record',
        href: 'https://unctad.org/topic/commission-on-science-and-technology-for-development/working-group-on-data-governance',
      },
    ],
  },
  {
    piece: 'acm',
    eyebrow: 'ACM POLICY LEADERSHIP',
    title: 'Founding in Europe and LATAM',
    summary: 'Founding policy leadership in Europe, followed by a founding committee role in LATAM.',
    links: [{ label: 'ACM volunteer record', href: 'https://www.acm.org/volunteers/volunteer/saucedo_9722274' }],
  },
  {
    piece: 'through-line',
    eyebrow: 'THE THROUGH-LINE',
    title: '2021 to 2026',
    summary: 'Continuous oversight from the 2021 AI Act comments to the 2026 agentic brief.',
    links: [
      { label: '2021 comments', href: 'https://www.acm.org/binaries/content/assets/public-policy/europe-tpc-comments-ai-consultation.pdf' },
      { label: '2026 brief', href: 'https://www.acm.org/public-policy/europe-tpc/calibrating-oversight-agentic-frontier-models-04272026' },
    ],
  },
];

// Collage copy, from the Set Table artifact: pixel-cluster glyph top-left, the
// shorter titles, the ACM Europe TPC footnote on the lead card, links per the
// anatomy (long cards keep both, the short middle row keeps a single primary).
const collageOverrides: Record<string, { glyph: 'scatter' | 'bracket' | 'tee' | 'corner'; title: string; summary: string; footnote?: string; links?: number }> =
  {
    eu: {
      glyph: 'scatter',
      title: '8 of 12',
      summary: 'Recommendations adopted into the main text of the second draft, EU GPAI Code of Practice.',
      footnote: 'ACM Europe TPC / Verbatim',
    },
    uk: { glyph: 'scatter', title: '13 of 14', summary: 'Recommendations adopted, UK AI Regulatory Proposal.' },
    mlsecops: { glyph: 'bracket', title: 'MLSecOps', summary: 'Recommendation 10, both GPAI Code responses.', links: 1 },
    un: { glyph: 'tee', title: 'Chair', summary: 'Principles Committee, UN CSTD.', links: 1 },
    acm: { glyph: 'scatter', title: 'Founding Chair', summary: 'ACM AI Policy Committee in Europe, founding member for LATAM.', links: 1 },
    'through-line': {
      glyph: 'corner',
      title: '2021 to 2026',
      summary: 'From AI Act comments demanding post deployment oversight of self modifying systems to the 2026 brief on agentic frontier oversight.',
    },
  };
const collageCards = baseCards.map((card) => {
  const over = collageOverrides[card.piece];
  return {
    ...card,
    glyph: over.glyph,
    title: over.title,
    summary: over.summary,
    footnote: over.footnote,
    links: over.links ? card.links.slice(0, over.links) : card.links,
  };
});

// V1 THE STACK: the current map, far-right column reordered bottom-to-top to a
// dud square (row 3), the UN short card (row 2) and a dud triangle (row 1).
const stackLayout = {
  areas: ['A A . . d3', '. B B . S', '. d2 C C d1', 'E E . D D'],
  blocks: {
    eu: { area: 'A', size: 'long' as const, dir: 1 },
    uk: { area: 'D', size: 'long' as const, dir: -1 },
    mlsecops: { area: 'B', size: 'long' as const, dir: 1 },
    acm: { area: 'C', size: 'long' as const, dir: -1 },
    'through-line': { area: 'E', size: 'long' as const, dir: 1 },
    un: { area: 'S', size: 'short' as const, dir: -1 },
  },
  duds: [
    { area: 'd1', shape: 'square' as const },
    { area: 'd2', shape: 'diamond' as const },
    { area: 'd3', shape: 'triangle' as const },
  ],
};

// V2 FULL-WIDTH COLLAGE: the live /policy/ composition, geometry lifted from its
// tokens.css rules, rebuilt on the current card system. The adoption pair keeps
// the slide reveal; the four supporting cards use the pick-up tilt, exactly like
// the live section's two hover modes.
const gridLayout = {
  areas: [],
  freeform: 973,
  blocks: {
    eu: { area: 'eu', size: 'long' as const, dir: 1, mode: 'slide' as const, rect: [22, 0, 50, 330] as [number, number, number, number] },
    uk: { area: 'uk', size: 'long' as const, dir: -1, mode: 'slide' as const, rect: [36, 329, 44, 300] as [number, number, number, number] },
    mlsecops: {
      area: 'mlsecops',
      size: 'long' as const,
      dir: 1,
      mode: 'tilt' as const,
      tilt: -4.5,
      rect: [2, 559, 31, 330] as [number, number, number, number],
    },
    un: { area: 'un', size: 'short' as const, dir: -1, mode: 'tilt' as const, tilt: 4.5, rect: [76, 189, 21, 370] as [number, number, number, number] },
    acm: { area: 'acm', size: 'long' as const, dir: -1, mode: 'tilt' as const, tilt: 3.8, rect: [32.6, 623, 31, 330] as [number, number, number, number] },
    'through-line': {
      area: 'through-line',
      size: 'long' as const,
      dir: 1,
      mode: 'tilt' as const,
      tilt: -3.6,
      rect: [63.2, 623, 35, 330] as [number, number, number, number],
    },
  },
  duds: [
    { area: 'filler-west', shape: 'square' as const, rect: [4, 239, 18, 300] as [number, number, number, number] },
    { area: 'filler-north', shape: 'plain' as const, rect: [14, 0, 8, 240] as [number, number, number, number] },
    { area: 'filler-east', shape: 'square' as const, rect: [72, 329, 8, 300] as [number, number, number, number] },
    { area: 'filler-centre', shape: 'square' as const, rect: [32, 409, 4, 220] as [number, number, number, number] },
    { area: 'filler-south', shape: 'plain' as const, rect: [33, 913, 29, 60] as [number, number, number, number] },
    { area: 'accent-eu', shape: 'accent' as const, rect: [69, 42, 7, 246] as [number, number, number, number] },
    { area: 'accent-uk', shape: 'accent' as const, rect: [33, 370, 5, 220] as [number, number, number, number] },
    { area: 'accent-static', shape: 'accent' as const, rect: [57, 573, 5, 56] as [number, number, number, number] },
    { area: 'diamond-north', shape: 'diamond' as const, rect: [18, 172, 6.5, 77] as [number, number, number, number] },
    { area: 'diamond-south', shape: 'diamond' as const, rect: [95, 884, 5, 59] as [number, number, number, number] },
  ],
};

// V3 SET TABLE COLLAGE: the artifact grid. Tall lead card (E) left, 13/14 (U)
// top-middle, a plain dud and a solid accent slab top-right, the short middle row
// (M, C, F), the wide through-line (T) bottom-left, the large diamond dud region
// bottom-right.
const collageLayout = {
  areas: ['E E U U p g', 'E E M C F F', 'T T T D D D'],
  // Lift directions vary per card: the lead keeps the artifact's up-left, others
  // reveal right, left and down so the collage feels handled from every side.
  blocks: {
    eu: { area: 'E', size: 'long' as const, dir: -1, lift: [-30, -30] as [number, number] },
    uk: { area: 'U', size: 'long' as const, dir: -1, lift: [34, 0] as [number, number] },
    mlsecops: { area: 'M', size: 'short' as const, dir: -1, lift: [-30, 0] as [number, number] },
    un: { area: 'C', size: 'short' as const, dir: -1, lift: [0, 26] as [number, number] },
    acm: { area: 'F', size: 'short' as const, dir: -1, lift: [30, 0] as [number, number] },
    'through-line': { area: 'T', size: 'long' as const, dir: -1, lift: [0, 30] as [number, number] },
  },
  duds: [
    { area: 'p', shape: 'plain' as const },
    { area: 'g', shape: 'accent' as const },
    { area: 'D', shape: 'diamond-open' as const },
  ],
};

const variations = [
  {
    value: 1 as const,
    label: 'V1 · STACK',
    eyebrow: 'V1 · THE STACK',
    cards: baseCards,
    layout: stackLayout,
    description:
      'The falling stack, far-right column reordered: a dud square, the UN short card and a dud triangle land above the adoption longs. Ghost numerals sit behind the copy; the reveal slides the card sideways onto the neon beneath.',
  },
  {
    value: 2 as const,
    label: 'V2 · GRID',
    eyebrow: 'V2 · FULL-WIDTH COLLAGE',
    cards: baseCards,
    layout: gridLayout,
    description:
      'The live /policy/ collage shape rebuilt on the current system: the adoption pair slides onto its neon, the supporting cards pick up and tilt, and the accent slabs, fillers and diamonds land with the stack.',
  },
  {
    value: 3 as const,
    label: 'V3 · SET TABLE',
    eyebrow: 'V3 · SET TABLE COLLAGE',
    cards: collageCards,
    layout: collageLayout,
    description:
      'The set-table collage with the ghost surface and isometric icons: the lead card lifts up-left while the others reveal right, left and down. The large dud region carries a faint diamond outline.',
  },
];
---

<BaseLayout frontmatter={frontmatter}>
  <header class="prototype-header">
    <p class="eyebrow">PROTOTYPE · POLICY ACHIEVEMENTS</p>
    <h1>Three layouts on one card system.</h1>
    <p>
      Every variant shares the same later trigger, falling lego blocks and one-second reveal where the card slides out of its cell onto the neon beneath. The
      card anatomy is consistent throughout: a top-anchored eyebrow or glyph, a hard one-line title, a description, then at most a primary and a secondary link.
    </p>
  </header>

  <PrototypeSwitcher options={variations.map(({ label, value }) => ({ label, value: String(value) }))}>
    {
      variations.map((variation, index) => (
        <section class="rendition-section" data-prototype-variant={String(variation.value)} hidden={index !== 0}>
          <header>
            <p class="eyebrow">{variation.eyebrow}</p>
            <h2>Highlight achievements</h2>
            <p>{variation.description}</p>
          </header>
          <AchievementNeonRendition variant={variation.value} cards={variation.cards} layout={variation.layout} />
        </section>
      ))
    }
  </PrototypeSwitcher>
</BaseLayout>

<style>
  .prototype-header {
    padding: 128px 48px 72px;
    scroll-margin-top: 124px;
  }
  .prototype-header h1 {
    font: 300 clamp(52px, 7vw, 92px) / 0.98 var(--font-display);
    letter-spacing: -0.03em;
    margin: 20px 0 24px;
    max-width: 1040px;
  }
  .prototype-header > p:last-child,
  .rendition-section > header > p:last-child {
    color: var(--text-2);
    font-size: var(--body-16);
    line-height: 1.7;
    margin: 0;
    max-width: 760px;
  }
  .rendition-section {
    padding: 72px 48px 100px;
    scroll-margin-top: 148px;
  }
  .rendition-section > header {
    margin-bottom: 54px;
  }
  .rendition-section h2 {
    font: 300 clamp(48px, 6vw, 76px) / 1 var(--font-display);
    letter-spacing: -0.025em;
    margin: 18px 0 22px;
  }
  section[hidden] {
    display: none;
  }
  @media (max-width: 600px) {
    .prototype-header {
      padding: 104px 18px 56px;
    }
    .rendition-section {
      padding: 56px 0 72px;
    }
    .rendition-section > header {
      padding-inline: 18px;
    }
  }
</style>
