---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemoryCallFlowPrototype from '../../components/prototypes/MemoryCallFlowPrototype.astro';
import MemoryLifecyclePrototype from '../../components/prototypes/MemoryLifecyclePrototype.astro';
import MemoryIsolationPrototype from '../../components/prototypes/MemoryIsolationPrototype.astro';

const frontmatter = {
  title: 'KAOS memory visual prototypes',
  description: 'Three interactive directions for explaining KAOS MemoryStore architecture.',
};
---

<BaseLayout frontmatter={frontmatter}>
  <div class="prototype-page">
    <header class="prototype-header">
      <p>KAOS · DESIGN COMPARISON</p>
      <h1>Memory should read as a service, not a mystery.</h1>
      <span>Three interaction models for the same architecture. Each loops while playing and holds its state when paused.</span>
      <nav aria-label="Memory prototype links">
        <a href="#prototype-a">A · Calls</a><a href="#prototype-b">B · Lifecycle</a><a href="#prototype-c">C · Isolation</a>
      </nav>
    </header>

    <div class="prototype-list">
      <section id="prototype-a">
        <div class="prototype-label"><div><p>PROTOTYPE A · REMOTE CALL ROUTER</p><h2>Follow the API boundary.</h2></div><span>RECOMMENDED</span></div>
        <p class="rationale">
          The clearest all-rounder: choose recall, write or forget and watch an authenticated remote call enter the central store, touch its internal tiers, and
          return.
        </p>
        <MemoryCallFlowPrototype />
      </section>

      <section id="prototype-b">
        <div class="prototype-label"><div><p>PROTOTYPE B · CONVERSATION LIFECYCLE</p><h2>Watch a turn change form.</h2></div></div>
        <p class="rationale">
          Best for explaining why three tiers exist: verbatim rows fill, context rolls into a session summary, then Mem0 extracts a deduplicated fact.
        </p>
        <MemoryLifecyclePrototype />
      </section>

      <section id="prototype-c">
        <div class="prototype-label"><div><p>PROTOTYPE C · TENANT VAULT</p><h2>Prove the isolation boundary.</h2></div></div>
        <p class="rationale">
          Best for the security story: switch authenticated agents and see the server-derived scope unlock exactly one tenant partition while every other recall
          path stays closed.
        </p>
        <MemoryIsolationPrototype />
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .prototype-page {
    margin: 0 auto;
    max-width: 1280px;
    padding: 150px 28px 120px;
  }
  .prototype-header {
    border-bottom: 1px solid var(--hairline);
    max-width: 920px;
    padding-bottom: 48px;
  }
  .prototype-header > p,
  .prototype-label p {
    color: var(--accent);
    font: var(--mono-10)/1 var(--font-mono);
    letter-spacing: 0.13em;
    margin: 0;
  }
  .prototype-header h1 {
    font: 400 clamp(42px, 6vw, 78px)/0.98 var(--font-display);
    letter-spacing: -0.04em;
    margin: 22px 0 24px;
  }
  .prototype-header > span {
    color: var(--text-2);
    display: block;
    font-size: var(--body-18);
    line-height: 1.55;
    max-width: 760px;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }
  nav a {
    border: 1px solid var(--hairline-card);
    color: var(--text-2);
    font: var(--mono-9)/1 var(--font-mono);
    padding: 10px 12px;
  }
  nav a:hover,
  nav a:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    outline: none;
  }
  .prototype-list {
    display: grid;
    gap: 110px;
    padding-top: 78px;
  }
  .prototype-list > section {
    scroll-margin-top: 90px;
  }
  .prototype-label {
    align-items: end;
    display: flex;
    justify-content: space-between;
  }
  .prototype-label h2 {
    font: 400 clamp(30px, 4vw, 48px)/1 var(--font-display);
    letter-spacing: -0.025em;
    margin: 12px 0 0;
  }
  .prototype-label > span {
    border: 1px solid rgba(94, 230, 160, 0.4);
    color: var(--accent);
    font: var(--mono-9)/1 var(--font-mono);
    padding: 8px 10px;
  }
  .rationale {
    color: var(--text-2);
    font-size: var(--body-15);
    line-height: 1.55;
    margin: 18px 0 26px;
    max-width: 860px;
  }
  @media (max-width: 620px) {
    .prototype-page {
      padding-inline: 18px;
      padding-top: 110px;
    }
    .prototype-label {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
  }
</style>
