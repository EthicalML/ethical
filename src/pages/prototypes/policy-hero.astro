---
import BaseLayout from '../../layouts/BaseLayout.astro';

const variants = [
  { label: 'Orbital baseline', value: 1 },
  { label: 'Policy assembly', value: 2 },
  { label: 'Ratification field', value: 3 },
  { label: 'Dotted terrain', value: 5 },
  { label: 'Neon sun system', value: 7 },
];
const frontmatter = {
  title: 'Policy hero canvas prototypes',
  description: 'Comparison page for policy hero canvas directions.',
};
const intro =
  "The Institute has contributed to the planning, creation and execution of the AI Act, Data Act, DSA, Cyber Resilience Act and the UK's regulatory proposal. Its consultation work draws on open-source software and production-ML practice.";
---

<BaseLayout {frontmatter}>
  <policy-hero-prototype>
    <nav class="prototype-switcher" aria-label="Policy hero canvas variants">
      <span>POLICY HERO STUDIES</span>
      {
        variants.map((option) => (
          <a href={`?v=${option.value}`} data-variant-link={option.value}>
            <b>{option.value}</b>
            {option.label}
          </a>
        ))
      }
    </nav>

    <header class="article-hero canvas-variant policy-prototype-hero" data-reveal>
      <span class="policy-prototype-mount" data-canvas-mount></span>
      <p class="eyebrow">POLICY &amp; STANDARDS</p>
      <h1>Policy written by practitioners.</h1>
      <p>{intro}</p>
    </header>

    <template data-canvas-variant="1"
      ><policy-hero-1 class="policy-prototype-mount"><canvas class="hero-canvas" aria-hidden="true"></canvas></policy-hero-1></template
    >
    <template data-canvas-variant="2"
      ><policy-hero-assembly class="policy-prototype-mount"><canvas class="hero-canvas" aria-hidden="true"></canvas></policy-hero-assembly></template
    >
    <template data-canvas-variant="3"
      ><policy-hero-fusion class="policy-prototype-mount"><canvas class="hero-canvas" aria-hidden="true"></canvas></policy-hero-fusion></template
    >
    <template data-canvas-variant="5"
      ><policy-hero-dotted-planet class="policy-prototype-mount"><canvas class="hero-canvas" aria-hidden="true"></canvas></policy-hero-dotted-planet></template
    >
    <template data-canvas-variant="7"
      ><policy-hero-sun-system class="policy-prototype-mount"><canvas class="hero-canvas" aria-hidden="true"></canvas></policy-hero-sun-system></template
    >
  </policy-hero-prototype>
</BaseLayout>

<script>
  import '../../shared/canvas/PolicyHero1';
  import '../../shared/canvas/PolicyHeroAssembly';
  import '../../shared/canvas/PolicyHeroFusion';
  import '../../shared/canvas/PolicyHeroDottedPlanet';
  import '../../shared/canvas/PolicyHeroSunSystem';

  class PolicyHeroPrototype extends HTMLElement {
    private controller = new AbortController();

    connectedCallback() {
      this.controller = new AbortController();
      this.querySelectorAll<HTMLAnchorElement>('[data-variant-link]').forEach((link) => {
        link.addEventListener('click', this.handleVariantClick, { signal: this.controller.signal });
      });
      window.addEventListener('popstate', this.handlePopState, { signal: this.controller.signal });
      this.selectVariant(this.variantFromUrl());
    }

    disconnectedCallback() {
      this.controller.abort();
    }

    private variantFromUrl() {
      const requested = Number.parseInt(new URL(window.location.href).searchParams.get('v') ?? '1', 10);
      return this.querySelector(`template[data-canvas-variant="${requested}"]`) ? requested : 1;
    }

    private selectVariant(variant: number) {
      const template = this.querySelector<HTMLTemplateElement>(`template[data-canvas-variant="${variant}"]`);
      const mount = this.querySelector<HTMLElement>('[data-canvas-mount]');
      if (!template || !mount) return;
      mount.replaceChildren(template.content.cloneNode(true));
      this.dataset.activeVariant = String(variant);
      this.querySelectorAll<HTMLAnchorElement>('[data-variant-link]').forEach((link) => {
        if (Number(link.dataset.variantLink) === variant) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
    }

    private handleVariantClick = (event: Event) => {
      const link = event.currentTarget as HTMLAnchorElement;
      const variant = Number(link.dataset.variantLink);
      if (!Number.isInteger(variant)) return;
      event.preventDefault();
      history.pushState({}, '', link.href);
      this.selectVariant(variant);
    };

    private handlePopState = () => this.selectVariant(this.variantFromUrl());
  }

  if (!customElements.get('policy-hero-prototype')) {
    customElements.define('policy-hero-prototype', PolicyHeroPrototype);
  }
</script>

<style>
  .prototype-switcher {
    align-items: center;
    border-bottom: 1px solid var(--hairline);
    display: flex;
    gap: 4px;
    min-height: 54px;
    padding: 7px 48px;
  }

  .prototype-switcher > span {
    color: var(--text-4);
    font: var(--mono-9)/1 var(--font-mono);
    letter-spacing: 0.14em;
    margin-right: 16px;
  }

  .prototype-switcher a {
    align-items: center;
    color: var(--text-3);
    display: flex;
    font-size: var(--body-13);
    gap: 8px;
    padding: 9px 11px;
  }

  .prototype-switcher a[aria-current='page'] {
    background: var(--accent-wash-09);
    color: var(--text-1);
  }

  .prototype-switcher b {
    color: var(--accent);
    font: 400 var(--mono-9)/1 var(--font-mono);
  }

  policy-hero-prototype,
  .policy-prototype-hero > :global(.policy-prototype-mount),
  .policy-prototype-hero :global(.policy-prototype-mount) {
    display: contents;
  }

  @media (max-width: 950px) {
    .prototype-switcher {
      align-items: stretch;
      gap: 0;
      overflow-x: auto;
      padding-inline: 18px;
    }

    .prototype-switcher > span {
      display: none;
    }

    .prototype-switcher a {
      flex: none;
      min-height: 44px;
    }
  }
</style>
