---
// PROTOTYPE D — "The map". Scroll moves city to city: the pin lights, the map
// pans to it, and the talks given there sit alongside. Scroll is the interaction.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollStage from '../../components/ScrollStage.astro';
import SpeakingEnquiry from '../../components/SpeakingEnquiry.astro';
import { loadEvents, eventDate } from '../../utils/Events';

const today = new Date();
const { all } = await loadEvents(today);
const spoken = all.filter((event) => (event.talks ?? []).length > 0 && event.location);

// Equirectangular placements, hand-set: a real projection needs a basemap and
// this prototype is about whether the device works, not cartographic accuracy.
const places: Record<string, { x: number; y: number }> = {
  Berlin: { x: 52.6, y: 26 },
  Brussels: { x: 50.8, y: 27 },
  London: { x: 48.8, y: 26 },
  Amsterdam: { x: 51, y: 25.5 },
  Darmstadt: { x: 52, y: 27.5 },
  Hamburg: { x: 52.3, y: 24.5 },
  Valencia: { x: 47.8, y: 32 },
  Kraków: { x: 55.5, y: 26.5 },
  Gdańsk: { x: 54.8, y: 23.5 },
  Detroit: { x: 24.5, y: 28 },
  'New Orleans': { x: 22.5, y: 34 },
  Austin: { x: 20.5, y: 33.5 },
  'Santa Clara': { x: 12, y: 31 },
  'San Francisco': { x: 11.5, y: 30.5 },
};

const cities = [...new Set(spoken.map((event) => (event.location ?? '').split(',')[0].trim()))]
  .filter((city) => places[city])
  .map((city) => ({
    city,
    at: places[city],
    events: spoken.filter((event) => (event.location ?? '').startsWith(city)),
  }))
  .sort((left, right) => right.events.length - left.events.length);
---

<BaseLayout
  frontmatter={{ title: 'Speaking — prototype D', description: 'Prototype.', noindex: true }}
>
  <main class="mapproto">
    <header class="mp-head">
      <p class="eyebrow">SPEAKING</p>
      <h1>{cities.length} cities, {spoken.length} stages</h1>
      <p class="lede">Scroll to travel. Every pin is a room I have spoken in.</p>
    </header>

    <ScrollStage class="mp-stage">
      <div slot="stage" class="mp-map">
        <svg viewBox="0 0 100 60" class="mp-canvas" role="img" aria-label="Map of speaking locations">
          <rect width="100" height="60" fill="var(--bg-inset)"></rect>
          {
            Array.from({ length: 13 }, (_, index) => (
              <line x1={index * 8} y1="0" x2={index * 8} y2="60" stroke="var(--hairline)" stroke-width="0.1" />
            ))
          }
          {
            Array.from({ length: 8 }, (_, index) => (
              <line x1="0" y1={index * 8} x2="100" y2={index * 8} stroke="var(--hairline)" stroke-width="0.1" />
            ))
          }
          {
            cities.map(({ city, at }) => (
              <g data-stage-item data-pin={city}>
                <circle class="pin-halo" cx={at.x} cy={at.y} r="3.4" />
                <circle class="pin" cx={at.x} cy={at.y} r="0.9" />
                <text class="pin-label" x={at.x + 2.2} y={at.y + 0.6}>
                  {city}
                </text>
              </g>
            ))
          }
        </svg>
      </div>

      <div slot="steps">
        {
          cities.map(({ city, events }) => (
            <section class="mp-step" data-stage-step>
              <p class="mp-city">{city}</p>
              <p class="mp-count">
                {events.length} {events.length === 1 ? 'appearance' : 'appearances'}
              </p>
              <ul>
                {events.map((event) => (
                  <li>
                    <span class="mp-date">{eventDate(event)}</span>
                    <strong>{event.name}</strong>
                    {(event.talks ?? []).map((talk) => (
                      <span class="mp-talk">
                        {talk.title}
                        {talk.video && (
                          <a href={talk.video} target="_blank" rel="noopener noreferrer">
                            Watch
                          </a>
                        )}
                      </span>
                    ))}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </ScrollStage>

    <section class="mp-close">
      <h2>Add a pin</h2>
      <button class="button primary" type="button" data-enquiry-open>Invite me to speak</button>
    </section>
    <SpeakingEnquiry />
  </main>
</BaseLayout>

<style>
  .mp-head {
    padding: var(--space-56) var(--space-40) var(--space-26);
  }
  .mp-head h1 {
    font-size: clamp(2rem, 4vw, 3.2rem);
    margin: var(--space-8) 0 var(--space-12);
  }
  .lede {
    color: var(--text-2);
  }
  .mp-stage {
    padding: 0 var(--space-40) var(--space-48);
  }
  .mp-map {
    border: 1px solid var(--hairline);
    height: 100%;
  }
  .mp-canvas {
    height: 100%;
    width: 100%;
  }
  .pin {
    fill: var(--text-3);
    transition:
      fill 0.5s ease,
      r 0.5s ease;
  }
  .pin-halo {
    fill: var(--accent, #5ee6a0);
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .pin-label {
    fill: var(--text-4);
    font-family: var(--font-mono);
    font-size: 1.4px;
    letter-spacing: 0.06em;
    transition:
      fill 0.5s ease,
      font-size 0.4s ease;
  }
  [data-stage-item][data-active='1'] .pin {
    fill: var(--accent, #5ee6a0);
  }
  [data-stage-item][data-active='1'] .pin-halo {
    opacity: 0.16;
  }
  [data-stage-item][data-active='1'] .pin-label {
    fill: var(--text-1);
    font-size: 2px;
  }
  .mp-step {
    border-top: 1px solid var(--hairline);
    min-height: 62vh;
    opacity: 0.32;
    padding: var(--space-34) 0;
    transition: opacity 0.5s ease;
  }
  .mp-step[data-active='1'] {
    opacity: 1;
  }
  .mp-city {
    font-family: var(--font-mono);
    font-size: 1.7rem;
    margin: 0;
  }
  .mp-count {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    margin: var(--space-4) 0 var(--space-20);
    text-transform: uppercase;
  }
  .mp-step ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mp-step li {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .mp-date {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .mp-talk {
    color: var(--text-2);
    font-size: 0.88rem;
  }
  .mp-talk a {
    color: var(--accent, var(--text-1));
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    margin-left: var(--space-8);
    text-transform: uppercase;
  }
  .mp-close {
    border-top: 1px solid var(--hairline);
    padding: var(--space-48) var(--space-40);
  }
  @media (max-width: 999px), (prefers-reduced-motion: reduce) {
    .mp-step {
      min-height: 0;
      opacity: 1;
    }
  }
</style>
