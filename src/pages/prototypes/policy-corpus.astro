---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PolicyCorpusCanvas from '../../components/PolicyCorpusCanvas.astro';
import PolicyCorpusExplorer from '../../components/PolicyCorpusExplorer.astro';
import PrototypeSwitcher from '../../components/PrototypeSwitcher.astro';

const frontmatter = {
  title: 'Policy corpus prototypes',
  description: 'Two interaction studies for the policy corpus explorer.',
};
---

<BaseLayout frontmatter={frontmatter}>
  <header class="prototype-header">
    <p class="eyebrow">PROTOTYPE · POLICY CORPUS</p>
    <h1>How should the record speak?</h1>
    <p>Compare the repaired DOM field with a canvas-driven typographic convergence.</p>
  </header>

  <PrototypeSwitcher
    options={[
      { label: 'V1 · DOM FIELD', value: '1' },
      { label: 'V2 · CANVAS FIELD', value: '2' },
    ]}
  >
    <section data-prototype-variant="1">
      <PolicyCorpusExplorer />
    </section>
    <section data-prototype-variant="2" hidden>
      <PolicyCorpusCanvas />
    </section>
  </PrototypeSwitcher>
</BaseLayout>

<style>
  .prototype-header {
    padding: 128px 48px 72px;
  }
  h1 {
    font: 300 clamp(52px, 7vw, 92px) / 0.98 var(--font-display);
    letter-spacing: -0.03em;
    margin: 20px 0 24px;
    max-width: 980px;
  }
  .prototype-header > p:last-child {
    color: var(--text-2);
    font-size: var(--body-16);
    line-height: 1.7;
    margin: 0;
    max-width: 720px;
  }
  section[hidden] {
    display: none;
  }
  @media (max-width: 600px) {
    .prototype-header {
      padding: 104px 18px 56px;
    }
  }
</style>
