---
// PROTOTYPE C — "The arc". A scrollytelling page: the year sticks on the left
// while its talks scroll past on the right, so the pitch is the trajectory
// rather than a list. Closest in spirit to the state-of-ML report.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpeakingEnquiry from '../../components/SpeakingEnquiry.astro';
import EventBanner from '../../components/EventBanner.astro';
import { loadEvents, recordings, type Event } from '../../utils/Events';

const today = new Date();
const { all } = await loadEvents(today);
const spoken = all.filter((event) => (event.talks ?? []).length > 0);

const years = [...new Set(spoken.map((event) => event.start.getFullYear()))].sort((a, b) => a - b);
const chapters = years.map((year) => ({
  year,
  events: spoken.filter((event) => event.start.getFullYear() === year),
  topics: [...new Set(spoken.filter((e) => e.start.getFullYear() === year).flatMap((e) => e.topics ?? []))],
}));

// The claim each year makes. Written here rather than derived: the arc is an
// argument, and the data underneath it is the evidence, not the sentence.
const claims: Record<number, string> = {
  2019: 'Getting a model into production was still the hard part.',
  2020: 'The tooling caught up, and the questions moved to operations.',
  2021: 'Explainability and risk stopped being someone else’s problem.',
  2022: 'Production ML became a platform discipline.',
  2024: 'Generative models arrived on every roadmap at once.',
  2025: 'The question turned from what a model can do to what it should be allowed to do.',
  2026: 'Agents made every old operational lesson urgent again.',
};

const shot = 'https://worldsummit.ai/wp-content/uploads/2025/10/WSAI25_Karen-Hao_Main-Stage_Wide-Audience-scaled.jpg';
---

<BaseLayout
  frontmatter={{
    title: 'Speaking — prototype C',
    description: 'Prototype: invite Alejandro Saucedo to speak.',
    noindex: true,
  }}
>
  <main class="arc">
    <section class="arc-open">
      <img src={shot} alt="" />
      <div>
        <p class="eyebrow">SPEAKING</p>
        <h1>Eight years of telling rooms what production ML actually costs</h1>
        <p class="lede">
          From MLOps tooling to agentic systems, on stages from FOSDEM to NeurIPS. If that arc is useful to your programme, the enquiry tab follows you down the
          page.
        </p>
      </div>
    </section>

    {
      chapters.map((chapter) => (
        <section class="chapter" data-reveal>
          <div class="chapter-side">
            <p class="chapter-year">{chapter.year}</p>
            <p class="chapter-claim">{claims[chapter.year] ?? ''}</p>
            <p class="chapter-topics">{chapter.topics.slice(0, 3).join(' · ')}</p>
          </div>
          <div class="chapter-talks">
            {chapter.events.map((event: Event) => (
              <a class="chapter-card" href={recordings(event)[0]?.video ?? event.url} target="_blank" rel="noopener noreferrer">
                <span class="chapter-art">
                  <EventBanner
                    slug={event.slug}
                    series={event.series}
                    label={event.series.toUpperCase()}
                    topic={event.topics?.[0]}
                    image={(event.talks ?? []).find((talk) => talk.image)?.image ?? event.image}
                  />
                </span>
                <span class="chapter-text">
                  <strong>{event.name}</strong>
                  {(event.talks ?? []).map((talk) => (
                    <span>{talk.title}</span>
                  ))}
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }

    <section class="arc-close">
      <h2>Where should this go next?</h2>
      <p>If the trajectory fits your audience, tell me about the event.</p>
      <button class="button primary" type="button" data-enquiry-open>Invite me to speak</button>
    </section>

    <SpeakingEnquiry />
  </main>
</BaseLayout>

<style>
  .arc-open {
    display: grid;
    gap: var(--space-40);
    grid-template-columns: 1fr 1fr;
    padding: var(--space-56) var(--space-40);
  }
  .arc-open img {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--hairline);
    object-fit: cover;
    width: 100%;
  }
  .arc-open h1 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    line-height: 1.08;
    margin: var(--space-14) 0 var(--space-20);
  }
  .lede {
    color: var(--text-2);
  }
  .chapter {
    border-top: 1px solid var(--hairline);
    display: grid;
    gap: var(--space-40);
    grid-template-columns: 300px minmax(0, 1fr);
    padding: var(--space-48) var(--space-40);
  }
  .chapter-side {
    align-self: start;
    position: sticky;
    top: 110px;
  }
  .chapter-year {
    color: var(--accent, var(--text-1));
    font-family: var(--font-mono);
    font-size: 2.6rem;
    margin: 0;
  }
  .chapter-claim {
    color: var(--text-1);
    font-size: 1.2rem;
    line-height: 1.3;
    margin: var(--space-12) 0;
  }
  .chapter-topics {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    margin: 0;
    text-transform: uppercase;
  }
  .chapter-talks {
    display: grid;
    gap: var(--space-20);
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
  .chapter-card {
    border: 1px solid var(--hairline);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.4s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .chapter-card:hover {
    border-color: var(--accent-edge, var(--hairline-strong));
    transform: translateY(-3px);
  }
  .chapter-art {
    aspect-ratio: 16 / 9;
    display: block;
    overflow: hidden;
  }
  .chapter-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-14);
  }
  .chapter-text span {
    color: var(--text-3);
    font-size: 0.8rem;
  }
  .arc-close {
    border-top: 1px solid var(--hairline);
    padding: var(--space-56) var(--space-40);
  }
  @media (prefers-reduced-motion: reduce) {
    .chapter-card {
      transition: none;
    }
    .chapter-card:hover {
      transform: none;
    }
  }
  @media (max-width: 900px) {
    .arc-open,
    .chapter {
      grid-template-columns: 1fr;
    }
    .chapter-side {
      position: static;
    }
  }
</style>
